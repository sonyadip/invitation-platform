<style lang="scss">
    /* ════════════════════════════════════════════
     DESIGN TOKENS
     ════════════════════════════════════════════ */
    :root {
        --ivory: #F4EFE5;
        --cream: #EAE1D2;
        --charcoal: #25241E;
        --taupe: #A99B88;
        --olive-grey: #777766;
        --deep-brown: #4A4034;
        --white: #FDFCFA;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --font-heading: "Cormorant Garamond", "Georgia", serif;
        --font-body: "DM Sans", "Helvetica Neue", Arial, sans-serif;
        --max-w: 1200px;
        --section-py: clamp(80px, 10vw, 140px);
        --section-px: clamp(16px, 4vw, 48px);
    }

    /* ════════════════════════════════════════════
     RESET & BASE
     ════════════════════════════════════════════ */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
    }

    body {
        background: var(--ivory);
        color: var(--charcoal);
        font-family: var(--font-body);
        font-weight: 400;
        font-size: 16px;
        line-height: 1.6;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    body.menu-open {
        overflow: hidden;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    img {
        display: block;
        max-width: 100%;
        height: auto;
    }

    h1,
    h2,
    h3,
    h4,
    p {
        margin: 0;
    }

    h1,
    h2,
    h3 {
        font-family: var(--font-heading);
        font-weight: 500;
        color: var(--deep-brown);
        line-height: 1.15;
    }

    /* ════════════════════════════════════════════
     BUTTONS
     ════════════════════════════════════════════ */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 14px 28px;
        border: 1px solid transparent;
        border-radius: 4px;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.03em;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;

        &--primary {
            background: var(--charcoal);
            color: var(--white);
            border-color: var(--charcoal);

            &:hover {
                background: var(--deep-brown);
                border-color: var(--deep-brown);
                transform: translateY(-1px);
            }
        }

        &--secondary {
            background: transparent;
            color: var(--charcoal);
            border-color: var(--taupe);

            &:hover {
                border-color: var(--charcoal);
                transform: translateY(-1px);
            }
        }

        &--sm {
            padding: 10px 20px;
            font-size: 13px;
        }

        svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }
    }

    /* ════════════════════════════════════════════
     SECTION COMMON
     ════════════════════════════════════════════ */
    .section-label {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--taupe);
        margin-bottom: 16px;
    }

    .section-title {
        font-size: clamp(28px, 4vw, 48px);
        font-weight: 400;
        line-height: 1.15;
        margin-bottom: 16px;
        max-width: 680px;
    }

    .section-subtitle {
        font-size: 16px;
        color: var(--olive-grey);
        max-width: 540px;
        line-height: 1.6;
        margin-bottom: 48px;
    }

    /* Section reveal */
    .section-reveal {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);

        &.is-visible {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
        transition-delay: var(--delay, 0ms);

        &.is-visible {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Wave divider */
    .wave-divider {
        width: 120px;
        margin: 0 auto 48px;
        color: var(--taupe);

        svg {
            width: 100%;
            height: auto;
        }

        &--light {
            color: var(--olive-grey);
        }
    }

    /* ════════════════════════════════════════════
     HEADER
     ════════════════════════════════════════════ */
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        transition: background 0.35s ease, border-color 0.35s ease, transform 0.35s ease;
        border-bottom: 1px solid transparent;

        &.is-scrolled {
            background: rgba(244, 239, 229, 0.92);
            backdrop-filter: blur(12px);
            border-bottom-color: rgba(169, 155, 136, 0.2);
        }

        &.is-hidden {
            transform: translateY(-100%);
        }
    }

    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 18px var(--section-px);
    }

    .header-logo {
        display: flex;
        align-items: center;
        flex-shrink: 0;

        img {
            height: 28px;
            width: auto;
        }
    }

    .header-nav {
        display: none;
        align-items: center;
        gap: 32px;

        a {
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.04em;
            color: var(--charcoal);
            transition: color 0.2s ease;

            &:hover {
                color: var(--taupe);
            }
        }
    }

    .header-cta {
        display: none;
        padding: 10px 20px;
        background: var(--charcoal);
        color: var(--white);
        border-radius: 4px;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.03em;
        transition: background 0.25s ease, transform 0.25s ease;
        cursor: pointer;

        &:hover {
            background: var(--deep-brown);
            transform: translateY(-1px);
        }
    }

    .menu-toggle {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 28px;
        height: 28px;
        background: none;
        border: 0;
        cursor: pointer;
        padding: 0;

        span {
            display: block;
            width: 100%;
            height: 1.5px;
            background: var(--charcoal);
            border-radius: 1px;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        &[aria-expanded="true"] {
            span:nth-child(1) {
                transform: translateY(6.5px) rotate(45deg);
            }

            span:nth-child(2) {
                opacity: 0;
            }

            span:nth-child(3) {
                transform: translateY(-6.5px) rotate(-45deg);
            }
        }
    }

    /* ════════════════════════════════════════════
     MOBILE MENU
     ════════════════════════════════════════════ */
    .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 99;
        background: rgba(244, 239, 229, 0.97);
        backdrop-filter: blur(16px);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.35s ease;

        &[aria-hidden="false"] {
            opacity: 1;
            pointer-events: auto;
        }
    }

    .mobile-menu__nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 28px;
    }

    .mobile-menu__link {
        font-family: var(--font-heading);
        font-size: 28px;
        font-weight: 400;
        color: var(--charcoal);
        transition: color 0.2s ease;

        &:hover {
            color: var(--taupe);
        }
    }

    .mobile-menu__cta {
        margin-top: 12px;
        padding: 14px 32px;
        background: var(--charcoal);
        color: var(--white);
        border-radius: 4px;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.03em;
        cursor: pointer;
        transition: background 0.25s ease;

        &:hover {
            background: var(--deep-brown);
        }
    }

    /* ════════════════════════════════════════════
     HERO
     ════════════════════════════════════════════ */
    .hero {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100svh;
        padding: 140px var(--section-px) 80px;
        text-align: center;
        overflow: hidden;
    }

    .hero__bg-grain {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.4;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.06'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 256px 256px;
    }

    .hero__ornament {
        position: relative;
        z-index: 1;
        width: 140px;
        margin-bottom: 40px;
        color: var(--taupe);

        svg {
            width: 100%;
            height: auto;
        }
    }

    .hero__content {
        position: relative;
        z-index: 1;
        max-width: 700px;
    }

    .hero__headline {
        font-size: clamp(32px, 5.5vw, 64px);
        font-weight: 400;
        line-height: 1.12;
        color: var(--charcoal);
        margin-bottom: 24px;
    }

    .hero__sub {
        font-size: clamp(15px, 1.8vw, 18px);
        color: var(--olive-grey);
        max-width: 560px;
        margin: 0 auto 36px;
        line-height: 1.65;
    }

    .hero__actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .hero__mockup {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 520px;
        margin-top: 56px;
    }

    .hero__mockup-stack {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
    }

    .hero__mockup-card {
        position: absolute;
        width: 45%;
        aspect-ratio: 3 / 4;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(37, 36, 30, 0.12);
        border: 1px solid rgba(169, 155, 136, 0.15);

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        &--back {
            left: 4%;
            top: 12%;
            transform: rotate(-4deg);
            z-index: 1;
        }

        &--mid {
            left: 28%;
            top: 4%;
            transform: rotate(1deg);
            z-index: 2;
        }

        &--front {
            right: 4%;
            top: 8%;
            transform: rotate(4deg);
            z-index: 3;
        }
    }

    /* ════════════════════════════════════════════
     BRAND INTRO
     ════════════════════════════════════════════ */
    .brand-intro {
        padding: var(--section-py) var(--section-px);
        max-width: var(--max-w);
        margin: 0 auto;
    }

    .brand-intro__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
    }

    .brand-intro__heading h2 {
        font-size: clamp(26px, 3.5vw, 42px);
        font-weight: 400;
        font-style: italic;
        line-height: 1.2;
        color: var(--deep-brown);
    }

    .brand-intro__body {
        display: flex;
        flex-direction: column;
        gap: 20px;

        p {
            font-size: 16px;
            color: var(--olive-grey);
            line-height: 1.7;
        }

        em {
            font-style: italic;
            color: var(--deep-brown);
        }
    }

    /* ════════════════════════════════════════════
     SERVICES
     ════════════════════════════════════════════ */
    .services {
        padding: var(--section-py) var(--section-px);
        max-width: var(--max-w);
        margin: 0 auto;
    }

    .services__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin-top: 8px;
    }

    .service-card {
        padding: 28px 24px;
        background: var(--cream);
        border: 1px solid rgba(169, 155, 136, 0.2);
        border-radius: 6px;
        transition: border-color 0.25s ease, box-shadow 0.3s ease;
        cursor: default;

        &:hover {
            border-color: rgba(169, 155, 136, 0.45);
            box-shadow: 0 8px 32px rgba(74, 64, 52, 0.06);
        }
    }

    .service-card__icon {
        width: 28px;
        height: 28px;
        color: var(--taupe);
        margin-bottom: 16px;

        svg {
            width: 100%;
            height: 100%;
        }
    }

    .service-card h3 {
        font-family: var(--font-heading);
        font-size: 20px;
        font-weight: 500;
        margin-bottom: 8px;
        color: var(--deep-brown);
    }

    .service-card p {
        font-size: 14px;
        color: var(--olive-grey);
        line-height: 1.6;
    }

    /* ════════════════════════════════════════════
     TEMPLATES
     ════════════════════════════════════════════ */
    .templates {
        padding: var(--section-py) var(--section-px);
        max-width: var(--max-w);
        margin: 0 auto;
    }

    .templates__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .template-card {
        display: flex;
        flex-direction: column;
        background: var(--cream);
        border: 1px solid rgba(169, 155, 136, 0.2);
        border-radius: 6px;
        overflow: hidden;
        transition: border-color 0.25s ease, box-shadow 0.3s ease, transform 0.3s ease;
        cursor: pointer;

        &:hover {
            border-color: rgba(169, 155, 136, 0.4);
            box-shadow: 0 16px 48px rgba(74, 64, 52, 0.1);
            transform: translateY(-3px);
        }
    }

    .template-card__media {
        aspect-ratio: 3 / 4;
        overflow: hidden;

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s var(--ease);
        }
    }

    .template-card:hover .template-card__media img {
        transform: scale(1.04);
    }

    .template-card__body {
        padding: 16px 18px 20px;
        display: flex;
        flex-direction: column;
        gap: 6px;

        h3 {
            font-family: var(--font-heading);
            font-size: 22px;
            font-weight: 500;
            color: var(--deep-brown);
        }
    }

    .template-card__tone {
        font-size: 12px;
        color: var(--olive-grey);
        letter-spacing: 0.06em;
        margin-bottom: 10px;
    }

    .template-card__actions {
        display: flex;
        gap: 8px;
    }

    /* ════════════════════════════════════════════
     WHY SENADDA
     ════════════════════════════════════════════ */
    .why {
        padding: var(--section-py) var(--section-px);
        max-width: var(--max-w);
        margin: 0 auto;
    }

    .why__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
        margin-top: 8px;
    }

    .why-item {
        padding: 24px 0;
        border-bottom: 1px solid rgba(169, 155, 136, 0.2);

        &:last-child {
            border-bottom: 0;
        }

        h3 {
            font-family: var(--font-heading);
            font-size: 20px;
            font-weight: 500;
            color: var(--deep-brown);
            margin-bottom: 6px;
        }

        p {
            font-size: 14px;
            color: var(--olive-grey);
            line-height: 1.6;
        }
    }

    /* ════════════════════════════════════════════
     PROCESS
     ════════════════════════════════════════════ */
    .process {
        padding: var(--section-py) var(--section-px);
        max-width: var(--max-w);
        margin: 0 auto;
    }

    .process__steps {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
        margin-top: 16px;
    }

    .process-step {
        position: relative;
        padding: 28px 0 28px 48px;
        border-left: 1px solid rgba(169, 155, 136, 0.3);

        &:last-child {
            border-left-color: transparent;
        }
    }

    .process-step__num {
        position: absolute;
        left: -15px;
        top: 28px;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--ivory);
        border: 1px solid var(--taupe);
        border-radius: 50%;
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        color: var(--deep-brown);
        letter-spacing: 0.02em;
    }

    .process-step h3 {
        font-family: var(--font-heading);
        font-size: 20px;
        font-weight: 500;
        color: var(--deep-brown);
        margin-bottom: 6px;
    }

    .process-step p {
        font-size: 14px;
        color: var(--olive-grey);
        line-height: 1.6;
        max-width: 420px;
    }

    .process-step__line {
        display: none;
        /* line is done via border-left */
    }

    /* ════════════════════════════════════════════
     PACKAGES
     ════════════════════════════════════════════ */
    .packages {
        padding: var(--section-py) var(--section-px);
        max-width: var(--max-w);
        margin: 0 auto;
    }

    .packages__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .package-card {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 32px 28px;
        background: var(--cream);
        border: 1px solid rgba(169, 155, 136, 0.2);
        border-radius: 6px;
        transition: border-color 0.25s ease, box-shadow 0.3s ease;

        &--highlighted {
            background: var(--charcoal);
            border-color: var(--charcoal);
            color: var(--ivory);

            h3,
            .package-card__meaning,
            .package-card__desc {
                color: var(--ivory);
            }

            .package-card__price {
                color: var(--cream);
            }

            .package-card__features li {
                color: rgba(244, 239, 229, 0.8);
            }

            .package-card__features svg {
                color: var(--taupe);
            }

            .package-card__badge {
                color: var(--charcoal);
                background: var(--cream);
            }
        }

        &:hover {
            box-shadow: 0 12px 40px rgba(74, 64, 52, 0.08);
        }
    }

    .package-card__badge {
        position: absolute;
        top: -12px;
        left: 24px;
        padding: 4px 14px;
        background: var(--charcoal);
        color: var(--white);
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 3px;
    }

    .package-card__header {
        margin-bottom: 12px;

        h3 {
            font-family: var(--font-heading);
            font-size: 28px;
            font-weight: 500;
            margin-bottom: 2px;
        }
    }

    .package-card__meaning {
        font-size: 13px;
        font-style: italic;
        color: var(--olive-grey);
    }

    .package-card__desc {
        font-size: 14px;
        color: var(--olive-grey);
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .package-card__price {
        font-family: var(--font-heading);
        font-size: 32px;
        font-weight: 500;
        color: var(--deep-brown);
        margin-bottom: 20px;
    }

    .package-card__features {
        list-style: none;
        padding: 0;
        margin: 0 0 24px;
        display: flex;
        flex-direction: column;
        gap: 10px;

        li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: var(--olive-grey);
            line-height: 1.4;
        }

        svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            color: var(--taupe);
        }
    }

    .package-card .btn {
        margin-top: auto;
        width: 100%;
    }

    /* ════════════════════════════════════════════
     TESTIMONIALS
     ════════════════════════════════════════════ */
    .testimonials {
        padding: var(--section-py) var(--section-px);
        max-width: var(--max-w);
        margin: 0 auto;
    }

    .testimonials__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        margin-top: 8px;
    }

    .testimonial-card {
        position: relative;
        padding: 32px 28px 28px;
        background: var(--cream);
        border: 1px solid rgba(169, 155, 136, 0.2);
        border-radius: 6px;
    }

    .testimonial-card__quote {
        font-family: var(--font-heading);
        font-size: 56px;
        line-height: 1;
        color: var(--taupe);
        opacity: 0.5;
        margin-bottom: -12px;
    }

    .testimonial-card p {
        font-size: 15px;
        color: var(--deep-brown);
        line-height: 1.65;
        font-style: italic;
        margin-bottom: 20px;
    }

    .testimonial-card footer {
        display: flex;
        flex-direction: column;
        gap: 2px;

        strong {
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 500;
            color: var(--charcoal);
        }

        span {
            font-size: 12px;
            color: var(--olive-grey);
        }
    }

    /* ════════════════════════════════════════════
     FINAL CTA
     ════════════════════════════════════════════ */
    .final-cta {
        padding: var(--section-py) var(--section-px);
        background: var(--cream);
        text-align: center;

        h2 {
            font-size: clamp(28px, 4vw, 48px);
            font-weight: 400;
            line-height: 1.15;
            margin-bottom: 16px;
            color: var(--deep-brown);
        }

        >p {
            font-size: 16px;
            color: var(--olive-grey);
            max-width: 480px;
            margin: 0 auto 36px;
            line-height: 1.65;
