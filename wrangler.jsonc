{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invitation-platform",
  "main": "./dist/_worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-06-06",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "senadda.id",
      "custom_domain": true
    },
    {
      "pattern": "www.senadda.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
