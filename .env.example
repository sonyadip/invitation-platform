# Aura Invite - Environment Variables Configuration Example
# Duplicate this file as '.env' and populate with your own project credentials.

# 1. Supabase Project Credentials (Required)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anonymous-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-dashboard-crud
SUPABASE_STORAGE_BUCKET=invitation-images
MAX_IMAGE_UPLOAD_MB=5

# 2. Server Runtime Config
# Mode selection (Cloudflare Pages compatible)
PUBLIC_SITE_URL=http://localhost:4321

# 3. Optional dashboard protection
# If set, /dashboard requires this password.
DASHBOARD_PASSWORD=change-this-dashboard-password
