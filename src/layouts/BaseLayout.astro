---
import FontLoader from "../components/common/FontLoader.astro";
import GoogleAnalytics from "../components/common/GoogleAnalytics.astro";
import "../styles/global.scss";
import type { Wedding, InvitationSettings } from "../types";

interface Props {
  title?: string;
  description?: string;
  wedding: Wedding;
  settings: InvitationSettings;
  to?: string | null;
  templateClass?: string;
  image?: string;
  themeColor?: string;
  styleUrl?: string;
}

const { title, description: customDescription, wedding, settings, to, templateClass, image, themeColor: customThemeColor, styleUrl } = Astro.props;

const brideName = wedding.bride_name;
const groomName = wedding.groom_name;
const defaultTitle = `The Wedding of ${groomName} & ${brideName}`;
const docTitle = title || defaultTitle;
const formattedDate = new Date(wedding.wedding_date).toLocaleDateString("id-ID", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const description = customDescription || `Undangan pernikahan ${groomName} & ${brideName}.\n${formattedDate}.`;

const theme = settings.theme_config.theme;

const sections = (settings.theme_config as any)?.sections || {};
const hasIntro = sections.introAnimation !== false;
const templateBg = templateClass === 'template-terre' ? '#f1e9de' : (theme.bgColor || '#FAF8F5');
const initialThemeColor = customThemeColor || (hasIntro ? '#000000' : templateBg);

const userAgent = Astro.request.headers.get("user-agent") || "";
const isVerticalPlatform = /WhatsApp/i.test(userAgent);

const verticalImage = image || settings.theme_config?.assets?.coverImage || settings.theme_config?.assets?.heroImage;
const landscapeImage = settings.theme_config?.assets?.ogImage || verticalImage;
const selectedImage = isVerticalPlatform ? (verticalImage || landscapeImage) : (landscapeImage || verticalImage);

const imageUrl = selectedImage ? new URL(selectedImage, Astro.url).toString() : null;
const imageType = imageUrl?.endsWith('.png') ? 'image/png' : (imageUrl?.endsWith('.jpg') || imageUrl?.endsWith('.jpeg')) ? 'image/jpeg' : 'image/webp';
---

<!doctype html>
<html lang="id">
  <head>
    <GoogleAnalytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" id="meta-theme-color" content={initialThemeColor} />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="generator" content={Astro.generator} />

    <FontLoader fontHeading={theme.fontHeading} fontBody={theme.fontBody} />

    <style is:global>
      astro-dev-toolbar, #dev-toolbar-root {
        display: none !important;
      }
    </style>

    {imageUrl && <link rel="preload" as="image" href={imageUrl} fetchpriority="high" />}
    {['template-noir', 'template-sage', 'template-ochre', 'template-blush', 'template-terre'].includes(templateClass || '') && (
      <link rel="preload" href="/fonts/GreatVibes-Regular.woff2" as="font" type="font/woff2" crossorigin />
    )}
    {templateClass === 'template-noir' && (
      <link rel="preload" href="/fonts/CVR.ttf" as="font" type="font/ttf" crossorigin />
    )}

    <title>{docTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={docTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={defaultTitle} />
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:secure_url" content={imageUrl} />
        <meta property="og:image:type" content={imageType} />
        {isVerticalPlatform ? (
          <>
            <meta property="og:image:width" content="800" />
            <meta property="og:image:height" content="1200" />
          </>
        ) : (
          <>
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
          </>
        )}
        <meta property="og:image:alt" content={docTitle} />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={docTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <style
      define:vars={{
        primaryColor: theme.primaryColor,
        secondaryColor: theme.secondaryColor,
        textColor: theme.textColor,
        bgColor: theme.bgColor,
        fontHeading: theme.fontHeading,
        fontBody: theme.fontBody,
      }}
    >
      :root {
        --primary-color: var(--primaryColor);
        --secondary-color: var(--secondaryColor);
        --text-color: var(--textColor);
        --bg-color: var(--bgColor);
        --font-heading: var(--fontHeading);
        --font-body: var(--fontBody);
      }
    </style>

    {styleUrl && <link rel="stylesheet" href={styleUrl} />}
  </head>
  <body
    class:list={[
      "bg-secondary-light text-slate-800 antialiased font-body",
      templateClass,
    ]}
    style={`color: ${theme.textColor}`}
    data-wedding-id={wedding.id}
    data-guest-name={to || ''}
    data-theme-bg={templateBg}
  >
    <slot />
    <script>
      import { initAutomaticInteractionTracking } from "../scripts/analytics";
      import { isLocalHost } from "../utils/analytics";
      import { initLenis } from "../scripts/lenis-smooth-scroll";

      initAutomaticInteractionTracking();
      initLenis({ duration: 1.1, lerp: 0.08 });

      const isLocal = Boolean(import.meta.env.DEV) || isLocalHost(window.location.hostname);
      if (!isLocal) {
        const openBtns = document.querySelectorAll("[data-template-open]");
        openBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            const docEl = document.documentElement as HTMLElement & {
              webkitRequestFullscreen?: () => Promise<void>;
              msRequestFullscreen?: () => Promise<void>;
            };
            if (docEl.requestFullscreen) {
              docEl.requestFullscreen().catch((err) => {
                console.warn("Fullscreen error:", err.message);
              });
            } else if (docEl.webkitRequestFullscreen) {
              docEl.webkitRequestFullscreen();
            } else if (docEl.msRequestFullscreen) {
              docEl.msRequestFullscreen();
            }
          });
        });
      }
    </script>
  </body>
</html>
