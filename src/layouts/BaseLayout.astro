---
import FontLoader from "../components/common/FontLoader.astro";
import "../styles/global.scss";
import type { Wedding, InvitationSettings } from "../types";

interface Props {
  title?: string;
  wedding: Wedding;
  settings: InvitationSettings;
  to?: string | null;
  templateClass?: string;
  image?: string;
}

const { title, wedding, settings, to, templateClass, image } = Astro.props;

const brideName = wedding.bride_name;
const groomName = wedding.groom_name;
const defaultTitle = `The Wedding of ${groomName} & ${brideName}`;
const docTitle = title || defaultTitle;
const formattedDate = new Date(wedding.wedding_date).toLocaleDateString("id-ID", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const description = `Undangan pernikahan ${groomName} & ${brideName}.\n${formattedDate}.`;

const theme = settings.theme_config.theme;
const ogImageCandidate = settings.theme_config?.assets?.ogImage || image;
const imageUrl = ogImageCandidate ? new URL(ogImageCandidate, Astro.url).toString() : null;
const imageType = imageUrl?.endsWith('.png') ? 'image/png' : (imageUrl?.endsWith('.jpg') || imageUrl?.endsWith('.jpeg')) ? 'image/jpeg' : 'image/webp';
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Dynamic Fonts Injection -->
    <FontLoader fontHeading={theme.fontHeading} fontBody={theme.fontBody} />

    <!-- LCP Image Preload -->
    {imageUrl && <link rel="preload" as="image" href={imageUrl} fetchpriority="high" />}

    <!-- SEO Meta Tags -->
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph (Facebook / WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={docTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={defaultTitle} />
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:secure_url" content={imageUrl} />
        <meta property="og:image:type" content={imageType} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={docTitle} />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={docTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <!-- Dynamic Theme Styling Injection -->
    <style
      define:vars={{
        primaryColor: theme.primaryColor,
        secondaryColor: theme.secondaryColor,
        textColor: theme.textColor,
        bgColor: theme.bgColor,
        fontHeading: theme.fontHeading,
        fontBody: theme.fontBody,
      }}
    >
      :root {
        --primary-color: var(--primaryColor);
        --secondary-color: var(--secondaryColor);
        --text-color: var(--textColor);
        --bg-color: var(--bgColor);
        --font-heading: var(--fontHeading);
        --font-body: var(--fontBody);
      }
    </style>
  </head>
  <body
    class:list={[
      "bg-secondary-light text-slate-800 antialiased font-body",
      templateClass,
    ]}
    style={`color: ${theme.textColor}`}
    data-wedding-id={wedding.id}
    data-guest-name={to || ''}
  >
    <slot />
    <script>
      import { initAutomaticInteractionTracking } from "../scripts/analytics";
      initAutomaticInteractionTracking();

      const openBtns = document.querySelectorAll("[data-template-open]");
      openBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const docEl = document.documentElement as HTMLElement & {
            webkitRequestFullscreen?: () => Promise<void>;
            msRequestFullscreen?: () => Promise<void>;
          };
          if (docEl.requestFullscreen) {
            docEl.requestFullscreen().catch((err) => {
              console.warn("Fullscreen error:", err.message);
            });
          } else if (docEl.webkitRequestFullscreen) {
            docEl.webkitRequestFullscreen();
          } else if (docEl.msRequestFullscreen) {
            docEl.msRequestFullscreen();
          }
        });
      });
    </script>
  </body>
</html>
