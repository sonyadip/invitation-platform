---
const { title = "Dashboard" } = Astro.props;
const slug = Astro.params.slug || "wayan-ayu"; // default fallback for safety
const currentPath = `/dashboard/${slug}${Astro.url.pathname.replace(`/dashboard/${slug}`, '')}`;
import "../styles/dashboard.scss";
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Senadda</title>
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link href="https://db.onlinewebfonts.com/c/4c4c08af466e9ad071b6d69cf44093df?family=SaolDisplay-Regular" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
</head>
<body>
  
  <!-- TopAppBar -->
  <header class="dashboard-header" id="dashboard-header">
    <div class="dashboard-header__left">
      <button id="menu-btn" class="icon-btn">
        <span class="material-symbols-outlined" data-icon="menu">menu</span>
      </button>
      <span class="dashboard-header__title">{title}</span>
    </div>
    
    <div class="dashboard-header__right">
      <a href="/api/auth/logout" class="icon-btn" title="Logout">
        <span class="material-symbols-outlined" data-icon="logout">logout</span>
      </a>
    </div>
  </header>

  <!-- Mobile Sidebar Drawer -->
  <div id="mobile-drawer" class="dashboard-drawer-wrapper">
    <div id="drawer-backdrop" class="dashboard-drawer__backdrop"></div>
    
    <div id="drawer-content" class="dashboard-drawer__content">
      <div class="dashboard-drawer__header">
        <img src="/images/senadda-logo.png" alt="Senadda Logo" class="dashboard-logo" />
        <button id="close-drawer" class="icon-btn">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="dashboard-drawer__nav">
        <a href={`/dashboard/${slug}`} class={`nav-link ${currentPath === `/dashboard/${slug}` ? 'nav-link--active' : ''}`}>
          <span class="material-symbols-outlined" style={currentPath === `/dashboard/${slug}` ? "font-variation-settings: 'FILL' 1" : ""}>home</span>
          Dashboard
        </a>
        <a href={`/dashboard/${slug}/kirim-undangan`} class={`nav-link ${currentPath === `/dashboard/${slug}/kirim-undangan` ? 'nav-link--active' : ''}`}>
          <span class="material-symbols-outlined" style={currentPath === `/dashboard/${slug}/kirim-undangan` ? "font-variation-settings: 'FILL' 1" : ""}>send</span>
          Kirim Undangan
        </a>
        <a href={`/dashboard/${slug}/rsvp`} class={`nav-link ${currentPath === `/dashboard/${slug}/rsvp` ? 'nav-link--active' : ''}`}>
          <span class="material-symbols-outlined" style={currentPath === `/dashboard/${slug}/rsvp` ? "font-variation-settings: 'FILL' 1" : ""}>mail</span>
          RSVP
        </a>
      </div>
      <div class="dashboard-drawer__footer">
        <a href="/api/auth/logout" class="nav-link nav-link--error">
          <span class="material-symbols-outlined">logout</span>
          Logout
        </a>
      </div>
    </div>
  </div>

  <!-- Navigation Bottom Bar (Mobile App Style) -->
  <nav class="dashboard-bottom-nav">
    <div class="dashboard-bottom-nav__inner">
      <a href={`/dashboard/${slug}`} class={`bottom-nav-item ${currentPath === `/dashboard/${slug}` ? 'bottom-nav-item--active' : ''}`}>
        <span class="material-symbols-outlined" style={currentPath === `/dashboard/${slug}` ? "font-variation-settings: 'FILL' 1" : ""}>home</span>
        <span class="bottom-nav-item__text">Home</span>
      </a>
      <a href={`/dashboard/${slug}/rsvp`} class={`bottom-nav-item ${currentPath === `/dashboard/${slug}/rsvp` ? 'bottom-nav-item--active' : ''}`}>
        <span class="material-symbols-outlined" style={currentPath === `/dashboard/${slug}/rsvp` ? "font-variation-settings: 'FILL' 1" : ""}>mail</span>
        <span class="bottom-nav-item__text">RSVP</span>
      </a>
      <a href={`/dashboard/${slug}/kirim-undangan`} class={`bottom-nav-item ${currentPath === `/dashboard/${slug}/kirim-undangan` ? 'bottom-nav-item--active' : ''}`}>
        <span class="material-symbols-outlined" style={currentPath === `/dashboard/${slug}/kirim-undangan` ? "font-variation-settings: 'FILL' 1" : ""}>send</span>
        <span class="bottom-nav-item__text">Kirim</span>
      </a>
    </div>
  </nav>

  <!-- Main Content Wrapper (Mobile Container) -->
  <main class="dashboard-main">
    <slot />
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Hamburger Menu Logic
      const menuBtn = document.getElementById('menu-btn');
      const drawer = document.getElementById('mobile-drawer');
      const backdrop = document.getElementById('drawer-backdrop');
      const content = document.getElementById('drawer-content');
      const closeBtn = document.getElementById('close-drawer');

      function openDrawer() {
        drawer.style.pointerEvents = 'auto';
        backdrop.style.opacity = '1';
        content.style.transform = 'translateX(0)';
      }

      function closeDrawer() {
        backdrop.style.opacity = '0';
        content.style.transform = 'translateX(-100%)';
        setTimeout(() => {
          drawer.style.pointerEvents = 'none';
        }, 300);
      }

      if (menuBtn) menuBtn.addEventListener('click', openDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (backdrop) backdrop.addEventListener('click', closeDrawer);

      // Intersection Observer for fade-in elements
      const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
              if (entry.isIntersecting) {
                  entry.target.classList.add('fade-in-bottom');
              }
          });
      }, { threshold: 0.1 });

      document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));

      // Tonal Layer scroll effect for Header
      window.addEventListener('scroll', () => {
          const header = document.getElementById('dashboard-header');
          if (window.scrollY > 20) {
              header.style.backgroundColor = '#ffffff';
              header.style.boxShadow = '0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)';
          } else {
              header.style.backgroundColor = 'var(--color-surface)';
              header.style.boxShadow = '0 1px 2px 0 rgba(0, 0, 0, 0.05)';
          }
      });
      
      // Haptic feedback for buttons
      document.querySelectorAll('button, a').forEach(el => {
          el.addEventListener('click', () => {
              if (window.navigator && window.navigator.vibrate) {
                  window.navigator.vibrate(5);
              }
          });
      });
    });
  </script>
</body>
</html>
