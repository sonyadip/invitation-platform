---
import { getSlugReportDetail } from '../../services/dashboard-report';
import { hashPasswordSHA256 } from '../../utils/security';

export const prerender = false;

const { slug } = Astro.params;
const dashboardPassword =
  import.meta.env.DASHBOARD_PASSWORD ||
  (typeof process !== 'undefined' ? process.env.DASHBOARD_PASSWORD : '') ||
  '';

const cookieName = 'dashboard_unlocked';
let errorMessage = '';

if (dashboardPassword && Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = String(formData.get('password') || '');
  const enteredHash = await hashPasswordSHA256(password);
  const passwordHash = await hashPasswordSHA256(dashboardPassword);

  if (enteredHash === passwordHash) {
    Astro.cookies.set(cookieName, enteredHash, {
      path: '/dashboard',
      maxAge: 60 * 60 * 8,
      httpOnly: true,
      secure: true,
      sameSite: 'strict'
    });

    return Astro.redirect(`/dashboard/${slug}`);
  }

  errorMessage = 'Password salah.';
}

const isUnlocked = !dashboardPassword ||
  Astro.cookies.get(cookieName)?.value === await hashPasswordSHA256(dashboardPassword);

const formatNumber = (value: number) => new Intl.NumberFormat('id-ID').format(value);
const formatDate = (value: string | null) => value
  ? new Date(value).toLocaleDateString('id-ID', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    })
  : '-';
const formatDateTime = (value: string | null) => value
  ? new Date(value).toLocaleString('id-ID', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })
  : '-';

let detail = null;
let loadError = '';

if (isUnlocked && slug) {
  try {
    detail = await getSlugReportDetail(slug);
  } catch (error) {
    console.error('Slug report load error:', error);
    loadError = error instanceof Error ? error.message : 'Gagal memuat report slug.';
  }
}

if (isUnlocked && !loadError && !detail) {
  return new Response('Report slug tidak ditemukan.', { status: 404 });
}
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{slug} - Slug Report</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    {isUnlocked ? (
      <main class="detail-shell">
        <header class="detail-header">
          <div>
            <a class="back-link" href="/dashboard">Back to dashboard</a>
            <p class="eyebrow">Slug Report</p>
            <h1>{detail?.summary.slug}</h1>
            <p class="subtitle">{detail?.summary.coupleName} · {detail && formatDate(detail.summary.weddingDate)}</p>
          </div>
          <div class="header-actions">
            <a href={`/dashboard/${detail?.summary.slug}/edit`}>Edit invitation</a>
            <a href={`/${detail?.summary.slug}`} target="_blank" rel="noopener noreferrer">Open invitation</a>
            {detail?.summary.customDomain && (
              <a href={`https://${detail.summary.customDomain}`} target="_blank" rel="noopener noreferrer">
                Open domain
              </a>
            )}
          </div>
        </header>

        {loadError ? (
          <section class="error-panel">
            <strong>Report gagal dimuat</strong>
            <p>{loadError}</p>
          </section>
        ) : detail && (
          <>
            <section class="metric-grid" aria-label="Slug summary">
              <div class="metric"><span>Views</span><strong>{formatNumber(detail.summary.viewCount)}</strong></div>
              <div class="metric"><span>RSVP</span><strong>{formatNumber(detail.summary.rsvpCount)}</strong></div>
              <div class="metric"><span>Attending</span><strong>{formatNumber(detail.summary.attendingCount)}</strong></div>
              <div class="metric"><span>Declined</span><strong>{formatNumber(detail.summary.declinedCount)}</strong></div>
              <div class="metric"><span>Guests</span><strong>{formatNumber(detail.summary.guestCount)}</strong></div>
              <div class="metric"><span>Wishes</span><strong>{formatNumber(detail.summary.wishesCount)}</strong></div>
            </section>

            <section class="panel-grid">
              <article class="panel">
                <div class="panel-heading">
                  <h2>Invitation Info</h2>
                </div>
                <dl class="info-list">
                  <div><dt>Status</dt><dd><span class={`status status--${detail.summary.status}`}>{detail.summary.status}</span></dd></div>
                  <div><dt>Template</dt><dd>{detail.wedding.template}</dd></div>
                  <div><dt>Wedding Date</dt><dd>{formatDateTime(detail.wedding.weddingDate)}</dd></div>
                  <div><dt>Venue</dt><dd>{detail.wedding.venueName}</dd></div>
                  <div><dt>Address</dt><dd>{detail.wedding.venueAddress}</dd></div>
                  <div><dt>Custom Domain</dt><dd>{detail.summary.customDomain || '-'}</dd></div>
                  <div><dt>Latest RSVP</dt><dd>{formatDateTime(detail.summary.latestRsvpAt)}</dd></div>
                  <div><dt>Created</dt><dd>{formatDateTime(detail.wedding.createdAt)}</dd></div>
                </dl>
              </article>

              <article class="panel">
                <div class="panel-heading">
                  <h2>Settings</h2>
                </div>
                {detail.settings ? (
                  <div class="toggle-grid">
                    <span class={detail.settings.rsvpEnabled ? 'on' : 'off'}>RSVP</span>
                    <span class={detail.settings.musicEnabled ? 'on' : 'off'}>Music</span>
                    <span class={detail.settings.countdownEnabled ? 'on' : 'off'}>Countdown</span>
                    <span class={detail.settings.galleryEnabled ? 'on' : 'off'}>Gallery</span>
                    <span class={detail.settings.wishesEnabled ? 'on' : 'off'}>Wishes</span>
                    <span class={detail.settings.giftEnabled ? 'on' : 'off'}>Gift</span>
                    <span class={detail.settings.viewCounterEnabled ? 'on' : 'off'}>View Counter</span>
                    <span class={detail.settings.maintenanceMode ? 'off' : 'on'}>Maintenance</span>
                    <span class={detail.settings.passwordProtectionEnabled ? 'off' : 'on'}>Password</span>
                    <span class={detail.summary.isExpired ? 'off' : 'on'}>Expiration</span>
                  </div>
                ) : (
                  <p class="empty">Settings tidak ditemukan.</p>
                )}
              </article>
            </section>

            <section class="panel-grid panel-grid--balanced">
              <article class="panel">
                <div class="panel-heading">
                  <h2>Events</h2>
                  <p>{formatNumber(detail.events.length)} event</p>
                </div>
                {detail.events.length ? (
                  <div class="stack-list">
                    {detail.events.map((event) => (
                      <div class="stack-item">
                        <strong>{event.name}</strong>
                        <span>{formatDate(event.date)} · {event.startTime} - {event.endTime}</span>
                        <p>{event.venueName}</p>
                      </div>
                    ))}
                  </div>
                ) : <p class="empty">Belum ada event.</p>}
              </article>

              <article class="panel">
                <div class="panel-heading">
                  <h2>Gift Accounts</h2>
                  <p>{formatNumber(detail.gifts.length)} account</p>
                </div>
                {detail.gifts.length ? (
                  <div class="stack-list">
                    {detail.gifts.map((gift) => (
                      <div class="stack-item">
                        <strong>{gift.bankName}</strong>
                        <span>{gift.accountNumber}</span>
                        <p>{gift.accountName}{gift.hasQris ? ' · QRIS available' : ''}</p>
                      </div>
                    ))}
                  </div>
                ) : <p class="empty">Belum ada gift account.</p>}
              </article>
            </section>

            <section class="panel">
              <div class="panel-heading">
                <h2>Daily Views</h2>
                <p>{formatNumber(detail.dailyViews.length)} day records</p>
              </div>
              {detail.dailyViews.length ? (
                <div class="daily-grid">
                  {detail.dailyViews.map((view) => (
                    <div>
                      <span>{formatDate(view.date)}</span>
                      <strong>{formatNumber(view.count)}</strong>
                    </div>
                  ))}
                </div>
              ) : <p class="empty">Belum ada view.</p>}
            </section>

            <section class="panel">
              <div class="panel-heading">
                <h2>RSVP & Wishes</h2>
                <p>{formatNumber(detail.rsvps.length)} records</p>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Guest</th>
                      <th>Status</th>
                      <th>Count</th>
                      <th>Message</th>
                      <th>Created</th>
                    </tr>
                  </thead>
                  <tbody>
                    {detail.rsvps.map((rsvp) => (
                      <tr>
                        <td>{rsvp.guestName}</td>
                        <td><span class={`status status--${rsvp.attendanceStatus}`}>{rsvp.attendanceStatus}</span></td>
                        <td>{formatNumber(rsvp.guestCount)}</td>
                        <td class="message-cell">{rsvp.message || '-'}</td>
                        <td>{formatDateTime(rsvp.createdAt)}</td>
                      </tr>
                    ))}
                    {!detail.rsvps.length && (
                      <tr>
                        <td colspan="5" class="empty-row">Belum ada RSVP.</td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          </>
        )}
      </main>
    ) : (
      <main class="login-shell">
        <form class="login-card" method="POST">
          <p class="eyebrow">Private Report</p>
          <h1>Dashboard Login</h1>
          <p class="subtitle">Masukkan password dashboard untuk melihat report slug.</p>
          <label for="password">Password</label>
          <input id="password" type="password" name="password" required autofocus />
          {errorMessage && <p class="form-error">{errorMessage}</p>}
          <button type="submit">Open Report</button>
        </form>
      </main>
    )}
  </body>
</html>

<style lang="scss">
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f4f5f7;
    color: #20242c;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .detail-shell {
    width: min(1280px, 100%);
    margin: 0 auto;
    padding: 28px;
  }

  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 22px;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 18px;
    color: #2563eb;
    font-size: 13px;
    font-weight: 700;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #687080;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 8px;
    font-size: 34px;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: 18px;
  }

  .subtitle {
    margin-bottom: 0;
    color: #687080;
    font-size: 14px;
    line-height: 1.6;
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  .header-actions a {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border: 1px solid #d9dde5;
    border-radius: 6px;
    background: #ffffff;
    font-size: 13px;
    font-weight: 700;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 18px;
  }

  .metric,
  .panel,
  .error-panel {
    border: 1px solid #d9dde5;
    border-radius: 8px;
    background: #ffffff;
  }

  .metric {
    padding: 16px;
  }

  .metric span {
    display: block;
    margin-bottom: 10px;
    color: #687080;
    font-size: 12px;
  }

  .metric strong {
    display: block;
    font-size: 26px;
    line-height: 1;
  }

  .panel-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 18px;
    margin-bottom: 18px;
  }

  .panel-grid--balanced {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .panel {
    margin-bottom: 18px;
  }

  .panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px;
    border-bottom: 1px solid #e5e8ef;
  }

  .panel-heading p {
    margin: 0;
    color: #687080;
    font-size: 13px;
  }

  .info-list {
    margin: 0;
    padding: 18px;
  }

  .info-list div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid #eef0f4;
  }

  .info-list div:last-child {
    border-bottom: 0;
  }

  dt {
    color: #687080;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  .toggle-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 18px;
  }

  .toggle-grid span,
  .status {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    text-transform: capitalize;
  }

  .toggle-grid .on,
  .status--published,
  .status--attending {
    background: #ecfdf5;
    color: #047857;
  }

  .toggle-grid .off,
  .status--declined {
    background: #fff1f2;
    color: #be123c;
  }

  .status--draft {
    background: #fff7ed;
    color: #c2410c;
  }

  .status--archived {
    background: #f3f4f6;
    color: #4b5563;
  }

  .stack-list {
    display: grid;
    gap: 0;
    padding: 0 18px;
  }

  .stack-item {
    padding: 16px 0;
    border-bottom: 1px solid #eef0f4;
  }

  .stack-item:last-child {
    border-bottom: 0;
  }

  .stack-item strong,
  .stack-item span {
    display: block;
  }

  .stack-item strong {
    margin-bottom: 6px;
    font-size: 14px;
  }

  .stack-item span,
  .stack-item p {
    color: #687080;
    font-size: 13px;
  }

  .stack-item p {
    margin: 6px 0 0;
    line-height: 1.5;
  }

  .daily-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    padding: 18px;
  }

  .daily-grid div {
    padding: 12px;
    border: 1px solid #eef0f4;
    border-radius: 6px;
    background: #fafbfc;
  }

  .daily-grid span,
  .daily-grid strong {
    display: block;
  }

  .daily-grid span {
    margin-bottom: 8px;
    color: #687080;
    font-size: 12px;
  }

  .daily-grid strong {
    font-size: 20px;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 860px;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 13px 14px;
    border-bottom: 1px solid #eef0f4;
    text-align: left;
    vertical-align: top;
    font-size: 13px;
  }

  th {
    color: #687080;
    background: #fafbfc;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .message-cell {
    max-width: 420px;
    white-space: normal;
    line-height: 1.55;
  }

  .empty,
  .empty-row {
    padding: 18px;
    color: #687080;
    font-size: 13px;
  }

  .error-panel {
    padding: 18px;
    color: #991b1b;
    background: #fff5f5;
  }

  .login-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
  }

  .login-card {
    width: min(420px, 100%);
    padding: 24px;
    border: 1px solid #d9dde5;
    border-radius: 8px;
    background: #ffffff;
  }

  .login-card label {
    display: block;
    margin: 22px 0 8px;
    color: #394150;
    font-size: 13px;
    font-weight: 700;
  }

  .login-card input {
    width: 100%;
    height: 44px;
    padding: 0 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font: inherit;
  }

  .login-card button {
    width: 100%;
    height: 44px;
    margin-top: 16px;
    border: 0;
    border-radius: 6px;
    background: #111827;
    color: #ffffff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .form-error {
    margin: 12px 0 0;
    color: #b91c1c;
    font-size: 13px;
  }

  @media (max-width: 1100px) {
    .metric-grid,
    .daily-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .panel-grid,
    .panel-grid--balanced {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .detail-shell {
      padding: 18px;
    }

    .detail-header,
    .panel-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .header-actions {
      justify-content: flex-start;
    }

    .metric-grid,
    .daily-grid,
    .toggle-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .info-list div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
