---
import { createInvitation, parseInvitationForm } from '../../services/dashboard-crud';
import { listTemplateKeys } from '../../templates/registry';
import { hashPasswordSHA256 } from '../../utils/security';

export const prerender = false;

const dashboardPassword =
  import.meta.env.DASHBOARD_PASSWORD ||
  (typeof process !== 'undefined' ? process.env.DASHBOARD_PASSWORD : '') ||
  '';
const cookieName = 'dashboard_unlocked';
const templateOptions = listTemplateKeys();
const isUnlocked = !dashboardPassword ||
  Astro.cookies.get(cookieName)?.value === await hashPasswordSHA256(dashboardPassword);

if (!isUnlocked) {
  return Astro.redirect('/dashboard');
}

let errorMessage = '';
const defaults = {
  slug: '',
  brideName: '',
  groomName: '',
  brideFullName: '',
  groomFullName: '',
  weddingDate: '',
  venueName: '',
  venueAddress: '',
  mapsUrl: '',
  musicUrl: '',
  template: 'noir',
  status: 'draft',
  rsvpEnabled: true,
  musicEnabled: true,
  countdownEnabled: true,
  galleryEnabled: true,
  wishesEnabled: true,
  giftEnabled: true,
  viewCounterEnabled: true,
  maintenanceMode: false,
  passwordProtectionEnabled: false,
  accessPassword: '',
  expirationDate: '',
  heroImageUrl: '',
  brideImageUrl: '',
  groomImageUrl: '',
  galleryImageUrls: ''
};

let values = defaults;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const parsed = parseInvitationForm(formData);
  values = {
    ...parsed,
    accessPassword: parsed.accessPassword || '',
    musicUrl: parsed.musicUrl || '',
    expirationDate: parsed.expirationDate || '',
    heroImageUrl: parsed.heroImageUrl || '',
    brideImageUrl: parsed.brideImageUrl || '',
    groomImageUrl: parsed.groomImageUrl || '',
    galleryImageUrls: parsed.galleryImageUrls.join('\n')
  };

  try {
    const slug = await createInvitation(parsed);
    return Astro.redirect(`/dashboard/${slug}/edit?created=1`);
  } catch (error) {
    console.error('Create invitation error:', error);
    errorMessage = error instanceof Error ? error.message : 'Failed to create invitation.';
  }
}
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Invitation - Dashboard</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="shell">
      <header class="header">
        <div>
          <a class="back-link" href="/dashboard">Back to dashboard</a>
          <p class="eyebrow">Dashboard CRUD</p>
          <h1>Create Invitation</h1>
          <p class="subtitle">Create core wedding data and default invitation settings.</p>
        </div>
      </header>

      {errorMessage && <div class="error-panel">{errorMessage}</div>}

      <form class="form-panel" method="POST" enctype="multipart/form-data">
        <section>
          <h2>Core Data</h2>
          <div class="form-grid">
            <label>Slug<input name="slug" value={values.slug} placeholder="wayan-ayu" required /></label>
            <label>Status
              <select name="status">
                <option value="draft" selected={values.status === 'draft'}>Draft</option>
                <option value="published" selected={values.status === 'published'}>Published</option>
                <option value="archived" selected={values.status === 'archived'}>Archived</option>
              </select>
            </label>
            <label>Template
              <select name="template">
                {templateOptions.map((template) => (
                  <option value={template} selected={values.template === template}>{template}</option>
                ))}
              </select>
            </label>
            <label>Wedding Date<input type="datetime-local" name="weddingDate" value={values.weddingDate} required /></label>
            <label>Groom Name<input name="groomName" value={values.groomName} required /></label>
            <label>Bride Name<input name="brideName" value={values.brideName} required /></label>
            <label>Groom Full Name<input name="groomFullName" value={values.groomFullName} required /></label>
            <label>Bride Full Name<input name="brideFullName" value={values.brideFullName} required /></label>
            <label>Venue Name<input name="venueName" value={values.venueName} required /></label>
            <label>Maps URL<input name="mapsUrl" value={values.mapsUrl} required /></label>
            <label class="wide">Venue Address<textarea name="venueAddress" rows="3" required>{values.venueAddress}</textarea></label>
            <label class="wide">Music URL<input name="musicUrl" value={values.musicUrl} /></label>
          </div>
        </section>

        <section>
          <h2>Images</h2>
          <div class="form-grid">
            <label class="wide">Hero / Cover Image URL<input name="heroImageUrl" value={values.heroImageUrl} placeholder="https://example.com/hero.jpg" /></label>
            <label class="wide">Upload Hero / Cover Image<input type="file" name="heroImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label>Bride Image URL<input name="brideImageUrl" value={values.brideImageUrl} placeholder="https://example.com/bride.jpg" /></label>
            <label>Upload Bride Image<input type="file" name="brideImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label>Groom Image URL<input name="groomImageUrl" value={values.groomImageUrl} placeholder="https://example.com/groom.jpg" /></label>
            <label>Upload Groom Image<input type="file" name="groomImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label class="wide">Gallery Image URLs<textarea name="galleryImageUrls" rows="6" placeholder={"https://example.com/gallery-1.jpg\nhttps://example.com/gallery-2.jpg"}>{values.galleryImageUrls}</textarea></label>
            <label class="wide">Upload Gallery Images<input type="file" name="galleryImageFiles" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple /></label>
          </div>
        </section>

        <section>
          <h2>Settings</h2>
          <div class="toggle-grid">
            <label><input type="checkbox" name="rsvpEnabled" checked={values.rsvpEnabled} /> RSVP</label>
            <label><input type="checkbox" name="musicEnabled" checked={values.musicEnabled} /> Music</label>
            <label><input type="checkbox" name="countdownEnabled" checked={values.countdownEnabled} /> Countdown</label>
            <label><input type="checkbox" name="galleryEnabled" checked={values.galleryEnabled} /> Gallery</label>
            <label><input type="checkbox" name="wishesEnabled" checked={values.wishesEnabled} /> Wishes</label>
            <label><input type="checkbox" name="giftEnabled" checked={values.giftEnabled} /> Gift</label>
            <label><input type="checkbox" name="viewCounterEnabled" checked={values.viewCounterEnabled} /> View Counter</label>
            <label><input type="checkbox" name="maintenanceMode" checked={values.maintenanceMode} /> Maintenance</label>
            <label><input type="checkbox" name="passwordProtectionEnabled" checked={values.passwordProtectionEnabled} /> Password Protection</label>
          </div>
          <div class="form-grid">
            <label>Access Password<input name="accessPassword" value={values.accessPassword} /></label>
            <label>Expiration Date<input type="datetime-local" name="expirationDate" value={values.expirationDate} /></label>
          </div>
        </section>

        <footer class="form-actions">
          <a href="/dashboard">Cancel</a>
          <button type="submit">Create Invitation</button>
        </footer>
      </form>
    </main>
  </body>
</html>

<style lang="scss">
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f4f5f7;
    color: #20242c;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .shell { width: min(1100px, 100%); margin: 0 auto; padding: 28px; }
  .header { margin-bottom: 22px; }
  .back-link { display: inline-flex; margin-bottom: 18px; color: #2563eb; font-size: 13px; font-weight: 700; text-decoration: none; }
  .eyebrow { margin: 0 0 8px; color: #687080; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0 0 8px; font-size: 32px; }
  h2 { margin: 0 0 16px; font-size: 18px; }
  .subtitle { margin: 0; color: #687080; font-size: 14px; }
  .form-panel, .error-panel {
    border: 1px solid #d9dde5;
    border-radius: 8px;
    background: #ffffff;
  }
  .error-panel { margin-bottom: 16px; padding: 14px 16px; color: #991b1b; background: #fff5f5; }
  section { padding: 20px; border-bottom: 1px solid #eef0f4; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  label { display: grid; gap: 7px; color: #394150; font-size: 13px; font-weight: 700; }
  label.wide { grid-column: 1 / -1; }
  input, select, textarea {
    width: 100%;
    min-height: 42px;
    padding: 9px 11px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font: inherit;
    font-weight: 400;
  }
  textarea { resize: vertical; }
  .toggle-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
  .toggle-grid label { display: flex; align-items: center; gap: 8px; padding: 10px; border: 1px solid #eef0f4; border-radius: 6px; }
  .toggle-grid input { width: 16px; min-height: 16px; }
  .form-actions { display: flex; justify-content: flex-end; gap: 10px; padding: 18px 20px; }
  .form-actions a, .form-actions button {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: 6px;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
  }
  .form-actions a { border: 1px solid #d9dde5; color: #394150; }
  .form-actions button { border: 0; background: #111827; color: #ffffff; cursor: pointer; }
  @media (max-width: 720px) {
    .shell { padding: 18px; }
    .form-grid, .toggle-grid { grid-template-columns: 1fr; }
  }
</style>
