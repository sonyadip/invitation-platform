---
import { createInvitation, parseInvitationForm } from '../../services/dashboard-crud';
import { listTemplateKeys } from '../../templates/registry';
import { hashPasswordSHA256 } from '../../utils/security';
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const templateOptions = listTemplateKeys();
const session = Astro.locals.session;

if (session?.role !== 'admin') {
  return Astro.redirect('/?login=admin');
}

let errorMessage = '';
const defaults = {
  slug: '',
  brideName: '',
  groomName: '',
  brideFullName: '',
  groomFullName: '',
  musicUrl: '',
  template: 'noir',
  status: 'draft',
  rsvpEnabled: true,
  musicEnabled: true,
  countdownEnabled: true,
  galleryEnabled: true,
  wishesEnabled: true,
  giftEnabled: true,
  storyEnabled: true,
  viewCounterEnabled: true,
  videoEnabled: true,
  introAnimationEnabled: false,
  maintenanceMode: false,
  passwordProtectionEnabled: false,
  accessPassword: '',
  clientPassword: '',
  expirationDate: '',
  heroVideoUrl: '',
  heroImageUrl: '',
  ogImageUrl: '',
  brideImageUrl: '',
  groomImageUrl: '',
  logoImageUrl: '',
  sliderImageUrls: [] as string[],
  galleryImageUrls: [] as string[],
  galleryVideoUrls: [] as string[],
  instagramUrl: '',
  groomInstagramUrl: '',
  brideInstagramUrl: '',
  groomFatherName: '',
  groomMotherName: '',
  groomChildNumber: '',
  groomAddress: '',
  brideFatherName: '',
  brideMotherName: '',
  brideChildNumber: '',
  brideAddress: '',
  giftDescription: '',
  thankYouMessage: '',
  introVerse: '',
  introVerseSource: '',
  events: [
    {
      name: '',
      date: '',
      startTime: '',
      endTime: '',
      venueName: '',
      venueAddress: '',
      mapsUrl: ''
    }
  ] as any[],
  gifts: [] as any[],
  story: [] as any[]
};

const toLocalInput = (value: string | null) => {
  if (!value) return '';
  const date = new Date(value);
  const offset = date.getTimezoneOffset();
  const local = new Date(date.getTime() - offset * 60 * 1000);
  return local.toISOString().slice(0, 16);
};

let values = defaults;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const parsed = parseInvitationForm(formData);
  values = {
    ...parsed,
    accessPassword: parsed.accessPassword || '',
    clientPassword: parsed.clientPassword || '',
    musicUrl: parsed.musicUrl || '',
    expirationDate: parsed.expirationDate || '',
    heroVideoUrl: parsed.heroVideoUrl || '',
    heroImageUrl: parsed.heroImageUrl || '',
    ogImageUrl: parsed.ogImageUrl || '',
    brideImageUrl: parsed.brideImageUrl || '',
    groomImageUrl: parsed.groomImageUrl || '',
    logoImageUrl: parsed.logoImageUrl || '',
    sliderImageUrls: parsed.sliderImageUrls || [],
    galleryImageUrls: parsed.galleryImageUrls || [],
    instagramUrl: parsed.instagramUrl || '',
    whatsappUrl: (parsed as any).whatsappUrl || '',
    groomInstagramUrl: parsed.groomInstagramUrl || '',
    brideInstagramUrl: parsed.brideInstagramUrl || '',
    groomFatherName: parsed.groomFatherName || '',
    groomMotherName: parsed.groomMotherName || '',
    groomChildNumber: parsed.groomChildNumber || '',
    groomAddress: parsed.groomAddress || '',
    brideFatherName: parsed.brideFatherName || '',
    brideMotherName: parsed.brideMotherName || '',
    brideChildNumber: parsed.brideChildNumber || '',
    brideAddress: parsed.brideAddress || '',
    giftDescription: parsed.giftDescription || '',
    thankYouMessage: parsed.thankYouMessage || '',
    introVerse: parsed.introVerse || '',
    introVerseSource: parsed.introVerseSource || '',
    events: parsed.events.length > 0 ? parsed.events : defaults.events,
    gifts: (parsed.gifts || []).map((gift) => ({ ...gift, qrisUrl: gift.qrisUrl || '' })),
    story: parsed.story || []
  };

  try {
    const slug = await createInvitation(parsed);
    return Astro.redirect(`/dashboard/${slug}/edit?created=1`);
  } catch (error) {
    console.error('Create invitation error:', error);
    errorMessage = error instanceof Error ? error.message : 'Failed to create invitation.';
  }
}
---

<AdminLayout
  title="Create Invitation"
  activeNav="new"
  breadcrumbs={[{ label: "Dashboard", href: "/dashboard" }, { label: "Create Invitation" }]}
>
  <header class="admin-page-header">
    <div class="admin-page-header__left">
      <h1 class="admin-page-header__title">Create Invitation</h1>
      <p class="admin-page-header__description">
        Set up a new wedding invitation, choose template theme, and configure initial couple information.
      </p>
    </div>

    <div class="admin-page-header__actions">
      <a href="/dashboard" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">
        ← Back to Overview
      </a>
    </div>
  </header>

  {errorMessage && (
    <div class="shadcn-alert shadcn-alert--error" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <div>
        <strong>Failed to Create</strong>
        <p>{errorMessage}</p>
      </div>
    </div>
  )}

  <form class="form-panel" id="new-invitation-form" method="POST" enctype="multipart/form-data">
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">⚙️</span>
        <div>
          <h2>General Settings</h2>
          <p>Slug URL, publication status, and template design.</p>
        </div>
      </div>

      <div class="form-grid" style="margin-bottom: 20px;">
        <div class="field-group">
          <label>Slug URL <span class="required">*</span></label>
          <input name="slug" value={values.slug} placeholder="wayan-ayu" required />
          <span class="hint">Will be accessible at senadda.id/slug</span>
        </div>

        <div class="field-group">
          <label>Status</label>
          <select name="status">
            <option value="draft" selected={values.status === 'draft'}>Draft</option>
            <option value="published" selected={values.status === 'published'}>Published</option>
            <option value="archived" selected={values.status === 'archived'}>Archived</option>
          </select>
        </div>

        <div class="field-group">
          <label>Template Theme</label>
          <select name="template">
            {templateOptions.map((template) => (
              <option value={template} selected={values.template === template}>{template}</option>
            ))}
          </select>
        </div>

        <div class="field-group">
          <label>Expiration Date</label>
          <input type="datetime-local" name="expirationDate" value={values.expirationDate} />
        </div>
      </div>

      <div style="background: var(--admin-zinc-50); border: 1px solid var(--admin-border); border-radius: var(--admin-radius-md); padding: 16px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 14px;">
        <div style="font-weight: 600; font-size: 13px; color: var(--admin-zinc-950); display: flex; align-items: center; gap: 6px;">
          <span>🔐</span> Access & Client Security
        </div>

        <div style="background: #ffffff; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); padding: 14px; display: flex; flex-direction: column; gap: 10px;">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
            <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; cursor: pointer; color: var(--admin-zinc-900);">
              <input type="checkbox" name="passwordProtectionEnabled" id="passwordProtectionToggle" checked={values.passwordProtectionEnabled} style="width: 16px; height: 16px; margin: 0;" />
              <span>Guest Password Protection (Password Gate)</span>
            </label>
            <span style="font-size: 11px; color: var(--admin-text-muted);">Lock public invitation page</span>
          </div>
          <div class="field-group">
            <label style="font-size: 12px;">Guest Access Password:</label>
            <input name="accessPassword" id="accessPasswordInput" value={values.accessPassword} placeholder="e.g. wedding2026" autocomplete="off" />
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); padding: 14px; display: flex; flex-direction: column; gap: 10px;">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
            <span style="font-weight: 600; font-size: 13px; color: var(--admin-zinc-900);">Client Dashboard Password</span>
            <span class="shadcn-badge shadcn-badge--outline">Optional (can use setup link)</span>
          </div>
          <div class="field-group">
            <label style="font-size: 12px;">Initial Client Password:</label>
            <input name="clientPassword" type="password" value={values.clientPassword} placeholder="Leave empty to use setup link later..." autocomplete="new-password" />
          </div>
        </div>
      </div>

      <div style="margin-top: 10px;">
        <label style="margin-bottom: 8px; font-weight: 600;">Active Features</label>
        <div class="toggle-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px;">
          <label class="toggle-card"><input type="checkbox" name="rsvpEnabled" checked={values.rsvpEnabled} /> RSVP</label>
          <label class="toggle-card"><input type="checkbox" name="musicEnabled" checked={values.musicEnabled} /> Music</label>
          <label class="toggle-card"><input type="checkbox" name="countdownEnabled" checked={values.countdownEnabled} /> Countdown</label>
          <label class="toggle-card"><input type="checkbox" name="galleryEnabled" checked={values.galleryEnabled} /> Gallery</label>
          <label class="toggle-card"><input type="checkbox" name="wishesEnabled" checked={values.wishesEnabled} /> Wishes</label>
          <label class="toggle-card"><input type="checkbox" name="giftEnabled" checked={values.giftEnabled} /> Gift & QRIS</label>
          <label class="toggle-card"><input type="checkbox" name="storyEnabled" checked={values.storyEnabled} /> Love Story</label>
          <label class="toggle-card"><input type="checkbox" name="viewCounterEnabled" checked={values.viewCounterEnabled} /> Views Counter</label>
          <label class="toggle-card"><input type="checkbox" name="videoEnabled" checked={values.videoEnabled} /> Videos</label>
          <label class="toggle-card"><input type="checkbox" name="introAnimationEnabled" checked={values.introAnimationEnabled} /> Intro Animation</label>
          <label class="toggle-card"><input type="checkbox" name="maintenanceMode" checked={values.maintenanceMode} /> Maintenance</label>
        </div>
      </div>
    </div>

    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">🖼️</span>
        <div>
          <h2>Opening & Hero Media</h2>
          <p>Logo, popup cover photo, slideshow slider, and intro quote.</p>
        </div>
      </div>

      <div class="form-grid">
        <div class="field-group wide">
          <label>Logo Image URL</label>
          <input name="logoImageUrl" value={values.logoImageUrl} placeholder="https://example.com/logo.png" />
        </div>
        <div class="field-group wide">
          <label>Upload Logo File</label>
          <input type="file" name="logoImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
        </div>

        <div class="field-group wide">
          <label>Popup / Cover Hero Image URL</label>
          <input name="heroImageUrl" id="hero-image-url-input" value={values.heroImageUrl} placeholder="https://example.com/hero.jpg" />
        </div>
        <div class="field-group wide">
          <label>Upload Popup / Hero Image File</label>
          <input type="file" name="heroImageFile" id="hero-image-file-input" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
        </div>

        <input type="hidden" name="ogImageUrl" id="og-image-url-input" value={values.ogImageUrl || ''} />
        <input type="file" name="ogImageFile" id="og-image-file-input" style="display: none;" />

        <div class="field-group wide">
          <label>Hero Video URL (Optional)</label>
          <input name="heroVideoUrl" value={values.heroVideoUrl} placeholder="https://example.com/hero.mp4" />
        </div>

        <div class="field-group wide" style="margin-top: 12px; padding-top: 14px; border-top: 1px solid var(--admin-border-subtle);">
          <label style="font-weight: 600;">Slider / Slideshow Photos (Optional)</label>
          <span class="hint">Photos for opening slider. If left empty, gallery photos will be used automatically.</span>
          <div id="slider_container" style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
            {(Array.isArray(values.sliderImageUrls) ? values.sliderImageUrls : []).map((url, index) => (
              <div class="repeater-item" style="display: flex; align-items: center; gap: 8px;">
                <input style="flex: 1;" name="sliderImageUrl" value={url} placeholder="https://example.com/slide.jpg" />
                <button type="button" class="btn-shadcn btn-shadcn--destructive-outline btn-shadcn--sm remove-btn">Delete</button>
              </div>
            ))}
          </div>
          <div style="margin-top: 10px;">
            <button type="button" id="add_slider_btn" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">+ Add Slider Photo URL</button>
          </div>
        </div>

        <div class="field-group wide">
          <label>Upload Multiple Slider Images</label>
          <input type="file" name="sliderImageFiles" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple />
        </div>

        <div class="field-group wide">
          <label>Intro Verse / Quote</label>
          <textarea name="introVerse" rows="3" placeholder="Enter holy scripture or wedding quote...">{values.introVerse}</textarea>
        </div>
        <div class="field-group wide">
          <label>Intro Verse Source</label>
          <input name="introVerseSource" value={values.introVerseSource} placeholder="(e.g. Rgveda : X.85.42 or 1 Corinthians 13:4)" />
        </div>
      </div>
    </div>

    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">💍</span>
        <div>
          <h2>Bride & Groom Profile</h2>
          <p>Full names, nicknames, parents, and social profiles.</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
        <div style="background: var(--admin-zinc-50); border: 1px solid var(--admin-border); border-radius: var(--admin-radius-md); padding: 18px;">
          <h3 style="margin: 0 0 14px 0; font-size: 14px; font-weight: 700; color: var(--admin-zinc-950);">🤵 Groom Profile</h3>
          <div class="form-grid cols-1">
            <div class="field-group">
              <label>Nickname / Call Name <span class="required">*</span></label>
              <input name="groomName" value={values.groomName} required placeholder="Wayan" />
            </div>
            <div class="field-group">
              <label>Full Legal Name <span class="required">*</span></label>
              <input name="groomFullName" value={values.groomFullName} required placeholder="I Wayan Pratama, S.Kom" />
            </div>
            <div class="field-group">
              <label>Father's Name</label>
              <input name="groomFatherName" value={values.groomFatherName} placeholder="Father name" />
            </div>
            <div class="field-group">
              <label>Mother's Name</label>
              <input name="groomMotherName" value={values.groomMotherName} placeholder="Mother name" />
            </div>
            <div class="field-group">
              <label>Child Order</label>
              <input name="groomChildNumber" value={values.groomChildNumber || ''} placeholder="1st son of" />
            </div>
            <div class="field-group">
              <label>Address / Origin</label>
              <input name="groomAddress" value={values.groomAddress || ''} placeholder="Origin or city" />
            </div>
            <div class="field-group">
              <label>Groom Image URL</label>
              <input name="groomImageUrl" value={values.groomImageUrl} placeholder="https://example.com/groom.jpg" />
            </div>
            <div class="field-group">
              <label>Upload Groom Image File</label>
              <input type="file" name="groomImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
            </div>
            <div class="field-group">
              <label>Groom Instagram URL</label>
              <input name="groomInstagramUrl" value={values.groomInstagramUrl} placeholder="https://instagram.com/username" />
            </div>
          </div>
        </div>

        <div style="background: var(--admin-zinc-50); border: 1px solid var(--admin-border); border-radius: var(--admin-radius-md); padding: 18px;">
          <h3 style="margin: 0 0 14px 0; font-size: 14px; font-weight: 700; color: var(--admin-zinc-950);">👰 Bride Profile</h3>
          <div class="form-grid cols-1">
            <div class="field-group">
              <label>Nickname / Call Name <span class="required">*</span></label>
              <input name="brideName" value={values.brideName} required placeholder="Ayu" />
            </div>
            <div class="field-group">
              <label>Full Legal Name <span class="required">*</span></label>
              <input name="brideFullName" value={values.brideFullName} required placeholder="Ni Made Ayu Lestari, S.E" />
            </div>
            <div class="field-group">
              <label>Father's Name</label>
              <input name="brideFatherName" value={values.brideFatherName} placeholder="Father name" />
            </div>
            <div class="field-group">
              <label>Mother's Name</label>
              <input name="brideMotherName" value={values.brideMotherName} placeholder="Mother name" />
            </div>
            <div class="field-group">
              <label>Child Order</label>
              <input name="brideChildNumber" value={values.brideChildNumber || ''} placeholder="2nd daughter of" />
            </div>
            <div class="field-group">
              <label>Address / Origin</label>
              <input name="brideAddress" value={values.brideAddress || ''} placeholder="Origin or city" />
            </div>
            <div class="field-group">
              <label>Bride Image URL</label>
              <input name="brideImageUrl" value={values.brideImageUrl} placeholder="https://example.com/bride.jpg" />
            </div>
            <div class="field-group">
              <label>Upload Bride Image File</label>
              <input type="file" name="brideImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
            </div>
            <div class="field-group">
              <label>Bride Instagram URL</label>
              <input name="brideInstagramUrl" value={values.brideInstagramUrl} placeholder="https://instagram.com/username" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">📅</span>
        <div>
          <h2>Events & Ceremonies</h2>
          <p>Ceremony schedules, venues, and Google Maps location links.</p>
        </div>
      </div>

      <div class="form-grid" style="margin-bottom: 16px;">
        <div class="field-group wide">
          <label>Event Section Background / Photo URL</label>
          <input name="eventImageUrl" value={values.eventImageUrl || ''} placeholder="https://example.com/event.jpg" />
        </div>
        <div class="field-group wide">
          <label>Upload Event Section Image File</label>
          <input type="file" name="eventImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
        </div>
      </div>

      <div id="events_container" style="display: flex; flex-direction: column; gap: 14px;">
        {values.events.map((event, index) => (
          <div class="repeater-item" style="background: var(--admin-zinc-50); border: 1px solid var(--admin-border); border-radius: var(--admin-radius-md); padding: 18px;">
            <div style="font-weight: 700; font-size: 13px; color: var(--admin-zinc-900); margin-bottom: 12px;">Event <span class="idx">{index + 1}</span></div>
            <div class="form-grid">
              <div class="field-group">
                <label>Event Name <span class="required">*</span></label>
                <input name="eventName" value={event.name} required={index === 0} placeholder="Wedding Ceremony / Pawiwahan" />
              </div>
              <div class="field-group">
                <label>Date & Time <span class="required">*</span></label>
                <input type="datetime-local" name="eventDate" value={toLocalInput(event.date)} required={index === 0} />
              </div>
              <div class="field-group">
                <label>Start Time</label>
                <input type="time" name="eventStartTime" value={event.startTime} />
              </div>
              <div class="field-group">
                <label>End Time</label>
                <input name="eventEndTime" value={event.endTime} placeholder="Finish / Selesai" />
              </div>
              <div class="field-group">
                <label>Venue Name</label>
                <input name="eventVenueName" value={event.venueName} placeholder="Grand Ballroom" />
              </div>
              <div class="field-group">
                <label>Google Maps URL <span class="required">*</span></label>
                <input name="eventMapsUrl" value={event.mapsUrl} required={index === 0} placeholder="https://maps.google.com/..." />
              </div>
              <div class="field-group wide">
                <label>Venue Address</label>
                <textarea name="eventVenueAddress" rows="2" placeholder="Full address of the event venue...">{event.venueAddress}</textarea>
              </div>
            </div>
            {index > 0 && (
              <div style="display: flex; justify-content: flex-end; margin-top: 12px;">
                <button type="button" class="btn-shadcn btn-shadcn--destructive-outline btn-shadcn--sm remove-btn">Delete Event</button>
              </div>
            )}
          </div>
        ))}
      </div>

      <div style="margin-top: 14px;">
        <button type="button" id="add_event_btn" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">+ Add Event</button>
      </div>
    </div>

    <div class="form-card" data-setting-target="storyEnabled">
      <div class="form-card__header">
        <span class="section-icon">📖</span>
        <div>
          <h2>Love Story Milestones</h2>
          <p>Chronological story cards for the couple.</p>
        </div>
      </div>

      <div id="stories_container" style="display: flex; flex-direction: column; gap: 14px;">
        {values.story.map((story, index) => (
          <div class="repeater-item" style="background: var(--admin-zinc-50); border: 1px solid var(--admin-border); border-radius: var(--admin-radius-md); padding: 18px;">
            <div style="font-weight: 700; font-size: 13px; color: var(--admin-zinc-900); margin-bottom: 12px;">Story Milestone <span class="idx">{index + 1}</span></div>
            <div class="form-grid">
              <div class="field-group wide">
                <label>Title</label>
                <input name="storyTitle" value={story.title} placeholder="HOW WE MET" />
              </div>
              <div class="field-group wide">
                <label>Description</label>
                <textarea name="storyDescription" rows="3" placeholder="Tell the milestone story...">{story.description}</textarea>
              </div>
            </div>
            <div style="display: flex; justify-content: flex-end; margin-top: 12px;">
              <button type="button" class="btn-shadcn btn-shadcn--destructive-outline btn-shadcn--sm remove-btn">Delete Story</button>
            </div>
          </div>
        ))}
      </div>

      <div style="margin-top: 14px;">
        <button type="button" id="add_story_btn" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">+ Add Story Milestone</button>
      </div>
    </div>

    <div class="form-card" data-setting-target="galleryEnabled">
      <div class="form-card__header">
        <span class="section-icon">📸</span>
        <div>
          <h2>Photo & Video Gallery</h2>
          <p>Photo gallery URLs, multi-image upload, and YouTube video embeds.</p>
        </div>
      </div>

      <div id="gallery_container" style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
        {(Array.isArray(values.galleryImageUrls) ? values.galleryImageUrls : []).map((url, index) => (
          <div class="repeater-item" style="display: flex; align-items: center; gap: 8px;">
            <input style="flex: 1;" name="galleryImageUrl" value={url} placeholder="https://example.com/gallery.jpg" />
            <button type="button" class="btn-shadcn btn-shadcn--destructive-outline btn-shadcn--sm remove-btn">Delete</button>
          </div>
        ))}
      </div>
      <div style="margin-bottom: 16px;">
        <button type="button" id="add_gallery_btn" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">+ Add Photo URL</button>
      </div>

