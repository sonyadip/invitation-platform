---
import { createInvitation, parseInvitationForm } from '../../services/dashboard-crud';
import { listTemplateKeys } from '../../templates/registry';
import { hashPasswordSHA256 } from '../../utils/security';
import PopupDialog from '../../components/common/PopupDialog.astro';

export const prerender = false;

const templateOptions = listTemplateKeys();
const session = Astro.locals.session;

if (session?.role !== 'admin') {
  return Astro.redirect('/?login=admin');
}

let errorMessage = '';
const defaults = {
  slug: '',
  brideName: '',
  groomName: '',
  brideFullName: '',
  groomFullName: '',
  musicUrl: '',
  template: 'noir',
  status: 'draft',
  rsvpEnabled: true,
  musicEnabled: true,
  countdownEnabled: true,
  galleryEnabled: true,
  wishesEnabled: true,
  giftEnabled: true,
  storyEnabled: true,
  viewCounterEnabled: true,
  videoEnabled: true,
  introAnimationEnabled: true,
  maintenanceMode: false,
  passwordProtectionEnabled: false,
  accessPassword: '',
  clientPassword: '',
  expirationDate: '',
  heroVideoUrl: '',
  heroImageUrl: '',
  ogImageUrl: '',
  brideImageUrl: '',
  groomImageUrl: '',
  logoImageUrl: '',
  sliderImageUrls: [] as string[],
  galleryImageUrls: [] as string[],
  galleryVideoUrls: [] as string[],
  instagramUrl: '',
  groomInstagramUrl: '',
  brideInstagramUrl: '',
  groomFatherName: '',
  groomMotherName: '',
  groomChildNumber: '',
  groomAddress: '',
  brideFatherName: '',
  brideMotherName: '',
  brideChildNumber: '',
  brideAddress: '',
  giftDescription: '',
  thankYouMessage: '',
  introVerse: '',
  introVerseSource: '',
  events: [
    {
      name: '',
      date: '',
      startTime: '',
      endTime: '',
      venueName: '',
      venueAddress: '',
      mapsUrl: ''
    }
  ] as any[],
  gifts: [] as any[],
  story: [] as any[]
};

const toLocalInput = (value: string | null) => {
  if (!value) return '';
  const date = new Date(value);
  const offset = date.getTimezoneOffset();
  const local = new Date(date.getTime() - offset * 60 * 1000);
  return local.toISOString().slice(0, 16);
};

let values = defaults;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const parsed = parseInvitationForm(formData);
  values = {
    ...parsed,
    accessPassword: parsed.accessPassword || '',
    clientPassword: parsed.clientPassword || '',
    musicUrl: parsed.musicUrl || '',
    expirationDate: parsed.expirationDate || '',
    heroVideoUrl: parsed.heroVideoUrl || '',
    heroImageUrl: parsed.heroImageUrl || '',
    ogImageUrl: parsed.ogImageUrl || '',
    brideImageUrl: parsed.brideImageUrl || '',
    groomImageUrl: parsed.groomImageUrl || '',
    logoImageUrl: parsed.logoImageUrl || '',
    sliderImageUrls: parsed.sliderImageUrls || [],
    galleryImageUrls: parsed.galleryImageUrls || [],
    instagramUrl: parsed.instagramUrl || '',
    whatsappUrl: (parsed as any).whatsappUrl || '',
    groomInstagramUrl: parsed.groomInstagramUrl || '',
    brideInstagramUrl: parsed.brideInstagramUrl || '',
    groomFatherName: parsed.groomFatherName || '',
    groomMotherName: parsed.groomMotherName || '',
    groomChildNumber: parsed.groomChildNumber || '',
    groomAddress: parsed.groomAddress || '',
    brideFatherName: parsed.brideFatherName || '',
    brideMotherName: parsed.brideMotherName || '',
    brideChildNumber: parsed.brideChildNumber || '',
    brideAddress: parsed.brideAddress || '',
    giftDescription: parsed.giftDescription || '',
    thankYouMessage: parsed.thankYouMessage || '',
    introVerse: parsed.introVerse || '',
    introVerseSource: parsed.introVerseSource || '',
    events: parsed.events.length > 0 ? parsed.events : defaults.events,
    gifts: (parsed.gifts || []).map((gift) => ({ ...gift, qrisUrl: gift.qrisUrl || '' })),
    story: parsed.story || []
  };

  try {
    const slug = await createInvitation(parsed);
    return Astro.redirect(`/dashboard/${slug}/edit?created=1`);
  } catch (error) {
    console.error('Create invitation error:', error);
    errorMessage = error instanceof Error ? error.message : 'Failed to create invitation.';
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Invitation - Dashboard</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <PopupDialog />
    <main class="shell">
      <header class="header">
        <div>
          <a class="back-link" href="/dashboard">← Back to Dashboard</a>
          <p class="eyebrow">Invitation Creator</p>
          <h1>Create Invitation</h1>
          <p class="subtitle">Set up new wedding details and default configuration.</p>
        </div>
      </header>

      {errorMessage && <div class="error-panel">{errorMessage}</div>}

      <form class="form-panel" id="new-invitation-form" method="POST" enctype="multipart/form-data">
        <section>
          <h2>General Settings</h2>
          <div class="form-grid" style="margin-bottom: 18px;">
            <label>Slug<input name="slug" value={values.slug} placeholder="wayan-ayu" required /></label>
            <label>Status
              <select name="status">
                <option value="draft" selected={values.status === 'draft'}>Draft</option>
                <option value="published" selected={values.status === 'published'}>Published</option>
                <option value="archived" selected={values.status === 'archived'}>Archived</option>
              </select>
            </label>
            <label>Template
              <select name="template">
                {templateOptions.map((template) => (
                  <option value={template} selected={values.template === template}>{template}</option>
                ))}
              </select>
            </label>
            <label>Expiration Date<input type="datetime-local" name="expirationDate" value={values.expirationDate} /></label>
          </div>

          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 16px;">
            <div style="font-weight: 700; font-size: 14px; color: #1e293b; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; display: flex; align-items: center; gap: 6px;">
              <span>🔐</span> Access & Client Security
            </div>

            <!-- Access Password (Guest Protection Gate) -->
            <div style="display: flex; flex-direction: column; gap: 8px; background: #ffffff; border: 1px solid #e2e8f0; padding: 14px; border-radius: 6px;">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; margin: 0; cursor: pointer; color: #1e293b;">
                  <input type="checkbox" name="passwordProtectionEnabled" id="passwordProtectionToggle" checked={values.passwordProtectionEnabled} style="width: 16px; min-height: 16px; margin: 0;" />
                  <span>Guest Password Protection (Password Gate)</span>
                </label>
                <span style="font-size: 12px; color: #64748b;">Lock public invitation page</span>
              </div>
              <div style="display: grid; gap: 6px;">
                <label style="font-size: 12px; color: #475569; margin: 0;">Guest Access Password:</label>
                <input name="accessPassword" id="accessPasswordInput" value={values.accessPassword} placeholder="e.g. wedding2026" autocomplete="off" />
                <p style="margin: 0; font-size: 12px; color: #64748b;">
                  When enabled, visitors must enter this password to view the invitation in public.
                </p>
              </div>
            </div>

            <!-- Client Password (Client Dashboard Authentication) -->
            <div style="display: flex; flex-direction: column; gap: 8px; background: #ffffff; border: 1px solid #e2e8f0; padding: 14px; border-radius: 6px;">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <span style="font-weight: 700; font-size: 13px; color: #334155;">Client Dashboard Password</span>
                <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: #64748b; background: #f1f5f9; padding: 2px 10px; border-radius: 9999px;">
                  Optional (can be set via One-Time Link later)
                </span>
              </div>
              <div style="display: grid; gap: 6px;">
                <label style="font-size: 12px; color: #475569; margin: 0;">Set Client Password (Initial):</label>
                <input name="clientPassword" type="password" value={values.clientPassword} placeholder="Set initial password (or leave empty to use setup link later)..." autocomplete="new-password" />
              </div>
            </div>
          </div>

          <div class="toggle-grid">
            <label><input type="checkbox" name="rsvpEnabled" checked={values.rsvpEnabled} /> RSVP</label>
            <label><input type="checkbox" name="musicEnabled" checked={values.musicEnabled} /> Music</label>
            <label><input type="checkbox" name="countdownEnabled" checked={values.countdownEnabled} /> Countdown</label>
            <label><input type="checkbox" name="galleryEnabled" checked={values.galleryEnabled} /> Gallery</label>
            <label><input type="checkbox" name="wishesEnabled" checked={values.wishesEnabled} /> Wishes</label>
            <label><input type="checkbox" name="giftEnabled" checked={values.giftEnabled} /> Gift</label>
            <label><input type="checkbox" name="storyEnabled" checked={values.storyEnabled} /> Our Story</label>
            <label><input type="checkbox" name="viewCounterEnabled" checked={values.viewCounterEnabled} /> View Counter</label>
            <label><input type="checkbox" name="videoEnabled" checked={values.videoEnabled} /> Video</label>
            <label><input type="checkbox" name="introAnimationEnabled" checked={values.introAnimationEnabled} /> Intro Animation</label>
            <label><input type="checkbox" name="maintenanceMode" checked={values.maintenanceMode} /> Maintenance</label>
          </div>
        </section>

        <section>
          <h2>Opening</h2>
          <div class="form-grid">
            <label class="wide">Logo Image URL<input name="logoImageUrl" value={values.logoImageUrl} placeholder="https://example.com/logo.png" /></label>
            <label class="wide">Upload Logo Image<input type="file" name="logoImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label class="wide">Popup / Hero Image URL<input name="heroImageUrl" id="hero-image-url-input" value={values.heroImageUrl} placeholder="https://example.com/hero.jpg" /></label>
            <label class="wide">Upload Popup / Hero Image<input type="file" name="heroImageFile" id="hero-image-file-input" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <input type="hidden" name="ogImageUrl" id="og-image-url-input" value={values.ogImageUrl || ''} />
            <input type="file" name="ogImageFile" id="og-image-file-input" style="display: none;" />
            <label class="wide">Hero Video URL<input name="heroVideoUrl" value={values.heroVideoUrl} placeholder="https://example.com/hero.mp4" /></label>
            <div style="grid-column: 1 / -1; margin-top: 16px; margin-bottom: 4px; padding-top: 16px; border-top: 1px solid var(--border, #e5e7eb);">
              <h3 style="font-size: 15px; font-weight: 600; margin-bottom: 4px;">Image Slider / Slideshow Photos</h3>
              <p class="section-sub" style="margin-bottom: 12px;">Opsional. Masukkan foto khusus untuk banner slider / slideshow. Jika dikosongkan, slider akan otomatis mengambil foto dari Photo Gallery.</p>
            </div>
            <div class="wide gallery-list" id="slider_container" style="grid-column: 1 / -1;">
              {(Array.isArray(values.sliderImageUrls) ? values.sliderImageUrls : []).map((url, index) => (
                <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
                  <label style="flex: 1; margin: 0;">Slider Image URL <span class="idx">{index + 1}</span><input name="sliderImageUrl" value={url} placeholder="https://example.com/slide.jpg" /></label>
                  <button type="button" class="remove-btn secondary-action">Delete</button>
                </div>
              ))}
            </div>
            <button type="button" id="add_slider_btn" class="secondary-action" style="grid-column: 1 / -1; margin-bottom: 16px; width: fit-content;">+ Add Slider Photo URL</button>
            <label class="wide">
              Upload Multiple Slider Images
              <input type="file" name="sliderImageFiles" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple />
            </label>
            <label class="wide">Intro Verse<textarea name="introVerse" rows="4">{values.introVerse}</textarea></label>
            <label class="wide">Intro Verse Source<input name="introVerseSource" value={values.introVerseSource} placeholder="(e.g. Rgveda : X.85.42 or 1 Corinthians 13:4)" /></label>
          </div>
        </section>

        <section>
          <h2>Couple</h2>
          <div class="couple-grid">
            <fieldset class="couple-card">
              <legend>Groom</legend>
              <div class="form-grid">
                <label>Groom Name<input name="groomName" value={values.groomName} required /></label>
                <label>Groom Full Name<input name="groomFullName" value={values.groomFullName} required /></label>
                <label>Groom Father Name<input name="groomFatherName" value={values.groomFatherName} placeholder="Groom father name" /></label>
                <label>Groom Mother Name<input name="groomMotherName" value={values.groomMotherName} placeholder="Groom mother name" /></label>
                <label>Groom Child Order<input name="groomChildNumber" value={values.groomChildNumber || ''} placeholder="1st son of" /></label>
                <label>Groom Family Address / Origin<input name="groomAddress" value={values.groomAddress || ''} placeholder="Origin or city" /></label>
                <label>Groom Image URL<input name="groomImageUrl" value={values.groomImageUrl} placeholder="https://example.com/groom.jpg" /></label>
                <label>Upload Groom Image<input type="file" name="groomImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                <label class="wide">Groom Instagram URL<input name="groomInstagramUrl" value={values.groomInstagramUrl} placeholder="https://www.instagram.com/username" /></label>
              </div>
            </fieldset>
            <fieldset class="couple-card">
              <legend>Bride</legend>
              <div class="form-grid">
                <label>Bride Name<input name="brideName" value={values.brideName} required /></label>
                <label>Bride Full Name<input name="brideFullName" value={values.brideFullName} required /></label>
                <label>Bride Father Name<input name="brideFatherName" value={values.brideFatherName} placeholder="Bride father name" /></label>
                <label>Bride Mother Name<input name="brideMotherName" value={values.brideMotherName} placeholder="Bride mother name" /></label>
                <label>Bride Child Order<input name="brideChildNumber" value={values.brideChildNumber || ''} placeholder="2nd daughter of" /></label>
                <label>Bride Family Address / Origin<input name="brideAddress" value={values.brideAddress || ''} placeholder="Origin or city" /></label>
                <label>Bride Image URL<input name="brideImageUrl" value={values.brideImageUrl} placeholder="https://example.com/bride.jpg" /></label>
                <label>Upload Bride Image<input type="file" name="brideImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                <label class="wide">Bride Instagram URL<input name="brideInstagramUrl" value={values.brideInstagramUrl} placeholder="https://www.instagram.com/username" /></label>
              </div>
            </fieldset>
          </div>
        </section>

        <section>
          <h2>Events</h2>
          <div class="form-grid" style="margin-bottom: 24px;">
            <label class="wide">Event Section Image URL<input name="eventImageUrl" value={values.eventImageUrl || ''} placeholder="https://example.com/event.jpg" /></label>
            <label class="wide">Upload Event Section Image<input type="file" name="eventImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
          </div>
          <div class="event-list" id="events_container">
            {values.events.map((event, index) => (
              <fieldset class="event-card repeater-item">
                <legend>Event <span class="idx">{index + 1}</span></legend>
                <div class="form-grid">
                  <label>Event Name<input name="eventName" value={event.name} required={index === 0} placeholder="Wedding Ceremony" /></label>
                  <label>Date<input type="datetime-local" name="eventDate" value={toLocalInput(event.date)} required={index === 0} /></label>
                  <label>Start Time<input type="time" name="eventStartTime" value={event.startTime} /></label>
                  <label>End Time<input name="eventEndTime" value={event.endTime} placeholder="Finish" /></label>
                  <label>Venue Name<input name="eventVenueName" value={event.venueName} /></label>
                  <label>Maps URL<input name="eventMapsUrl" value={event.mapsUrl} required={index === 0} /></label>
                  <label class="wide">Venue Address<textarea name="eventVenueAddress" rows="3" required={index === 0}>{event.venueAddress}</textarea></label>
                </div>
                {index > 0 && <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Event</button>}
              </fieldset>
            ))}
          </div>
          <button type="button" id="add_event_btn" class="secondary-action" style="margin-top: 16px;">+ Add Event</button>
        </section>

        <section data-setting-target="storyEnabled">
          <h2>Our Story</h2>
          <div class="story-list" id="stories_container">
            {values.story.map((story, index) => (
              <fieldset class="story-card repeater-item">
                <legend>Story <span class="idx">{index + 1}</span></legend>
                <div class="form-grid">
                  <label>Title<input name="storyTitle" value={story.title} placeholder="HOW WE MET" /></label>
                  <label class="wide">Description<textarea name="storyDescription" rows="3">{story.description}</textarea></label>
                </div>
                <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Story</button>
              </fieldset>
            ))}
          </div>
          <button type="button" id="add_story_btn" class="secondary-action" style="margin-top: 16px;">+ Add Story</button>
        </section>

        <section data-setting-target="galleryEnabled">
          <h2>Gallery</h2>
          <div class="gallery-list" id="gallery_container">
            {(Array.isArray(values.galleryImageUrls) ? values.galleryImageUrls : []).map((url, index) => (
              <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
                <label style="flex: 1; margin: 0;">Image URL <span class="idx">{index + 1}</span><input name="galleryImageUrl" value={url} placeholder="https://example.com/gallery.jpg" /></label>
                <button type="button" class="remove-btn secondary-action">Delete</button>
              </div>
            ))}
          </div>
          <button type="button" id="add_gallery_btn" class="secondary-action" style="margin-top: 10px; margin-bottom: 16px;">+ Add Image URL</button>
          <div class="form-grid" style="margin-bottom: 24px;">
            <label class="wide">Upload Gallery Images<input type="file" name="galleryImageFiles" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple /></label>
          </div>

          <h3 style="margin-top: 24px; margin-bottom: 12px; font-size: 15px;">Gallery Videos</h3>
          <div class="gallery-video-list" id="gallery_videos_container">
            {(Array.isArray(values.galleryVideoUrls) ? values.galleryVideoUrls : []).map((url, index) => (
              <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
                <label style="flex: 1; margin: 0;">Video URL <span class="idx">{index + 1}</span><input name="galleryVideoUrl" value={url} placeholder="https://www.youtube.com/watch?v=..." /></label>
                <button type="button" class="remove-btn secondary-action">Delete</button>
              </div>
            ))}
          </div>
          <button type="button" id="add_gallery_video_btn" class="secondary-action" style="margin-top: 10px;">+ Add Video URL</button>
        </section>

        <section>
          <h2>RSVP & Countdown Images</h2>
          <div class="form-grid">
            <label class="wide">RSVP Image URL<input name="rsvpImageUrl" value={values.rsvpImageUrl || ''} placeholder="https://example.com/rsvp.jpg" /></label>
            <label class="wide">Upload RSVP Image<input type="file" name="rsvpImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label class="wide">Countdown Image URL<input name="countdownImageUrl" value={values.countdownImageUrl || ''} placeholder="https://example.com/countdown.jpg" /></label>
            <label class="wide">Upload Countdown Image<input type="file" name="countdownImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
          </div>
        </section>

        <section>
          <h2>Gift & Thank You</h2>
          <div class="gift-list" id="gifts_container">
            {values.gifts.map((gift, index) => (
              <fieldset class="gift-card-form repeater-item">
                <legend>Gift Card <span class="idx">{index + 1}</span></legend>
                <div class="form-grid">
                  <label>Bank Name<input name="giftBankName" value={gift.bankName} placeholder="BCA / Chase" /></label>
                  <label>Account Number<input name="giftAccountNumber" value={gift.accountNumber} placeholder="1234567890" /></label>
                  <label>Account Name<input name="giftAccountName" value={gift.accountName} placeholder="Account holder name" /></label>
                  <label>QRIS URL<input name="giftQrisUrl" value={gift.qrisUrl} placeholder="https://example.com/qris.png" /></label>
                </div>
                <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Gift Card</button>
              </fieldset>
            ))}
          </div>
          <button type="button" id="add_gift_btn" class="secondary-action" style="margin-top: 16px; margin-bottom: 24px;">+ Add Gift Card</button>
          <div class="form-grid">
            <label class="wide">Wedding Gift Description<textarea name="giftDescription" rows="4">{values.giftDescription}</textarea></label>
            <label class="wide">Thank You Message<textarea name="thankYouMessage" rows="4">{values.thankYouMessage}</textarea></label>
            <label class="wide">Closing Image URL<input name="closingImageUrl" value={values.closingImageUrl || ''} placeholder="https://example.com/closing.jpg" /></label>
            <label class="wide">Upload Closing Image<input type="file" name="closingImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
          </div>
        </section>



        <section data-setting-target="musicEnabled">
          <h2>Music</h2>
          <div class="form-grid">
            <label class="wide">Music URL<input name="musicUrl" value={values.musicUrl} placeholder="https://example.com/audio.mp3" /></label>
            <label class="wide">Upload Music File (MP3 / AAC / WAV)<input type="file" name="musicFile" accept="audio/*,.mp3,.wav,.ogg,.aac,.m4a,.webm" /></label>
          </div>
        </section>

        <footer class="form-actions">
          <a href="/dashboard">Cancel</a>
          <button type="submit">Create Invitation</button>
        </footer>
      </form>
    </main>
    <template id="event_template">
      <fieldset class="event-card repeater-item">
        <legend>Event <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Event Name<input name="eventName" placeholder="Wedding Ceremony" /></label>
          <label>Date<input type="datetime-local" name="eventDate" /></label>
          <label>Start Time<input type="time" name="eventStartTime" /></label>
          <label>End Time<input name="eventEndTime" placeholder="Finish" /></label>
          <label>Venue Name<input name="eventVenueName" /></label>
          <label>Maps URL<input name="eventMapsUrl" /></label>
          <label class="wide">Venue Address<textarea name="eventVenueAddress" rows="3"></textarea></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Event</button>
      </fieldset>
    </template>

    <template id="story_template">
      <fieldset class="story-card repeater-item">
        <legend>Story <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Title<input name="storyTitle" placeholder="HOW WE MET" /></label>
          <label class="wide">Description<textarea name="storyDescription" rows="3"></textarea></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Story</button>
      </fieldset>
    </template>

    <template id="slider_template">
      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
        <label style="flex: 1; margin: 0;">Slider Image URL <span class="idx"></span><input name="sliderImageUrl" placeholder="https://example.com/slide.jpg" /></label>
        <button type="button" class="remove-btn secondary-action">Delete</button>
      </div>
    </template>

    <template id="gallery_template">
      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
        <label style="flex: 1; margin: 0;">Image URL <span class="idx"></span><input name="galleryImageUrl" placeholder="https://example.com/gallery.jpg" /></label>
        <button type="button" class="remove-btn secondary-action">Delete</button>
      </div>
    </template>

    <template id="gallery_video_template">
      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
        <label style="flex: 1; margin: 0;">Video URL <span class="idx"></span><input name="galleryVideoUrl" placeholder="https://www.youtube.com/watch?v=..." /></label>
        <button type="button" class="remove-btn secondary-action">Delete</button>
      </div>
    </template>

    <template id="gift_template">
      <fieldset class="gift-card-form repeater-item">
        <legend>Gift Card <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Bank Name<input name="giftBankName" placeholder="BCA / Chase" /></label>
          <label>Account Number<input name="giftAccountNumber" placeholder="1234567890" /></label>
          <label>Account Name<input name="giftAccountName" placeholder="Account holder name" /></label>
          <label>QRIS URL<input name="giftQrisUrl" placeholder="https://example.com/qris.png" /></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Gift Card</button>
      </fieldset>
    </template>

    <script>
      function setupRepeater(containerId, btnId, templateId) {
        const container = document.getElementById(containerId);
        const btn = document.getElementById(btnId);
        const template = document.getElementById(templateId);

        if (!container || !btn || !template) return;

        function updateIndexes() {
          const items = container.querySelectorAll('.repeater-item');
          items.forEach((item, index) => {
            const idxSpan = item.querySelector('.idx');
            if (idxSpan) idxSpan.textContent = index + 1;
          });
        }

        btn.addEventListener('click', () => {
          const clone = template.content.cloneNode(true);
          container.appendChild(clone);
          updateIndexes();
        });

        container.addEventListener('click', async (e) => {
          if (e.target.classList.contains('remove-btn')) {
            const confirmed = await window.showConfirm({
              title: 'Delete Item',
              message: 'Are you sure you want to delete this item?',
              confirmText: 'Delete',
              cancelText: 'Cancel',
              variant: 'danger',
              icon: 'delete'
            });
            if (!confirmed) return;
            const item = e.target.closest('.repeater-item');
            if (item) {
              item.remove();
              updateIndexes();
            }
          }
        });
      }

      setupRepeater('slider_container', 'add_slider_btn', 'slider_template');
      setupRepeater('events_container', 'add_event_btn', 'event_template');
      setupRepeater('stories_container', 'add_story_btn', 'story_template');
      setupRepeater('gallery_container', 'add_gallery_btn', 'gallery_template');
      setupRepeater('gallery_videos_container', 'add_gallery_video_btn', 'gallery_video_template');
      setupRepeater('gifts_container', 'add_gift_btn', 'gift_template');

      const settingTargets = document.querySelectorAll('[data-setting-target]');

      function syncSettingTargets() {
        settingTargets.forEach((target) => {
          const toggleName = target.getAttribute('data-setting-target');
          const toggle = toggleName ? document.querySelector(`input[name="${toggleName}"]`) : null;
          if (!(toggle instanceof HTMLInputElement)) return;

          target.hidden = !toggle.checked;
        });
      }

      document
        .querySelectorAll('.toggle-grid input[type="checkbox"]')
        .forEach((toggle) => toggle.addEventListener('change', syncSettingTargets));

      syncSettingTargets();

      const accessPasswordInput = document.getElementById('accessPasswordInput');
      const passwordProtectionToggle = document.getElementById('passwordProtectionToggle');
      if (accessPasswordInput && passwordProtectionToggle) {
        accessPasswordInput.addEventListener('input', () => {
          if (accessPasswordInput.value.trim().length > 0 && !(passwordProtectionToggle as HTMLInputElement).checked) {
            (passwordProtectionToggle as HTMLInputElement).checked = true;
          }
        });
      }

      // Automatic Smart OG Image Generator (1200x630)
      import { createOgImageBlob } from '../../utils/og-generator';

      const heroUrlInput = document.getElementById('hero-image-url-input') as HTMLInputElement | null;
      const heroFileInput = document.getElementById('hero-image-file-input') as HTMLInputElement | null;
      const ogFileInput = document.getElementById('og-image-file-input') as HTMLInputElement | null;
      const ogUrlInput = document.getElementById('og-image-url-input') as HTMLInputElement | null;
      const newForm = document.getElementById('new-invitation-form') as HTMLFormElement | null;

      async function ensureOgImageGenerated() {
        const sourceFile = heroFileInput?.files?.[0];
        const sourceUrl = heroUrlInput?.value.trim();

        if (sourceFile) {
          try {
            const blob = await createOgImageBlob(sourceFile);
            if (ogFileInput) {
              const file = new File([blob], 'og-thumbnail.jpg', { type: 'image/jpeg' });
              const dt = new DataTransfer();
              dt.items.add(file);
              ogFileInput.files = dt.files;
            }
          } catch (err) {
            console.warn('Auto OG generation from file error:', err);
          }
        } else if (sourceUrl && !ogUrlInput?.value) {
          try {
            const blob = await createOgImageBlob(sourceUrl);
            if (ogFileInput) {
              const file = new File([blob], 'og-thumbnail.jpg', { type: 'image/jpeg' });
              const dt = new DataTransfer();
              dt.items.add(file);
              ogFileInput.files = dt.files;
            }
          } catch (err) {
            console.warn('Auto OG generation from URL error:', err);
          }
        }
      }

      // Auto generate when hero file is chosen
      heroFileInput?.addEventListener('change', () => {
        const file = heroFileInput.files?.[0];
        if (file) {
          createOgImageBlob(file).then((blob) => {
            if (ogFileInput) {
              const f = new File([blob], 'og-thumbnail.jpg', { type: 'image/jpeg' });
              const dt = new DataTransfer();
              dt.items.add(f);
              ogFileInput.files = dt.files;
            }
          }).catch(console.warn);
        }
      });

      newForm?.addEventListener('submit', async (e) => {
        const sourceFile = heroFileInput?.files?.[0];
        const sourceUrl = heroUrlInput?.value.trim();
        if ((sourceFile || sourceUrl) && !ogFileInput?.files?.length) {
          e.preventDefault();
          await ensureOgImageGenerated();
          newForm.submit();
        }
      });
    </script>
  </body>
</html>

