    gap: 3px;
    flex-shrink: 0;

    @media (max-width: 640px) {
      width: 100%;
      justify-content: center;
    }
  }

  .view-switch-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    height: 38px;
    border-radius: 7px;
    border: none;
    background: transparent;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;

    &:hover:not(.view-switch-btn--active) {
      background: rgba(255, 255, 255, 0.7);
      color: #0f172a;
    }

    &--active {
      background: #ffffff;
      color: #0f172a;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);

      .view-switch-badge {
        background: var(--color-primary, #a68966);
        color: #ffffff;
      }
    }

    @media (max-width: 480px) {
      padding: 5px 10px;
      font-size: 12px;
      gap: 5px;
      height: 34px;
      flex: 1;
      justify-content: center;
    }
  }

  .view-switch-badge {
    font-size: 11px;
    font-weight: 800;
    padding: 1.5px 6.5px;
    border-radius: 12px;
    background: #e2e8f0;
    color: #475569;
    transition: all 0.2s ease;
  }

  /* Search Input */
  .search-wrapper.activity-search-wrapper,
  .activity-search-wrapper {
    flex: 1;
    min-width: 0;
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    margin-bottom: 0 !important;

    @media (max-width: 640px) {
      order: 2;
    }
  }

  .clear-btn {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-outline);
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;

    &:hover {
      color: var(--color-on-surface);
    }
  }

  /* Filters */
  .activity-filter-wrapper {
    width: 220px;
    flex-shrink: 0;

    @media (max-width: 640px) {
      width: 100%;
      order: 1;
    }

    .activity-select {
      width: 100%;
      height: 40px;
      padding: 0 12px;
      font-size: 13px;
      border-radius: 8px;
    }
  }

  .activity-select {
    min-width: 140px;
    height: 40px;
    padding: 0 10px;
    font-size: 13px;
  }

  .activity-export-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--color-surface-container-high);
    border-radius: 8px;
    color: var(--color-on-surface);
    transition: all 0.2s;

    &:hover {
      background: var(--color-surface-container-low);
      border-color: var(--color-outline);
    }
  }

  /* Tags Row */
  .activity-tags-row {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--color-surface-container-low);

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .activity-tag {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid var(--color-surface-container-high);
    background: var(--color-surface-container-lowest);
    color: var(--color-on-surface-variant);
    cursor: pointer;
    transition: all 0.2s;

    &:hover {
      background: var(--color-surface-container-low);
    }

    &--active {
      background: var(--color-primary);
      color: #ffffff;
      border-color: var(--color-primary);

      &:hover {
        background: var(--color-primary);
      }
    }
  }

  /* Filter Indicator */
  .filter-indicator {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background: rgba(166, 137, 102, 0.08);
    border: 1px dashed var(--color-primary-container);
    border-radius: 8px;
    margin-bottom: 14px;
    font-size: 12px;
    color: var(--color-on-surface);
  }

  .reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;

    &:hover {
      text-decoration: underline;
    }
  }

  /* Activity List Rows */
  .activity-list {
    display: flex;
    flex-direction: column;
  }

  .act-row-wrapper {
    display: block;
  }

  .act-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 8px;
    transition: background 0.15s ease;

    &:hover {
      background: var(--color-surface-container-low);
      border-radius: 8px;
    }

    @media (max-width: 480px) {
      gap: 10px;
      padding: 12px 2px;
    }
  }

  .act-row__icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    flex-shrink: 0;
    margin-top: 2px;

    .material-symbols-outlined {
      font-size: 22px;
    }

    @media (max-width: 480px) {
      width: 34px;
      height: 34px;
      border-radius: 10px;

      .material-symbols-outlined {
        font-size: 19px;
      }
    }
  }

  .act-row__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .act-row__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .act-row__actor {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .act-row__name {
    font-size: 14.5px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;

    &--anon {
      font-weight: 600;
      color: #64748b;
    }

    @media (max-width: 480px) {
      font-size: 13.5px;
    }
  }

  .act-tag-guest {
    font-size: 10px;
    font-weight: 800;
    padding: 1.5px 6px;
    border-radius: 4px;
    background: #e0e7ff;
    color: #3730a3;
    border: 1px solid #c7d2fe;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .act-tag-anon {
    font-size: 10px;
    font-weight: 600;
    padding: 1.5px 6px;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
  }

  .rsvp-micro-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 1.5px 6px;
    border-radius: 4px;

    &--attending {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #bbf7d0;
    }
    &--declined {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }
    &--tentative {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
    }
  }

  .act-row__action-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 1px;
  }

  .act-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 2.5px 8px;
    border-radius: 6px;
    letter-spacing: 0.02em;
    display: inline-block;

    &--primary {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
    }

    &--info {
      background: #dbeafe;
      color: #1e40af;
      border: 1px solid #bfdbfe;
    }

    &--purple {
      background: #f3e8ff;
      color: #6b21a8;
      border: 1px solid #e9d5ff;
    }

    &--warning {
      background: #fef9c3;
      color: #854d0e;
      border: 1px solid #fef08a;
    }

    &--pink {
      background: #fce7f3;
      color: #9d174d;
      border: 1px solid #fbcfe8;
    }

    &--teal {
      background: #ccfbf1;
      color: #0f766e;
      border: 1px solid #99f6e4;
    }

    &--indigo {
      background: #e0e7ff;
      color: #3730a3;
      border: 1px solid #c7d2fe;
    }

    &--emerald {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }

    &--amber {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
    }

    &--success {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #bbf7d0;
    }

    &--neutral {
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
    }
  }

  .act-time-rel {
    font-size: 11.5px;
    font-weight: 700;
    color: #b45309;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .act-row__desc {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    color: #334155;
    line-height: 1.4;

    @media (max-width: 480px) {
      font-size: 12.5px;
    }
  }

  .act-meta-box {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12.5px;
    width: fit-content;
    max-width: 100%;

    .meta-icon {
      font-size: 17px;
      flex-shrink: 0;
    }

    .meta-link {
      color: inherit;
      text-decoration: underline;
      font-weight: 700;
      word-break: break-all;
    }

    &--warning {
      background: #fffbeb;
      color: #78350f;
      border: 1px solid #fcd34d;
    }

    &--info {
      background: #eff6ff;
      color: #1e3a8a;
      border: 1px solid #93c5fd;
    }

    &--pink {
      background: #fdf2f8;
      color: #831843;
      border: 1px solid #f472b6;
    }
  }

  .act-row__footer {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;

    @media (min-width: 640px) {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .act-row__chips {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }

  .act-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    padding: 2.5px 7px;
    border-radius: 6px;
    background: #f8fafc;
    color: #1e293b;
    border: 1px solid #e2e8f0;

    .chip-icon {
      font-size: 13.5px;
      color: #64748b;
    }

    &--device {
      background: #eff6ff;
      color: #1e40af;
      border-color: #dbeafe;
      .chip-icon { color: #2563eb; }
    }

    &--browser {
      background: #f0fdf4;
      color: #166534;
      border-color: #dcfce7;
      .chip-icon { color: #16a34a; }
    }

    &--source {
      background: #fffbeb;
      color: #92400e;
      border-color: #fef3c7;
      .chip-icon { color: #d97706; }
    }

    &--location {
      background: #faf5ff;
      color: #6b21a8;
      border-color: #f3e8ff;
      .chip-icon { color: #9333ea; }
    }
  }

  .act-date-full {
    font-size: 11px;
    font-weight: 500;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;

    @media (min-width: 640px) {
      margin-top: 0;
      margin-left: auto;
    }
  }

  .act-row__divider {
    height: 1px;
    background: var(--color-surface-container-low);
    margin: 0;
  }

  .activity-empty {
    text-align: center;
    padding: 40px 20px;
    color: var(--color-outline);

    &__icon {
      font-size: 48px;
      margin-bottom: 8px;
      opacity: 0.4;
    }

    &__title {
      font-size: 16px;
      font-weight: 700;
      color: var(--color-on-surface);
      margin: 0 0 4px;
    }

    &__text {
      font-size: 13px;
      margin: 0;
    }
  }

  /* Guest Journey (Per Tamu) Cards */
  .guest-journey-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .guest-card {
    background: #ffffff;
    border: 1px solid var(--color-outline-variant, #e2e8f0);
    border-radius: 12px;
    padding: 16px;
    cursor: pointer;
    transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.15s ease;

    &:hover {
      border-color: #cbd5e1;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    }

    &--expanded {
      border-color: var(--color-primary, #a68966);
      box-shadow: 0 4px 16px rgba(166, 137, 102, 0.12);
    }

    @media (max-width: 480px) {
      padding: 12px;
    }
  }

  .guest-card__header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .guest-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .guest-card__info {
    flex: 1;
    min-width: 0;
  }

  .guest-card__name-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .guest-card__name {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
  }

  .rsvp-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 6px;

    &--attending {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #bbf7d0;
    }
    &--declined {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }
    &--tentative {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
    }
    &--none {
      background: #f1f5f9;
      color: #64748b;
      border: 1px solid #e2e8f0;
    }
  }

  .guest-card__meta {
    margin: 3px 0 0;
    font-size: 12px;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;

    .meta-dot {
      color: #cbd5e1;
    }
  }

  .guest-card__quick-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .action-icon-btn {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;

    .material-symbols-outlined {
      font-size: 16px;
    }

    &:hover {
      background: #ffffff;
      border-color: var(--color-primary);
      color: var(--color-primary);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    }

    &--wa {
      &:hover {
        background: #f0fdf4;
        border-color: #22c55e;
        color: #16a34a;
      }
    }
  }

  .guest-wish-quote {
    margin-top: 10px;
    padding: 8px 12px;
    background: #fffbeb;
    border-left: 3px solid #f59e0b;
    border-radius: 6px;
    display: flex;
    align-items: flex-start;
    gap: 6px;

    .quote-icon {
      font-size: 16px;
      color: #d97706;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .quote-text {
      margin: 0;
      font-size: 12px;
      font-style: italic;
      color: #78350f;
      line-height: 1.4;
    }
  }

  .guest-card__toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #334155;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;

    &:hover {
      background: #f1f5f9;
      border-color: #cbd5e1;
    }

    .toggle-icon {
      font-size: 18px;
      transition: transform 0.2s ease;
    }

    &[aria-expanded="true"] .toggle-icon {
      transform: rotate(180deg);
    }
  }

  .guest-card__milestones {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--color-outline-variant, #e2e8f0);
  }

  .milestone-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;

    .material-symbols-outlined {
      font-size: 13.5px;
    }

    &--done {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #bbf7d0;
    }

    &--pending {
      background: #f8fafc;
      color: #94a3b8;
      border: 1px dashed #cbd5e1;
    }

    &--info {
      background: #dbeafe;
      color: #1e40af;
      border: 1px solid #bfdbfe;
    }

    &--purple {
      background: #f3e8ff;
      color: #6b21a8;
      border: 1px solid #e9d5ff;
    }

    &--warning {
      background: #fef9c3;
      color: #854d0e;
      border: 1px solid #fef08a;
    }

    &--pink {
      background: #fce7f3;
      color: #9d174d;
      border: 1px solid #fbcfe8;
    }

    &--teal {
      background: #ccfbf1;
      color: #0f766e;
      border: 1px solid #99f6e4;
    }

    &--indigo {
      background: #e0e7ff;
      color: #3730a3;
      border: 1px solid #c7d2fe;
    }

    &--success {
      background: #ecfdf5;
      color: #047857;
      border: 1px solid #a7f3d0;
    }

    &--neutral {
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #e2e8f0;
    }
  }

  .guest-card__tech {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .guest-card__timeline {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
    cursor: default;
  }

  .guest-timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;

    .timeline-title {
      font-size: 12px;
      font-weight: 700;
      color: #475569;
    }

    .filter-guest-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--color-primary, #a68966);
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .guest-timeline-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 8px;
    border-left: 2px solid #e2e8f0;
    margin-left: 6px;
  }

  .guest-timeline-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;

    &__icon {
      font-size: 16px;
      margin-top: 1px;
      flex-shrink: 0;
      .material-symbols-outlined { font-size: 16px; }
    }

    &__content {
      flex: 1;
      min-width: 0;
    }

    &__top {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    &__time {
      font-size: 11px;
      color: #64748b;
    }

    &__desc {
      margin: 2px 0 0;
      font-size: 12px;
      color: #334155;
    }
  }

  .pagination-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 0 0 0;
    margin-top: 16px;
    border-top: 1px solid var(--color-surface-container);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;

    @media (max-width: 480px) {
      gap: 8px;
    }
  }

  .pagination-btn {
    padding: 6px 12px;
    height: 34px;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #1e293b;
    cursor: pointer;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;

    &:hover:not(:disabled) {
