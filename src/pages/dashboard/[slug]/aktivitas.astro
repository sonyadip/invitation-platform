      // Bind dynamic actions on guest cards
      function bindGuestCardEvents() {
        document.querySelectorAll('.guest-card').forEach(card => {
          const toggleBtn = card.querySelector('.guest-card__toggle-btn');
          const timeline = card.querySelector('.guest-card__timeline');
          const toggleText = card.querySelector('.toggle-text');

          function toggle() {
            if (!timeline) return;
            const isExpanded = timeline.style.display !== 'none';
            if (isExpanded) {
              timeline.style.display = 'none';
              toggleBtn?.setAttribute('aria-expanded', 'false');
              if (toggleText) toggleText.textContent = 'Detail';
              card.classList.remove('guest-card--expanded');
            } else {
              timeline.style.display = 'block';
              toggleBtn?.setAttribute('aria-expanded', 'true');
              if (toggleText) toggleText.textContent = 'Tutup';
              card.classList.add('guest-card--expanded');
            }
          }

          card.addEventListener('click', (e) => {
            if (
              e.target.closest('.guest-card__timeline') ||
              e.target.closest('.filter-guest-btn') ||
              e.target.closest('.action-icon-btn')
            ) {
              return;
            }
            toggle();
          });

          const filterGuestBtn = card.querySelector('.filter-guest-btn');
          filterGuestBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            const name = filterGuestBtn.getAttribute('data-name') || '';
            if (searchInput) searchInput.value = name;
            searchQuery = name.toLowerCase();
            if (clearSearchBtn) clearSearchBtn.style.display = 'flex';
            switchViewMode('timeline');
          });
        });

        // 1-Click Copy Personal Guest Link Handler
        document.querySelectorAll('.copy-guest-link-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const link = btn.getAttribute('data-link') || '';
            const name = btn.getAttribute('data-name') || 'Tamu';
            if (!link) return;

            try {
              if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(link);
              } else {
                const textArea = document.createElement("textarea");
                textArea.value = link;
                textArea.style.position = "fixed";
                textArea.style.opacity = "0";
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
              }

              if (window.showToast) {
                window.showToast({
                  type: 'success',
                  message: `Tautan personal untuk ${name} berhasil disalin ke clipboard!`
                });
              } else {
                alert(`Tautan untuk ${name} berhasil disalin!`);
              }
            } catch (err) {
              if (window.showToast) {
                window.showToast({ type: 'error', message: 'Gagal menyalin link' });
              }
            }
          });
        });
      }

      // 5. Fetch Activities Feed (Server Paginated)
      async function fetchActivities(page = 1, scrollToTop = false) {
        currentTimelinePage = page;
        if (activityList) {
          activityList.innerHTML = `
            <div class="act-skeleton-list">
              <div class="act-skeleton-row"></div>
              <div class="act-skeleton-row"></div>
              <div class="act-skeleton-row"></div>
            </div>
          `;
        }

        const params = new URLSearchParams({
          slug: slug,
          page: String(page),
          category: activeTag,
          tag: activeTag,
          eventType: eventSelect?.value || 'all',
          event: eventSelect?.value || 'all',
          search: searchQuery,
          timeRange: timeRangeSelect?.value || 'all'
        });

        try {
          const res = await fetch(`/api/analytics/activities?${params.toString()}`);
          if (!res.ok) throw new Error('Failed to fetch activities');
          const data = await res.json();

          totalTimelinePages = data.totalPages || data.pagination?.totalPages || 1;

          if (data.tagCounts) {
            const elAll = document.getElementById('tagAllCount');
            const elId = document.getElementById('tagIdentifiedCount');
            const elInt = document.getElementById('tagInteraksiCount');
            const elRsvp = document.getElementById('tagRsvpCount');
            const elVen = document.getElementById('tagVendorCount');
            const elKunj = document.getElementById('tagKunjunganCount');
            if (elAll) elAll.textContent = `(${data.tagCounts.all || 0})`;
            if (elId) elId.textContent = `(${data.tagCounts.identified || 0})`;
            if (elInt) elInt.textContent = `(${data.tagCounts.interaksi || 0})`;
            if (elRsvp) elRsvp.textContent = `(${data.tagCounts.rsvp || 0})`;
            if (elVen) elVen.textContent = `(${data.tagCounts.vendor || 0})`;
            if (elKunj) elKunj.textContent = `(${data.tagCounts.kunjungan || 0})`;
          }

          if (!activityList) return;

          if (!data.items || data.items.length === 0) {
            activityList.innerHTML = `
              <div class="activity-empty">
                <span class="material-symbols-outlined activity-empty__icon">inbox</span>
                <p class="activity-empty__title">Tidak Ada Aktivitas Sesuai Filter</p>
                <p class="activity-empty__text">Coba ubah kata kunci pencarian atau sesuaikan opsi filter.</p>
              </div>
            `;
          } else {
            activityList.innerHTML = data.items.map(renderTimelineRow).join('');
            bindTimelineRowEvents();
          }

          updatePaginationControls(currentTimelinePage, totalTimelinePages);
          updateFilterIndicator();

          if (scrollToTop) scrollToTopSection();
        } catch (err) {
          console.error('Error fetching activities:', err);
          if (activityList) {
            activityList.innerHTML = `
              <div class="activity-empty">
                <span class="material-symbols-outlined activity-empty__icon" style="color: #ef4444;">error</span>
                <p class="activity-empty__title">Gagal Memuat Data</p>
                <p class="activity-empty__text">Terjadi kendala saat mengambil data aktivitas. Silakan coba tombol perbarui.</p>
              </div>
            `;
          }
        }
      }

      // 6. Fetch Guest Journeys Feed (Server Paginated)
      async function fetchGuests(page = 1, scrollToTop = false) {
        currentGuestsPage = page;
        if (guestJourneyList) {
          guestJourneyList.innerHTML = `
            <div class="act-skeleton-list">
              <div class="act-skeleton-row"></div>
              <div class="act-skeleton-row"></div>
            </div>
          `;
        }

        const params = new URLSearchParams({
          slug: slug,
          page: String(page),
          search: searchQuery,
          timeRange: timeRangeSelect?.value || 'all'
        });

        try {
          const res = await fetch(`/api/analytics/guests?${params.toString()}`);
          if (!res.ok) throw new Error('Failed to fetch guests');
          const data = await res.json();

          totalGuestsPages = data.totalPages || data.pagination?.totalPages || 1;

          if (!guestJourneyList) return;

          if (!data.items || data.items.length === 0) {
            guestJourneyList.innerHTML = `
              <div class="activity-empty">
                <span class="material-symbols-outlined activity-empty__icon">group_off</span>
                <p class="activity-empty__title">Tidak Ada Tamu Sesuai Filter</p>
                <p class="activity-empty__text">Coba ubah kata kunci pencarian atau sesuaikan rentang waktu.</p>
              </div>
            `;
          } else {
            guestJourneyList.innerHTML = data.items.map(renderGuestCard).join('');
            bindGuestCardEvents();
          }

          updatePaginationControls(currentGuestsPage, totalGuestsPages);
          updateFilterIndicator();

          if (scrollToTop) scrollToTopSection();
        } catch (err) {
          console.error('Error fetching guests:', err);
          if (guestJourneyList) {
            guestJourneyList.innerHTML = `
              <div class="activity-empty">
                <span class="material-symbols-outlined activity-empty__icon" style="color: #ef4444;">error</span>
                <p class="activity-empty__title">Gagal Memuat Tamu</p>
                <p class="activity-empty__text">Terjadi kendala saat mengambil data tamu. Silakan coba lagi.</p>
              </div>
            `;
          }
        }
      }

      function updateFilterIndicator() {
        const isFiltered = searchQuery || activeTag !== 'all' || (eventSelect && eventSelect.value !== 'all') || (timeRangeSelect && timeRangeSelect.value !== 'all');
        if (filterIndicator) {
          filterIndicator.style.display = isFiltered ? 'flex' : 'none';
          if (filterIndicatorText) {
            filterIndicatorText.textContent = 'Menampilkan hasil filter' + (searchQuery ? ` untuk "${searchQuery}"` : '');
          }
        }
      }

      function updatePaginationControls(currentPage, totalPages) {
        if (!pageNumbers || !prevBtn || !nextBtn) return;

        pageNumbers.innerHTML = '';
        if (totalPages <= 1) {
          prevBtn.disabled = true;
          nextBtn.disabled = true;
          return;
        }

        prevBtn.disabled = currentPage <= 1;
        nextBtn.disabled = currentPage >= totalPages;

        prevBtn.onclick = () => {
          if (currentPage > 1) {
            if (viewMode === 'timeline') fetchActivities(currentPage - 1, true);
            else fetchGuests(currentPage - 1, true);
          }
        };

        nextBtn.onclick = () => {
          if (currentPage < totalPages) {
            if (viewMode === 'timeline') fetchActivities(currentPage + 1, true);
            else fetchGuests(currentPage + 1, true);
          }
        };

        function createBtn(num) {
          const btn = document.createElement('button');
          btn.className = 'pagination-num' + (num === currentPage ? ' pagination-num--active' : '');
          btn.innerText = String(num);
          btn.onclick = () => {
            if (viewMode === 'timeline') fetchActivities(num, true);
            else fetchGuests(num, true);
          };
          return btn;
        }

        function createEllipsis() {
          const span = document.createElement('span');
          span.className = 'pagination-ellipsis';
          span.innerText = '...';
          return span;
        }

        if (totalPages <= 5) {
          for (let i = 1; i <= totalPages; i++) pageNumbers.appendChild(createBtn(i));
        } else {
          if (currentPage <= 3) {
            for (let i = 1; i <= 4; i++) pageNumbers.appendChild(createBtn(i));
            pageNumbers.appendChild(createEllipsis());
            pageNumbers.appendChild(createBtn(totalPages));
          } else if (currentPage >= totalPages - 2) {
            pageNumbers.appendChild(createBtn(1));
            pageNumbers.appendChild(createEllipsis());
            for (let i = totalPages - 3; i <= totalPages; i++) pageNumbers.appendChild(createBtn(i));
          } else {
            pageNumbers.appendChild(createBtn(1));
            pageNumbers.appendChild(createEllipsis());
            pageNumbers.appendChild(createBtn(currentPage - 1));
            pageNumbers.appendChild(createBtn(currentPage));
            pageNumbers.appendChild(createBtn(currentPage + 1));
            pageNumbers.appendChild(createEllipsis());
            pageNumbers.appendChild(createBtn(totalPages));
          }
        }
      }

      function switchViewMode(mode) {
        viewMode = mode;
        if (viewMode === 'timeline') {
          if (viewModeTimelineBtn) viewModeTimelineBtn.classList.add('view-switch-btn--active');
          if (viewModeGuestsBtn) viewModeGuestsBtn.classList.remove('view-switch-btn--active');
          if (activityList) activityList.style.display = 'flex';
          if (guestJourneyList) guestJourneyList.style.display = 'none';
          if (tagRow) tagRow.style.display = 'flex';
          if (eventFilterWrapper) eventFilterWrapper.style.display = 'block';
          fetchActivities(1);
        } else {
          if (viewModeGuestsBtn) viewModeGuestsBtn.classList.add('view-switch-btn--active');
          if (viewModeTimelineBtn) viewModeTimelineBtn.classList.remove('view-switch-btn--active');
          if (activityList) activityList.style.display = 'none';
          if (guestJourneyList) guestJourneyList.style.display = 'flex';
          if (tagRow) tagRow.style.display = 'none';
          if (eventFilterWrapper) eventFilterWrapper.style.display = 'none';
          fetchGuests(1);
        }
      }

      // View Mode Toggle Listeners
      if (viewModeTimelineBtn) viewModeTimelineBtn.addEventListener('click', () => switchViewMode('timeline'));
      if (viewModeGuestsBtn) viewModeGuestsBtn.addEventListener('click', () => switchViewMode('guests'));

      // Category Tag Buttons Listener
      tagButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          tagButtons.forEach(b => b.classList.remove('activity-tag--active'));
          btn.classList.add('activity-tag--active');
          activeTag = btn.getAttribute('data-tag') || 'all';
          fetchActivities(1);
        });
      });

      // Event Filter Listener
      if (eventSelect) {
        eventSelect.addEventListener('change', () => {
          fetchActivities(1);
        });
      }

      // Time Range Filter Listener
      if (timeRangeSelect) {
        timeRangeSelect.addEventListener('change', () => {
          if (viewMode === 'timeline') fetchActivities(1);
          else fetchGuests(1);
        });
      }

      // Search with 300ms debounce
      if (searchInput) {
        searchInput.addEventListener('input', () => {
          const val = searchInput.value.trim();
          searchQuery = val.toLowerCase();
          if (clearSearchBtn) clearSearchBtn.style.display = val ? 'flex' : 'none';

          if (searchTimeout) clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            if (viewMode === 'timeline') fetchActivities(1);
            else fetchGuests(1);
          }, 300);
        });
      }

      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            searchQuery = '';
            clearSearchBtn.style.display = 'none';
            if (viewMode === 'timeline') fetchActivities(1);
            else fetchGuests(1);
            searchInput.focus();
          }
        });
      }

      // Reset Filters Listener
      if (resetFiltersBtn) {
        resetFiltersBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          searchQuery = '';
          if (clearSearchBtn) clearSearchBtn.style.display = 'none';
          if (timeRangeSelect) timeRangeSelect.value = 'all';
          if (eventSelect) eventSelect.value = 'all';
          activeTag = 'all';
          tagButtons.forEach(b => b.classList.remove('activity-tag--active'));
          document.getElementById('tagAll')?.classList.add('activity-tag--active');

          if (viewMode === 'timeline') fetchActivities(1);
          else fetchGuests(1);
        });
      }

      // Refresh Button Listener
      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => {
          const icon = refreshBtn.querySelector('.refresh-icon');
          if (icon) icon.classList.add('refresh-icon--spin');
          if (window.showToast) {
            window.showToast({ type: 'info', message: 'Memperbarui data aktivitas...' });
          }
          fetchSummary();
          if (viewMode === 'timeline') fetchActivities(currentTimelinePage);
          else fetchGuests(currentGuestsPage);
          setTimeout(() => {
            if (icon) icon.classList.remove('refresh-icon--spin');
          }, 600);
        });
      }

      // Export to Excel Listener
      if (exportBtn) {
        exportBtn.addEventListener('click', async () => {
          if (typeof XLSX === 'undefined') {
            window.showToast({ type: 'info', message: 'Modul export sedang dimuat, silakan coba sesaat lagi.' });
            return;
          }

          exportBtn.disabled = true;
          if (window.showToast) {
            window.showToast({ type: 'info', message: 'Menyiapkan data ekspor Excel...' });
          }

          try {
            const res = await fetch(`/api/analytics/export?slug=${slug}`);
            if (!res.ok) throw new Error('Failed to export data');
            const data = await res.json();

            if (!data.items || data.items.length === 0) {
              window.showToast({ type: 'warning', message: 'Tidak ada data aktivitas untuk diekspor.' });
              return;
            }

            const ws_data = [
              ["No", "Nama Tamu", "Tipe", "Status RSVP", "Aktivitas", "Keterangan / Target", "Perangkat / Browser", "Lokasi", "Waktu (WITA)"]
            ];

            let count = 1;
            data.items.forEach(it => {
              ws_data.push([
                count++,
                it.guestName,
                it.isGuest ? 'Tamu Terdaftar' : 'Anonim',
                it.rsvpStatus,
                it.activity,
                it.detail,
                it.device,
                it.location,
                formatFullDate(it.createdAt)
              ]);
            });

            const ws = XLSX.utils.aoa_to_sheet(ws_data);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Semua Log Aktivitas");
            XLSX.writeFile(wb, `Laporan_Aktivitas_${slug}_${new Date().toISOString().slice(0, 10)}.xlsx`);
            if (window.showToast) {
              window.showToast({ type: 'success', message: 'Data aktivitas berhasil diunduh ke Excel.' });
            }
          } catch (err) {
            console.error('Export error:', err);
            if (window.showToast) {
              window.showToast({ type: 'error', message: 'Gagal mengekspor data ke Excel.' });
            }
          } finally {
            exportBtn.disabled = false;
          }
        });
      }

      // Initialize AJAX Calls on Page Load
      fetchSummary();
      fetchActivities(1);
    });
  </script>
</ClientLayout>

