---
const { slug } = Astro.params;
const session = Astro.locals.session;

if (session?.role !== 'admin') {
  return Astro.redirect('/?login=admin');
}

import ClientLayout from "../../../layouts/ClientLayout.astro";
import { getSlugReportDetail } from "../../../services/dashboard-report";

const report = await getSlugReportDetail(slug);
if (!report) {
  return Astro.redirect('/dashboard');
}

const analytics = report.analytics || {
  deviceStats: { mobile: 0, desktop: 0, tablet: 0, mobilePercent: 0, desktopPercent: 0, tabletPercent: 0 },
  browserStats: [],
  interactionStats: {
    openCover: 0,
    clickMaps: 0,
    clickCalendar: 0,
    copyGift: 0,
    playMusic: 0,
    clickWishes: 0,
    clickRsvp: 0,
    viewGallery: 0,
    clickCoupleInstagram: 0,
    clickVendorWhatsApp: 0,
    clickVendorInstagram: 0,
    clickVendorSite: 0,
    totalInteractions: 0
  },
  recentVisitors: [],
  allVisitors: [],
  allEvents: []
};

const allVisitors = analytics.allVisitors || [];
const allEvents = analytics.allEvents || [];
const rsvps = report.rsvps || [];
const sentInvitations = report.sentInvitations || [];

// Create quick lookup maps for RSVPs and Sent Invitations
const rsvpMap = new Map<string, { id: string; attendanceStatus: string; guestCount: number; message: string | null; createdAt: string }>();
for (const r of rsvps) {
  if (r.guestName) {
    const k = r.guestName.trim().toLowerCase();
    if (!rsvpMap.has(k)) {
      rsvpMap.set(k, {
        id: r.id,
        attendanceStatus: r.attendanceStatus,
        guestCount: r.guestCount || 1,
        message: r.message || null,
        createdAt: r.createdAt
      });
    }
  }
}

const sentMap = new Map<string, { id: string; phone: string | null; openedAt: string | null; lastOpenedAt: string | null; openCount: number; createdAt: string }>();
for (const s of sentInvitations) {
  if (s.guestName) {
    const k = s.guestName.trim().toLowerCase();
    if (!sentMap.has(k)) {
      sentMap.set(k, {
        id: s.id,
        phone: s.phone || null,
        openedAt: s.openedAt || null,
        lastOpenedAt: s.lastOpenedAt || null,
        openCount: s.openCount || 0,
        createdAt: s.createdAt
      });
    }
  }
}

// Layout & Section feature availability flags
const showMapsStat = Boolean(report.wedding.mapsUrl || report.events?.some((e: any) => e.maps_url)) || (analytics.interactionStats?.clickMaps || 0) > 0;
const showCalendarStat = Boolean(report.wedding.weddingDate || report.events?.length > 0) || (analytics.interactionStats?.clickCalendar || 0) > 0;
const showGiftStat = (Boolean(report.settings.giftEnabled) && (report.gifts?.length > 0)) || (analytics.interactionStats?.copyGift || 0) > 0;
const showMusicStat = (Boolean(report.settings.musicEnabled) && Boolean(report.wedding.musicUrl)) || (analytics.interactionStats?.playMusic || 0) > 0;
const showVideoStat = (Boolean(report.settings.videoEnabled) && Boolean(report.settings.assets?.heroVideo)) || (analytics.interactionStats?.playVideo || 0) > 0;
const showGalleryStat = Boolean(report.settings.galleryEnabled) || (analytics.interactionStats?.viewGallery || 0) > 0;
const showRsvpStat = Boolean(report.settings.rsvpEnabled) || (analytics.interactionStats?.clickRsvp || 0) > 0 || (report.rsvps?.length > 0);
const showWishesStat = Boolean(report.settings.wishesEnabled) || (analytics.interactionStats?.clickWishes || 0) > 0 || (report.summary?.wishesCount > 0);
const showCoupleIgStat = Boolean(report.settings.content?.groomInstagramUrl || report.settings.content?.brideInstagramUrl || report.settings.content?.instagramUrl) || (analytics.interactionStats?.clickCoupleInstagram || 0) > 0;

// Event Configuration
const eventConfig: Record<string, { label: string; desc: string; icon: string; category: 'interaksi' | 'vendor' | 'kunjungan'; categoryLabel: string; badgeClass: string; iconBg: string; iconColor: string }> = {
  open_cover: {
    label: 'Buka Undangan',
    desc: 'Membuka cover / amplop undangan digital',
    icon: 'drafts',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--primary',
    iconBg: '#fbf4eb',
    iconColor: '#a68966'
  },
  click_maps: {
    label: 'Petunjuk Maps',
    desc: 'Membuka tautan rute peta lokasi / Google Maps',
    icon: 'location_on',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--info',
    iconBg: '#eff6ff',
    iconColor: '#2563eb'
  },
  click_calendar: {
    label: 'Simpan Kalender',
    desc: 'Menyimpan jadwal resepsi ke Google Calendar',
    icon: 'calendar_month',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--purple',
    iconBg: '#faf5ff',
    iconColor: '#9333ea'
  },
  copy_gift: {
    label: 'Salin Rekening',
    desc: 'Menyalin nomor rekening / informasi hadiah digital',
    icon: 'content_copy',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--warning',
    iconBg: '#fffbeb',
    iconColor: '#d97706'
  },
  play_music: {
    label: 'Putar Musik',
    desc: 'Memutar musik latar belakang undangan',
    icon: 'music_note',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--teal',
    iconBg: '#f0fdfa',
    iconColor: '#0d9488'
  },
  pause_music: {
    label: 'Jeda Musik',
    desc: 'Mematikan / menjeda musik latar belakang',
    icon: 'music_off',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--neutral',
    iconBg: '#f8fafc',
    iconColor: '#64748b'
  },
  play_video: {
    label: 'Putar Video Momen',
    desc: 'Memutar video momen pernikahan di layout video',
    icon: 'smart_display',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--purple',
    iconBg: '#f5f3ff',
    iconColor: '#7c3aed'
  },
  view_gallery: {
    label: 'Lihat Galeri Foto',
    desc: 'Membuka atau melihat preview galeri foto mempelai',
    icon: 'photo_library',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--indigo',
    iconBg: '#eef2ff',
    iconColor: '#4f46e5'
  },
  click_rsvp: {
    label: 'Klik Form RSVP',
    desc: 'Menavigasi atau membuka form konfirmasi kehadiran',
    icon: 'how_to_reg',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--emerald',
    iconBg: '#ecfdf5',
    iconColor: '#059669'
  },
  click_wishes: {
    label: 'Buka Form Ucapan',
    desc: 'Membuka form doa & ucapan selamat untuk mempelai',
    icon: 'forum',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--amber',
    iconBg: '#fffbeb',
    iconColor: '#b45309'
  },
  click_couple_instagram: {
    label: 'Instagram Pengantin',
    desc: 'Membuka tautan profil Instagram mempelai',
    icon: 'photo_camera',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--pink',
    iconBg: '#fdf2f8',
    iconColor: '#db2777'
  },
  click_vendor_whatsapp: {
    label: 'WhatsApp Senadda',
    desc: 'Menghubungi admin WhatsApp Senadda (Pemesanan Undangan)',
    icon: 'chat',
    category: 'vendor',
    categoryLabel: 'Leads Vendor',
    badgeClass: 'act-badge--success',
    iconBg: '#f0fdf4',
    iconColor: '#16a34a'
  },
  click_vendor_instagram: {
    label: 'Instagram Senadda',
    desc: 'Membuka profil Instagram resmi Senadda',
    icon: 'photo_camera',
    category: 'vendor',
    categoryLabel: 'Branding',
    badgeClass: 'act-badge--pink',
    iconBg: '#fdf2f8',
    iconColor: '#db2777'
  },
  click_vendor_site: {
    label: 'Website Senadda',
    desc: 'Membuka situs website resmi Senadda',
    icon: 'language',
    category: 'vendor',
    categoryLabel: 'Branding',
    badgeClass: 'act-badge--info',
    iconBg: '#eff6ff',
    iconColor: '#2563eb'
  },
  page_view: {
    label: 'Kunjungan Halaman',
    desc: 'Membuka dan melihat halaman undangan digital',
    icon: 'visibility',
    category: 'kunjungan',
    categoryLabel: 'Kunjungan',
    badgeClass: 'act-badge--neutral',
    iconBg: '#f8fafc',
    iconColor: '#64748b'
  }
};

// Map events
const eventActivities = allEvents.map((ev, idx) => {
  const conf = eventConfig[ev.eventType] || {
    label: ev.eventType,
    desc: 'Interaksi pada undangan',
    icon: 'touch_app',
    category: 'interaksi',
    categoryLabel: 'Interaksi',
    badgeClass: 'act-badge--neutral',
    iconBg: '#f8fafc',
    iconColor: '#64748b'
  };

  return {
    id: `ev-${ev.id || idx}`,
    type: 'event',
    eventType: ev.eventType,
    category: conf.category,
    categoryLabel: conf.categoryLabel,
    label: conf.label,
    desc: conf.desc,
    icon: conf.icon,
    badgeClass: conf.badgeClass,
    iconBg: conf.iconBg,
    iconColor: conf.iconColor,
    guestName: ev.guestName || null,
    metadata: ev.metadata || {},
    deviceType: 'mobile',
    deviceModel: 'Smartphone',
    browser: '',
    os: '',
    source: 'Link Undangan',
    city: null,
    country: null,
    createdAt: ev.createdAt
  };
});

// Map views
const viewActivities = allVisitors.map((v, idx) => {
  const conf = eventConfig['page_view'];
  return {
    id: `v-${v.id || idx}`,
    type: 'view',
    eventType: 'page_view',
    category: 'kunjungan',
    categoryLabel: conf.categoryLabel,
    label: conf.label,
    desc: conf.desc,
    icon: conf.icon,
    badgeClass: conf.badgeClass,
    iconBg: conf.iconBg,
    iconColor: conf.iconColor,
    guestName: v.guestName || null,
    metadata: { referrer: v.referrer },
    deviceType: v.deviceType || 'mobile',
    deviceModel: v.deviceModel || 'Perangkat Web',
    browser: v.browser || 'Unknown',
    os: v.os || 'Unknown',
    source: v.source || 'Tautan Langsung / WhatsApp',
    city: v.city || null,
    country: v.country || null,
    createdAt: v.createdAt
  };
});

// Merge and sort descending
const activities = [...eventActivities, ...viewActivities].sort((a, b) => {
  return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
});

const totalInteractions = analytics.interactionStats?.totalInteractions ?? (analytics as any).totalEvents ?? allEvents.length;
const totalViews = report.summary.viewCount ?? (analytics as any).totalViews ?? allVisitors.length;

// Count unique active guests
const uniqueGuests = new Set(
  activities.map(a => a.guestName?.trim().toLowerCase()).filter(Boolean)
);
const totalIdentifiedGuests = (analytics as any).totalIdentifiedGuests || uniqueGuests.size;

// Funnel & Engagement Calculations
const totalSent = sentInvitations.length;
const totalOpenedSent = sentInvitations.filter(s => (s.openCount || 0) > 0 || s.openedAt).length;
const openRate = totalSent > 0 ? Math.round((totalOpenedSent / totalSent) * 100) : null;
const coverOpenRate = totalViews > 0 ? Math.min(100, Math.round(((analytics.interactionStats?.openCover || 0) / totalViews) * 100)) : 0;
const rsvpRate = totalViews > 0 ? Math.min(100, Math.round(((report.summary.rsvpCount || 0) / totalViews) * 100)) : 0;
const engagementRate = totalViews > 0 ? Math.min(100, Math.round((totalInteractions / totalViews) * 100)) : 0;

// 24-Hour Activity Distribution (WITA timezone: UTC+8)
const hourlyBuckets = new Array(24).fill(0);
for (const act of activities) {
  if (act.createdAt) {
    const d = new Date(act.createdAt);
    // Convert to WITA (UTC+8)
    const hour = (d.getUTCHours() + 8) % 24;
    hourlyBuckets[hour]++;
  }
}
const maxHourlyActivity = Math.max(...hourlyBuckets, 1);
const peakHour = hourlyBuckets.indexOf(Math.max(...hourlyBuckets));

// Serialized compact activities for live interactive client-side graph engine
const chartActivitiesData = activities.map(a => ({
  t: a.createdAt,
  e: a.eventType,
  c: a.category,
  g: !!a.guestName,
  n: a.guestName || ''
}));

// Group activities by unique Guest
interface GuestJourney {
  key: string;
  guestName: string;
  isGuest: boolean;
  totalActivities: number;
  lastActive: string;
  devices: string[];
  browsers: string[];
  sources: string[];
  cities: string[];
  rsvp: {
    status: string; // 'attending' | 'declined' | 'tentative' | 'none'
    guestCount: number;
    message: string | null;
  } | null;
  sentInfo: {
    phone: string | null;
    openCount: number;
    lastOpenedAt: string | null;
  } | null;
  counts: {
    cover: number;
    maps: number;
    calendar: number;
    gift: number;
    coupleIg: number;
    vendorWa: number;
    vendorIg: number;
    vendorSite: number;
    music: number;
    gallery: number;
    rsvpClick: number;
    wishes: number;
    views: number;
  };
  items: typeof activities;
}

const guestMap = new Map<string, GuestJourney>();

activities.forEach(act => {
  const isGuest = !!act.guestName;
  const key = isGuest ? act.guestName.trim().toLowerCase() : '__anon__';
  const displayName = isGuest ? act.guestName.trim() : 'Pengunjung Umum (Anonim)';

  if (!guestMap.has(key)) {
    const rsvpData = isGuest && rsvpMap.has(key) ? {
      status: rsvpMap.get(key)!.attendanceStatus,
      guestCount: rsvpMap.get(key)!.guestCount,
      message: rsvpMap.get(key)!.message
    } : null;

    const sentData = isGuest && sentMap.has(key) ? {
      phone: sentMap.get(key)!.phone,
      openCount: sentMap.get(key)!.openCount,
      lastOpenedAt: sentMap.get(key)!.lastOpenedAt
    } : null;

    guestMap.set(key, {
      key,
      guestName: displayName,
      isGuest,
      totalActivities: 0,
      lastActive: act.createdAt,
      devices: [],
      browsers: [],
      sources: [],
      cities: [],
      rsvp: rsvpData,
      sentInfo: sentData,
      counts: {
        cover: 0,
        maps: 0,
        calendar: 0,
        gift: 0,
        coupleIg: 0,
        vendorWa: 0,
        vendorIg: 0,
        vendorSite: 0,
        music: 0,
        gallery: 0,
        rsvpClick: 0,
        wishes: 0,
        views: 0
      },
      items: []
    });
  }

  const g = guestMap.get(key)!;
  g.totalActivities++;
  g.items.push(act);

  if (act.deviceModel && act.deviceModel !== 'Perangkat Web' && !g.devices.includes(act.deviceModel)) {
    g.devices.push(act.deviceModel);
  }
  if (act.browser && act.browser !== 'Unknown' && !g.browsers.includes(act.browser)) {
    g.browsers.push(act.browser);
  }
  if (act.source && !g.sources.includes(act.source)) {
    g.sources.push(act.source);
  }
  if (act.city && !g.cities.includes(act.city)) {
    g.cities.push(act.city);
  }

  if (act.eventType === 'open_cover') g.counts.cover++;
  else if (act.eventType === 'click_maps') g.counts.maps++;
  else if (act.eventType === 'click_calendar') g.counts.calendar++;
  else if (act.eventType === 'copy_gift') g.counts.gift++;
  else if (act.eventType === 'click_couple_instagram') g.counts.coupleIg++;
  else if (act.eventType === 'click_vendor_whatsapp') g.counts.vendorWa++;
  else if (act.eventType === 'click_vendor_instagram') g.counts.vendorIg++;
  else if (act.eventType === 'click_vendor_site') g.counts.vendorSite++;
  else if (act.eventType === 'play_music' || act.eventType === 'pause_music') g.counts.music++;
  else if (act.eventType === 'view_gallery') g.counts.gallery++;
  else if (act.eventType === 'click_rsvp') g.counts.rsvpClick++;
  else if (act.eventType === 'click_wishes') g.counts.wishes++;
  else if (act.eventType === 'page_view') g.counts.views++;

  if (new Date(act.createdAt).getTime() > new Date(g.lastActive).getTime()) {
    g.lastActive = act.createdAt;
  }
});

// Sort identified guests first (by lastActive desc), then anonymous
const guestJourneys = Array.from(guestMap.values()).sort((a, b) => {
  if (a.isGuest && !b.isGuest) return -1;
  if (!a.isGuest && b.isGuest) return 1;
  return new Date(b.lastActive).getTime() - new Date(a.lastActive).getTime();
});

const displayActivities = activities;
const displayGuestJourneys = guestJourneys;

function timeAgo(dateStr: string): string {
  if (!dateStr) return '';
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'Baru saja';
  if (mins < 60) return `${mins} mnt lalu`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs} jam lalu`;
  const days = Math.floor(hrs / 24);
  if (days === 1) return 'Kemarin';
  if (days < 7) return `${days} hari lalu`;
  return new Date(dateStr).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
}

function formatFullDate(dateStr: string): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('id-ID', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Asia/Makassar'
  }) + ' WITA';
}

function getDeviceIcon(deviceType: string): string {
  const dt = (deviceType || '').toLowerCase();
  if (dt === 'desktop') return 'computer';
  if (dt === 'tablet') return 'tablet_android';
  return 'smartphone';
}

const originUrl = Astro.url.origin;
---

<ClientLayout title="Aktivitas Tamu">
  <div class="activity-page-layout">
    <!-- Header & Summary Cards -->
    <div class="activity-top fade-in-bottom animate-on-scroll">
      <div class="bento-card" style="width: 100%;">
        <div class="activity-card-header">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap;">
              <h3 class="bento-card__title" style="margin: 0;">Log Aktivitas & Interaksi Tamu</h3>
              <span class="admin-badge">Admin Only</span>
            </div>
            <p class="bento-card__subtitle" style="margin: 0; color: var(--color-outline); font-size: 13px;">
              Analisis mendalam interaksi undangan, konversi RSVP, leads pemilik jasa (Senadda), dan perangkat secara komprehensif.
            </p>
          </div>

          <!-- Quick Refresh Button -->
          <button id="refreshActivityBtn" class="refresh-act-btn" title="Refresh data terbaru">
            <span class="material-symbols-outlined refresh-icon">refresh</span>
            <span class="refresh-text">Perbarui</span>
          </button>
        </div>

        <!-- 4 Key Summary Stats -->
        <div class="stats-grid" style="margin-top: 16px;">
          <div class="stat-card">
            <div class="stat-card__icon" style="background: rgba(166, 137, 102, 0.12); color: var(--color-primary);">
              <span class="material-symbols-outlined">visibility</span>
            </div>
            <div class="stat-card__label">TOTAL KUNJUNGAN</div>
            <div class="stat-card__number">{totalViews}</div>
          </div>

          <div class="stat-card">
            <div class="stat-card__icon" style="background: rgba(22, 163, 74, 0.12); color: #16a34a;">
              <span class="material-symbols-outlined">touch_app</span>
            </div>
            <div class="stat-card__label">TOTAL INTERAKSI</div>
            <div class="stat-card__number">{totalInteractions}</div>
          </div>

          <div class="stat-card">
            <div class="stat-card__icon" style="background: rgba(37, 99, 235, 0.12); color: #2563eb;">
              <span class="material-symbols-outlined">person_pin</span>
            </div>
            <div class="stat-card__label">TAMU TERIDENTIFIKASI</div>
            <div class="stat-card__number">{totalIdentifiedGuests}</div>
          </div>

          <div class="stat-card">
            <div class="stat-card__icon" style="background: rgba(217, 119, 6, 0.12); color: #d97706;">
              <span class="material-symbols-outlined">storefront</span>
            </div>
            <div class="stat-card__label">LEADS VENDOR</div>
            <div class="stat-card__number">
              {(analytics.interactionStats?.clickVendorWhatsApp || 0) + (analytics.interactionStats?.clickVendorInstagram || 0) + (analytics.interactionStats?.clickVendorSite || 0)}
            </div>
          </div>
        </div>

        <!-- Conversion Funnel & Engagement Bar -->
        <div class="conversion-funnel-card">
          <div class="funnel-header">
            <span class="funnel-title">
              <span class="material-symbols-outlined" style="font-size: 16px; color: var(--color-primary);">monitoring</span>
              Conversion Funnel & Engagement Rate
            </span>
            <span class="funnel-caption">Efektivitas interaksi tamu</span>
          </div>

          <div class="funnel-grid">
            <div class="funnel-item">
              <div class="funnel-item__top">
                <span class="funnel-item__label">Cover Open Rate</span>
                <span class="funnel-item__val">{coverOpenRate}%</span>
              </div>
              <div class="funnel-progress">
                <div class="funnel-progress__bar" style={`width: ${coverOpenRate}%; background: var(--color-primary);`}></div>
              </div>
              <span class="funnel-item__desc">{analytics.interactionStats?.openCover || 0} dari {totalViews} pengunjung buka amplop</span>
            </div>

            <div class="funnel-item">
              <div class="funnel-item__top">
                <span class="funnel-item__label">RSVP Conversion</span>
                <span class="funnel-item__val">{rsvpRate}%</span>
              </div>
              <div class="funnel-progress">
                <div class="funnel-progress__bar" style={`width: ${rsvpRate}%; background: #059669;`}></div>
              </div>
              <span class="funnel-item__desc">{report.summary.rsvpCount || 0} tamu telah mengisi RSVP</span>
            </div>

            <div class="funnel-item">
              <div class="funnel-item__top">
                <span class="funnel-item__label">Interaction Rate</span>
                <span class="funnel-item__val">{engagementRate}%</span>
              </div>
              <div class="funnel-progress">
                <div class="funnel-progress__bar" style={`width: Math.min(100, ${engagementRate})%; background: #2563eb;`}></div>
              </div>
              <span class="funnel-item__desc">Rata-rata {totalViews > 0 ? (totalInteractions / totalViews).toFixed(1) : 0} aksi per pengunjung</span>
            </div>

            {totalSent > 0 && openRate !== null && (
              <div class="funnel-item">
                <div class="funnel-item__top">
                  <span class="funnel-item__label">WA Sent Open Rate</span>
                  <span class="funnel-item__val">{openRate}%</span>
                </div>
                <div class="funnel-progress">
                  <div class="funnel-progress__bar" style={`width: ${openRate}%; background: #9333ea;`}></div>
                </div>
                <span class="funnel-item__desc">{totalOpenedSent} dari {totalSent} tamu WA telah membuka</span>
              </div>
            )}
          </div>
        </div>

        <!-- Interactive Analytics Chart & Trend Graph with Full Filters -->
        <div class="activity-graph-card" id="activityGraphSection">
          <div class="graph-card-header">
            <div class="graph-card-title-group">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span class="material-symbols-outlined" style="font-size: 20px; color: var(--color-primary, #a68966);">monitoring</span>
                <h4 class="graph-card-title">Grafik & Tren Aktivitas Pengunjung</h4>
              </div>
              <p class="graph-card-subtitle">Visualisasi interaktif pola kunjungan, respon amplop, dan interaksi tamu secara real-time</p>
            </div>

            <!-- Granularity & Metric Filter Controls -->
            <div class="graph-controls-panel">
              <!-- Metric Filter -->
              <div class="graph-filter-select-wrapper">
                <select id="graphMetricFilter" class="form-input graph-select" title="Filter jenis aktivitas">
                  <option value="all">📊 Semua Aktivitas</option>
                  <option value="views">👁️ Kunjungan Halaman</option>
                  <option value="cover">💌 Buka Cover Undangan</option>
                  <option value="interaction">🎯 Interaksi Undangan</option>
                  <option value="guests">👤 Tamu Teridentifikasi</option>
                  <option value="vendor">💼 Leads Vendor (Senadda)</option>
                </select>
              </div>

              <!-- Time Range Tabs -->
              <div class="graph-time-tabs" role="tablist">
                <button type="button" class="graph-time-tab graph-time-tab--active" data-range="24h" title="Lihat distribusi 24 jam per jam (WITA)">
                  24 Jam
                </button>
                <button type="button" class="graph-time-tab" data-range="7d" title="Lihat tren harian 7 hari terakhir">
                  7 Hari
                </button>
                <button type="button" class="graph-time-tab" data-range="30d" title="Lihat tren 30 hari terakhir">
                  30 Hari
                </button>
                <button type="button" class="graph-time-tab" data-range="all" title="Lihat seluruh riwayat waktu">
                  Semua
                </button>
              </div>

              <!-- Chart Type Switcher (Area vs Bar) -->
              <div class="graph-type-switcher">
                <button type="button" class="graph-type-btn graph-type-btn--active" data-type="area" title="Tampilan Grafik Garis & Area">
                  <span class="material-symbols-outlined">show_chart</span>
                </button>
                <button type="button" class="graph-type-btn" data-type="bar" title="Tampilan Grafik Batang">
                  <span class="material-symbols-outlined">bar_chart</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Dynamic Live KPI Summary Bar -->
          <div class="graph-kpi-bar">
            <div class="graph-kpi-item">
              <span class="graph-kpi-label">Total Terpilih</span>
              <span class="graph-kpi-val" id="graphKpiTotal">0</span>
            </div>
            <div class="graph-kpi-item">
              <span class="graph-kpi-label">Puncak Tertinggi</span>
              <span class="graph-kpi-val" id="graphKpiPeak">-</span>
            </div>
            <div class="graph-kpi-item">
              <span class="graph-kpi-label">Rata-rata</span>
              <span class="graph-kpi-val" id="graphKpiAvg">0</span>
            </div>
            <div class="graph-kpi-item">
              <span class="graph-kpi-label">Tamu Terlibat</span>
              <span class="graph-kpi-val" id="graphKpiGuests">0</span>
            </div>
          </div>

          <!-- Interactive Chart Canvas & Tooltip Container -->
          <div class="graph-canvas-container" id="graphCanvasContainer">
            <!-- SVG Interactive Chart (Area / Line & Bar modes) -->
            <div class="graph-svg-wrapper" id="graphSvgWrapper">
              <svg class="graph-svg" id="activityGraphSvg" viewBox="0 0 800 220" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#a68966" stop-opacity="0.32" />
                    <stop offset="100%" stop-color="#a68966" stop-opacity="0.01" />
                  </linearGradient>
                </defs>
                <!-- Grid Lines -->
                <g id="graphGridGroup"></g>
                <!-- Bar Chart Group -->
                <g id="graphBarsGroup" style="display: none;"></g>
                <!-- Area Chart Group -->
                <g id="graphAreaGroup">
                  <path id="graphAreaPath" class="graph-area-path" d="" fill="url(#areaGradient)" />
                  <path id="graphLinePath" class="graph-line-path" d="" fill="none" stroke="var(--color-primary, #a68966)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  <g id="graphPointsGroup"></g>
                </g>
                <!-- Interactive Vertical Guide Line & Active Indicator -->
                <g id="graphTrackerGroup" style="display: none;">
                  <line id="graphTrackerLine" x1="0" y1="25" x2="0" y2="190" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="3,3" />
                  <circle id="graphTrackerCircle" cx="0" cy="0" r="5.5" fill="#a68966" stroke="#ffffff" stroke-width="2.5" />
                </g>
              </svg>
            </div>

            <!-- X-Axis Labels Row -->
            <div class="graph-xaxis" id="graphXAxisLabels"></div>

            <!-- Floating Interactive Tooltip -->
            <div class="graph-tooltip" id="graphTooltip" style="display: none;">
              <div class="graph-tooltip__header" id="graphTooltipTitle">Waktu</div>
              <div class="graph-tooltip__body">
                <span class="graph-tooltip__badge" id="graphTooltipVal">0 Aksi</span>
                <span class="graph-tooltip__sub" id="graphTooltipSub"></span>
              </div>
            </div>
          </div>
        </div>

        <script is:inline id="analytics-activities-json" type="application/json" set:html={JSON.stringify(chartActivitiesData)}></script>

        <!-- 3 Detailed Breakdown Cards -->
        <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 20px;">
          <!-- 1. Interaksi Tamu pada Undangan -->
          <div class="analytics-subcard" style="margin-bottom: 0;">
            <h4 class="analytics-section-title" style="margin-bottom: 12px;">
              <span class="material-symbols-outlined" style="font-size: 18px; color: var(--color-primary);">touch_app</span>
              Interaksi Tamu pada Undangan
            </h4>
            <div class="interaction-grid">
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon">drafts</span>
                <span class="interaction-card__label">Buka Undangan</span>
                <span class="interaction-card__value">{analytics.interactionStats?.openCover || 0}</span>
              </div>
              {showMapsStat && (
                <div class="interaction-card">
                  <span class="material-symbols-outlined interaction-card__icon" style="color: #2563eb;">location_on</span>
                  <span class="interaction-card__label">Petunjuk Maps</span>
                  <span class="interaction-card__value">{analytics.interactionStats?.clickMaps || 0}</span>
                </div>
              )}
              {showCalendarStat && (
                <div class="interaction-card">
                  <span class="material-symbols-outlined interaction-card__icon" style="color: #9333ea;">calendar_month</span>
                  <span class="interaction-card__label">Simpan Kalender</span>
                  <span class="interaction-card__value">{analytics.interactionStats?.clickCalendar || 0}</span>
                </div>
              )}
              {showGiftStat && (
                <div class="interaction-card">
                  <span class="material-symbols-outlined interaction-card__icon" style="color: #d97706;">content_copy</span>
                  <span class="interaction-card__label">Salin Rekening</span>
                  <span class="interaction-card__value">{analytics.interactionStats?.copyGift || 0}</span>
                </div>
              )}
              {showMusicStat && (
                <div class="interaction-card">
                  <span class="material-symbols-outlined interaction-card__icon" style="color: #0d9488;">music_note</span>
                  <span class="interaction-card__label">Putar Musik</span>
                  <span class="interaction-card__value">{analytics.interactionStats?.playMusic || 0}</span>
                </div>
              )}
              {showVideoStat && (
                <div class="interaction-card">
                  <span class="material-symbols-outlined interaction-card__icon" style="color: #7c3aed;">smart_display</span>
                  <span class="interaction-card__label">Putar Video</span>
                  <span class="interaction-card__value">{analytics.interactionStats?.playVideo || 0}</span>
                </div>
              )}
              {showGalleryStat && (
                <div class="interaction-card">
                  <span class="material-symbols-outlined interaction-card__icon" style="color: #4f46e5;">photo_library</span>
                  <span class="interaction-card__label">Lihat Galeri</span>
                  <span class="interaction-card__value">{analytics.interactionStats?.viewGallery || 0}</span>
                </div>
              )}
              {showRsvpStat && (
                <div class="interaction-card">
                  <span class="material-symbols-outlined interaction-card__icon" style="color: #059669;">how_to_reg</span>
                  <span class="interaction-card__label">Klik Form RSVP</span>
                  <span class="interaction-card__value">{analytics.interactionStats?.clickRsvp || 0}</span>
                </div>
              )}
              {showCoupleIgStat && (
                <div class="interaction-card">
                  <span class="material-symbols-outlined interaction-card__icon" style="color: #db2777;">photo_camera</span>
                  <span class="interaction-card__label">Instagram Mempelai</span>
                  <span class="interaction-card__value">{analytics.interactionStats?.clickCoupleInstagram || 0}</span>
                </div>
              )}
            </div>
          </div>

          <!-- 2. Leads & Branding Pemilik Jasa (Senadda) -->
          <div class="analytics-subcard" style="margin-bottom: 0;">
            <h4 class="analytics-section-title" style="margin-bottom: 12px;">
              <span class="material-symbols-outlined" style="font-size: 18px; color: #16a34a;">storefront</span>
              Leads & Branding Pemilik Jasa (Senadda)
            </h4>
            <div class="interaction-grid">
              <div class="interaction-card" style="border-left: 3px solid #16a34a;">
                <span class="material-symbols-outlined interaction-card__icon" style="color: #16a34a;">chat</span>
                <span class="interaction-card__label">Pesan WhatsApp Senadda</span>
                <span class="interaction-card__value">{analytics.interactionStats?.clickVendorWhatsApp || 0}</span>
              </div>
              <div class="interaction-card" style="border-left: 3px solid #db2777;">
                <span class="material-symbols-outlined interaction-card__icon" style="color: #db2777;">photo_camera</span>
                <span class="interaction-card__label">Instagram Senadda</span>
                <span class="interaction-card__value">{analytics.interactionStats?.clickVendorInstagram || 0}</span>
              </div>
              <div class="interaction-card" style="border-left: 3px solid #2563eb;">
                <span class="material-symbols-outlined interaction-card__icon" style="color: #2563eb;">language</span>
                <span class="interaction-card__label">Website Senadda</span>
                <span class="interaction-card__value">{analytics.interactionStats?.clickVendorSite || 0}</span>
              </div>
            </div>
          </div>

          <!-- 3. Perangkat Pengunjung & Browser -->
          <div class="analytics-subcard" style="margin-bottom: 0;">
            <h4 class="analytics-section-title" style="margin-bottom: 10px;">
              <span class="material-symbols-outlined" style="font-size: 18px; color: #3b82f6;">devices</span>
              Perangkat Pengunjung & Browser Terpopuler
            </h4>
            
            <div class="analytics-bar-wrapper">
              <div class="analytics-bar-segment analytics-bar-segment--mobile" style={`width: ${analytics.deviceStats?.mobilePercent || 0}%`} title={`Mobile: ${analytics.deviceStats?.mobilePercent || 0}%`}></div>
              <div class="analytics-bar-segment analytics-bar-segment--desktop" style={`width: ${analytics.deviceStats?.desktopPercent || 0}%`} title={`Desktop: ${analytics.deviceStats?.desktopPercent || 0}%`}></div>
              <div class="analytics-bar-segment analytics-bar-segment--tablet" style={`width: ${analytics.deviceStats?.tabletPercent || 0}%`} title={`Tablet: ${analytics.deviceStats?.tabletPercent || 0}%`}></div>
            </div>

            <div class="analytics-legend" style="margin-top: 8px;">
              <div class="analytics-legend-item">
                <span class="analytics-legend-dot" style="background-color: var(--color-primary, #6366f1);"></span>
                <span>Smartphone: <strong>{analytics.deviceStats?.mobilePercent || 0}%</strong> ({analytics.deviceStats?.mobile || 0})</span>
              </div>
              <div class="analytics-legend-item">
                <span class="analytics-legend-dot" style="background-color: #06b6d4;"></span>
                <span>Desktop: <strong>{analytics.deviceStats?.desktopPercent || 0}%</strong> ({analytics.deviceStats?.desktop || 0})</span>
              </div>
              <div class="analytics-legend-item">
                <span class="analytics-legend-dot" style="background-color: #f59e0b;"></span>
                <span>Tablet: <strong>{analytics.deviceStats?.tabletPercent || 0}%</strong> ({analytics.deviceStats?.tablet || 0})</span>
              </div>
            </div>

            {analytics.browserStats && analytics.browserStats.length > 0 && (
              <div style="margin-top: 14px; border-top: 1px dashed var(--color-outline-variant); padding-top: 10px;">
                <span style="font-size: 11px; color: var(--color-outline); font-weight: 600; display: block; margin-bottom: 6px;">Browser / In-App WebView Terpopuler:</span>
                <div class="browser-tag-list">
                  {analytics.browserStats.slice(0, 8).map(b => (
                    <span class="browser-tag">
                      {b.browser} <span class="browser-tag__count">{b.count}</span>
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Main List Container -->
    <div class="bento-card fade-in-bottom animate-on-scroll" style="width: 100%;" id="activityListCard">
      <!-- Top Bar: Title & Export Button -->
      <div class="activity-top-bar">
        <div>
          <h4 class="activity-top-bar__title">Daftar Aktivitas & Riwayat</h4>
          <p class="activity-top-bar__subtitle">Eksplorasi interaksi real-time dan perjalanan tamu secara terpadu</p>
        </div>
        <button id="activityExport" class="filter-btn filter-btn--outline activity-export-btn" title="Download data aktivitas (.xlsx)">
          <span class="material-symbols-outlined" style="font-size: 18px;">download</span>
          Export Excel
        </button>
      </div>

      <!-- Search & Filters Container -->
      <div class="activity-controls">
        <!-- Row 1: View Switcher (Kiri) sejajar dengan Rentang Waktu (Kanan) -->
        <div class="activity-controls__row">
          <div class="activity-view-switcher">
            <button type="button" class="view-switch-btn view-switch-btn--active" id="viewModeTimeline" data-mode="timeline" title="Lihat semua log waktu nyata">
              <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span>
              <span>Semua Log</span>
              <span class="view-switch-badge" id="badgeTotalTimeline">{activities.length}</span>
            </button>
            <button type="button" class="view-switch-btn" id="viewModeGuests" data-mode="guests" title="Lihat rangkuman per tamu">
              <span class="material-symbols-outlined" style="font-size: 16px;">group</span>
              <span>Per Tamu</span>
              <span class="view-switch-badge" id="badgeTotalGuests">{guestJourneys.filter(g => g.isGuest).length}</span>
            </button>
          </div>

          <!-- Date Range Filter -->
          <div class="activity-filter-wrapper">
            <select id="timeRangeFilter" class="form-input activity-select">
              <option value="all">Semua Waktu</option>
              <option value="today">Hari Ini (WITA)</option>
              <option value="24h">24 Jam Terakhir</option>
              <option value="7d">7 Hari Terakhir</option>
              <option value="30d">30 Hari Terakhir</option>
            </select>
          </div>
        </div>

        <!-- Row 2: Search (Kiri) sejajar dengan Filter Aksi/Kategori (Kanan) -->
        <div class="activity-controls__row">
          <div class="search-wrapper activity-search-wrapper">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" id="activitySearch" placeholder="Cari nama tamu, aksi, pesan doa, browser, HP..." class="search-input">
            <button type="button" id="clearSearchBtn" class="clear-btn" style="display: none;">
              <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
            </button>
          </div>

          <div class="activity-filter-wrapper">
            <select id="eventFilter" class="form-input activity-select">
              <option value="all">Semua Jenis Aksi</option>
              <option value="open_cover">Buka Undangan (Cover)</option>
              {showMapsStat && <option value="click_maps">Klik Google Maps</option>}
              {showCalendarStat && <option value="click_calendar">Simpan ke Kalender</option>}
              {showGiftStat && <option value="copy_gift">Salin No. Rekening</option>}
              {showMusicStat && <option value="play_music">Putar Musik Latar</option>}
              {showMusicStat && <option value="pause_music">Jeda Musik Latar</option>}
              {showVideoStat && <option value="play_video">Putar Video Momen</option>}
              {showGalleryStat && <option value="view_gallery">Lihat Galeri Foto</option>}
              {showRsvpStat && <option value="click_rsvp">Klik Form RSVP</option>}
              {showWishesStat && <option value="click_wishes">Buka Doa / Ucapan</option>}
              {showCoupleIgStat && <option value="click_couple_instagram">Instagram Pengantin</option>}
              <option value="click_vendor_whatsapp">WhatsApp Senadda</option>
              <option value="click_vendor_instagram">Instagram Senadda</option>
              <option value="click_vendor_site">Website Senadda</option>
              <option value="page_view">Kunjungan Halaman</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Quick Filter Tags -->
      <div class="activity-tags-row">
        <button class="activity-tag activity-tag--active" data-tag="all" id="tagAll">
          Semua <span class="tag-count">({totalViews + totalInteractions})</span>
        </button>
        <button class="activity-tag" data-tag="identified" id="tagIdentified">
          Tamu Terdaftar <span class="tag-count">({totalIdentifiedGuests})</span>
        </button>
        <button class="activity-tag" data-tag="interaksi" id="tagInteraksi">
          Interaksi Undangan <span class="tag-count">({totalInteractions})</span>
        </button>
        <button class="activity-tag" data-tag="rsvp" id="tagRsvp">
          Sudah RSVP <span class="tag-count">({report.summary.rsvpCount || 0})</span>
        </button>
        <button class="activity-tag" data-tag="vendor" id="tagVendor">
          Leads Vendor <span class="tag-count">({(analytics.interactionStats?.clickVendorWhatsApp || 0) + (analytics.interactionStats?.clickVendorInstagram || 0) + (analytics.interactionStats?.clickVendorSite || 0)})</span>
        </button>
        <button class="activity-tag" data-tag="kunjungan" id="tagKunjungan">
          Kunjungan Halaman <span class="tag-count">({totalViews})</span>
        </button>
      </div>

      <!-- Active Filter Indicator Banner -->
      <div id="filterIndicator" class="filter-indicator" style="display: none;">
        <span id="filterIndicatorText">Menampilkan hasil filter</span>
        <button type="button" id="resetFiltersBtn" class="reset-btn">
          Reset Filter <span class="material-symbols-outlined" style="font-size: 14px;">restart_alt</span>
        </button>
      </div>

      <!-- Activity Items Feed (Timeline) -->
      <div class="activity-list" id="activityList">
        {displayActivities.length === 0 ? (
          <div class="activity-empty">
            <span class="material-symbols-outlined activity-empty__icon">inbox</span>
            <p class="activity-empty__title">Belum Ada Aktivitas</p>
            <p class="activity-empty__text">Log interaksi dan kunjungan tamu akan otomatis dicatat di sini secara real-time.</p>
          </div>
        ) : (
          displayActivities.map((item, index) => {
            const isGuest = !!item.guestName;
            const guestDisplay = isGuest ? item.guestName : 'Pengunjung Umum (Anonim)';
            const guestRsvp = isGuest && item.guestName ? rsvpMap.get(item.guestName.trim().toLowerCase()) : null;
            const searchIndex = `${item.guestName || ''} ${guestRsvp?.message || ''} ${item.label} ${item.desc} ${item.browser} ${item.deviceModel} ${item.os} ${item.source} ${item.city || ''} ${item.metadata?.target || ''} ${item.metadata?.href || ''}`.toLowerCase();

            return (
              <div
                class="act-row-wrapper"
                data-id={item.id}
                data-name={(item.guestName || '').toLowerCase()}
                data-is-guest={isGuest ? 'true' : 'false'}
                data-has-rsvp={guestRsvp ? 'true' : 'false'}
                data-category={item.category}
                data-event={item.eventType}
                data-time={item.createdAt}
                data-search={searchIndex}
              >
                <div class="act-row">
                  <!-- Left: Icon -->
                  <div class="act-row__icon-box" style={`background: ${item.iconBg}; color: ${item.iconColor};`}>
                    <span class="material-symbols-outlined">{item.icon}</span>
                  </div>

                  <!-- Middle: Main Content -->
                  <div class="act-row__content">
                    <!-- Top Line: Actor Name on Left, Relative Time on Right -->
                    <div class="act-row__header">
                      <div class="act-row__actor">
                        <span class={`act-row__name ${!isGuest ? 'act-row__name--anon' : ''}`}>
                          {guestDisplay}
                        </span>
                        {isGuest ? (
                          <span class="act-tag-guest">Tamu</span>
                        ) : (
                          <span class="act-tag-anon">Anonim</span>
                        )}

                        {guestRsvp && (
                          <span class={`rsvp-micro-badge rsvp-micro-badge--${guestRsvp.attendanceStatus}`}>
                            {guestRsvp.attendanceStatus === 'attending' ? `Hadir (${guestRsvp.guestCount}pax)` : guestRsvp.attendanceStatus === 'declined' ? 'Tidak Hadir' : 'Ragu'}
                          </span>
                        )}
                      </div>
                      <span class="act-time-rel">{timeAgo(item.createdAt)}</span>
                    </div>

                    <!-- Action Badge Line -->
                    <div class="act-row__action-row">
                      <span class={`act-badge ${item.badgeClass}`}>{item.label}</span>
                    </div>

                    <!-- Description Line -->
                    <p class="act-row__desc">{item.desc}</p>

                    <!-- Target Metadata Highlight (if any) -->
                    {item.eventType === 'copy_gift' && item.metadata?.target && (
                      <div class="act-meta-box act-meta-box--warning">
                        <span class="material-symbols-outlined meta-icon">content_copy</span>
                        <span>Nomor Rekening: <strong>{item.metadata.target}</strong></span>
                      </div>
                    )}
                    {item.eventType === 'click_maps' && item.metadata?.href && (
                      <div class="act-meta-box act-meta-box--info">
                        <span class="material-symbols-outlined meta-icon">location_on</span>
                        <span>Tautan Maps: <a href={item.metadata.href} target="_blank" rel="noopener noreferrer" class="meta-link">{item.metadata.href}</a></span>
                      </div>
                    )}
                    {item.eventType === 'click_couple_instagram' && (
                      <div class="act-meta-box act-meta-box--pink">
                        <span class="material-symbols-outlined meta-icon">photo_camera</span>
                        <span>Instagram Mempelai: {item.metadata?.href ? <a href={item.metadata.href} target="_blank" rel="noopener noreferrer" class="meta-link">{item.metadata.href}</a> : item.metadata?.role || 'Pengantin'}</span>
                      </div>
                    )}

                    <!-- Footer Details Chips -->
                    <div class="act-row__footer">
                      <div class="act-row__chips">
                        {item.deviceModel && item.deviceModel !== 'Perangkat Web' && (
                          <span class="act-chip act-chip--device">
                            <span class="material-symbols-outlined chip-icon">{getDeviceIcon(item.deviceType)}</span>
                            {item.deviceModel} {item.os ? `(${item.os})` : ''}
                          </span>
                        )}
                        {item.browser && item.browser !== 'Unknown' && (
                          <span class="act-chip act-chip--browser">
                            <span class="material-symbols-outlined chip-icon">language</span>
                            {item.browser}
                          </span>
                        )}
                        {item.source && (
                          <span class="act-chip act-chip--source">
                            <span class="material-symbols-outlined chip-icon">link</span>
                            {item.source}
                          </span>
                        )}
                        {item.city && (
                          <span class="act-chip act-chip--location">
                            <span class="material-symbols-outlined chip-icon">place</span>
                            {item.city}{item.country ? `, ${item.country}` : ''}
                          </span>
                        )}
                      </div>
                      <div class="act-date-full">
                        <span class="material-symbols-outlined" style="font-size: 13px;">schedule</span>
                        {formatFullDate(item.createdAt)}
                      </div>
                    </div>
                  </div>
                </div>

                {index < activities.length - 1 && (
                  <div class="act-row__divider"></div>
                )}
              </div>
            );
          })
        )}
      </div>

      <!-- Guest Journeys Feed (Per Tamu) -->
      <div class="guest-journey-list" id="guestJourneyList" style="display: none;">
        {displayGuestJourneys.length === 0 ? (
          <div class="activity-empty">
            <span class="material-symbols-outlined activity-empty__icon">group_off</span>
            <p class="activity-empty__title">Belum Ada Tamu Terdeteksi</p>
            <p class="activity-empty__text">Aktivitas per tamu akan muncul otomatis saat ada tamu membuka tautan undangan.</p>
          </div>
        ) : (
          displayGuestJourneys.map(guest => {
            const searchIndex = `${guest.guestName} ${guest.rsvp?.message || ''} ${guest.sentInfo?.phone || ''} ${guest.devices.join(' ')} ${guest.browsers.join(' ')} ${guest.sources.join(' ')} ${guest.cities.join(' ')}`.toLowerCase();
            const initials = guest.isGuest ? guest.guestName.slice(0, 2).toUpperCase() : '?';
            const guestDirectLink = `${originUrl}/${slug}?to=${encodeURIComponent(guest.guestName)}`;

            return (
              <div
                class="guest-card"
                data-guest-name={guest.guestName.toLowerCase()}
                data-search={searchIndex}
                data-is-guest={guest.isGuest ? 'true' : 'false'}
                data-has-rsvp={guest.rsvp ? 'true' : 'false'}
                data-has-cover={guest.counts.cover > 0 ? 'true' : 'false'}
                data-has-maps={guest.counts.maps > 0 ? 'true' : 'false'}
                data-has-gift={guest.counts.gift > 0 ? 'true' : 'false'}
                data-time={guest.lastActive}
              >
                <!-- Guest Header -->
                <div class="guest-card__header">
                  <div class="guest-card__avatar" style={guest.isGuest ? 'background: #e0e7ff; color: #3730a3;' : 'background: #f1f5f9; color: #64748b;'}>
                    {initials}
                  </div>
                  <div class="guest-card__info">
                    <div class="guest-card__name-row">
                      <h4 class="guest-card__name">{guest.guestName}</h4>
                      {guest.isGuest ? (
                        <span class="act-tag-guest">Tamu</span>
                      ) : (
                        <span class="act-tag-anon">Anonim</span>
                      )}

                      <!-- RSVP Status Badge -->
                      {guest.rsvp ? (
                        <span class={`rsvp-status-badge rsvp-status-badge--${guest.rsvp.status}`}>
                          <span class="material-symbols-outlined" style="font-size: 13px;">
                            {guest.rsvp.status === 'attending' ? 'check_circle' : guest.rsvp.status === 'declined' ? 'cancel' : 'help'}
                          </span>
                          {guest.rsvp.status === 'attending' ? `Konfirmasi Hadir (${guest.rsvp.guestCount} Pax)` : guest.rsvp.status === 'declined' ? 'Berhalangan Hadir' : 'Ragu-ragu'}
                        </span>
                      ) : guest.isGuest ? (
                        <span class="rsvp-status-badge rsvp-status-badge--none">
                          <span class="material-symbols-outlined" style="font-size: 13px;">pending</span>
                          Belum Konfirmasi RSVP
                        </span>
                      ) : null}
                    </div>

                    <p class="guest-card__meta">
                      <span>Terakhir aktif: <strong>{timeAgo(guest.lastActive)}</strong></span>
                      <span class="meta-dot">•</span>
                      <span>Total: <strong>{guest.totalActivities} aktivitas</strong></span>
                      {guest.sentInfo?.phone && (
                        <>
                          <span class="meta-dot">•</span>
                          <span>WA: <strong>{guest.sentInfo.phone}</strong></span>
                        </>
                      )}
                    </p>
                  </div>

                  <!-- Quick Action Buttons -->
                  <div class="guest-card__quick-actions">
                    {guest.isGuest && (
                      <>
                        <button
                          type="button"
                          class="action-icon-btn copy-guest-link-btn"
                          data-link={guestDirectLink}
                          data-name={guest.guestName}
                          title="Salin tautan undangan personal untuk tamu ini"
                        >
                          <span class="material-symbols-outlined">link</span>
                        </button>

                        {guest.sentInfo?.phone && (
                          <a
                            href={`https://wa.me/${guest.sentInfo.phone.replace(/[^0-9]/g, '')}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-icon-btn action-icon-btn--wa"
                            title="Buka chat WhatsApp tamu"
                            onclick="event.stopPropagation();"
                          >
                            <span class="material-symbols-outlined">chat</span>
                          </a>
                        )}
                      </>
                    )}

                    <button type="button" class="guest-card__toggle-btn" aria-expanded="false" title="Buka detail riwayat">
                      <span class="toggle-text">Detail</span>
                      <span class="material-symbols-outlined toggle-icon">expand_more</span>
                    </button>
                  </div>
                </div>

                <!-- RSVP Wish / Doa Quote Box (if submitted) -->
                {guest.rsvp?.message && (
                  <div class="guest-wish-quote">
                    <span class="material-symbols-outlined quote-icon">format_quote</span>
                    <p class="quote-text">"{guest.rsvp.message}"</p>
                  </div>
                )}

                <!-- Guest Milestones Pills -->
                <div class="guest-card__milestones">
                  {guest.counts.cover > 0 ? (
                    <span class="milestone-badge milestone-badge--done" title="Sudah membuka amplop cover">
                      <span class="material-symbols-outlined">mark_email_read</span> Buka Cover ({guest.counts.cover}x)
                    </span>
                  ) : (
                    <span class="milestone-badge milestone-badge--pending" title="Belum membuka cover">
                      <span class="material-symbols-outlined">drafts</span> Buka Cover
                    </span>
                  )}

                  {guest.counts.maps > 0 && (
                    <span class="milestone-badge milestone-badge--info" title="Melihat rute Google Maps">
                      <span class="material-symbols-outlined">location_on</span> Cek Maps ({guest.counts.maps}x)
                    </span>
                  )}

                  {guest.counts.calendar > 0 && (
                    <span class="milestone-badge milestone-badge--purple" title="Menyimpan acara ke kalender">
                      <span class="material-symbols-outlined">event_available</span> Simpan Kalender ({guest.counts.calendar}x)
                    </span>
                  )}

                  {guest.counts.gift > 0 && (
                    <span class="milestone-badge milestone-badge--warning" title="Menyalin nomor rekening amplop">
                      <span class="material-symbols-outlined">content_copy</span> Salin Rekening ({guest.counts.gift}x)
                    </span>
                  )}

                  {guest.counts.gallery > 0 && (
                    <span class="milestone-badge milestone-badge--indigo" title="Melihat galeri foto">
                      <span class="material-symbols-outlined">photo_library</span> Galeri ({guest.counts.gallery}x)
                    </span>
                  )}

                  {guest.counts.music > 0 && (
                    <span class="milestone-badge milestone-badge--teal" title="Memutar musik latar">
                      <span class="material-symbols-outlined">music_note</span> Musik ({guest.counts.music}x)
                    </span>
                  )}

                  {guest.counts.coupleIg > 0 && (
                    <span class="milestone-badge milestone-badge--pink" title="Melihat Instagram Mempelai">
                      <span class="material-symbols-outlined">photo_camera</span> Profil IG ({guest.counts.coupleIg}x)
                    </span>
                  )}

                  {guest.counts.vendorWa > 0 && (
                    <span class="milestone-badge milestone-badge--success" title="Menghubungi WhatsApp Senadda">
                      <span class="material-symbols-outlined">chat</span> WA Senadda ({guest.counts.vendorWa}x)
                    </span>
                  )}

                  {guest.counts.views > 0 && (
                    <span class="milestone-badge milestone-badge--neutral" title="Total kunjungan halaman">
                      <span class="material-symbols-outlined">visibility</span> Kunjungan ({guest.counts.views}x)
                    </span>
                  )}
                </div>

                <!-- Devices & Origin Used by this Guest -->
                <div class="guest-card__tech">
                  {guest.devices.length > 0 && (
                    <span class="act-chip act-chip--device">
                      <span class="material-symbols-outlined chip-icon">devices</span>
                      {guest.devices.join(', ')}
                    </span>
                  )}
                  {guest.browsers.length > 0 && (
                    <span class="act-chip act-chip--browser">
                      <span class="material-symbols-outlined chip-icon">language</span>
                      {guest.browsers.join(', ')}
                    </span>
                  )}
                  {guest.sources.length > 0 && (
                    <span class="act-chip act-chip--source">
                      <span class="material-symbols-outlined chip-icon">link</span>
                      {guest.sources.join(', ')}
                    </span>
                  )}
                  {guest.cities.length > 0 && (
                    <span class="act-chip act-chip--location">
                      <span class="material-symbols-outlined chip-icon">place</span>
                      {guest.cities.join(', ')}
                    </span>
                  )}
                </div>

                <!-- Expandable Timeline per Guest -->
                <div class="guest-card__timeline" style="display: none;">
                  <div class="guest-timeline-header">
                    <span class="timeline-title">Riwayat Lengkap Interaksi:</span>
                    {guest.isGuest && (
                      <button type="button" class="filter-guest-btn" data-name={guest.guestName}>
                        <span class="material-symbols-outlined" style="font-size: 14px;">filter_alt</span>
                        Filter di Semua Log
                      </button>
                    )}
                  </div>
                  <div class="guest-timeline-items">
                    {guest.items.map(item => (
                      <div class="guest-timeline-item">
                        <div class="guest-timeline-item__icon" style={`color: ${item.iconColor};`}>
                          <span class="material-symbols-outlined">{item.icon}</span>
                        </div>
                        <div class="guest-timeline-item__content">
                          <div class="guest-timeline-item__top">
                            <span class={`act-badge ${item.badgeClass}`}>{item.label}</span>
                            <span class="guest-timeline-item__time">{formatFullDate(item.createdAt)}</span>
                          </div>
                          <p class="guest-timeline-item__desc">{item.desc}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            );
          })
        )}
      </div>



      <!-- Pagination -->
      <div class="pagination-wrapper" style="border-top: 1px solid var(--color-surface-container); padding: 16px 0 0 0; margin-top: 16px;">
        <button class="pagination-btn" id="actPrev" disabled>Prev</button>
        <div class="pagination-numbers" id="actPageNumbers"></div>
        <button class="pagination-btn" id="actNext" disabled>Next</button>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('activitySearch');
      const clearSearchBtn = document.getElementById('clearSearchBtn');
      const timeRangeSelect = document.getElementById('timeRangeFilter');
      const eventSelect = document.getElementById('eventFilter');
      const exportBtn = document.getElementById('activityExport');
      const refreshBtn = document.getElementById('refreshActivityBtn');
      const tagButtons = document.querySelectorAll('.activity-tag');
      const tagRow = document.querySelector('.activity-tags-row');
      const filterIndicator = document.getElementById('filterIndicator');
      const filterIndicatorText = document.getElementById('filterIndicatorText');
      const resetFiltersBtn = document.getElementById('resetFiltersBtn');

      const viewModeTimelineBtn = document.getElementById('viewModeTimeline');
      const viewModeGuestsBtn = document.getElementById('viewModeGuests');
      const activityList = document.getElementById('activityList');
      const guestJourneyList = document.getElementById('guestJourneyList');

      const allRows = Array.from(document.querySelectorAll('.act-row-wrapper'));
      const allGuestCards = Array.from(document.querySelectorAll('.guest-card'));

      const prevBtn = document.getElementById('actPrev');
      const nextBtn = document.getElementById('actNext');
      const pageNumbers = document.getElementById('actPageNumbers');

      let viewMode = 'timeline'; // 'timeline' | 'guests'
      let currentPage = 1;
      const itemsPerPageTimeline = 15;
      const itemsPerPageGuests = 10;
      let activeTag = 'all';
      let filteredRows = [...allRows];
      let filteredGuests = [...allGuestCards];

      function scrollToTopSection() {
        const cardEl = document.getElementById('activityListCard') || document.getElementById('activityList');
        if (cardEl) {
          const navbarHeight = 85;
          const targetY = cardEl.getBoundingClientRect().top + window.pageYOffset - navbarHeight;
          window.scrollTo({
            top: Math.max(0, targetY),
            behavior: 'smooth'
          });
        }
      }

      // Refresh Button Handler
      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => {
          const icon = refreshBtn.querySelector('.refresh-icon');
          if (icon) icon.classList.add('refresh-icon--spin');
          if (window.showToast) {
            window.showToast({ type: 'info', message: 'Memperbarui data aktivitas...' });
          }
          setTimeout(() => {
            window.location.reload();
          }, 400);
        });
      }

      // 1-Click Copy Personal Guest Link Handler
      document.querySelectorAll('.copy-guest-link-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const link = btn.getAttribute('data-link') || '';
          const name = btn.getAttribute('data-name') || 'Tamu';
          if (!link) return;

          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(link);
            } else {
              const textArea = document.createElement("textarea");
              textArea.value = link;
              textArea.style.position = "fixed";
              textArea.style.opacity = "0";
              document.body.appendChild(textArea);
              textArea.focus();
              textArea.select();
              document.execCommand('copy');
              document.body.removeChild(textArea);
            }

            if (window.showToast) {
              window.showToast({
                type: 'success',
                message: `Tautan personal untuk ${name} berhasil disalin ke clipboard!`
              });
            } else {
              alert(`Tautan untuk ${name} berhasil disalin!`);
            }
          } catch (err) {
            if (window.showToast) {
              window.showToast({ type: 'error', message: 'Gagal menyalin link' });
            }
          }
        });
      });

      function switchViewMode(mode) {
        viewMode = mode;
        currentPage = 1;

        if (viewMode === 'timeline') {
          viewModeTimelineBtn?.classList.add('view-switch-btn--active');
          viewModeGuestsBtn?.classList.remove('view-switch-btn--active');
          if (activityList) activityList.style.display = 'flex';
          if (guestJourneyList) guestJourneyList.style.display = 'none';
          if (tagRow) tagRow.style.display = 'flex';
        } else {
          viewModeGuestsBtn?.classList.add('view-switch-btn--active');
          viewModeTimelineBtn?.classList.remove('view-switch-btn--active');
          if (activityList) activityList.style.display = 'none';
          if (guestJourneyList) guestJourneyList.style.display = 'flex';
          if (tagRow) tagRow.style.display = 'flex';
        }

        applyFilters();
      }

      viewModeTimelineBtn?.addEventListener('click', () => switchViewMode('timeline'));
      viewModeGuestsBtn?.addEventListener('click', () => switchViewMode('guests'));

      // Toggle accordion on guest cards
      allGuestCards.forEach(card => {
        const toggleBtn = card.querySelector('.guest-card__toggle-btn');
        const timeline = card.querySelector('.guest-card__timeline');
        const toggleText = card.querySelector('.toggle-text');

        function toggleCard() {
          if (!timeline) return;
          const isExpanded = timeline.style.display !== 'none';
          if (isExpanded) {
            timeline.style.display = 'none';
            toggleBtn?.setAttribute('aria-expanded', 'false');
            if (toggleText) toggleText.textContent = 'Detail';
            card.classList.remove('guest-card--expanded');
          } else {
            timeline.style.display = 'block';
            toggleBtn?.setAttribute('aria-expanded', 'true');
            if (toggleText) toggleText.textContent = 'Tutup';
            card.classList.add('guest-card--expanded');
          }
        }

        card.addEventListener('click', (e) => {
          if (
            e.target.closest('.guest-card__timeline') ||
            e.target.closest('.filter-guest-btn') ||
            e.target.closest('.action-icon-btn')
          ) {
            return;
          }
          toggleCard();
        });

        const filterGuestBtn = card.querySelector('.filter-guest-btn');
        filterGuestBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          const name = filterGuestBtn.getAttribute('data-name') || '';
          if (searchInput) searchInput.value = name;
          switchViewMode('timeline');
          applyFilters();
          scrollToTopSection();
        });
      });

      // Time Filter Evaluation Helper
      function isWithinTimeRange(timeStr, rangeVal) {
        if (rangeVal === 'all' || !timeStr) return true;
        const itemTime = new Date(timeStr).getTime();
        const now = Date.now();

        if (rangeVal === '24h') {
          return now - itemTime <= 24 * 60 * 60 * 1000;
        }
        if (rangeVal === '7d') {
          return now - itemTime <= 7 * 24 * 60 * 60 * 1000;
        }
        if (rangeVal === '30d') {
          return now - itemTime <= 30 * 24 * 60 * 60 * 1000;
        }
        if (rangeVal === 'today') {
          // Compare day in WITA (UTC+8)
          const itemWita = new Date(itemTime + 8 * 3600000).toISOString().slice(0, 10);
          const nowWita = new Date(now + 8 * 3600000).toISOString().slice(0, 10);
          return itemWita === nowWita;
        }
        return true;
      }

      function applyFilters() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        const timeVal = timeRangeSelect?.value || 'all';
        const eventVal = eventSelect?.value || 'all';

        if (clearSearchBtn) {
          clearSearchBtn.style.display = query ? 'flex' : 'none';
        }

        if (viewMode === 'timeline') {
          // 1. Base filter for timeline
          const baseRows = allRows.filter(row => {
            const rowEvent = row.getAttribute('data-event') || '';
            const rowTime = row.getAttribute('data-time') || '';
            const searchData = row.getAttribute('data-search') || '';

            if (eventVal !== 'all' && rowEvent !== eventVal) return false;
            if (!isWithinTimeRange(rowTime, timeVal)) return false;
            if (query && !searchData.includes(query)) return false;

            return true;
          });

          // 2. Update dynamic tag counts
          const countAll = baseRows.length;
          const countIdentified = baseRows.filter(r => r.getAttribute('data-is-guest') === 'true').length;
          const countInteraksi = baseRows.filter(r => r.getAttribute('data-category') === 'interaksi').length;
          const countRsvp = baseRows.filter(r => r.getAttribute('data-has-rsvp') === 'true').length;
          const countVendor = baseRows.filter(r => r.getAttribute('data-category') === 'vendor').length;
          const countKunjungan = baseRows.filter(r => r.getAttribute('data-category') === 'kunjungan').length;

          const tagAll = document.getElementById('tagAll');
          const tagIdentified = document.getElementById('tagIdentified');
          const tagInteraksi = document.getElementById('tagInteraksi');
          const tagRsvp = document.getElementById('tagRsvp');
          const tagVendor = document.getElementById('tagVendor');
          const tagKunjungan = document.getElementById('tagKunjungan');

          if (tagAll?.querySelector('.tag-count')) tagAll.querySelector('.tag-count').textContent = `(${countAll})`;
          if (tagIdentified?.querySelector('.tag-count')) tagIdentified.querySelector('.tag-count').textContent = `(${countIdentified})`;
          if (tagInteraksi?.querySelector('.tag-count')) tagInteraksi.querySelector('.tag-count').textContent = `(${countInteraksi})`;
          if (tagRsvp?.querySelector('.tag-count')) tagRsvp.querySelector('.tag-count').textContent = `(${countRsvp})`;
          if (tagVendor?.querySelector('.tag-count')) tagVendor.querySelector('.tag-count').textContent = `(${countVendor})`;
          if (tagKunjungan?.querySelector('.tag-count')) tagKunjungan.querySelector('.tag-count').textContent = `(${countKunjungan})`;

          // 3. Apply active tag filter
          filteredRows = baseRows.filter(row => {
            const isGuest = row.getAttribute('data-is-guest') === 'true';
            const cat = row.getAttribute('data-category') || '';
            const hasRsvp = row.getAttribute('data-has-rsvp') === 'true';

            if (activeTag === 'identified' && !isGuest) return false;
            if (activeTag === 'interaksi' && cat !== 'interaksi') return false;
            if (activeTag === 'rsvp' && !hasRsvp) return false;
            if (activeTag === 'vendor' && cat !== 'vendor') return false;
            if (activeTag === 'kunjungan' && cat !== 'kunjungan') return false;

            return true;
          });

          // Filter Indicator
          const hasFilters = query || timeVal !== 'all' || eventVal !== 'all' || activeTag !== 'all';
          if (filterIndicator) {
            filterIndicator.style.display = hasFilters ? 'flex' : 'none';
            if (filterIndicatorText) {
              filterIndicatorText.textContent = `Menampilkan ${filteredRows.length} dari ${allRows.length} total aktivitas.`;
            }
          }
        } else {
          // Guest mode filtering
          const baseGuests = allGuestCards.filter(card => {
            const searchData = card.getAttribute('data-search') || '';
            const lastTime = card.getAttribute('data-time') || '';
            const isGuest = card.getAttribute('data-is-guest') === 'true';
            const hasRsvp = card.getAttribute('data-has-rsvp') === 'true';
            const hasCover = card.getAttribute('data-has-cover') === 'true';
            const hasMaps = card.getAttribute('data-has-maps') === 'true';
            const hasGift = card.getAttribute('data-has-gift') === 'true';

            if (!isWithinTimeRange(lastTime, timeVal)) return false;
            if (query && !searchData.includes(query)) return false;

            if (eventVal === 'open_cover' && !hasCover) return false;
            if (eventVal === 'click_maps' && !hasMaps) return false;
            if (eventVal === 'copy_gift' && !hasGift) return false;
            if (eventVal === 'click_rsvp' && !hasRsvp) return false;

            return true;
          });

          // Tag filter on guests
          filteredGuests = baseGuests.filter(card => {
            const isGuest = card.getAttribute('data-is-guest') === 'true';
            const hasRsvp = card.getAttribute('data-has-rsvp') === 'true';

            if (activeTag === 'identified' && !isGuest) return false;
            if (activeTag === 'rsvp' && !hasRsvp) return false;
            return true;
          });

          const hasFilters = query || timeVal !== 'all' || eventVal !== 'all' || activeTag !== 'all';
          if (filterIndicator) {
            filterIndicator.style.display = hasFilters ? 'flex' : 'none';
            if (filterIndicatorText) {
              filterIndicatorText.textContent = `Menampilkan ${filteredGuests.length} dari ${allGuestCards.length} profil tamu.`;
            }
          }
        }

        updatePagination();
      }

      function updatePagination() {
        const activeItems = viewMode === 'timeline' ? filteredRows : filteredGuests;
        const currentItemsPerPage = viewMode === 'timeline' ? itemsPerPageTimeline : itemsPerPageGuests;

        const totalPages = Math.ceil(activeItems.length / currentItemsPerPage) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        // Hide all items first
        if (viewMode === 'timeline') {
          allRows.forEach(row => { row.style.display = 'none'; });
          const start = (currentPage - 1) * currentItemsPerPage;
          const end = start + currentItemsPerPage;
          activeItems.slice(start, end).forEach(row => { row.style.display = 'block'; });
        } else {
          allGuestCards.forEach(card => { card.style.display = 'none'; });
          const start = (currentPage - 1) * currentItemsPerPage;
          const end = start + currentItemsPerPage;
          activeItems.slice(start, end).forEach(card => { card.style.display = 'block'; });
        }

        // Update Prev / Next buttons
        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

        // Render Page Number Buttons
        if (pageNumbers) {
          pageNumbers.innerHTML = '';

          function createBtn(i) {
            const btn = document.createElement('button');
            btn.className = `pagination-num ${i === currentPage ? 'pagination-num--active' : ''}`;
            btn.innerText = String(i);
            btn.onclick = () => {
              currentPage = i;
              updatePagination();
              scrollToTopSection();
            };
            return btn;
          }

          function createEllipsis() {
            const span = document.createElement('span');
            span.className = 'pagination-ellipsis';
            span.innerText = '...';
            return span;
          }

          if (totalPages <= 5) {
            for (let i = 1; i <= totalPages; i++) pageNumbers.appendChild(createBtn(i));
          } else {
            if (currentPage <= 3) {
              for (let i = 1; i <= 4; i++) pageNumbers.appendChild(createBtn(i));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(totalPages));
            } else if (currentPage >= totalPages - 2) {
              pageNumbers.appendChild(createBtn(1));
              pageNumbers.appendChild(createEllipsis());
              for (let i = totalPages - 3; i <= totalPages; i++) pageNumbers.appendChild(createBtn(i));
            } else {
              pageNumbers.appendChild(createBtn(1));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(currentPage - 1));
              pageNumbers.appendChild(createBtn(currentPage));
              pageNumbers.appendChild(createBtn(currentPage + 1));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(totalPages));
            }
          }
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            updatePagination();
            scrollToTopSection();
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const activeItems = viewMode === 'timeline' ? filteredRows : filteredGuests;
          const currentItemsPerPage = viewMode === 'timeline' ? itemsPerPageTimeline : itemsPerPageGuests;
          const totalPages = Math.ceil(activeItems.length / currentItemsPerPage) || 1;
          if (currentPage < totalPages) {
            currentPage++;
            updatePagination();
            scrollToTopSection();
          }
        });
      }

      if (searchInput) searchInput.addEventListener('input', () => { currentPage = 1; applyFilters(); });
      if (timeRangeSelect) timeRangeSelect.addEventListener('change', () => { currentPage = 1; applyFilters(); });
      if (eventSelect) eventSelect.addEventListener('change', () => { currentPage = 1; applyFilters(); });

      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            currentPage = 1;
            applyFilters();
            searchInput.focus();
          }
        });
      }

      if (resetFiltersBtn) {
        resetFiltersBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          if (timeRangeSelect) timeRangeSelect.value = 'all';
          if (eventSelect) eventSelect.value = 'all';
          activeTag = 'all';
          tagButtons.forEach(b => b.classList.remove('activity-tag--active'));
          document.getElementById('tagAll')?.classList.add('activity-tag--active');
          currentPage = 1;
          applyFilters();
        });
      }

      tagButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          tagButtons.forEach(b => b.classList.remove('activity-tag--active'));
          btn.classList.add('activity-tag--active');
          activeTag = btn.getAttribute('data-tag') || 'all';
          currentPage = 1;
          applyFilters();
        });
      });

      // Export to Excel / CSV with Enhanced Fields
      if (exportBtn) {
        exportBtn.addEventListener('click', () => {
          if (typeof XLSX === 'undefined') {
            window.showToast({ type: 'info', message: 'Modul export sedang dimuat, silakan coba sesaat lagi.' });
            return;
          }

          if (viewMode === 'timeline') {
            if (filteredRows.length === 0) {
              window.showToast({ type: 'warning', message: 'Tidak ada data aktivitas untuk diekspor.' });
              return;
            }

            const ws_data = [
              ["No", "Nama Tamu", "Status RSVP", "Aktivitas", "Keterangan", "Waktu", "Perangkat / Browser"]
            ];

            let count = 1;
            filteredRows.forEach(row => {
              const nameEl = row.querySelector('.act-row__name');
              const rsvpEl = row.querySelector('.rsvp-micro-badge');
              const badgeEl = row.querySelector('.act-badge');
              const descEl = row.querySelector('.act-row__desc');
              const dateEl = row.querySelector('.act-date-full');
              const chipsEl = Array.from(row.querySelectorAll('.act-chip')).map(c => c.innerText.trim()).join(' | ');

              ws_data.push([
                count,
                nameEl ? nameEl.innerText.trim() : 'Anonim',
                rsvpEl ? rsvpEl.innerText.trim() : 'Belum RSVP',
                badgeEl ? badgeEl.innerText.trim() : '',
                descEl ? descEl.innerText.trim() : '',
                dateEl ? dateEl.innerText.trim() : '',
                chipsEl
              ]);
              count++;
            });

            const ws = XLSX.utils.aoa_to_sheet(ws_data);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Log Aktivitas");
            XLSX.writeFile(wb, `Log_Aktivitas_${slug}_${new Date().toISOString().slice(0, 10)}.xlsx`);
            window.showToast({ type: 'success', message: 'Data log aktivitas berhasil diekspor.' });
          } else {
            if (filteredGuests.length === 0) {
              window.showToast({ type: 'warning', message: 'Tidak ada data tamu untuk diekspor.' });
              return;
            }

            const ws_data = [
              ["No", "Nama Tamu", "Tipe", "Status RSVP", "Kutipan Doa", "Aktivitas Terakhir", "Milestone Aksi", "Perangkat"]
            ];

            let count = 1;
            filteredGuests.forEach(card => {
              const nameEl = card.querySelector('.guest-card__name');
              const isGuest = card.getAttribute('data-is-guest') === 'true';
              const rsvpEl = card.querySelector('.rsvp-status-badge');
              const wishEl = card.querySelector('.quote-text');
              const metaEl = card.querySelector('.guest-card__meta');
              const milestones = Array.from(card.querySelectorAll('.milestone-badge')).map(m => m.innerText.trim()).join(', ');
              const techEl = Array.from(card.querySelectorAll('.guest-card__tech .act-chip')).map(c => c.innerText.trim()).join(' | ');

              ws_data.push([
                count,
                nameEl ? nameEl.innerText.trim() : 'Anonim',
                isGuest ? 'Tamu Terdaftar' : 'Anonim',
                rsvpEl ? rsvpEl.innerText.trim() : 'Belum Konfirmasi',
                wishEl ? wishEl.innerText.trim() : '-',
                metaEl ? metaEl.innerText.trim() : '',
                milestones,
                techEl
              ]);
              count++;
            });

            const ws = XLSX.utils.aoa_to_sheet(ws_data);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Aktivitas Per Tamu");
            XLSX.writeFile(wb, `Aktivitas_Per_Tamu_${slug}_${new Date().toISOString().slice(0, 10)}.xlsx`);
            window.showToast({ type: 'success', message: 'Data aktivitas per tamu berhasil diekspor.' });
          }
        });
      }



      // ==========================================
      // --- INTERACTIVE ANALYTICS GRAPH ENGINE ---
      // ==========================================
      const rawActivitiesJson = document.getElementById('analytics-activities-json')?.textContent;
      const chartRawData = rawActivitiesJson ? JSON.parse(rawActivitiesJson) : [];

      const graphMetricSelect = document.getElementById('graphMetricFilter');
      const graphTimeTabs = document.querySelectorAll('.graph-time-tab');
      const graphTypeBtns = document.querySelectorAll('.graph-type-btn');

      const svgEl = document.getElementById('activityGraphSvg');
      const gridGroup = document.getElementById('graphGridGroup');
      const barsGroup = document.getElementById('graphBarsGroup');
      const areaGroup = document.getElementById('graphAreaGroup');
      const areaPath = document.getElementById('graphAreaPath');
      const linePath = document.getElementById('graphLinePath');
      const pointsGroup = document.getElementById('graphPointsGroup');
      const trackerGroup = document.getElementById('graphTrackerGroup');
      const trackerLine = document.getElementById('graphTrackerLine');
      const trackerCircle = document.getElementById('graphTrackerCircle');
      const xAxisEl = document.getElementById('graphXAxisLabels');
      const graphTooltip = document.getElementById('graphTooltip');
      const tooltipTitle = document.getElementById('graphTooltipTitle');
      const tooltipVal = document.getElementById('graphTooltipVal');
      const tooltipSub = document.getElementById('graphTooltipSub');
      const graphContainer = document.getElementById('graphCanvasContainer');

      const kpiTotal = document.getElementById('graphKpiTotal');
      const kpiPeak = document.getElementById('graphKpiPeak');
      const kpiAvg = document.getElementById('graphKpiAvg');
      const kpiGuests = document.getElementById('graphKpiGuests');

      let currentGraphRange = '24h'; // '24h' | '7d' | '30d' | 'all'
      let currentGraphMetric = 'all'; // 'all' | 'views' | 'cover' | 'interaction' | 'guests' | 'vendor'
      let currentGraphType = 'area'; // 'area' | 'bar'

      const monthNamesIndo = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

      function getWitaDate(dateObj) {
        return new Date(dateObj.getTime() + 8 * 3600000);
      }

      function renderInteractiveChart() {
        if (!svgEl) return;

        // 1. Filter raw activities by metric
        const filteredData = chartRawData.filter(item => {
          if (currentGraphMetric === 'views') return item.e === 'page_view';
          if (currentGraphMetric === 'cover') return item.e === 'open_cover';
          if (currentGraphMetric === 'interaction') return item.c === 'interaksi' && item.e !== 'page_view';
          if (currentGraphMetric === 'guests') return item.g === true;
          if (currentGraphMetric === 'vendor') return item.c === 'vendor';
          return true;
        });

        // 2. Build time buckets
        let buckets = [];
        const now = new Date();
        const nowWita = getWitaDate(now);

        if (currentGraphRange === '24h') {
          // 24 hours buckets (00:00 to 23:00 WITA)
          for (let h = 0; h < 24; h++) {
            const hStr = h.toString().padStart(2, '0');
            buckets.push({
              key: h,
              label: `${hStr}:00`,
              fullLabel: `Pukul ${hStr}:00 - ${hStr}:59 WITA`,
              count: 0,
              guestNames: new Set()
            });
          }

          filteredData.forEach(item => {
            if (!item.t) return;
            const d = getWitaDate(new Date(item.t));
            const h = d.getUTCHours();
            if (buckets[h]) {
              buckets[h].count++;
              if (item.n) buckets[h].guestNames.add(item.n);
            }
          });
        } else if (currentGraphRange === '7d' || currentGraphRange === '30d') {
          const daysCount = currentGraphRange === '7d' ? 7 : 30;
          const dayMap = new Map();

          for (let i = daysCount - 1; i >= 0; i--) {
            const d = new Date(nowWita);
            d.setUTCDate(d.getUTCDate() - i);
            const dateKey = d.toISOString().slice(0, 10);
            const dateNum = d.getUTCDate();
            const monthStr = monthNamesIndo[d.getUTCMonth()];
            const dayLabel = currentGraphRange === '7d' ? `${dateNum} ${monthStr}` : `${dateNum.toString().padStart(2, '0')}`;
            const fullLabel = `${dateNum} ${monthStr} ${d.getUTCFullYear()}`;

            const bucketObj = {
              key: dateKey,
              label: dayLabel,
              fullLabel,
              count: 0,
              guestNames: new Set()
            };
            buckets.push(bucketObj);
            dayMap.set(dateKey, bucketObj);
          }

          filteredData.forEach(item => {
            if (!item.t) return;
            const d = getWitaDate(new Date(item.t));
            const dateKey = d.toISOString().slice(0, 10);
            if (dayMap.has(dateKey)) {
              const b = dayMap.get(dateKey);
              b.count++;
              if (item.n) b.guestNames.add(item.n);
            }
          });
        } else {
          // 'all' time: Group by days or months
          if (filteredData.length === 0) {
            buckets = [{ key: 'all', label: 'Hari ini', fullLabel: 'Hari ini', count: 0, guestNames: new Set() }];
          } else {
            const timestamps = filteredData.map(a => new Date(a.t).getTime()).filter(Boolean);
            const minTime = Math.min(...timestamps);
            const maxTime = Math.max(...timestamps);
            const dayDiff = Math.max(1, Math.ceil((maxTime - minTime) / (1000 * 3600 * 24)));

            const dayMap = new Map();
            for (let i = dayDiff; i >= 0; i--) {
              const d = new Date(nowWita);
              d.setUTCDate(d.getUTCDate() - i);
              const dateKey = d.toISOString().slice(0, 10);
              const dateNum = d.getUTCDate();
              const monthStr = monthNamesIndo[d.getUTCMonth()];

              const bucketObj = {
                key: dateKey,
                label: `${dateNum} ${monthStr}`,
                fullLabel: `${dateNum} ${monthStr} ${d.getUTCFullYear()}`,
                count: 0,
                guestNames: new Set()
              };
              buckets.push(bucketObj);
              dayMap.set(dateKey, bucketObj);
            }

            filteredData.forEach(item => {
              if (!item.t) return;
              const d = getWitaDate(new Date(item.t));
              const dateKey = d.toISOString().slice(0, 10);
              if (dayMap.has(dateKey)) {
                const b = dayMap.get(dateKey);
                b.count++;
                if (item.n) b.guestNames.add(item.n);
              }
            });

            if (buckets.length > 30) {
              const step = Math.ceil(buckets.length / 30);
              const sampled = [];
              for (let i = 0; i < buckets.length; i += step) {
                const slice = buckets.slice(i, i + step);
                const totalC = slice.reduce((sum, b) => sum + b.count, 0);
                const allG = new Set();
                slice.forEach(b => b.guestNames.forEach(n => allG.add(n)));
                sampled.push({
                  key: slice[0].key,
                  label: slice[0].label,
                  fullLabel: `${slice[0].fullLabel} - ${slice[slice.length - 1].fullLabel}`,
                  count: totalC,
                  guestNames: allG
                });
              }
              buckets = sampled;
            }
          }
        }

        // 3. Compute KPIs
        const totalCount = buckets.reduce((sum, b) => sum + b.count, 0);
        let maxCount = 0;
        let peakBucket = null;
        const allUniqueGuests = new Set();

        buckets.forEach(b => {
          if (b.count > maxCount) {
            maxCount = b.count;
            peakBucket = b;
          }
          b.guestNames.forEach(n => allUniqueGuests.add(n));
        });

        const avgCount = buckets.length > 0 ? (totalCount / buckets.length).toFixed(1) : '0';

        if (kpiTotal) kpiTotal.textContent = `${totalCount} aksi`;
        if (kpiPeak) {
          kpiPeak.textContent = maxCount > 0 && peakBucket ? `${maxCount} aksi (${peakBucket.label})` : '-';
        }
        if (kpiAvg) kpiAvg.textContent = `${avgCount} / titik`;
        if (kpiGuests) kpiGuests.textContent = `${allUniqueGuests.size} tamu`;

        // 4. Render Grid & Scales
        const svgW = 800;
        const svgH = 220;
        const padTop = 25;
        const padBottom = 30;
        const padLeft = 45;
        const padRight = 20;
        const chartW = svgW - padLeft - padRight;
        const chartH = svgH - padTop - padBottom;

        const maxScale = Math.max(4, Math.ceil(maxCount * 1.15));

        // Draw horizontal gridlines (4 levels: 0, 33%, 66%, 100%)
        let gridHtml = '';
        for (let i = 0; i <= 3; i++) {
          const val = Math.round((maxScale / 3) * i);
          const y = padTop + chartH - (i / 3) * chartH;
          gridHtml += `
            <line x1="${padLeft}" y1="${y}" x2="${svgW - padRight}" y2="${y}" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="3,3" />
            <text x="${padLeft - 8}" y="${y + 4}" fill="#94a3b8" font-size="10" font-weight="600" text-anchor="end">${val}</text>
          `;
        }
        if (gridGroup) gridGroup.innerHTML = gridHtml;

        // 5. Render Chart Type (Area vs Bar in SVG)
        if (currentGraphType === 'area') {
          if (areaGroup) areaGroup.style.display = 'block';
          if (barsGroup) barsGroup.style.display = 'none';

          const points = buckets.map((b, idx) => {
            const x = padLeft + (buckets.length === 1 ? chartW / 2 : (idx / Math.max(1, buckets.length - 1)) * chartW);
            const y = padTop + chartH - (b.count / maxScale) * chartH;
            return { x, y, bucket: b, idx };
          });

          function createCurve(pts) {
            if (!pts.length) return '';
            if (pts.length === 1) return `M ${pts[0].x} ${pts[0].y}`;
            let path = `M ${pts[0].x} ${pts[0].y}`;
            for (let i = 0; i < pts.length - 1; i++) {
              const p0 = pts[i];
              const p1 = pts[i + 1];
              const mx = (p0.x + p1.x) / 2;
              path += ` C ${mx} ${p0.y}, ${mx} ${p1.y}, ${p1.x} ${p1.y}`;
            }
            return path;
          }

          const lineD = createCurve(points);
          const baselineY = padTop + chartH;
          const areaD = points.length > 0
            ? `${lineD} L ${points[points.length - 1].x} ${baselineY} L ${points[0].x} ${baselineY} Z`
            : '';

          if (linePath) linePath.setAttribute('d', lineD);
          if (areaPath) areaPath.setAttribute('d', areaD);

          let ptsHtml = '';
          points.forEach((p) => {
            const isPeak = p.bucket.count === maxCount && maxCount > 0;
            ptsHtml += `
              <circle cx="${p.x}" cy="${p.y}" r="${isPeak ? 5.5 : 4}" class="graph-point-circle ${isPeak ? 'graph-point-circle--peak' : ''}" fill="#ffffff" stroke="var(--color-primary, #a68966)" stroke-width="${isPeak ? 2.5 : 2}" />
            `;
          });
          if (pointsGroup) pointsGroup.innerHTML = ptsHtml;
        } else {
          // Bar Chart rendering inside SVG
          if (areaGroup) areaGroup.style.display = 'none';
          if (barsGroup) {
            barsGroup.style.display = 'block';
            let barsHtml = '';
            const colW = chartW / Math.max(1, buckets.length);
            const barWidth = Math.max(6, Math.min(32, colW * 0.65));

            buckets.forEach((b, idx) => {
              const cx = padLeft + (idx + 0.5) * colW;
              const barH = (b.count / maxScale) * chartH;
              const barY = (padTop + chartH) - barH;
              const isPeak = b.count === maxCount && maxCount > 0;
              const barColor = isPeak ? '#a68966' : '#cbd5e1';

              barsHtml += `
                <g class="graph-svg-bar-col" data-idx="${idx}" style="cursor: pointer;">
                  <rect x="${cx - barWidth / 2}" y="${padTop}" width="${barWidth}" height="${chartH}" rx="3" fill="#f8fafc" class="graph-svg-bar-track" />
                  <rect x="${cx - barWidth / 2}" y="${barY}" width="${barWidth}" height="${Math.max(3, barH)}" rx="3" fill="${barColor}" class="graph-svg-bar ${isPeak ? 'graph-svg-bar--peak' : ''}" />
                </g>
              `;
            });
            barsGroup.innerHTML = barsHtml;
          }
        }

        // 6. Render X-Axis Labels
        if (xAxisEl) {
          let xHtml = '';
          const totalB = buckets.length;
          const labelInterval = totalB <= 8 ? 1 : totalB <= 15 ? 2 : totalB <= 24 ? 4 : 5;

          buckets.forEach((b, idx) => {
            const isVisible = idx % labelInterval === 0 || idx === totalB - 1;
            xHtml += `
              <div class="graph-xaxis__item ${isVisible ? 'graph-xaxis__item--visible' : ''}">
                ${isVisible ? b.label : ''}
              </div>
            `;
          });
          xAxisEl.innerHTML = xHtml;
        }

        // 7. Unified 0ms-Lag Mouse & Touch Tracking
        if (!graphContainer) return;

        function showTooltipAtBucket(idx) {
          const b = buckets[idx];
          if (!b || !graphTooltip || !graphContainer) return;

          if (tooltipTitle) tooltipTitle.textContent = b.fullLabel;
          if (tooltipVal) tooltipVal.textContent = `${b.count} Aktivitas`;
          if (tooltipSub) {
            const pct = totalCount > 0 ? Math.round((b.count / totalCount) * 100) : 0;
            const guestsText = b.guestNames.size > 0 ? ` • ${b.guestNames.size} tamu terdeteksi` : '';
            tooltipSub.textContent = `${pct}% dari total periode${guestsText}`;
          }

          const containerRect = graphContainer.getBoundingClientRect();
          let ptX = 0;
          let ptY = 0;

          if (currentGraphType === 'area') {
            ptX = padLeft + (buckets.length === 1 ? chartW / 2 : (idx / Math.max(1, buckets.length - 1)) * chartW);
            ptY = padTop + chartH - (b.count / maxScale) * chartH;
          } else {
            const colW = chartW / Math.max(1, buckets.length);
            ptX = padLeft + (idx + 0.5) * colW;
            const barH = (b.count / maxScale) * chartH;
            ptY = (padTop + chartH) - barH;

            // Highlight active bar and restore others
            const allBars = svgEl.querySelectorAll('.graph-svg-bar');
            allBars.forEach((bar, bIdx) => {
              if (bIdx === idx) {
                bar.classList.add('graph-svg-bar--active');
                bar.setAttribute('fill', '#a68966');
              } else {
                bar.classList.remove('graph-svg-bar--active');
                const isPeak = buckets[bIdx]?.count === maxCount && maxCount > 0;
                bar.setAttribute('fill', isPeak ? '#a68966' : '#cbd5e1');
              }
            });
          }

          // Move Guide Line & Active Circle Indicator
          if (trackerLine) {
            trackerLine.setAttribute('x1', ptX);
            trackerLine.setAttribute('x2', ptX);
            trackerLine.setAttribute('y1', padTop);
            trackerLine.setAttribute('y2', padTop + chartH);
          }
          if (trackerCircle) {
            trackerCircle.setAttribute('cx', ptX);
            trackerCircle.setAttribute('cy', ptY);
          }
          if (trackerGroup) trackerGroup.style.display = 'block';

          // Position Tooltip Floating Above Point
          const pixelX = (ptX / 800) * containerRect.width;
          const pixelY = (ptY / 220) * containerRect.height;

          const clampedX = Math.max(85, Math.min(containerRect.width - 85, pixelX));
          const clampedY = Math.max(8, pixelY - 12);

          graphTooltip.style.left = `${clampedX}px`;
          graphTooltip.style.top = `${clampedY}px`;
          graphTooltip.style.display = 'block';
          graphTooltip.style.opacity = '1';
        }

        function hideTooltip() {
          if (graphTooltip) {
            graphTooltip.style.opacity = '0';
            graphTooltip.style.display = 'none';
          }
          if (trackerGroup) trackerGroup.style.display = 'none';
          if (svgEl) {
            svgEl.querySelectorAll('.graph-svg-bar').forEach((bar, bIdx) => {
              bar.classList.remove('graph-svg-bar--active');
              const isPeak = buckets[bIdx]?.count === maxCount && maxCount > 0;
              bar.setAttribute('fill', isPeak ? '#a68966' : '#cbd5e1');
            });
          }
        }

        function handlePointer(e) {
          if (!buckets.length || !graphContainer) return;
          const containerRect = graphContainer.getBoundingClientRect();
          const clientX = e.touches && e.touches.length > 0 ? e.touches[0].clientX : e.clientX;
          const relX = clientX - containerRect.left;

          const padLeftPx = (padLeft / 800) * containerRect.width;
          const chartWPx = (chartW / 800) * containerRect.width;

          let idx = 0;
          if (currentGraphType === 'area') {
            const ratio = (relX - padLeftPx) / Math.max(1, chartWPx);
            idx = Math.max(0, Math.min(buckets.length - 1, Math.round(ratio * Math.max(1, buckets.length - 1))));
          } else {
            const colWidthPx = chartWPx / Math.max(1, buckets.length);
            idx = Math.max(0, Math.min(buckets.length - 1, Math.floor((relX - padLeftPx) / colWidthPx)));
          }

          showTooltipAtBucket(idx);
        }

        // Attach directly for 100% continuous coverage without dead zones
        graphContainer.onmousemove = handlePointer;
        graphContainer.onmouseenter = handlePointer;
        graphContainer.onmouseleave = hideTooltip;
        graphContainer.ontouchstart = handlePointer;
        graphContainer.ontouchmove = handlePointer;
        graphContainer.ontouchend = hideTooltip;
      }

      // Graph Controls Listeners
      if (graphMetricSelect) {
        graphMetricSelect.addEventListener('change', () => {
          currentGraphMetric = graphMetricSelect.value;
          renderInteractiveChart();
        });
      }

      graphTimeTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          graphTimeTabs.forEach(t => t.classList.remove('graph-time-tab--active'));
          tab.classList.add('graph-time-tab--active');
          currentGraphRange = tab.getAttribute('data-range') || '24h';
          renderInteractiveChart();
        });
      });

      graphTypeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          graphTypeBtns.forEach(b => b.classList.remove('graph-type-btn--active'));
          btn.classList.add('graph-type-btn--active');
          currentGraphType = btn.getAttribute('data-type') || 'area';
          renderInteractiveChart();
        });
      });

      // Initial Graph Render
      renderInteractiveChart();

      // Resize listener for responsive pagination button count and graph redraw
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          updatePagination();
          renderInteractiveChart();
        }, 150);
      });

      // Initial filter & pagination render
      applyFilters();
    });
  </script>
</ClientLayout>

