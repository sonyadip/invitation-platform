  <script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>


  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const pageRoot = document.getElementById('activityPageRoot');
      const slug = pageRoot?.dataset.slug || window.location.pathname.split('/')[2];
      const originUrl = pageRoot?.dataset.origin || window.location.origin;

      // Elements
      const searchInput = document.getElementById('activitySearch');
      const clearSearchBtn = document.getElementById('clearSearchBtn');
      const timeRangeSelect = document.getElementById('timeRangeFilter');
      const eventSelect = document.getElementById('eventFilter');
      const exportBtn = document.getElementById('activityExport');
      const refreshBtn = document.getElementById('refreshActivityBtn');
      const tagButtons = document.querySelectorAll('.activity-tag');
      const tagRow = document.getElementById('activityTagsRow');
      const filterIndicator = document.getElementById('filterIndicator');
      const filterIndicatorText = document.getElementById('filterIndicatorText');
      const resetFiltersBtn = document.getElementById('resetFiltersBtn');

      const viewModeTimelineBtn = document.getElementById('viewModeTimeline');
      const viewModeGuestsBtn = document.getElementById('viewModeGuests');
      const activityList = document.getElementById('activityList');
      const guestJourneyList = document.getElementById('guestJourneyList');
      const eventFilterWrapper = document.getElementById('eventFilterWrapper');

      const prevBtn = document.getElementById('actPrev');
      const nextBtn = document.getElementById('actNext');
      const pageNumbers = document.getElementById('actPageNumbers');

      let viewMode = 'timeline'; // 'timeline' | 'guests'
      let currentTimelinePage = 1;
      let currentGuestsPage = 1;
      let totalTimelinePages = 1;
      let totalGuestsPages = 1;
      let activeTag = 'all';
      let searchQuery = '';
      let searchTimeout = null;

      const daysArr = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
      const monthsArr = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function timeAgo(dateStr) {
        if (!dateStr) return '';
        const diff = Date.now() - new Date(dateStr).getTime();
        const mins = Math.floor(diff / 60000);
        if (mins < 1) return 'Baru saja';
        if (mins < 60) return mins + ' mnt lalu';
        const hrs = Math.floor(mins / 60);
        if (hrs < 24) return hrs + ' jam lalu';
        const days = Math.floor(hrs / 24);
        if (days === 1) return 'Kemarin';
        if (days < 7) return days + ' hari lalu';
        const d = new Date(new Date(dateStr).getTime() + 8 * 3600000);
        return d.getUTCDate() + ' ' + monthsArr[d.getUTCMonth()];
      }

      function formatFullDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(new Date(dateStr).getTime() + 8 * 3600000);
        const dayName = daysArr[d.getUTCDay()];
        const date = d.getUTCDate();
        const monthName = monthsArr[d.getUTCMonth()];
        const year = d.getUTCFullYear();
        const hour = String(d.getUTCHours()).padStart(2, '0');
        const minute = String(d.getUTCMinutes()).padStart(2, '0');
        return dayName + ', ' + date + ' ' + monthName + ' ' + year + ' ' + hour + '.' + minute + ' WITA';
      }

      function getDeviceIcon(deviceType) {
        const dt = (deviceType || '').toLowerCase();
        if (dt === 'desktop') return 'computer';
        if (dt === 'tablet') return 'tablet_android';
        return 'smartphone';
      }

      function scrollToTopSection() {
        const cardEl = document.getElementById('activityListCard') || activityList;
        if (cardEl) {
          const navbarHeight = 85;
          const targetY = cardEl.getBoundingClientRect().top + window.pageYOffset - navbarHeight;
          window.scrollTo({
            top: Math.max(0, targetY),
            behavior: 'smooth'
          });
        }
      }

      // 1. Fetch & Populate Analytics Summary
      async function fetchSummary() {
        try {
          const res = await fetch(`/api/analytics/summary?slug=${slug}`);
          if (!res.ok) throw new Error('Failed to fetch summary');
          const data = await res.json();

          // 4 Stat Cards
          const statViews = document.getElementById('statTotalViews');
          const statInteractions = document.getElementById('statTotalInteractions');
          const statIdentified = document.getElementById('statTotalIdentified');
          const statVendor = document.getElementById('statVendorLeads');

          if (statViews) statViews.textContent = Number(data.totalViews || 0).toLocaleString('id-ID');
          if (statInteractions) statInteractions.textContent = Number(data.totalEvents || 0).toLocaleString('id-ID');
          if (statIdentified) statIdentified.textContent = Number(data.totalIdentifiedGuests || 0).toLocaleString('id-ID');
          if (statVendor) statVendor.textContent = Number(data.interactionStats?.vendorLeads || 0).toLocaleString('id-ID');

          // Conversion Funnel
          const fCoverVal = document.getElementById('funnelCoverVal');
          const fCoverBar = document.getElementById('funnelCoverBar');
          const fCoverDesc = document.getElementById('funnelCoverDesc');
          const fRsvpVal = document.getElementById('funnelRsvpVal');
          const fRsvpBar = document.getElementById('funnelRsvpBar');
          const fRsvpDesc = document.getElementById('funnelRsvpDesc');
          const fEngageVal = document.getElementById('funnelEngageVal');
          const fEngageBar = document.getElementById('funnelEngageBar');
          const fEngageDesc = document.getElementById('funnelEngageDesc');
          const fWaItem = document.getElementById('funnelWaItem');
          const fWaVal = document.getElementById('funnelWaVal');
          const fWaBar = document.getElementById('funnelWaBar');
          const fWaDesc = document.getElementById('funnelWaDesc');

          if (fCoverVal) fCoverVal.textContent = (data.funnel?.coverOpenRate || 0) + '%';
          if (fCoverBar) fCoverBar.style.width = (data.funnel?.coverOpenRate || 0) + '%';
          if (fCoverDesc) fCoverDesc.textContent = (data.interactionStats?.openCover || 0) + ' dari ' + (data.totalViews || 0) + ' pengunjung buka amplop';

          if (fRsvpVal) fRsvpVal.textContent = (data.funnel?.rsvpRate || 0) + '%';
          if (fRsvpBar) fRsvpBar.style.width = (data.funnel?.rsvpRate || 0) + '%';
          if (fRsvpDesc) fRsvpDesc.textContent = (data.rsvpStats?.totalRsvp || 0) + ' tamu telah mengisi RSVP';

          if (fEngageVal) fEngageVal.textContent = (data.funnel?.engagementRate || 0) + '%';
          if (fEngageBar) fEngageBar.style.width = Math.min(100, (data.funnel?.engagementRate || 0)) + '%';
          if (fEngageDesc) {
            const avg = data.totalViews > 0 ? (data.totalEvents / data.totalViews).toFixed(1) : 0;
            fEngageDesc.textContent = 'Rata-rata ' + avg + ' aksi per pengunjung';
          }

          if (data.funnel?.totalSent > 0 && fWaItem) {
            fWaItem.style.display = 'flex';
            if (fWaVal) fWaVal.textContent = (data.funnel?.openRate || 0) + '%';
            if (fWaBar) fWaBar.style.width = (data.funnel?.openRate || 0) + '%';
            if (fWaDesc) fWaDesc.textContent = (data.funnel?.totalOpenedSent || 0) + ' dari ' + data.funnel.totalSent + ' tamu WA telah membuka';
          }

          // 12 Breakdown Cards
          const statsMap = {
            cardStatCover: data.interactionStats?.openCover,
            cardStatMaps: data.interactionStats?.clickMaps,
            cardStatCalendar: data.interactionStats?.clickCalendar,
            cardStatGift: data.interactionStats?.copyGift,
            cardStatMusic: data.interactionStats?.playMusic,
            cardStatVideo: data.interactionStats?.playVideo,
            cardStatGallery: data.interactionStats?.viewGallery,
            cardStatRsvp: data.interactionStats?.clickRsvp,
            cardStatCoupleIg: data.interactionStats?.clickCoupleInstagram,
            cardStatVendorWa: data.interactionStats?.clickVendorWhatsApp,
            cardStatVendorIg: data.interactionStats?.clickVendorInstagram,
            cardStatVendorSite: data.interactionStats?.clickVendorSite
          };

          for (const [id, val] of Object.entries(statsMap)) {
            const el = document.getElementById(id);
            if (el) el.textContent = val !== undefined ? val : 0;
          }

          // Device Breakdown Bars & Legend
          const bDevMobile = document.getElementById('barDeviceMobile');
          const bDevDesktop = document.getElementById('barDeviceDesktop');
          const bDevTablet = document.getElementById('barDeviceTablet');
          const lDevMobile = document.getElementById('lblDeviceMobile');
          const lDevDesktop = document.getElementById('lblDeviceDesktop');
          const lDevTablet = document.getElementById('lblDeviceTablet');

          if (bDevMobile) bDevMobile.style.width = (data.deviceStats?.mobilePercent || 0) + '%';
          if (bDevDesktop) bDevDesktop.style.width = (data.deviceStats?.desktopPercent || 0) + '%';
          if (bDevTablet) bDevTablet.style.width = (data.deviceStats?.tabletPercent || 0) + '%';

          if (lDevMobile) lDevMobile.textContent = (data.deviceStats?.mobilePercent || 0) + '% (' + (data.deviceStats?.mobile || 0) + ')';
          if (lDevDesktop) lDevDesktop.textContent = (data.deviceStats?.desktopPercent || 0) + '% (' + (data.deviceStats?.desktop || 0) + ')';
          if (lDevTablet) lDevTablet.textContent = (data.deviceStats?.tabletPercent || 0) + '% (' + (data.deviceStats?.tablet || 0) + ')';

          // Browser Breakdown Tags
          const browserList = document.getElementById('browserTagList');
          if (browserList && data.browserStats && data.browserStats.length > 0) {
            browserList.innerHTML = data.browserStats.slice(0, 8).map(b => `
              <span class="browser-tag">
                ${escapeHtml(b.browser)} <span class="browser-tag__count">${b.count}</span>
              </span>
            `).join('');
          }

          // Quick Filter Tag Counts
          const tAll = document.getElementById('tagAllCount');
          const tIdentified = document.getElementById('tagIdentifiedCount');
          const tInteraksi = document.getElementById('tagInteraksiCount');
          const tRsvp = document.getElementById('tagRsvpCount');
          const tVendor = document.getElementById('tagVendorCount');
          const tKunjungan = document.getElementById('tagKunjunganCount');

          if (tAll) tAll.textContent = '(' + (data.totalActivities || 0) + ')';
          if (tIdentified) tIdentified.textContent = '(' + (data.totalIdentifiedGuests || 0) + ')';
          if (tInteraksi) tInteraksi.textContent = '(' + (data.totalEvents || 0) + ')';
          if (tRsvp) tRsvp.textContent = '(' + (data.rsvpStats?.totalRsvp || 0) + ')';
          if (tVendor) tVendor.textContent = '(' + (data.interactionStats?.vendorLeads || 0) + ')';
          if (tKunjungan) tKunjungan.textContent = '(' + (data.totalViews || 0) + ')';

          // View Switcher Badges
          const bTimeline = document.getElementById('badgeTotalTimeline');
          const bGuests = document.getElementById('badgeTotalGuests');
          if (bTimeline) bTimeline.textContent = data.totalActivities || 0;
          if (bGuests) bGuests.textContent = data.totalIdentifiedGuests || 0;

          // Render Interactive SVG Chart
          if (data.chartRawData) {
            initInteractiveChartEngine(data.chartRawData);
          }
        } catch (err) {
          console.error('Error fetching analytics summary:', err);
        }
      }

      // 2. Interactive SVG Activity Chart Engine (Identical to original)
      function initInteractiveChartEngine(rawActivities) {
        const svg = document.getElementById('activityGraphSvg');
        if (!svg) return;

        const gridGroup = document.getElementById('graphGridGroup');
        const barsGroup = document.getElementById('graphBarsGroup');
        const areaGroup = document.getElementById('graphAreaGroup');
        const areaPath = document.getElementById('graphAreaPath');
        const linePath = document.getElementById('graphLinePath');
        const pointsGroup = document.getElementById('graphPointsGroup');
        const trackerGroup = document.getElementById('graphTrackerGroup');
        const trackerLine = document.getElementById('graphTrackerLine');
        const trackerCircle = document.getElementById('graphTrackerCircle');
        const xAxisLabels = document.getElementById('graphXAxisLabels');
        const tooltip = document.getElementById('graphTooltip');
        const tooltipTitle = document.getElementById('graphTooltipTitle');
        const tooltipVal = document.getElementById('graphTooltipVal');
        const tooltipSub = document.getElementById('graphTooltipSub');

        const kpiTotal = document.getElementById('graphKpiTotal');
        const kpiPeak = document.getElementById('graphKpiPeak');
        const kpiAvg = document.getElementById('graphKpiAvg');
        const kpiGuests = document.getElementById('graphKpiGuests');

        const metricSelect = document.getElementById('graphMetricFilter');
        const timeTabs = document.querySelectorAll('.graph-time-tab');
        const typeButtons = document.querySelectorAll('.graph-type-btn');

        let currentMetric = 'all';
        let currentRange = '24h';
        let currentType = 'area';

        function filterActivitiesByMetric(item) {
          if (currentMetric === 'all') return true;
          if (currentMetric === 'views') return item.e === 'page_view';
          if (currentMetric === 'cover') return item.e === 'open_cover';
          if (currentMetric === 'interaction') return item.c === 'interaksi';
          if (currentMetric === 'guests') return item.g === true;
          if (currentMetric === 'vendor') return item.c === 'vendor';
          return true;
        }

        function buildBuckets() {
          const now = new Date();
          let filtered = rawActivities.filter(filterActivitiesByMetric);
          let buckets = [];

          if (currentRange === '24h') {
            const nowTime = now.getTime();
            const oneHour = 3600000;
            for (let i = 23; i >= 0; i--) {
              const bTime = new Date(nowTime - i * oneHour);
              const bHour = (bTime.getUTCHours() + 8) % 24;
              const bDateStr = bTime.toISOString().slice(0, 10);
              const label = String(bHour).padStart(2, '0') + ':00';
              buckets.push({
                key: bDateStr + '-' + bHour,
                label: label,
                fullLabel: label + ' WITA',
                count: 0,
                guests: new Set()
              });
            }

            filtered.forEach(item => {
              if (!item.t) return;
              const itemTime = new Date(item.t).getTime();
              if (nowTime - itemTime <= 24 * oneHour) {
                const d = new Date(item.t);
                const h = (d.getUTCHours() + 8) % 24;
                const dStr = d.toISOString().slice(0, 10);
                const k = dStr + '-' + h;
                const b = buckets.find(x => x.key === k);
                if (b) {
                  b.count++;
                  if (item.n) b.guests.add(item.n.toLowerCase());
                }
              }
            });
          } else if (currentRange === '7d' || currentRange === '30d') {
            const daysCount = currentRange === '7d' ? 7 : 30;
            const oneDay = 86400000;
            for (let i = daysCount - 1; i >= 0; i--) {
              const bTime = new Date(now.getTime() - i * oneDay);
              const dStr = bTime.toISOString().slice(0, 10);
              const dayNum = bTime.getUTCDate();
              const monthName = monthsArr[bTime.getUTCMonth()];
              const label = dayNum + ' ' + monthName;
              buckets.push({
                key: dStr,
                label: label,
                fullLabel: label + ' ' + bTime.getUTCFullYear(),
                count: 0,
                guests: new Set()
              });
            }

            filtered.forEach(item => {
              if (!item.t) return;
              const dStr = item.t.slice(0, 10);
              const b = buckets.find(x => x.key === dStr);
              if (b) {
                b.count++;
                if (item.n) b.guests.add(item.n.toLowerCase());
              }
            });
          } else {
            const dateMap = new Map();
            filtered.forEach(item => {
              if (!item.t) return;
              const dStr = item.t.slice(0, 10);
              if (!dateMap.has(dStr)) {
                dateMap.set(dStr, { count: 0, guests: new Set() });
              }
              const d = dateMap.get(dStr);
              d.count++;
              if (item.n) d.guests.add(item.n.toLowerCase());
            });

            const sortedDates = Array.from(dateMap.keys()).sort();
            if (sortedDates.length === 0) {
              const dStr = now.toISOString().slice(0, 10);
              buckets.push({
                key: dStr,
                label: now.getUTCDate() + ' ' + monthsArr[now.getUTCMonth()],
                fullLabel: now.getUTCDate() + ' ' + monthsArr[now.getUTCMonth()] + ' ' + now.getUTCFullYear(),
                count: 0,
                guests: new Set()
              });
            } else {
              sortedDates.forEach(dStr => {
                const dt = new Date(dStr);
                const label = dt.getUTCDate() + ' ' + monthsArr[dt.getUTCMonth()];
                const dData = dateMap.get(dStr);
                buckets.push({
                  key: dStr,
                  label: label,
                  fullLabel: label + ' ' + dt.getUTCFullYear(),
                  count: dData.count,
                  guests: dData.guests
                });
              });
            }
          }

          return buckets;
        }

        function renderChart() {
          const buckets = buildBuckets();
          const totalCount = buckets.reduce((acc, b) => acc + b.count, 0);
          const maxCount = Math.max(...buckets.map(b => b.count), 1);
          const allGuestsSet = new Set();
          buckets.forEach(b => b.guests.forEach(g => allGuestsSet.add(g)));

          if (kpiTotal) kpiTotal.textContent = totalCount.toLocaleString('id-ID');
          if (kpiGuests) kpiGuests.textContent = allGuestsSet.size.toLocaleString('id-ID');
          if (kpiAvg) {
            const avg = buckets.length > 0 ? (totalCount / buckets.length).toFixed(1) : 0;
            kpiAvg.textContent = avg;
          }
          if (kpiPeak) {
            const peakB = buckets.reduce((max, b) => (b.count > (max?.count || 0) ? b : max), null);
            kpiPeak.textContent = peakB && peakB.count > 0 ? peakB.count + ' (' + peakB.label + ')' : '-';
          }

          // SVG Viewport Coordinates
          const W = 800;
          const H = 220;
          const padL = 30;
          const padR = 30;
          const padT = 25;
          const padB = 30;
          const plotW = W - padL - padR;
          const plotH = H - padT - padB;

          // Render Grid Lines
          let gridHtml = '';
          const gridSteps = 4;
          for (let i = 0; i <= gridSteps; i++) {
            const y = padT + (plotH / gridSteps) * i;
            gridHtml += `<line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="rgba(226, 232, 240, 0.6)" stroke-width="1" stroke-dasharray="2,2" />`;
          }
          if (gridGroup) gridGroup.innerHTML = gridHtml;

          // Compute Points
          const n = buckets.length;
          const pts = buckets.map((b, i) => {
            const x = n > 1 ? padL + (i / (n - 1)) * plotW : padL + plotW / 2;
            const y = padT + plotH - (b.count / maxCount) * plotH;
            return { x, y, bucket: b };
          });

          // Render Area / Line Mode
          if (currentType === 'area') {
            if (barsGroup) barsGroup.style.display = 'none';
            if (areaGroup) areaGroup.style.display = 'block';

            let lineD = '';
            let areaD = '';

            if (pts.length > 0) {
              lineD = 'M ' + pts[0].x.toFixed(1) + ' ' + pts[0].y.toFixed(1);
              areaD = 'M ' + pts[0].x.toFixed(1) + ' ' + (padT + plotH) + ' L ' + pts[0].x.toFixed(1) + ' ' + pts[0].y.toFixed(1);

              for (let i = 1; i < pts.length; i++) {
                const prev = pts[i - 1];
                const curr = pts[i];
                const cx1 = prev.x + (curr.x - prev.x) / 2;
                const cy1 = prev.y;
                const cx2 = prev.x + (curr.x - prev.x) / 2;
                const cy2 = curr.y;
                lineD += ' C ' + cx1.toFixed(1) + ' ' + cy1.toFixed(1) + ', ' + cx2.toFixed(1) + ' ' + cy2.toFixed(1) + ', ' + curr.x.toFixed(1) + ' ' + curr.y.toFixed(1);
                areaD += ' C ' + cx1.toFixed(1) + ' ' + cy1.toFixed(1) + ', ' + cx2.toFixed(1) + ' ' + cy2.toFixed(1) + ', ' + curr.x.toFixed(1) + ' ' + curr.y.toFixed(1);
              }

              areaD += ' L ' + pts[pts.length - 1].x.toFixed(1) + ' ' + (padT + plotH) + ' Z';
            }

            if (linePath) linePath.setAttribute('d', lineD);
            if (areaPath) areaPath.setAttribute('d', areaD);

            let ptsHtml = '';
            pts.forEach((p, idx) => {
              if (p.bucket.count > 0 || pts.length <= 12) {
                ptsHtml += `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3" fill="#a68966" stroke="#ffffff" stroke-width="1.5" />`;
              }
            });
            if (pointsGroup) pointsGroup.innerHTML = ptsHtml;
          } else {
            // Bar Mode
            if (areaGroup) areaGroup.style.display = 'none';
            if (barsGroup) {
              barsGroup.style.display = 'block';
              const barWidth = Math.max(4, Math.min(28, (plotW / n) * 0.65));
              let barsHtml = '';
              pts.forEach((p, i) => {
                const bx = p.x - barWidth / 2;
                const by = p.y;
                const bh = padT + plotH - by;
                barsHtml += `
                  <rect
                    x="${bx.toFixed(1)}"
                    y="${by.toFixed(1)}"
                    width="${barWidth.toFixed(1)}"
                    height="${bh.toFixed(1)}"
                    rx="3"
                    fill="var(--color-primary, #a68966)"
                    opacity="0.85"
                  />
                `;
              });
              barsGroup.innerHTML = barsHtml;
            }
          }

          // X-Axis Labels
          if (xAxisLabels) {
            const step = Math.max(1, Math.ceil(n / 6));
            let labelsHtml = '';
            for (let i = 0; i < n; i += step) {
              const b = buckets[i];
              labelsHtml += `<span>${escapeHtml(b.label)}</span>`;
            }
            if ((n - 1) % step !== 0 && n > 1) {
              const bLast = buckets[n - 1];
              labelsHtml += `<span>${escapeHtml(bLast.label)}</span>`;
            }
            xAxisLabels.innerHTML = labelsHtml;
          }

          // Mousemove Hover Tooltip
          svg.onmousemove = (e) => {
            const rect = svg.getBoundingClientRect();
            const mouseX = ((e.clientX - rect.left) / rect.width) * W;

            let closest = pts[0];
            let minDiff = Infinity;
            pts.forEach(p => {
              const diff = Math.abs(p.x - mouseX);
              if (diff < minDiff) {
                minDiff = diff;
                closest = p;
              }
            });

            if (closest) {
              if (trackerGroup) {
                trackerGroup.style.display = 'block';
                if (trackerLine) {
                  trackerLine.setAttribute('x1', closest.x.toFixed(1));
                  trackerLine.setAttribute('x2', closest.x.toFixed(1));
                }
                if (trackerCircle) {
                  trackerCircle.setAttribute('cx', closest.x.toFixed(1));
                  trackerCircle.setAttribute('cy', closest.y.toFixed(1));
                }
              }

              if (tooltip) {
                tooltip.style.display = 'block';
                if (tooltipTitle) tooltipTitle.textContent = closest.bucket.fullLabel;
                if (tooltipVal) tooltipVal.textContent = closest.bucket.count + ' Aktivitas';
                if (tooltipSub) {
                  const gCount = closest.bucket.guests.size;
                  tooltipSub.textContent = gCount > 0 ? gCount + ' tamu teridentifikasi' : 'Tidak ada tamu bernama';
                }

                const clientX = e.clientX;
                const clientY = e.clientY;
                tooltip.style.left = Math.min(window.innerWidth - 180, Math.max(10, clientX - 80)) + 'px';
                tooltip.style.top = (clientY - 85) + 'px';
              }
            }
          };

          svg.onmouseleave = () => {
            if (trackerGroup) trackerGroup.style.display = 'none';
            if (tooltip) tooltip.style.display = 'none';
          };
        }

        // Listener: Metric Select
        if (metricSelect) {
          metricSelect.addEventListener('change', () => {
            currentMetric = metricSelect.value;
            renderChart();
          });
        }

        // Listener: Time Tabs
        timeTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            timeTabs.forEach(t => t.classList.remove('graph-time-tab--active'));
            tab.classList.add('graph-time-tab--active');
            currentRange = tab.getAttribute('data-range') || '24h';
            renderChart();
          });
        });

        // Listener: Chart Type Buttons
        typeButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            typeButtons.forEach(b => b.classList.remove('graph-type-btn--active'));
            btn.classList.add('graph-type-btn--active');
            currentType = btn.getAttribute('data-type') || 'area';
            renderChart();
          });
        });

        renderChart();
      }

