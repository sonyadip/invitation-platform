---
const { slug } = Astro.params;
const session = Astro.locals.session;

if (session?.role !== 'admin' && !(session?.role === 'client' && session?.slug === slug)) {
  return Astro.redirect('/?login=client');
}

import ClientLayout from "../../../layouts/ClientLayout.astro";
import { getSlugReportDetail } from "../../../services/dashboard-report";
import "../../../styles/dashboard-aktivitas.scss";

const report = await getSlugReportDetail(slug);
if (!report) {
  return Astro.redirect('/dashboard');
}

const wedding = report.wedding;
const settings = report.settings;

const totalViews = report.summary.viewCount || 0;
const totalSent = report.sentInvitations?.length || 0;
const totalOpenedSent = report.sentInvitations?.filter((s: any) => (s.openCount || 0) > 0 || s.openedAt).length || 0;
const openRate = totalSent > 0 ? Math.round((totalOpenedSent / totalSent) * 100) : null;

const stats = report.analytics?.interactionStats;
const showMapsStat = Boolean(wedding.mapsUrl || report.events?.some((e: any) => e.maps_url)) || (stats?.clickMaps || 0) > 0;
const showCalendarStat = Boolean(wedding.weddingDate || report.events?.length > 0) || (stats?.clickCalendar || 0) > 0;
const showGiftStat = Boolean(settings.giftEnabled && report.gifts?.length > 0) || (stats?.copyGift || 0) > 0;
const showMusicStat = Boolean(settings.musicEnabled && wedding.musicUrl) || (stats?.playMusic || 0) > 0;
const showVideoStat = Boolean(settings.videoEnabled && settings.assets?.heroVideo) || (stats?.playVideo || 0) > 0;
const showGalleryStat = Boolean(settings.galleryEnabled) || (stats?.viewGallery || 0) > 0;
const showRsvpStat = Boolean(settings.rsvpEnabled || report.rsvps?.length > 0) || (stats?.clickRsvp || 0) > 0;
const showCoupleIgStat = Boolean(
  settings.content?.groomInstagramUrl ||
  settings.content?.brideInstagramUrl ||
  settings.content?.instagramUrl ||
  wedding.groom_instagram ||
  wedding.bride_instagram
) || (stats?.clickCoupleInstagram || 0) > 0;
const hasParticipants = Boolean(
  (Array.isArray(settings?.content?.participants) && settings.content.participants.length > 0) ||
  wedding.template?.includes('metatah')
);
const showParticipantStat = hasParticipants || (stats?.clickParticipant || 0) > 0;

interface InteractionCardDef {
  filter: string;
  boxVariant: string;
  icon: string;
  label: string;
  title: string;
  valueId: string;
  wrapperId?: string;
  visible: boolean;
  hideViaStyle?: boolean;
}

const guestInteractionCards: InteractionCardDef[] = [
  { filter: 'open_cover', boxVariant: 'cover', icon: 'drafts', label: 'Buka Undangan', title: 'Klik untuk filter log Buka Undangan', valueId: 'cardStatCover', visible: true },
  { filter: 'click_maps', boxVariant: 'maps', icon: 'location_on', label: 'Petunjuk Maps', title: 'Klik untuk filter log Petunjuk Maps', valueId: 'cardStatMaps', visible: showMapsStat },
  { filter: 'click_calendar', boxVariant: 'calendar', icon: 'calendar_month', label: 'Simpan Kalender', title: 'Klik untuk filter log Simpan Kalender', valueId: 'cardStatCalendar', visible: showCalendarStat },
  { filter: 'copy_gift', boxVariant: 'gift', icon: 'content_copy', label: 'Salin Rekening', title: 'Klik untuk filter log Salin Rekening', valueId: 'cardStatGift', visible: showGiftStat },
  { filter: 'play_music', boxVariant: 'music', icon: 'music_note', label: 'Putar Musik', title: 'Klik untuk filter log Putar Musik', valueId: 'cardStatMusic', visible: showMusicStat },
  { filter: 'play_video', boxVariant: 'video', icon: 'play_circle', label: 'Putar Video', title: 'Klik untuk filter log Putar Video', valueId: 'cardStatVideo', visible: showVideoStat },
  { filter: 'view_gallery', boxVariant: 'gallery', icon: 'photo_library', label: 'Lihat Galeri', title: 'Klik untuk filter log Lihat Galeri', valueId: 'cardStatGallery', visible: showGalleryStat },
  { filter: 'click_rsvp', boxVariant: 'rsvp', icon: 'how_to_reg', label: 'Klik Form RSVP', title: 'Klik untuk filter log Klik Form RSVP', valueId: 'cardStatRsvp', visible: showRsvpStat },
  { filter: 'click_participant', boxVariant: 'participant', icon: 'person', label: 'Detail Peserta', title: 'Klik untuk filter log Detail Peserta', valueId: 'cardStatParticipant', wrapperId: 'cardParticipantWrapper', visible: showParticipantStat, hideViaStyle: true },
  { filter: 'click_couple_instagram', boxVariant: 'couple-ig', icon: 'photo_camera', label: 'Instagram Mempelai', title: 'Klik untuk filter log Membuka tautan profil Instagram mempelai', valueId: 'cardStatCoupleIg', wrapperId: 'cardCoupleIgWrapper', visible: showCoupleIgStat, hideViaStyle: true }
];

const vendorLeadCards: Omit<InteractionCardDef, 'visible' | 'wrapperId' | 'hideViaStyle'>[] = [
  { filter: 'click_vendor_whatsapp', boxVariant: 'wa', icon: 'chat', label: 'Pesan WhatsApp Senadda', title: 'Klik untuk filter log WhatsApp Senadda', valueId: 'cardStatVendorWa' },
  { filter: 'click_vendor_instagram', boxVariant: 'ig', icon: 'photo_camera', label: 'Instagram Senadda', title: 'Klik untuk filter log Instagram Senadda', valueId: 'cardStatVendorIg' },
  { filter: 'click_vendor_site', boxVariant: 'web', icon: 'language', label: 'Website Senadda', title: 'Klik untuk filter log Website Senadda', valueId: 'cardStatVendorSite' }
];

const weddingGifts = (report.gifts || []).map((g: any) => ({
  accountNumber: g.accountNumber || '',
  accountName: g.accountName || '',
  bankName: g.bankName || ''
}));

const originUrl = Astro.url.origin;
---

<ClientLayout title="Aktivitas Tamu">
  <div class="activity-page-layout" id="activityPageRoot" data-slug={slug} data-origin={originUrl} data-wedding-gifts={JSON.stringify(weddingGifts)}>
    <div class="activity-top fade-in-bottom animate-on-scroll">
      <div class="bento-card" style="width: 100%;">
        <div class="activity-card-header">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap;">
              <h3 class="bento-card__title" style="margin: 0;">Log Aktivitas & Interaksi Tamu</h3>
              <span class="admin-badge">Admin Only</span>
            </div>
            <p class="bento-card__subtitle" style="margin: 0; color: var(--color-outline); font-size: 13px;">
              Analisis mendalam interaksi undangan, konversi RSVP, leads pemilik jasa (Senadda), dan perangkat secara komprehensif.
            </p>
          </div>

          <button id="refreshActivityBtn" class="refresh-act-btn" title="Refresh data terbaru">
            <span class="material-symbols-outlined refresh-icon">refresh</span>
            <span class="refresh-text">Perbarui</span>
          </button>
        </div>

        <div class="stats-grid" style="margin-top: 16px;">
          <div class="stat-card">
            <div class="stat-card__icon" style="background: #f4f4f5; color: #111827;">
              <span class="material-symbols-outlined">visibility</span>
            </div>
            <div class="stat-card__label">TOTAL KUNJUNGAN</div>
            <div class="stat-card__number" id="statTotalViews">{totalViews.toLocaleString('id-ID')}</div>
          </div>

          <div class="stat-card">
            <div class="stat-card__icon" style="background: rgba(22, 163, 74, 0.12); color: #16a34a;">
              <span class="material-symbols-outlined">touch_app</span>
            </div>
            <div class="stat-card__label">TOTAL INTERAKSI</div>
            <div class="stat-card__number" id="statTotalInteractions">-</div>
          </div>

          <div class="stat-card">
            <div class="stat-card__icon" style="background: rgba(37, 99, 235, 0.12); color: #2563eb;">
              <span class="material-symbols-outlined">person_pin</span>
            </div>
            <div class="stat-card__label">TAMU TERIDENTIFIKASI</div>
            <div class="stat-card__number" id="statTotalIdentified">-</div>
          </div>

          <div class="stat-card">
            <div class="stat-card__icon" style="background: rgba(217, 119, 6, 0.12); color: #d97706;">
              <span class="material-symbols-outlined">storefront</span>
            </div>
            <div class="stat-card__label">LEADS VENDOR</div>
            <div class="stat-card__number" id="statVendorLeads">-</div>
          </div>
        </div>

        <div class="conversion-funnel-card">
          <div class="funnel-header">
            <span class="funnel-title">
              <span class="material-symbols-outlined" style="font-size: 16px; color: var(--color-primary);">monitoring</span>
              Conversion Funnel & Engagement Rate
            </span>
            <span class="funnel-caption">Efektivitas interaksi tamu</span>
          </div>

          <div class="funnel-grid">
            <div class="funnel-item">
              <div class="funnel-item__top">
                <span class="funnel-item__label">Cover Open Rate</span>
                <span class="funnel-item__val" id="funnelCoverVal">0%</span>
              </div>
              <div class="funnel-progress">
                <div class="funnel-progress__bar" id="funnelCoverBar" style="width: 0%; background: var(--color-primary);"></div>
              </div>
              <span class="funnel-item__desc" id="funnelCoverDesc">0 dari {totalViews} pengunjung buka amplop</span>
            </div>

            <div class="funnel-item">
              <div class="funnel-item__top">
                <span class="funnel-item__label">RSVP Conversion</span>
                <span class="funnel-item__val" id="funnelRsvpVal">0%</span>
              </div>
              <div class="funnel-progress">
                <div class="funnel-progress__bar" id="funnelRsvpBar" style="width: 0%; background: #059669;"></div>
              </div>
              <span class="funnel-item__desc" id="funnelRsvpDesc">{report.summary.rsvpCount || 0} tamu telah mengisi RSVP</span>
            </div>

            <div class="funnel-item">
              <div class="funnel-item__top">
                <span class="funnel-item__label">Interaction Rate</span>
                <span class="funnel-item__val" id="funnelEngageVal">0%</span>
              </div>
              <div class="funnel-progress">
                <div class="funnel-progress__bar" id="funnelEngageBar" style="width: 0%; background: #2563eb;"></div>
              </div>
              <span class="funnel-item__desc" id="funnelEngageDesc">Menghitung rata-rata aksi per pengunjung...</span>
            </div>

            <div class="funnel-item" id="funnelWaItem" style={totalSent > 0 ? 'display: flex;' : 'display: none;'}>
              <div class="funnel-item__top">
                <span class="funnel-item__label">WA Sent Open Rate</span>
                <span class="funnel-item__val" id="funnelWaVal">{`${openRate || 0}%`}</span>
              </div>
              <div class="funnel-progress">
                <div class="funnel-progress__bar" id="funnelWaBar" style={`width: ${openRate || 0}%; background: #9333ea;`}></div>
              </div>
              <span class="funnel-item__desc" id="funnelWaDesc">{totalOpenedSent} dari {totalSent} tamu WA telah membuka</span>
            </div>
          </div>
        </div>

        <div class="activity-graph-card" id="activityGraphSection">
          <div class="graph-card-header">
            <div class="graph-card-title-group">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span class="material-symbols-outlined" style="font-size: 20px; color: var(--color-primary, #111827);">monitoring</span>
                <h4 class="graph-card-title">Grafik & Tren Aktivitas Pengunjung</h4>
              </div>
              <p class="graph-card-subtitle">Visualisasi interaktif pola kunjungan, respon amplop, dan interaksi tamu secara real-time</p>
            </div>

            <div class="graph-controls-panel">
              <div class="graph-filter-select-wrapper">
                <select id="graphMetricFilter" class="form-input graph-select" title="Filter jenis aktivitas">
                  <option value="all">📊 Semua Aktivitas</option>
                  <option value="views">👁️ Kunjungan Halaman</option>
                  <option value="cover">💌 Buka Cover Undangan</option>
                  <option value="interaction">🎯 Interaksi Undangan</option>
                  <option value="guests">👤 Tamu Teridentifikasi</option>
                  <option value="vendor">💼 Leads Vendor (Senadda)</option>
                </select>

                <div class="graph-type-switcher">
                  <button type="button" class="graph-type-btn graph-type-btn--active" data-type="area" title="Tampilan Grafik Garis & Area">
                    <span class="material-symbols-outlined">show_chart</span>
                  </button>
                  <button type="button" class="graph-type-btn" data-type="bar" title="Tampilan Grafik Batang">
                    <span class="material-symbols-outlined">bar_chart</span>
                  </button>
                </div>
              </div>

              <div class="graph-time-tabs" role="tablist">
                <button type="button" class="graph-time-tab graph-time-tab--active" data-range="24h" title="Lihat distribusi 24 jam per jam (WITA)">24 Jam</button>
                <button type="button" class="graph-time-tab" data-range="7d" title="Lihat tren harian 7 hari terakhir">7 Hari</button>
                <button type="button" class="graph-time-tab" data-range="30d" title="Lihat tren 30 hari terakhir">30 Hari</button>
                <button type="button" class="graph-time-tab" data-range="all" title="Lihat seluruh riwayat waktu">Semua</button>
              </div>
            </div>
          </div>

          <div class="graph-kpi-bar">
            <div class="graph-kpi-item">
              <span class="graph-kpi-label">Total Terpilih</span>
              <span class="graph-kpi-val" id="graphKpiTotal">0</span>
            </div>
            <div class="graph-kpi-item">
              <span class="graph-kpi-label">Puncak Tertinggi</span>
              <span class="graph-kpi-val" id="graphKpiPeak">-</span>
            </div>
            <div class="graph-kpi-item">
              <span class="graph-kpi-label">Rata-rata</span>
              <span class="graph-kpi-val" id="graphKpiAvg">0</span>
            </div>
            <div class="graph-kpi-item">
              <span class="graph-kpi-label">Tamu Terlibat</span>
              <span class="graph-kpi-val" id="graphKpiGuests">0</span>
            </div>
          </div>

          <div class="graph-canvas-container" id="graphCanvasContainer">
            <div class="graph-svg-wrapper" id="graphSvgWrapper">
              <svg class="graph-svg" id="activityGraphSvg" viewBox="0 0 800 220" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#111827" stop-opacity="0.25" />
                    <stop offset="100%" stop-color="#111827" stop-opacity="0.01" />
                  </linearGradient>
                </defs>
                <g id="graphGridGroup"></g>
                <g id="graphBarsGroup" style="display: none;"></g>
                <g id="graphAreaGroup">
                  <path id="graphAreaPath" class="graph-area-path" d="" fill="url(#areaGradient)" />
                  <path id="graphLinePath" class="graph-line-path" d="" fill="none" stroke="var(--color-primary, #111827)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  <g id="graphPointsGroup"></g>
                </g>
                <g id="graphTrackerGroup" style="display: none;">
                  <line id="graphTrackerLine" x1="0" y1="25" x2="0" y2="190" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="3,3" />
                  <circle id="graphTrackerCircle" cx="0" cy="0" r="5.5" fill="#111827" stroke="#ffffff" stroke-width="2.5" />
                </g>
              </svg>
            </div>

            <div class="graph-xaxis" id="graphXAxisLabels"></div>

            <div class="graph-tooltip" id="graphTooltip" style="display: none;">
              <div class="graph-tooltip__header" id="graphTooltipTitle">Waktu</div>
              <div class="graph-tooltip__body">
                <span class="graph-tooltip__badge" id="graphTooltipVal">0 Aksi</span>
                <span class="graph-tooltip__sub" id="graphTooltipSub"></span>
              </div>
            </div>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 20px;">
          <div class="analytics-subcard" style="margin-bottom: 0;">
            <h4 class="analytics-section-title" style="margin-bottom: 12px;">
              Interaksi Tamu pada Undangan
            </h4>
            <div class="interaction-grid">
              {
                guestInteractionCards.map((card) =>
                  (card.hideViaStyle || card.visible) && (
                    <div
                      class="interaction-card"
                      id={card.wrapperId}
                      style={card.hideViaStyle && !card.visible ? 'display: none;' : undefined}
                      data-filter={card.filter}
                      tabindex="0"
                      role="button"
                      title={card.title}
                    >
                      <div class={`interaction-card__icon-box interaction-card__icon-box--${card.boxVariant}`}>
                        <span class="material-symbols-outlined interaction-card__icon">{card.icon}</span>
                      </div>
                      <div class="interaction-card__content">
                        <span class="interaction-card__label">{card.label}</span>
                        <span class="interaction-card__value" id={card.valueId}>-</span>
                      </div>
                    </div>
                  )
                )
              }
            </div>
          </div>

          <div class="analytics-subcard" style="margin-bottom: 0;">
            <h4 class="analytics-section-title" style="margin-bottom: 12px;">
              Leads & Branding Pemilik Jasa (Senadda)
            </h4>
            <div class="interaction-grid">
              {
                vendorLeadCards.map((card) => (
                  <div class="interaction-card" data-filter={card.filter} tabindex="0" role="button" title={card.title}>
                    <div class={`interaction-card__icon-box interaction-card__icon-box--${card.boxVariant}`}>
                      <span class="material-symbols-outlined interaction-card__icon">{card.icon}</span>
                    </div>
                    <div class="interaction-card__content">
                      <span class="interaction-card__label">{card.label}</span>
                      <span class="interaction-card__value" id={card.valueId}>-</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="analytics-subcard" style="margin-bottom: 0;">
            <h4 class="analytics-section-title" style="margin-bottom: 10px;">
              <span class="material-symbols-outlined" style="font-size: 18px; color: #3b82f6;">devices</span>
              Perangkat Pengunjung & Browser Terpopuler
            </h4>

            <div class="analytics-bar-wrapper">
              <div class="analytics-bar-segment analytics-bar-segment--mobile" id="barDeviceMobile" style="width: 0%;" title="Smartphone"></div>
              <div class="analytics-bar-segment analytics-bar-segment--desktop" id="barDeviceDesktop" style="width: 0%;" title="Desktop"></div>
              <div class="analytics-bar-segment analytics-bar-segment--tablet" id="barDeviceTablet" style="width: 0%;" title="Tablet"></div>
            </div>

            <div class="analytics-legend" style="margin-top: 8px;">
              <div class="analytics-legend-item">
                <span class="analytics-legend-dot" style="background-color: var(--color-primary, #6366f1);"></span>
                <span>Smartphone: <strong id="lblDeviceMobile">-</strong></span>
              </div>
              <div class="analytics-legend-item">
                <span class="analytics-legend-dot" style="background-color: #06b6d4;"></span>
                <span>Desktop: <strong id="lblDeviceDesktop">-</strong></span>
              </div>
              <div class="analytics-legend-item">
                <span class="analytics-legend-dot" style="background-color: #f59e0b;"></span>
                <span>Tablet: <strong id="lblDeviceTablet">-</strong></span>
              </div>
            </div>

            <div id="browserBreakdownSection" style="margin-top: 14px; border-top: 1px dashed var(--color-outline-variant); padding-top: 10px;">
              <span style="font-size: 11px; color: var(--color-outline); font-weight: 600; display: block; margin-bottom: 6px;">Browser / In-App WebView Terpopuler:</span>
              <div class="browser-tag-list" id="browserTagList">
                <span class="browser-tag" style="opacity: 0.6;">Memuat data browser...</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="bento-card fade-in-bottom animate-on-scroll" style="width: 100%;" id="activityListCard">
      <div class="activity-top-bar">
        <div>
          <h4 class="activity-top-bar__title">Daftar Aktivitas & Riwayat</h4>
          <p class="activity-top-bar__subtitle">Eksplorasi interaksi real-time dan perjalanan tamu secara terpadu</p>
        </div>
        <button id="activityExport" class="filter-btn filter-btn--outline activity-export-btn" title="Download data aktivitas (.xlsx)">
          <span class="material-symbols-outlined" style="font-size: 18px;">download</span>
          Export Excel
        </button>
      </div>

      <div class="activity-controls">
        <div class="activity-controls__row">
          <div class="activity-view-switcher">
            <button type="button" class="view-switch-btn view-switch-btn--active" id="viewModeTimeline" data-mode="timeline" title="Lihat semua log waktu nyata">
              <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span>
              <span>Semua Log</span>
              <span class="view-switch-badge" id="badgeTotalTimeline">-</span>
            </button>
            <button type="button" class="view-switch-btn" id="viewModeGuests" data-mode="guests" title="Lihat rangkuman per tamu">
              <span class="material-symbols-outlined" style="font-size: 16px;">group</span>
              <span>Per Tamu</span>
              <span class="view-switch-badge" id="badgeTotalGuests">-</span>
            </button>
          </div>

          <div class="activity-filter-wrapper">
            <select id="timeRangeFilter" class="form-input activity-select">
              <option value="all">Semua Waktu</option>
              <option value="today">Hari Ini (WITA)</option>
              <option value="24h">24 Jam Terakhir</option>
              <option value="7d">7 Hari Terakhir</option>
              <option value="30d">30 Hari Terakhir</option>
            </select>
          </div>
        </div>

        <div class="activity-controls__row">
          <div class="search-wrapper activity-search-wrapper">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" id="activitySearch" placeholder="Cari nama tamu, aksi, pesan doa, browser, HP..." class="search-input" />
            <button type="button" id="clearSearchBtn" class="clear-btn" style="display: none;">
              <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
            </button>
          </div>

          <div class="activity-filter-wrapper" id="eventFilterWrapper">
            <select id="eventFilter" class="form-input activity-select">
              <option value="all">Semua Jenis Aksi</option>
              <option value="open_cover">Buka Undangan (Cover)</option>
              <option value="click_maps">Klik Google Maps</option>
              <option value="click_calendar">Simpan ke Kalender</option>
              <option value="copy_gift">Salin No. Rekening</option>
              <option value="play_music">Putar Musik Latar</option>
              <option value="pause_music">Jeda Musik Latar</option>
              <option value="play_video">Putar Video Momen</option>
              <option value="view_gallery">Lihat Galeri Foto</option>
              <option value="click_rsvp">Klik Form RSVP</option>
              <option value="click_wishes">Buka Doa / Ucapan</option>
              <option value="click_couple_instagram">Instagram Pengantin / Mempelai</option>
              <option value="click_participant">Detail Peserta (Popup)</option>
              <option value="click_vendor_whatsapp">WhatsApp Senadda</option>
              <option value="click_vendor_instagram">Instagram Senadda</option>
              <option value="click_vendor_site">Website Senadda</option>
              <option value="page_view">Kunjungan Halaman</option>
            </select>
          </div>
        </div>
      </div>

      <div class="activity-tags-row" id="activityTagsRow">
        <button class="activity-tag activity-tag--active" data-tag="all" id="tagAll">
          Semua <span class="tag-count" id="tagAllCount">(-)</span>
        </button>
        <button class="activity-tag" data-tag="identified" id="tagIdentified">
          Tamu Terdaftar <span class="tag-count" id="tagIdentifiedCount">(-)</span>
        </button>
        <button class="activity-tag" data-tag="interaksi" id="tagInteraksi">
          Interaksi Undangan <span class="tag-count" id="tagInteraksiCount">(-)</span>
        </button>
        <button class="activity-tag" data-tag="rsvp" id="tagRsvp">
          Sudah RSVP <span class="tag-count" id="tagRsvpCount">({report.summary.rsvpCount || 0})</span>
        </button>
        <button class="activity-tag" data-tag="vendor" id="tagVendor">
          Leads Vendor <span class="tag-count" id="tagVendorCount">(-)</span>
        </button>
        <button class="activity-tag" data-tag="kunjungan" id="tagKunjungan">
          Kunjungan Halaman <span class="tag-count" id="tagKunjunganCount">({totalViews})</span>
        </button>
      </div>

      <div id="filterIndicator" class="filter-indicator" style="display: none;">
        <span id="filterIndicatorText">Menampilkan hasil filter</span>
        <button type="button" id="resetFiltersBtn" class="reset-btn">
          Reset Filter <span class="material-symbols-outlined" style="font-size: 14px;">restart_alt</span>
        </button>
      </div>

      <div class="activity-list" id="activityList">
        <div class="act-skeleton-list">
          <div class="act-skeleton-row"></div>
          <div class="act-skeleton-row"></div>
          <div class="act-skeleton-row"></div>
        </div>
      </div>

      <div class="guest-journey-list" id="guestJourneyList" style="display: none;">
        <div class="act-skeleton-list">
          <div class="act-skeleton-row"></div>
          <div class="act-skeleton-row"></div>
        </div>
      </div>

      <div class="pagination-wrapper" style="border-top: 1px solid var(--color-surface-container); padding: 16px 0 0 0; margin-top: 16px;">
        <button class="pagination-btn" id="actPrev" disabled>Prev</button>
        <div class="pagination-numbers" id="actPageNumbers"></div>
        <button class="pagination-btn" id="actNext" disabled>Next</button>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script>
    import "../../../scripts/dashboard-aktivitas";
  </script>
</ClientLayout>
