---
const { slug } = Astro.params;
const session = Astro.locals.session;

if (!session || (session.role === 'client' && session.slug !== slug)) {
  return Astro.redirect('/?login=client');
}

import ClientLayout from "../../../layouts/ClientLayout.astro";
import { getSlugReportDetail } from "../../../services/dashboard-report";

const report = await getSlugReportDetail(slug);
if (!report) {
  return Astro.redirect('/dashboard');
}

const coupleName = report.summary.coupleName;
const weddingDate = report.wedding.weddingDate;
const link = `${Astro.url.origin}/${slug}`;
const templateName = report.summary.template || 'noir';
const coverModules = import.meta.glob('../../../templates/*/assets/cover.{jpg,png,webp,jpeg}', { eager: true }) as Record<string, { default: { src: string } }>;
const defaultCoverKey = Object.keys(coverModules).find(key => key.includes(`/${templateName}/assets/cover.`));
const defaultCoverSrc = defaultCoverKey ? coverModules[defaultCoverKey].default.src : 'https://images.unsplash.com/photo-1519741497674-611481863552?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80';

const coverImage = report.settings?.assets?.heroImage || report.settings?.assets?.coverImage || defaultCoverSrc;

const hadir = report.summary.attendingCount || 0;
const tidakHadir = report.summary.declinedCount || 0;
const ragu = report.summary.tentativeCount || 0;
const totalTamu = report.summary.rsvpCount || 0;

const hadirDeg = totalTamu > 0 ? Math.round((hadir / totalTamu) * 360) : 0;
const tidakHadirDeg = totalTamu > 0 ? Math.round((tidakHadir / totalTamu) * 360) : 0;

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  return `${Math.floor(hrs / 24)}d ago`;
}

const wishesWithMessage = report.rsvps.filter(r => r.message);
const newWishesCount = wishesWithMessage.filter(r => {
  const diff = Date.now() - new Date(r.createdAt).getTime();
  return diff < 24 * 60 * 60 * 1000; // last 24h
}).length;
---

<ClientLayout title="Dashboard">
  <div class="dashboard-bento-layout">
  <!-- Hero Section -->
  <section class="fade-in-bottom">
    <div class="hero-card">
      <div class="hero-card__overlay"></div>
      <div class="hero-card__bg" style={`background-image: url('${coverImage}')`}></div>
      <div class="hero-card__content">
        <h1 class="hero-card__title">{coupleName}</h1>
        <a href={link} target="_blank" class="hero-card__link">{link.replace('https://', '')}</a>
      </div>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card bento-card--overview">
      <h3 class="bento-card__title">Overview</h3>
      <div class="stats-grid stats-grid--dashboard">
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="event_available">event_available</span>
          </div>
          <div class="stat-card__label">TOTAL RSVP</div>
          <div class="stat-card__number">{report.summary.rsvpCount}</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="group">group</span>
          </div>
          <div class="stat-card__label">TOTAL PAX</div>
          <div class="stat-card__number">{report.summary.guestCount}</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="forum">forum</span>
          </div>
          <div class="stat-card__label">UCAPAN</div>
          <div class="stat-card__number">{report.summary.wishesCount}</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="visibility">visibility</span>
          </div>
          <div class="stat-card__label">PAGE VIEWS</div>
          <div class="stat-card__number">{report.summary.viewCount}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Countdown Timer -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <div class="countdown-header-row">
        <span class="countdown-label">Countdown:</span>
        <span class="countdown-date">{new Date(weddingDate).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</span>
      </div>
      <div class="countdown-grid">
        <div class="countdown-item">
          <div class="countdown-item__number" id="cd-days">00</div>
          <div class="countdown-item__label">HARI</div>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <div class="countdown-item__number" id="cd-hours">00</div>
          <div class="countdown-item__label">JAM</div>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <div class="countdown-item__number" id="cd-minutes">00</div>
          <div class="countdown-item__label">MENIT</div>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <div class="countdown-item__number" id="cd-seconds">00</div>
          <div class="countdown-item__label">DETIK</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rangkaian Acara -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <h3 class="bento-card__title">Rangkaian Acara</h3>
      <div class="event-list">
        {report.events.map((event, index) => (
          <div class="event-item">
            <div class="event-item__row1">
              <div class="event-item__time-block">
                <span class="material-symbols-outlined event-item__time-icon">schedule</span>
                <span class="event-item__time">
                  {event.startTime}{event.endTime ? ` - ${event.endTime}` : ''}
                </span>
              </div>
              <span class="event-item__date">
                {new Date(event.date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </div>
            <div class="event-item__body">
              <p class="event-item__name">{event.name}</p>
              {event.venueAddress && <p class="event-item__address">{event.venueAddress}</p>}
              {event.mapsUrl && (
                <a href={event.mapsUrl} target="_blank" class="event-item__btn">Lihat Lokasi</a>
              )}
            </div>
            {index < report.events.length - 1 && <div class="event-item__divider"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Guest Stats Chart -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <h3 class="bento-card__title">Statistik Tamu</h3>
      <div class="guest-stats">
        <div class="guest-stats__chart">
          <div class="guest-stats__donut" style={`--hadir-deg: ${hadirDeg}deg; --tidak-hadir-deg: ${tidakHadirDeg}deg;`}>
            <div class="guest-stats__donut-inner">
              <span class="guest-stats__total-val">{totalTamu}</span>
              <span class="guest-stats__total-lbl">TOTAL</span>
            </div>
          </div>
        </div>
        <div class="guest-stats__legend">
          <div class="guest-stats__legend-item">
            <div class="guest-stats__dot" style="background-color: #22c55e;"></div>
            <span class="guest-stats__label">Hadir</span>
            <span class="guest-stats__value">{hadir}</span>
          </div>
          <div class="guest-stats__legend-item">
            <div class="guest-stats__dot" style="background-color: #ef4444;"></div>
            <span class="guest-stats__label">Tidak Hadir</span>
            <span class="guest-stats__value">{tidakHadir}</span>
          </div>
          <div class="guest-stats__legend-item">
            <div class="guest-stats__dot" style="background-color: #9ca3af;"></div>
            <span class="guest-stats__label">Ragu</span>
            <span class="guest-stats__value">{ragu}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Wishes Section -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <div class="wish-header">
        <h3 class="bento-card__title bento-card__title--no-margin">Ucapan</h3>
        {newWishesCount > 0 && (
          <span class="wish-new-badge">{newWishesCount} New</span>
        )}
      </div>
      <div class="wishes-list">
        {wishesWithMessage.slice(0, 2).map((rsvp, index, arr) => (
          <div class="wish-item">
            <div class="wish-item__header">
              <div class="wish-item__left">
                <span class="wish-item__name">{rsvp.guestName}</span>
                <span class={`wish-item__status wish-item__status--${rsvp.attendanceStatus}`}>
                  {rsvp.attendanceStatus === 'attending' ? 'HADIR' : rsvp.attendanceStatus === 'declined' ? 'TIDAK' : 'RAGU'}
                </span>
              </div>
              <span class="wish-item__ago">{timeAgo(rsvp.createdAt)}</span>
            </div>
            <p class="wish-item__message">"{rsvp.message}"</p>
            {index < arr.length - 1 && <div class="wish-item__divider"></div>}
          </div>
        ))}
        {wishesWithMessage.length === 0 && (
          <p class="empty-state">Belum ada ucapan.</p>
        )}
      </div>
      {wishesWithMessage.length > 0 && (
        <a href={`/dashboard/${slug}/rsvp`} class="wish-see-all">
          LIHAT SEMUA {report.summary.wishesCount} UCAPAN
        </a>
      )}
    </div>
  </section>

  </div>
  
  <script define:vars={{ weddingDate }}>
    function updateCountdown() {
      if (!weddingDate) return;
      const target = new Date(weddingDate).getTime();
      const now = new Date().getTime();
      const diff = target - now;

      const set = (id, val) => { const el = document.getElementById(id); if (el) el.innerText = String(val).padStart(2, '0'); };

      if (diff < 0) {
        ['cd-days','cd-hours','cd-minutes','cd-seconds'].forEach(id => set(id, 0));
        return;
      }

      set('cd-days',    Math.floor(diff / (1000 * 60 * 60 * 24)));
      set('cd-hours',   Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
      set('cd-minutes', Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60)));
      set('cd-seconds', Math.floor((diff % (1000 * 60)) / 1000));
    }
    
    setInterval(updateCountdown, 1000);
    updateCountdown();
  </script>
</ClientLayout>
