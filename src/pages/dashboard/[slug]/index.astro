---
const { slug } = Astro.params;
const session = Astro.locals.session;

if (!session || (session.role === 'client' && session.slug !== slug)) {
  return Astro.redirect('/?login=client');
}

import ClientLayout from "../../../layouts/ClientLayout.astro";
import { getSlugReportDetail } from "../../../services/dashboard-report";

const report = await getSlugReportDetail(slug);
if (!report) {
  return Astro.redirect('/dashboard');
}

const coupleName = report.summary.coupleName;
const weddingDate = report.wedding.weddingDate;
const link = `${Astro.url.origin}/${slug}`;
const templateName = report.summary.template || 'noir';
const coverModules = import.meta.glob('../../../templates/*/assets/cover.{jpg,png,webp,jpeg}', { eager: true }) as Record<string, { default: { src: string } }>;
const defaultCoverKey = Object.keys(coverModules).find(key => key.includes(`/${templateName}/assets/cover.`));
const defaultCoverSrc = defaultCoverKey ? coverModules[defaultCoverKey].default.src : 'https://images.unsplash.com/photo-1519741497674-611481863552?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80';

const coverImage = report.settings?.assets?.heroImage || report.settings?.assets?.coverImage || defaultCoverSrc;

const hadir = report.summary.attendingCount || 0;
const tidakHadir = report.summary.declinedCount || 0;
const ragu = report.summary.tentativeCount || 0;
const totalTamu = report.summary.rsvpCount || 0;

const hadirDeg = totalTamu > 0 ? Math.round((hadir / totalTamu) * 360) : 0;
const tidakHadirDeg = totalTamu > 0 ? Math.round((tidakHadir / totalTamu) * 360) : 0;

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  return `${Math.floor(hrs / 24)}d ago`;
}

const wishesWithMessage = report.rsvps.filter(r => r.message);
const newWishesCount = wishesWithMessage.filter(r => {
  const diff = Date.now() - new Date(r.createdAt).getTime();
  return diff < 24 * 60 * 60 * 1000; // last 24h
}).length;

const analytics = report.analytics || {
  deviceStats: { mobile: 0, desktop: 0, tablet: 0, mobilePercent: 0, desktopPercent: 0, tabletPercent: 0 },
  browserStats: [],
  interactionStats: { openCover: 0, clickMaps: 0, clickCalendar: 0, copyGift: 0, playMusic: 0, playVideo: 0, viewGallery: 0, clickRsvp: 0, clickCoupleInstagram: 0, clickVendorWhatsApp: 0, clickVendorInstagram: 0, clickVendorSite: 0, totalInteractions: 0 },
  recentVisitors: []
};

// Layout & Section feature availability flags
const showMapsStat = Boolean(report.wedding.mapsUrl || report.events?.some((e: any) => e.maps_url)) || (analytics.interactionStats?.clickMaps || 0) > 0;
const showCalendarStat = Boolean(report.wedding.weddingDate || report.events?.length > 0) || (analytics.interactionStats?.clickCalendar || 0) > 0;
const showGiftStat = (Boolean(report.settings.giftEnabled) && (report.gifts?.length > 0)) || (analytics.interactionStats?.copyGift || 0) > 0;
const showMusicStat = (Boolean(report.settings.musicEnabled) && Boolean(report.wedding.musicUrl)) || (analytics.interactionStats?.playMusic || 0) > 0;
const showVideoStat = (Boolean(report.settings.videoEnabled) && Boolean(report.settings.assets?.heroVideo)) || (analytics.interactionStats?.playVideo || 0) > 0;
const showGalleryStat = Boolean(report.settings.galleryEnabled) || (analytics.interactionStats?.viewGallery || 0) > 0;
const showRsvpStat = Boolean(report.settings.rsvpEnabled) || (analytics.interactionStats?.clickRsvp || 0) > 0 || (report.rsvps?.length > 0);
const showCoupleIgStat = Boolean(report.settings.content?.groomInstagramUrl || report.settings.content?.brideInstagramUrl || report.settings.content?.instagramUrl) || (analytics.interactionStats?.clickCoupleInstagram || 0) > 0;
---

<ClientLayout title="Dashboard">
  <div class="dashboard-bento-layout">
  <!-- Hero Section -->
  <section class="fade-in-bottom">
    <div class="hero-card">
      <div class="hero-card__overlay"></div>
      <div class="hero-card__bg" style={`background-image: url('${coverImage}')`}></div>
      <div class="hero-card__content">
        <h1 class="hero-card__title">{coupleName}</h1>
        <a href={link} target="_blank" rel="noopener noreferrer" class="hero-card__link">{link.replace('https://', '')}</a>
      </div>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card bento-card--overview">
      <h3 class="bento-card__title">Overview</h3>
      <div class="stats-grid stats-grid--dashboard">
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="event_available">event_available</span>
          </div>
          <div class="stat-card__label">TOTAL RSVP</div>
          <div class="stat-card__number">{report.summary.rsvpCount}</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="group">group</span>
          </div>
          <div class="stat-card__label">TOTAL PAX</div>
          <div class="stat-card__number">{report.summary.guestCount}</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="forum">forum</span>
          </div>
          <div class="stat-card__label">UCAPAN</div>
          <div class="stat-card__number">{report.summary.wishesCount}</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="visibility">visibility</span>
          </div>
          <div class="stat-card__label">PAGE VIEWS</div>
          <div class="stat-card__number">{report.summary.viewCount}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Countdown Timer -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <div class="countdown-header-row">
        <span class="countdown-label">Countdown:</span>
        <span class="countdown-date">{new Date(weddingDate).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</span>
      </div>
      <div class="countdown-grid">
        <div class="countdown-item">
          <div class="countdown-item__number" id="cd-days">00</div>
          <div class="countdown-item__label">HARI</div>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <div class="countdown-item__number" id="cd-hours">00</div>
          <div class="countdown-item__label">JAM</div>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <div class="countdown-item__number" id="cd-minutes">00</div>
          <div class="countdown-item__label">MENIT</div>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <div class="countdown-item__number" id="cd-seconds">00</div>
          <div class="countdown-item__label">DETIK</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rangkaian Acara -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <h3 class="bento-card__title">Rangkaian Acara</h3>
      <div class="event-list">
        {report.events.map((event, index) => (
          <div class="event-item">
            <div class="event-item__row1">
              <div class="event-item__time-block">
                <span class="material-symbols-outlined event-item__time-icon">schedule</span>
                <span class="event-item__time">
                  {event.startTime}{event.endTime ? ` - ${event.endTime}` : ''}
                </span>
              </div>
              <span class="event-item__date">
                {new Date(event.date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </div>
            <div class="event-item__body">
              <p class="event-item__name">{event.name}</p>
              {event.venueAddress && <p class="event-item__address">{event.venueAddress}</p>}
              {event.mapsUrl && (
                <a href={event.mapsUrl} target="_blank" rel="noopener noreferrer" class="event-item__btn">Lihat Lokasi</a>
              )}
            </div>
            {index < report.events.length - 1 && <div class="event-item__divider"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Guest Stats Chart -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <h3 class="bento-card__title">Statistik Tamu</h3>
      <div class="guest-stats">
        <div class="guest-stats__chart">
          <div class="guest-stats__donut" style={`--hadir-deg: ${hadirDeg}deg; --tidak-hadir-deg: ${tidakHadirDeg}deg;`}>
            <div class="guest-stats__donut-inner">
              <span class="guest-stats__total-val">{totalTamu}</span>
              <span class="guest-stats__total-lbl">TOTAL</span>
            </div>
          </div>
        </div>
        <div class="guest-stats__legend">
          <div class="guest-stats__legend-item">
            <div class="guest-stats__dot" style="background-color: #22c55e;"></div>
            <span class="guest-stats__label">Hadir</span>
            <span class="guest-stats__value">{hadir}</span>
          </div>
          <div class="guest-stats__legend-item">
            <div class="guest-stats__dot" style="background-color: #ef4444;"></div>
            <span class="guest-stats__label">Tidak Hadir</span>
            <span class="guest-stats__value">{tidakHadir}</span>
          </div>
          <div class="guest-stats__legend-item">
            <div class="guest-stats__dot" style="background-color: #9ca3af;"></div>
            <span class="guest-stats__label">Ragu</span>
            <span class="guest-stats__value">{ragu}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visitor Analytics & Engagement (Admin Only) -->
  {session?.role === 'admin' && (
    <section class="fade-in-bottom animate-on-scroll">
      <div class="bento-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
          <h3 class="bento-card__title" style="margin: 0;">
            Analitik Pengunjung & Interaksi
            <span style="font-size: 11px; font-weight: 500; background: #e0e7ff; color: #4338ca; padding: 2px 8px; border-radius: 9999px; margin-left: 8px;">Admin Only</span>
          </h3>
        <a href={`/dashboard/${slug}/aktivitas`} style="font-size: 12px; font-weight: 700; color: var(--color-primary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; background: rgba(166, 137, 102, 0.1); padding: 4px 10px; border-radius: 6px;">
          Lihat Log Lengkap <span class="material-symbols-outlined" style="font-size: 15px;">arrow_forward</span>
        </a>
      </div>
        
        <!-- Device Distribution -->
        <div class="analytics-subcard">
          <h4 class="analytics-section-title">
            <span class="material-symbols-outlined" style="font-size: 18px; color: var(--color-primary);">devices</span>
            Perangkat Pengunjung
          </h4>
          
          <div class="analytics-bar-wrapper">
            <div class="analytics-bar-segment analytics-bar-segment--mobile" style={`width: ${analytics.deviceStats.mobilePercent || (report.summary.viewCount ? 100 : 0)}%`} title={`Mobile: ${analytics.deviceStats.mobilePercent}%`}></div>
            <div class="analytics-bar-segment analytics-bar-segment--desktop" style={`width: ${analytics.deviceStats.desktopPercent}%`} title={`Desktop: ${analytics.deviceStats.desktopPercent}%`}></div>
            <div class="analytics-bar-segment analytics-bar-segment--tablet" style={`width: ${analytics.deviceStats.tabletPercent}%`} title={`Tablet: ${analytics.deviceStats.tabletPercent}%`}></div>
          </div>
          
          <div class="analytics-legend">
            <div class="analytics-legend-item">
              <span class="analytics-legend-dot" style="background-color: var(--color-primary, #6366f1);"></span>
              <span>Mobile: <strong>{analytics.deviceStats.mobilePercent || (report.summary.viewCount ? 100 : 0)}%</strong> ({analytics.deviceStats.mobile})</span>
            </div>
            <div class="analytics-legend-item">
              <span class="analytics-legend-dot" style="background-color: #06b6d4;"></span>
              <span>Desktop: <strong>{analytics.deviceStats.desktopPercent}%</strong> ({analytics.deviceStats.desktop})</span>
            </div>
            <div class="analytics-legend-item">
              <span class="analytics-legend-dot" style="background-color: #f59e0b;"></span>
              <span>Tablet: <strong>{analytics.deviceStats.tabletPercent}%</strong> ({analytics.deviceStats.tablet})</span>
            </div>
          </div>

          {analytics.browserStats.length > 0 && (
            <div style="margin-top: 14px; border-top: 1px dashed var(--color-outline-variant); padding-top: 10px;">
              <span style="font-size: 11px; color: var(--color-outline); font-weight: 500;">Browser / WebView Terpopuler:</span>
              <div class="browser-tag-list">
                {analytics.browserStats.slice(0, 8).map(b => (
                  <span class="browser-tag">
                    {b.browser} <span class="browser-tag__count">{b.count}</span>
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Feature Interactions -->
        <div class="analytics-subcard">
          <h4 class="analytics-section-title">
            <span class="material-symbols-outlined" style="font-size: 18px; color: var(--color-primary);">touch_app</span>
            Interaksi Tamu pada Undangan
          </h4>
          <div class="interaction-grid">
            <div class="interaction-card">
              <span class="material-symbols-outlined interaction-card__icon">drafts</span>
              <span class="interaction-card__label">Buka Undangan</span>
              <span class="interaction-card__value">{analytics.interactionStats?.openCover || 0}</span>
            </div>
            {showMapsStat && (
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon">location_on</span>
                <span class="interaction-card__label">Petunjuk Maps</span>
                <span class="interaction-card__value">{analytics.interactionStats?.clickMaps || 0}</span>
              </div>
            )}
            {showCalendarStat && (
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon">calendar_month</span>
                <span class="interaction-card__label">Simpan Kalender</span>
                <span class="interaction-card__value">{analytics.interactionStats?.clickCalendar || 0}</span>
              </div>
            )}
            {showGiftStat && (
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon">content_copy</span>
                <span class="interaction-card__label">Salin Rekening</span>
                <span class="interaction-card__value">{analytics.interactionStats?.copyGift || 0}</span>
              </div>
            )}
            {showMusicStat && (
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon" style="color: #0d9488;">music_note</span>
                <span class="interaction-card__label">Putar Musik</span>
                <span class="interaction-card__value">{analytics.interactionStats?.playMusic || 0}</span>
              </div>
            )}
            {showVideoStat && (
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon" style="color: #7c3aed;">smart_display</span>
                <span class="interaction-card__label">Putar Video</span>
                <span class="interaction-card__value">{analytics.interactionStats?.playVideo || 0}</span>
              </div>
            )}
            {showGalleryStat && (
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon" style="color: #4f46e5;">photo_library</span>
                <span class="interaction-card__label">Lihat Galeri</span>
                <span class="interaction-card__value">{analytics.interactionStats?.viewGallery || 0}</span>
              </div>
            )}
            {showRsvpStat && (
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon" style="color: #059669;">how_to_reg</span>
                <span class="interaction-card__label">Klik Form RSVP</span>
                <span class="interaction-card__value">{analytics.interactionStats?.clickRsvp || 0}</span>
              </div>
            )}
            {showCoupleIgStat && (
              <div class="interaction-card">
                <span class="material-symbols-outlined interaction-card__icon">photo_camera</span>
                <span class="interaction-card__label">Instagram Pengantin</span>
                <span class="interaction-card__value">{analytics.interactionStats?.clickCoupleInstagram || 0}</span>
              </div>
            )}
          </div>
        </div>

        <!-- Vendor & Branding Leads (Pemilik Jasa) -->
        <div class="analytics-subcard">
          <h4 class="analytics-section-title">
            <span class="material-symbols-outlined" style="font-size: 18px; color: #10b981;">storefront</span>
            Leads & Branding Pemilik Jasa (Senadda)
          </h4>
          <div class="interaction-grid">
            <div class="interaction-card" style="border-left: 3px solid #22c55e;">
              <span class="material-symbols-outlined interaction-card__icon" style="color: #22c55e;">chat</span>
              <span class="interaction-card__label">Klik Chat WhatsApp</span>
              <span class="interaction-card__value">{analytics.interactionStats.clickVendorWhatsApp || 0}</span>
            </div>
            <div class="interaction-card" style="border-left: 3px solid #e1306c;">
              <span class="material-symbols-outlined interaction-card__icon" style="color: #e1306c;">photo_camera</span>
              <span class="interaction-card__label">Klik Instagram Jasa</span>
              <span class="interaction-card__value">{analytics.interactionStats.clickVendorInstagram || 0}</span>
            </div>
            <div class="interaction-card" style="border-left: 3px solid #3b82f6;">
              <span class="material-symbols-outlined interaction-card__icon" style="color: #3b82f6;">language</span>
              <span class="interaction-card__label">Klik Website Jasa</span>
              <span class="interaction-card__value">{analytics.interactionStats.clickVendorSite || 0}</span>
            </div>
          </div>
        </div>

        <!-- Recent Visitors -->
        {analytics.recentVisitors.length > 0 && (
          <div class="analytics-subcard">
            <h4 class="analytics-section-title">
              <span class="material-symbols-outlined" style="font-size: 18px; color: var(--color-primary);">history</span>
              Kunjungan Terbaru
            </h4>
            <div class="recent-visitors-list">
              {analytics.recentVisitors.slice(0, 5).map(v => (
                <div class="recent-visitor-item">
                  <div class="recent-visitor-item__left">
                    <span class="material-symbols-outlined" style="font-size: 16px; color: var(--color-primary);">
                      {v.deviceType === 'desktop' ? 'computer' : v.deviceType === 'tablet' ? 'tablet' : 'smartphone'}
                    </span>
                    <div>
                      <div class="recent-visitor-item__name">
                        {v.guestName || 'Pengunjung Umum'}
                      </div>
                      <div class="recent-visitor-item__meta">
                        {v.browser} {v.city ? `• ${v.city}` : ''}
                      </div>
                    </div>
                  </div>
                  <span class="recent-visitor-item__time">{timeAgo(v.createdAt)}</span>
                </div>
              ))}
            </div>
            <div style="margin-top: 10px; text-align: center;">
              <a href={`/dashboard/${slug}/aktivitas`} style="font-size: 12px; font-weight: 600; color: var(--color-primary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                Buka Semua Riwayat Aktivitas & Perangkat <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
              </a>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Wishes Section -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <div class="wish-header">
        <h3 class="bento-card__title bento-card__title--no-margin">Ucapan</h3>
        {newWishesCount > 0 && (
          <span class="wish-new-badge">{newWishesCount} New</span>
        )}
      </div>
      <div class="wishes-list">
        {wishesWithMessage.slice(0, 2).map((rsvp, index, arr) => (
          <div class="wish-item">
            <div class="wish-item__header">
              <div class="wish-item__left">
                <span class="wish-item__name">{rsvp.guestName}</span>
                <span class={`wish-item__status wish-item__status--${rsvp.attendanceStatus}`}>
                  {rsvp.attendanceStatus === 'attending' ? 'HADIR' : rsvp.attendanceStatus === 'declined' ? 'TIDAK' : 'RAGU'}
                </span>
              </div>
              <span class="wish-item__ago">{timeAgo(rsvp.createdAt)}</span>
            </div>
            <p class="wish-item__message">"{rsvp.message}"</p>
            {index < arr.length - 1 && <div class="wish-item__divider"></div>}
          </div>
        ))}
        {wishesWithMessage.length === 0 && (
          <p class="empty-state">Belum ada ucapan.</p>
        )}
      </div>
      {wishesWithMessage.length > 0 && (
        <a href={`/dashboard/${slug}/rsvp`} class="wish-see-all">
          LIHAT SEMUA {report.summary.wishesCount} UCAPAN
        </a>
      )}
    </div>
  </section>

  </div>
  
  <script define:vars={{ weddingDate }}>
    function updateCountdown() {
      if (!weddingDate) return;
      const target = new Date(weddingDate).getTime();
      const now = new Date().getTime();
      const diff = target - now;

      const set = (id, val) => { const el = document.getElementById(id); if (el) el.innerText = String(val).padStart(2, '0'); };

      if (diff < 0) {
        ['cd-days','cd-hours','cd-minutes','cd-seconds'].forEach(id => set(id, 0));
        return;
      }

      set('cd-days',    Math.floor(diff / (1000 * 60 * 60 * 24)));
      set('cd-hours',   Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
      set('cd-minutes', Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60)));
      set('cd-seconds', Math.floor((diff % (1000 * 60)) / 1000));
    }
    
    setInterval(updateCountdown, 1000);
    updateCountdown();
  </script>
</ClientLayout>
