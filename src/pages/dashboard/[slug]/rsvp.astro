---
const { slug } = Astro.params;
const authRole = Astro.cookies.get('auth_role')?.value;
const authSlug = Astro.cookies.get('auth_slug')?.value;

if (!authRole || (authRole === 'client' && authSlug !== slug)) {
  return Astro.redirect('/?login=client');
}

import ClientLayout from "../../../layouts/ClientLayout.astro";
import { getSlugReportDetail } from "../../../services/dashboard-report";

const report = await getSlugReportDetail(slug);
if (!report) {
  return Astro.redirect('/dashboard');
}

const guests = report.rsvps;

function formatRsvpDateTime(dateStr: string | null): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return '';
  return d.toLocaleString('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).replace('.', ':');
}
---

<ClientLayout title="RSVP">
  <div class="rsvp-layout">
  
  <!-- Summary Grid -->
  <div class="rsvp-top fade-in-bottom animate-on-scroll">
    <div class="bento-card" style="width: 100%;">
      <h3 class="bento-card__title">Ringkasan RSVP</h3>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="mail">mail</span>
          </div>
          <div class="stat-card__label">TOTAL RSVP</div>
          <div class="stat-card__number" id="statTotalRsvp">{report.summary.rsvpCount}</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="group">group</span>
          </div>
          <div class="stat-card__label">TOTAL PAX</div>
          <div class="stat-card__number" id="statTotalPax">{report.summary.guestCount}</div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
          </div>
          <div class="stat-card__label">HADIR</div>
          <div class="stat-card__number" id="statAttending">{report.summary.attendingCount}</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="cancel">cancel</span>
          </div>
          <div class="stat-card__label">TIDAK HADIR</div>
          <div class="stat-card__number" id="statDeclined">{report.summary.declinedCount}</div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="help_outline">help_outline</span>
          </div>
          <div class="stat-card__label">RAGU</div>
          <div class="stat-card__number" id="statTentative">{report.summary.tentativeCount}</div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon">
            <span class="material-symbols-outlined" data-icon="forum">forum</span>
          </div>
          <div class="stat-card__label">UCAPAN</div>
          <div class="stat-card__number" id="statWishes">{report.summary.wishesCount}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="bento-card fade-in-bottom animate-on-scroll" style="width: 100%;">
    <!-- Search, Filter, Export Row -->
    <div class="rsvp-controls">
      <div class="search-wrapper rsvp-search-wrapper">
        <span class="material-symbols-outlined search-icon">search</span>
        <input type="text" id="rsvpSearch" placeholder="Cari nama tamu..." class="search-input">
      </div>
      <div class="rsvp-actions">
        <select id="rsvpFilter" class="form-input rsvp-filter-select">
          <option value="all">Semua Status</option>
          <option value="attending">Hadir</option>
          <option value="declined">Tidak Hadir</option>
          <option value="tentative">Ragu</option>
          <option value="with_message">Ada Ucapan</option>
        </select>
        <button id="rsvpExport" class="filter-btn filter-btn--outline rsvp-filter-btn rsvp-export-btn">
          <span class="material-symbols-outlined rsvp-filter-icon">download</span>
          Export
        </button>
      </div>
    </div>

    <!-- Guest Items -->
    <div class="rsvp-table" id="rsvpTable">
      {guests.length === 0 ? (
        <div class="rsvp-table__empty">Belum ada data RSVP</div>
      ) : (
        guests.map((guest, index) => (
          <div class="rsvp-row-wrapper" data-id={guest.id} data-name={guest.guestName.toLowerCase()} data-status={guest.attendanceStatus.toLowerCase()} data-pax={guest.guestCount} data-has-message={guest.message ? "true" : "false"}>
            <div class="rsvp-row">
              <div class="rsvp-row__header">
                <div class="rsvp-row__user">
                  <span class="rsvp-row__index">{(index + 1).toString().padStart(2, '0')}</span>
                  <div class="rsvp-row__user-info">
                    <span class="rsvp-row__name">{guest.guestName}</span>
                    {guest.createdAt && (
                      <span class="rsvp-row__date">{formatRsvpDateTime(guest.createdAt)}</span>
                    )}
                  </div>
                </div>
                <div class="rsvp-row__badges">
                  <div class="rsvp-row__status">
                    {guest.attendanceStatus.toLowerCase() === 'attending' && (
                      <span class="status-label status-label--attending">Hadir</span>
                    )}
                    {guest.attendanceStatus.toLowerCase() === 'declined' && (
                      <span class="status-label status-label--declined">Tdk Hadir</span>
                    )}
                    {(guest.attendanceStatus.toLowerCase() === 'tentative' || guest.attendanceStatus.toLowerCase() === 'pending') && (
                      <span class="status-label status-label--tentative">Ragu</span>
                    )}
                  </div>
                  <div class="rsvp-row__pax-col">
                    <span class="rsvp-row__pax-badge"><span class="rsvp-row__pax-val">{guest.guestCount}</span> Pax</span>
                  </div>
                  <button class="rsvp-row__btn-delete" title="Hapus RSVP" aria-label="Hapus RSVP">
                    <span class="material-symbols-outlined rsvp-row__delete-icon">delete</span>
                  </button>
                </div>
              </div>
              {guest.message ? (
                <div class="rsvp-row__message-col">
                  <p class="rsvp-row__message">"{guest.message}"</p>
                </div>
              ) : (
                <span class="rsvp-row__message rsvp-row__message--empty" style="display: none;">-</span>
              )}
            </div>
            {index < guests.length - 1 && (
              <div class="rsvp-row__divider"></div>
            )}
          </div>
        ))
      )}
    </div>

    <!-- Pagination UI -->
    <div class="pagination-wrapper">
      <button class="pagination-btn" id="rsvpPrev" disabled>Prev</button>
      <div class="pagination-numbers" id="rsvpPageNumbers"></div>
      <button class="pagination-btn" id="rsvpNext" disabled>Next</button>
    </div>
  </div>
  
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('rsvpSearch');
      const filterSelect = document.getElementById('rsvpFilter');
      const exportBtn = document.getElementById('rsvpExport');
      const tableContainer = document.getElementById('rsvpTable');
      
      let currentPage = 1;
      const itemsPerPage = 10;
      let filteredRows = [];

      function filterGuests() {
        const rows = document.querySelectorAll('.rsvp-row-wrapper');
        if (!searchInput || !filterSelect) return;
        const query = searchInput.value.toLowerCase().trim();
        const status = filterSelect.value.toLowerCase();
        
        filteredRows = [];
        
        rows.forEach(row => {
          const rowName = row.getAttribute('data-name') || '';
          const rowStatus = row.getAttribute('data-status') || '';
          const hasMessage = row.getAttribute('data-has-message') === 'true';
          
          const matchesSearch = rowName.includes(query);
          let matchesStatus = false;
          if (status === 'all') {
            matchesStatus = true;
          } else if (status === 'with_message') {
            matchesStatus = hasMessage;
          } else if (status === 'tentative' || status === 'pending') {
            matchesStatus = rowStatus === 'tentative' || rowStatus === 'pending';
          } else {
            matchesStatus = rowStatus === status;
          }

          if (matchesSearch && matchesStatus) {
            filteredRows.push(row);
          } else {
            row.style.display = 'none';
          }
        });
        
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage) || 1;
        if (currentPage > totalPages) {
          currentPage = totalPages;
        }
        updatePagination();
      }

      function updatePagination() {
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage) || 1;
        
        filteredRows.forEach((row, index) => {
          const startIndex = (currentPage - 1) * itemsPerPage;
          const endIndex = startIndex + itemsPerPage;
          
          if (index >= startIndex && index < endIndex) {
            row.style.display = 'block';
          } else {
            row.style.display = 'none';
          }
        });

        const prevBtn = document.getElementById('rsvpPrev');
        const nextBtn = document.getElementById('rsvpNext');
        const pageNumbers = document.getElementById('rsvpPageNumbers');

        if (prevBtn) prevBtn.disabled = currentPage === 1;
        if (nextBtn) nextBtn.disabled = currentPage === totalPages;

        if (pageNumbers) {
          pageNumbers.innerHTML = '';
          
          function createBtn(i) {
            const btn = document.createElement('button');
            btn.className = `pagination-num ${i === currentPage ? 'pagination-num--active' : ''}`;
            btn.innerText = i;
            btn.onclick = () => { currentPage = i; updatePagination(); };
            return btn;
          }
          function createEllipsis() {
            const span = document.createElement('span');
            span.className = 'pagination-ellipsis';
            span.innerText = '...';
            return span;
          }

          if (totalPages <= 5) {
            for (let i = 1; i <= totalPages; i++) pageNumbers.appendChild(createBtn(i));
          } else {
            if (currentPage <= 3) {
              for (let i = 1; i <= 4; i++) pageNumbers.appendChild(createBtn(i));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(totalPages));
            } else if (currentPage >= totalPages - 2) {
              pageNumbers.appendChild(createBtn(1));
              pageNumbers.appendChild(createEllipsis());
              for (let i = totalPages - 3; i <= totalPages; i++) pageNumbers.appendChild(createBtn(i));
            } else {
              pageNumbers.appendChild(createBtn(1));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(currentPage - 1));
              pageNumbers.appendChild(createBtn(currentPage));
              pageNumbers.appendChild(createBtn(currentPage + 1));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(totalPages));
            }
          }
        }
      }

      const prevBtn = document.getElementById('rsvpPrev');
      const nextBtn = document.getElementById('rsvpNext');
      
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            updatePagination();
          }
        });
      }
      
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const totalPages = Math.ceil(filteredRows.length / itemsPerPage) || 1;
          if (currentPage < totalPages) {
            currentPage++;
            updatePagination();
          }
        });
      }

      if (searchInput) searchInput.addEventListener('input', () => { currentPage = 1; filterGuests(); });
      if (filterSelect) filterSelect.addEventListener('change', () => { currentPage = 1; filterGuests(); });
      
      // Delete RSVP action
      if (tableContainer) {
        tableContainer.addEventListener('click', async (e) => {
          const deleteBtn = e.target.closest('.rsvp-row__btn-delete');
          if (!deleteBtn) return;

          const rowWrapper = deleteBtn.closest('.rsvp-row-wrapper');
          if (!rowWrapper) return;

          const id = rowWrapper.getAttribute('data-id');
          const nameEl = rowWrapper.querySelector('.rsvp-row__name');
          const guestName = nameEl ? nameEl.innerText.trim() : 'tamu ini';

          if (!confirm(`Hapus konfirmasi RSVP dari "${guestName}"?`)) return;

          try {
            deleteBtn.disabled = true;
            deleteBtn.style.opacity = '0.5';

            const res = await fetch('/api/rsvp', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id })
            });

            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.error || 'Gagal menghapus data RSVP.');
            }

            // Remove row from DOM
            rowWrapper.remove();

            // Update summary counters
            const statusAttr = rowWrapper.getAttribute('data-status') || '';
            const paxAttr = parseInt(rowWrapper.getAttribute('data-pax') || '0', 10) || 0;
            const hasMsg = rowWrapper.getAttribute('data-has-message') === 'true';

            const statTotalRsvp = document.getElementById('statTotalRsvp');
            const statTotalPax = document.getElementById('statTotalPax');
            const statAttending = document.getElementById('statAttending');
            const statDeclined = document.getElementById('statDeclined');
            const statTentative = document.getElementById('statTentative');
            const statWishes = document.getElementById('statWishes');

            if (statTotalRsvp) {
              const cur = parseInt(statTotalRsvp.innerText, 10) || 0;
              statTotalRsvp.innerText = Math.max(0, cur - 1);
            }
            if (statTotalPax) {
              const cur = parseInt(statTotalPax.innerText, 10) || 0;
              statTotalPax.innerText = Math.max(0, cur - paxAttr);
            }
            if (statusAttr === 'attending' && statAttending) {
              const cur = parseInt(statAttending.innerText, 10) || 0;
              statAttending.innerText = Math.max(0, cur - 1);
            } else if (statusAttr === 'declined' && statDeclined) {
              const cur = parseInt(statDeclined.innerText, 10) || 0;
              statDeclined.innerText = Math.max(0, cur - 1);
            } else if ((statusAttr === 'tentative' || statusAttr === 'pending') && statTentative) {
              const cur = parseInt(statTentative.innerText, 10) || 0;
              statTentative.innerText = Math.max(0, cur - 1);
            }
            if (hasMsg && statWishes) {
              const cur = parseInt(statWishes.innerText, 10) || 0;
              statWishes.innerText = Math.max(0, cur - 1);
            }

            // Re-index remaining rows
            const allRows = document.querySelectorAll('.rsvp-row-wrapper');
            allRows.forEach((row, idx) => {
              const idxEl = row.querySelector('.rsvp-row__index');
              if (idxEl) {
                idxEl.innerText = (idx + 1).toString().padStart(2, '0');
              }
            });

            if (allRows.length === 0) {
              tableContainer.innerHTML = '<div class="rsvp-table__empty">Belum ada data RSVP</div>';
            }

            // Re-run filter and pagination
            filterGuests();
          } catch (err) {
            console.error('Error deleting RSVP:', err);
            alert(err.message || 'Terjadi kesalahan saat menghapus RSVP.');
            deleteBtn.disabled = false;
            deleteBtn.style.opacity = '1';
          }
        });
      }

      // Initialize on load
      filterGuests();

      if (exportBtn) {
        exportBtn.addEventListener('click', () => {
          if (typeof XLSX === 'undefined') {
            alert('Fitur export masih dimuat, silakan coba sebentar lagi.');
            return;
          }

          const ws_data = [
            ["No", "Nama Tamu", "Waktu RSVP", "Ucapan", "Status", "Pax"]
          ];
          let count = 1;
          
          // Export ALL filtered rows, not just the visible page
          filteredRows.forEach(row => {
            const nameEl = row.querySelector('.rsvp-row__name');
            const dateEl = row.querySelector('.rsvp-row__date');
            const statusAttr = row.getAttribute('data-status');
            const paxEl = row.querySelector('.rsvp-row__pax-val');
            const messageEl = row.querySelector('.rsvp-row__message');
            
            const name = nameEl ? nameEl.innerText : '';
            const dateText = dateEl ? dateEl.innerText : '';
            let statusText = 'Ragu';
            if (statusAttr === 'attending') statusText = 'Hadir';
            if (statusAttr === 'declined') statusText = 'Tidak Hadir';
            const pax = paxEl ? parseInt(paxEl.innerText) || 0 : 0;
            let message = messageEl ? messageEl.innerText : '';
            if (message === '-') message = '';
            
            if (message.startsWith('"') && message.endsWith('"')) {
               message = message.substring(1, message.length - 1);
            }
            
            ws_data.push([count, name, dateText, message, statusText, pax]);
            count++;
          });

          const ws = XLSX.utils.aoa_to_sheet(ws_data);
          
          // Set column widths agar rapi di Excel
          ws['!cols'] = [
            { wch: 5 },   // No
            { wch: 30 },  // Nama Tamu
            { wch: 20 },  // Waktu RSVP
            { wch: 50 },  // Ucapan
            { wch: 15 },  // Status
            { wch: 10 }   // Pax
          ];

          const wb = XLSX.utils.book_new();
          XLSX.utils.book_append_sheet(wb, ws, "RSVP");
          XLSX.writeFile(wb, "Data-RSVP.xlsx");
        });
      }
    });
  </script>
</ClientLayout>
