---
const { slug } = Astro.params;
const authRole = Astro.cookies.get('auth_role')?.value;
const authSlug = Astro.cookies.get('auth_slug')?.value;

if (!authRole || (authRole === 'client' && authSlug !== slug)) {
  return Astro.redirect('/?login=client');
}

import ClientLayout from "../../../layouts/ClientLayout.astro";
import { getSlugReportDetail } from "../../../services/dashboard-report";

const report = await getSlugReportDetail(slug);
if (!report) {
  return Astro.redirect('/dashboard');
}

const guests = report.rsvps;
---

<ClientLayout title="RSVP">
  <!-- Header / Title -->
  <div class="mb-6 fade-in-bottom">
    <h1 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface mb-2">RSVP</h1>
    <p class="font-body-md text-body-md text-outline">Kelola daftar kehadiran tamu undangan Anda.</p>
  </div>

  <!-- Summary Grid -->
  <div class="grid grid-cols-2 gap-4 mb-8 fade-in-bottom" style="animation-delay: 0.1s">
    <div class="bg-surface-container-lowest p-4 rounded-[24px] shadow-[0px_4px_20px_rgba(166,137,102,0.08)] bento-card">
      <div class="font-headline-md text-headline-md text-on-surface mb-1">{report.summary.rsvpCount}</div>
      <div class="font-label-sm text-label-sm text-outline">Total RSVP</div>
    </div>
    <div class="bg-surface-container-lowest p-4 rounded-[24px] shadow-[0px_4px_20px_rgba(166,137,102,0.08)] bento-card border-l-4 border-[#1e4620]">
      <div class="font-headline-md text-headline-md text-on-surface mb-1">{report.summary.attendingCount}</div>
      <div class="font-label-sm text-label-sm text-[#1e4620]">Hadir</div>
    </div>
    <div class="bg-surface-container-lowest p-4 rounded-[24px] shadow-[0px_4px_20px_rgba(166,137,102,0.08)] bento-card">
      <div class="font-headline-md text-headline-md text-on-surface mb-1">{report.summary.guestCount}</div>
      <div class="font-label-sm text-label-sm text-outline">Total Pax</div>
    </div>
    <div class="bg-surface-container-lowest p-4 rounded-[24px] shadow-[0px_4px_20px_rgba(166,137,102,0.08)] bento-card border-l-4 border-[#8e1a1a]">
      <div class="font-headline-md text-headline-md text-on-surface mb-1">{report.summary.declinedCount}</div>
      <div class="font-label-sm text-label-sm text-[#8e1a1a]">Tidak Hadir</div>
    </div>
  </div>

  <!-- Search & Filter Area -->
  <div class="fade-in-bottom" style="animation-delay: 0.2s">
    <div class="relative mb-4">
      <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
      <input type="text" placeholder="Cari nama tamu..." class="w-full bg-surface-container-lowest border border-outline-variant rounded-full py-3 pl-12 pr-4 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
    </div>
    <div class="flex items-center gap-2">
      <button class="px-6 py-2 rounded-full border border-primary text-primary font-label-md text-label-md flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">filter_list</span>
        Semua Status
      </button>
      <div class="flex-1 border-b border-tertiary opacity-10"></div>
    </div>
  </div>

  <!-- Guest List -->
  <div class="mt-6 space-y-3 fade-in-bottom" style="animation-delay: 0.3s">
    <!-- Header (Visual Guide) -->
    <div class="grid grid-cols-[40px_1fr_100px_40px] px-4 py-2 text-outline font-label-sm text-label-sm uppercase tracking-widest">
      <span>No.</span>
      <span>Nama Tamu</span>
      <span class="text-center">Status</span>
      <span></span>
    </div>

    <!-- Guest Items -->
    <div class="bg-surface-container-lowest rounded-[24px] p-2 shadow-[0px_4px_20px_rgba(166,137,102,0.08)]">
      {guests.length === 0 ? (
        <div class="p-6 text-center text-outline font-body-md">Belum ada data RSVP</div>
      ) : (
        guests.map((guest, index) => (
          <div>
            <div class="grid grid-cols-[40px_1fr_100px_40px] items-center p-4">
              <span class="font-label-md text-label-md text-outline">{(index + 1).toString().padStart(2, '0')}</span>
              <div class="flex flex-col">
                <span class="font-body-md font-bold text-on-surface truncate pr-2">{guest.guestName}</span>
                <span class="font-label-sm text-label-sm text-outline">Pax: {guest.guestCount}</span>
              </div>
              <div class="flex justify-center">
                {guest.attendanceStatus.toLowerCase() === 'attending' && (
                  <span class="bg-[#e7f3ea] text-[#1e4620] px-3 py-1 rounded-full font-label-sm text-label-sm font-bold uppercase text-[10px]">Hadir</span>
                )}
                {guest.attendanceStatus.toLowerCase() === 'declined' && (
                  <span class="bg-[#fceef0] text-[#8e1a1a] px-3 py-1 rounded-full font-label-sm text-label-sm font-bold uppercase text-[10px]">Tdk Hadir</span>
                )}
                {guest.attendanceStatus.toLowerCase() === 'pending' && (
                  <span class="bg-secondary-container text-secondary px-3 py-1 rounded-full font-label-sm text-label-sm font-bold uppercase text-[10px]">Pending</span>
                )}
              </div>
              <button class="p-2 hover:bg-surface-container-low rounded-full transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-outline text-[20px]">edit</span>
              </button>
            </div>
            {index < guests.length - 1 && (
              <div class="mx-4 border-b border-surface-variant h-[1px]"></div>
            )}
          </div>
        ))
      )}
    </div>
  </div>

  <!-- Concierge Tip Widget -->
  <div class="mt-8 p-6 rounded-[24px] bg-gradient-to-br from-secondary-fixed to-surface-container-low flex gap-4 items-center border border-outline-variant/30 fade-in-bottom" style="animation-delay: 0.4s">
    <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center shrink-0">
      <span class="material-symbols-outlined text-on-primary">support_agent</span>
    </div>
    <div>
      <h4 class="font-label-md text-label-md text-primary mb-1">Butuh Bantuan?</h4>
      <p class="font-body-md text-on-surface-variant text-[14px]">Ingin mengirimkan pengingat RSVP ke tamu yang belum merespon?</p>
    </div>
  </div>
</ClientLayout>
