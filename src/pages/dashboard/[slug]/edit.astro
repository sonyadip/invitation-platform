---
import { getSlugReportDetail } from '../../../services/dashboard-report';
import {
  parseInvitationForm,
  permanentlyDeleteInvitation,
  softDeleteInvitation,
  updateInvitation
} from '../../../services/dashboard-crud';
import { listTemplateKeys } from '../../../templates/registry';
import { hashPasswordSHA256 } from '../../../utils/security';

export const prerender = false;

const { slug } = Astro.params;
const templateOptions = listTemplateKeys();
const authRole = Astro.cookies.get('auth_role')?.value;

if (authRole !== 'admin') {
  return Astro.redirect('/?login=admin');
}

const toLocalInput = (value: string | null) => {
  if (!value) return '';
  const date = new Date(value);
  const offset = date.getTimezoneOffset();
  const local = new Date(date.getTime() - offset * 60 * 1000);
  return local.toISOString().slice(0, 16);
};

let detail = slug ? await getSlugReportDetail(slug) : null;
if (!detail) {
  return new Response('Report slug tidak ditemukan.', { status: 404 });
}

let errorMessage = '';
let successMessage = Astro.url.searchParams.get('created') ? 'Invitation created.' : '';
if (Astro.url.searchParams.get('duplicated')) {
  successMessage = 'Invitation duplicated. Review the copied data before publishing.';
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') || 'save');

  try {
    if (action === 'delete') {
      await softDeleteInvitation(detail.wedding.id);
      return Astro.redirect('/dashboard?deleted=1');
    }

    if (action === 'permanent-delete') {
      await permanentlyDeleteInvitation(detail.wedding.id);
      return Astro.redirect('/dashboard?permanentlyDeleted=1');
    }

    const parsed = parseInvitationForm(formData);
    const updatedSlug = await updateInvitation(detail.wedding.id, parsed);
    return Astro.redirect(`/dashboard/${updatedSlug}/edit?saved=1`);
  } catch (error) {
    console.error('Update invitation error:', error);
    errorMessage = error instanceof Error ? error.message : 'Failed to update invitation.';
  }
}

if (Astro.url.searchParams.get('saved')) {
  successMessage = 'Invitation saved.';
}

const settings = detail.settings;
const assets = settings?.assets || { heroImage: '', brideImage: '', groomImage: '', logoImage: '' };
const content = settings?.content || {
  instagramUrl: '',
  whatsappUrl: '',
  groomInstagramUrl: '',
  brideInstagramUrl: '',
  groomFatherName: '',
  groomMotherName: '',
  brideFatherName: '',
  brideMotherName: '',
  giftDescription: '',
  thankYouMessage: ''
};
const galleryImageUrls = detail.galleryImages.map((image) => image.imageUrl);
const galleryVideoUrls = content.galleryVideoUrls || [];
const eventValues = detail.events;
const storyValues = detail.wedding.story.length ? detail.wedding.story : [];
const giftValues = detail.gifts.length
  ? detail.gifts.map((gift) => ({
      bankName: gift.bankName,
      accountNumber: gift.accountNumber,
      accountName: gift.accountName,
      qrisUrl: gift.qrisUrl || ''
    }))
  : [];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit {detail.summary.slug} - Dashboard</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="shell">
      <header class="header">
        <div>
          <a class="back-link" href={`/dashboard/${detail.summary.slug}`}>Back to report</a>
          <p class="eyebrow">Dashboard CRUD</p>
          <h1>Edit Invitation</h1>
          <p class="subtitle">{detail.summary.slug} · {detail.summary.coupleName}</p>
        </div>
        <a class="secondary-action" href={`/${detail.summary.slug}`} target="_blank" rel="noopener noreferrer">Open invitation</a>
      </header>

      {successMessage && <div class="success-panel">{successMessage}</div>}
      {errorMessage && <div class="error-panel">{errorMessage}</div>}

      <form class="form-panel" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="action" value="save" />
        <section>
          <h2>Settings</h2>
          <div class="form-grid" style="margin-bottom: 18px;">
            <label>Slug<input name="slug" value={detail.wedding.slug} required /></label>
            <label>Status
              <select name="status">
                <option value="draft" selected={detail.wedding.status === 'draft'}>Draft</option>
                <option value="published" selected={detail.wedding.status === 'published'}>Published</option>
                <option value="archived" selected={detail.wedding.status === 'archived'}>Archived</option>
              </select>
            </label>
            <label>Template
              <select name="template">
                {templateOptions.map((template) => (
                  <option value={template} selected={detail.wedding.template === template}>{template}</option>
                ))}
              </select>
            </label>
            <label>Access Password<input name="accessPassword" value={settings?.accessPassword || ''} /></label>
            <label>Client Password<input name="clientPassword" placeholder="Keep empty to keep existing" /></label>
            <label>Expiration Date<input type="datetime-local" name="expirationDate" value={toLocalInput(settings?.expirationDate || null)} /></label>
          </div>
          <div class="toggle-grid">
            <label><input type="checkbox" name="rsvpEnabled" checked={settings?.rsvpEnabled ?? true} /> RSVP</label>
            <label><input type="checkbox" name="musicEnabled" checked={settings?.musicEnabled ?? true} /> Music</label>
            <label><input type="checkbox" name="countdownEnabled" checked={settings?.countdownEnabled ?? true} /> Countdown</label>
            <label><input type="checkbox" name="galleryEnabled" checked={settings?.galleryEnabled ?? true} /> Gallery</label>
            <label><input type="checkbox" name="wishesEnabled" checked={settings?.wishesEnabled ?? true} /> Wishes</label>
            <label><input type="checkbox" name="giftEnabled" checked={settings?.giftEnabled ?? true} /> Gift</label>
            <label><input type="checkbox" name="storyEnabled" checked={settings?.storyEnabled ?? true} /> Our Story</label>
            <label><input type="checkbox" name="viewCounterEnabled" checked={settings?.viewCounterEnabled ?? true} /> View Counter</label>
            <label><input type="checkbox" name="maintenanceMode" checked={settings?.maintenanceMode ?? false} /> Maintenance</label>
            <label><input type="checkbox" name="passwordProtectionEnabled" checked={settings?.passwordProtectionEnabled ?? false} /> Password Protection</label>
          </div>
        </section>

        <section>
          <h2>Opening</h2>
          <div class="form-grid">
            <label class="wide">Logo Image URL<input name="logoImageUrl" value={assets.logoImage} placeholder="https://example.com/logo.png" /></label>
            <label class="wide">Upload Logo Image<input type="file" name="logoImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label class="wide">Popup / Hero Image URL<input name="heroImageUrl" value={assets.heroImage} placeholder="https://example.com/hero.jpg" /></label>
            <label class="wide">Upload Popup / Hero Image<input type="file" name="heroImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label class="wide">Hero Video URL<input name="heroVideoUrl" value={assets.heroVideo || ''} placeholder="https://example.com/hero.mp4" /></label>
            <label class="wide">Intro Verse<textarea name="introVerse" rows="4">{content.introVerse || ''}</textarea></label>
            <label>Intro Verse Source<input name="introVerseSource" value={content.introVerseSource || ''} placeholder="(Rgveda : X.85.42)" /></label>
            <label>Instagram URL<input name="instagramUrl" value={content.instagramUrl || ''} placeholder="https://www.instagram.com/username" /></label>
          </div>
        </section>

        <section>
          <h2>Couple</h2>
          <div class="couple-grid">
            <fieldset class="couple-card">
              <legend>Groom</legend>
              <div class="form-grid">
                <label>Groom Name<input name="groomName" value={detail.wedding.groomName} required /></label>
                <label>Groom Full Name<input name="groomFullName" value={detail.wedding.groomFullName} required /></label>
                <label>Groom Father Name<input name="groomFatherName" value={content.groomFatherName || ''} placeholder="Groom father name" /></label>
                <label>Groom Mother Name<input name="groomMotherName" value={content.groomMotherName || ''} placeholder="Groom mother name" /></label>
                <label>Groom Anak Ke-<input name="groomChildNumber" value={content.groomChildNumber || ''} placeholder="pertama" /></label>
                <label>Groom Image URL<input name="groomImageUrl" value={assets.groomImage} placeholder="https://example.com/groom.jpg" /></label>
                <label>Upload Groom Image<input type="file" name="groomImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                <label class="wide">Groom Instagram URL<input name="groomInstagramUrl" value={content.groomInstagramUrl || content.instagramUrl} placeholder="https://www.instagram.com/username" /></label>
              </div>
            </fieldset>
            <fieldset class="couple-card">
              <legend>Bride</legend>
              <div class="form-grid">
                <label>Bride Name<input name="brideName" value={detail.wedding.brideName} required /></label>
                <label>Bride Full Name<input name="brideFullName" value={detail.wedding.brideFullName} required /></label>
                <label>Bride Father Name<input name="brideFatherName" value={content.brideFatherName || ''} placeholder="Bride father name" /></label>
                <label>Bride Mother Name<input name="brideMotherName" value={content.brideMotherName || ''} placeholder="Bride mother name" /></label>
                <label>Bride Anak Ke-<input name="brideChildNumber" value={content.brideChildNumber || ''} placeholder="kedua" /></label>
                <label>Bride Image URL<input name="brideImageUrl" value={assets.brideImage} placeholder="https://example.com/bride.jpg" /></label>
                <label>Upload Bride Image<input type="file" name="brideImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                <label class="wide">Bride Instagram URL<input name="brideInstagramUrl" value={content.brideInstagramUrl || content.instagramUrl} placeholder="https://www.instagram.com/username" /></label>
              </div>
            </fieldset>
          </div>
        </section>

        <section>
          <h2>Events</h2>
          <div class="event-list" id="events_container">
            {eventValues.map((event, index) => (
              <fieldset class="event-card repeater-item">
                <legend>Event <span class="idx">{index + 1}</span></legend>
                <div class="form-grid">
                  <label>Event Name<input name="eventName" value={event.name} required={index === 0} placeholder="Akad Nikah" /></label>
                  <label>Date<input type="datetime-local" name="eventDate" value={toLocalInput(event.date)} required={index === 0} /></label>
                  <label>Start Time<input type="time" name="eventStartTime" value={event.startTime} /></label>
                  <label>End Time<input name="eventEndTime" value={event.endTime} placeholder="Selesai" /></label>
                  <label>Venue Name<input name="eventVenueName" value={event.venueName} required={index === 0} /></label>
                  <label>Maps URL<input name="eventMapsUrl" value={event.mapsUrl} required={index === 0} /></label>
                  <label class="wide">Venue Address<textarea name="eventVenueAddress" rows="3" required={index === 0}>{event.venueAddress}</textarea></label>
                </div>
                {index > 0 && <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Hapus Event</button>}
              </fieldset>
            ))}
          </div>
          <button type="button" id="add_event_btn" class="secondary-action" style="margin-top: 16px;">+ Tambah Event</button>
        </section>

        <section data-setting-target="storyEnabled">
          <h2>Our Story</h2>
          <div class="story-list" id="stories_container">
            {storyValues.map((story, index) => (
              <fieldset class="story-card repeater-item">
                <legend>Story <span class="idx">{index + 1}</span></legend>
                <div class="form-grid">
                  <label>Title<input name="storyTitle" value={story.title} placeholder="AWAL BERTEMU" /></label>
                  <label class="wide">Description<textarea name="storyDescription" rows="3">{story.description}</textarea></label>
                </div>
                <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Hapus Story</button>
              </fieldset>
            ))}
          </div>
          <button type="button" id="add_story_btn" class="secondary-action" style="margin-top: 16px;">+ Tambah Story</button>
        </section>

        <section data-setting-target="galleryEnabled">
          <h2>Gallery</h2>
          <div class="gallery-list" id="gallery_container">
            {galleryImageUrls.map((url, index) => (
              <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
                <label style="flex: 1; margin: 0;">Image URL <span class="idx">{index + 1}</span><input name="galleryImageUrl" value={url} placeholder="https://example.com/gallery.jpg" /></label>
                <button type="button" class="remove-btn secondary-action">Hapus</button>
              </div>
            ))}
          </div>
          <button type="button" id="add_gallery_btn" class="secondary-action" style="margin-top: 10px; margin-bottom: 16px;">+ Tambah Image URL</button>
          <div class="form-grid" style="margin-bottom: 24px;">
            <label class="wide">Upload Gallery Images<input type="file" name="galleryImageFiles" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple /></label>
          </div>

          <h3 style="margin-top: 24px; margin-bottom: 12px; font-size: 15px;">Gallery Videos</h3>
          <div class="gallery-video-list" id="gallery_videos_container">
            {galleryVideoUrls.map((url, index) => (
              <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
                <label style="flex: 1; margin: 0;">Video URL <span class="idx">{index + 1}</span><input name="galleryVideoUrl" value={url} placeholder="https://www.youtube.com/watch?v=..." /></label>
                <button type="button" class="remove-btn secondary-action">Hapus</button>
              </div>
            ))}
          </div>
          <button type="button" id="add_gallery_video_btn" class="secondary-action" style="margin-top: 10px;">+ Tambah Video URL</button>
        </section>

        <section>
          <h2>Gift & Thank You</h2>
          <div class="gift-list" id="gifts_container">
            {giftValues.map((gift, index) => (
              <fieldset class="gift-card-form repeater-item">
                <legend>Gift Card <span class="idx">{index + 1}</span></legend>
                <div class="form-grid">
                  <label>Bank Name<input name="giftBankName" value={gift.bankName} placeholder="BCA" /></label>
                  <label>Account Number<input name="giftAccountNumber" value={gift.accountNumber} placeholder="1234567890" /></label>
                  <label>Account Name<input name="giftAccountName" value={gift.accountName} placeholder="Account holder name" /></label>
                  <label>QRIS URL<input name="giftQrisUrl" value={gift.qrisUrl} placeholder="https://example.com/qris.png" /></label>
                </div>
                <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Hapus Gift Card</button>
              </fieldset>
            ))}
          </div>
          <button type="button" id="add_gift_btn" class="secondary-action" style="margin-top: 16px; margin-bottom: 24px;">+ Tambah Gift Card</button>
          <div class="form-grid">
            <label class="wide">Wedding Gift Description<textarea name="giftDescription" rows="4">{content.giftDescription || ''}</textarea></label>
            <label class="wide">Thank You Message<textarea name="thankYouMessage" rows="4">{content.thankYouMessage || ''}</textarea></label>
          </div>
        </section>



        <section data-setting-target="musicEnabled">
          <h2>Music</h2>
          <div class="form-grid">
            <label class="wide">Music URL<input name="musicUrl" value={detail.wedding.musicUrl || ''} /></label>
          </div>
        </section>

        <footer class="form-actions">
          <a href={`/dashboard/${detail.summary.slug}`}>Cancel</a>
          <button type="submit">Save Changes</button>
        </footer>
      </form>

      <form class="danger-panel" method="POST">
        <input type="hidden" name="action" value="delete" />
        <div>
          <h2>Soft Delete Invitation</h2>
          <p>Soft delete hides this slug from public routes and reports without removing related RSVP or view data.</p>
        </div>
        <button type="submit" onclick="return confirm('Soft delete this invitation?')">Soft Delete</button>
      </form>

      <form class="danger-panel danger-panel--permanent" method="POST">
        <input type="hidden" name="action" value="permanent-delete" />
        <div>
          <h2>Permanent Delete Invitation</h2>
          <p>Permanently delete this slug, related database rows, and Supabase Storage images that are not used by another invitation.</p>
        </div>
        <button
          type="submit"
          onclick="return confirm('Permanently delete this invitation and unshared Supabase images? This cannot be undone.')"
        >
          Permanent Delete
        </button>
      </form>
    </main>
    <template id="event_template">
      <fieldset class="event-card repeater-item">
        <legend>Event <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Event Name<input name="eventName" placeholder="Akad Nikah" /></label>
          <label>Date<input type="datetime-local" name="eventDate" /></label>
          <label>Start Time<input type="time" name="eventStartTime" /></label>
          <label>End Time<input name="eventEndTime" placeholder="Selesai" /></label>
          <label>Venue Name<input name="eventVenueName" /></label>
          <label>Maps URL<input name="eventMapsUrl" /></label>
          <label class="wide">Venue Address<textarea name="eventVenueAddress" rows="3"></textarea></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Hapus Event</button>
      </fieldset>
    </template>

    <template id="story_template">
      <fieldset class="story-card repeater-item">
        <legend>Story <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Title<input name="storyTitle" placeholder="AWAL BERTEMU" /></label>
          <label class="wide">Description<textarea name="storyDescription" rows="3"></textarea></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Hapus Story</button>
      </fieldset>
    </template>

    <template id="gallery_template">
      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
        <label style="flex: 1; margin: 0;">Image URL <span class="idx"></span><input name="galleryImageUrl" placeholder="https://example.com/gallery.jpg" /></label>
        <button type="button" class="remove-btn secondary-action">Hapus</button>
      </div>
    </template>

    <template id="gallery_video_template">
      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
        <label style="flex: 1; margin: 0;">Video URL <span class="idx"></span><input name="galleryVideoUrl" placeholder="https://www.youtube.com/watch?v=..." /></label>
        <button type="button" class="remove-btn secondary-action">Hapus</button>
      </div>
    </template>

    <template id="gift_template">
      <fieldset class="gift-card-form repeater-item">
        <legend>Gift Card <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Bank Name<input name="giftBankName" placeholder="BCA" /></label>
          <label>Account Number<input name="giftAccountNumber" placeholder="1234567890" /></label>
          <label>Account Name<input name="giftAccountName" placeholder="Account holder name" /></label>
          <label>QRIS URL<input name="giftQrisUrl" placeholder="https://example.com/qris.png" /></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Hapus Gift Card</button>
      </fieldset>
    </template>

    <script>
      function setupRepeater(containerId, btnId, templateId) {
        const container = document.getElementById(containerId);
        const btn = document.getElementById(btnId);
        const template = document.getElementById(templateId);

        if (!container || !btn || !template) return;

        function updateIndexes() {
          const items = container.querySelectorAll('.repeater-item');
          items.forEach((item, index) => {
            const idxSpan = item.querySelector('.idx');
            if (idxSpan) idxSpan.textContent = index + 1;
          });
        }

        btn.addEventListener('click', () => {
          const clone = template.content.cloneNode(true);
          container.appendChild(clone);
          updateIndexes();
        });

        container.addEventListener('click', (e) => {
          if (e.target.classList.contains('remove-btn')) {
            const item = e.target.closest('.repeater-item');
            if (item) {
              item.remove();
              updateIndexes();
            }
          }
        });
      }

      setupRepeater('events_container', 'add_event_btn', 'event_template');
      setupRepeater('stories_container', 'add_story_btn', 'story_template');
      setupRepeater('gallery_container', 'add_gallery_btn', 'gallery_template');
      setupRepeater('gallery_videos_container', 'add_gallery_video_btn', 'gallery_video_template');
      setupRepeater('gifts_container', 'add_gift_btn', 'gift_template');

      const settingTargets = document.querySelectorAll('[data-setting-target]');

      function syncSettingTargets() {
        settingTargets.forEach((target) => {
          const toggleName = target.getAttribute('data-setting-target');
          const toggle = toggleName ? document.querySelector(`input[name="${toggleName}"]`) : null;
          if (!(toggle instanceof HTMLInputElement)) return;

          target.hidden = !toggle.checked;
        });
      }

      document
        .querySelectorAll('.toggle-grid input[type="checkbox"]')
        .forEach((toggle) => toggle.addEventListener('change', syncSettingTargets));

      syncSettingTargets();
    </script>
  </body>
</html>

<style lang="scss">
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f4f5f7;
    color: #20242c;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .shell { width: min(1100px, 100%); margin: 0 auto; padding: 28px; }
  .header { display: flex; justify-content: space-between; align-items: flex-end; gap: 18px; margin-bottom: 22px; }
  .back-link { display: inline-flex; margin-bottom: 18px; color: #2563eb; font-size: 13px; font-weight: 700; text-decoration: none; }
  .secondary-action { min-height: 40px; display: inline-flex; align-items: center; padding: 0 14px; border: 1px solid #d9dde5; border-radius: 6px; background: #ffffff; color: #394150; font-size: 13px; font-weight: 700; text-decoration: none; }
  .eyebrow { margin: 0 0 8px; color: #687080; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0 0 8px; font-size: 32px; }
  h2 { margin: 0 0 16px; font-size: 18px; }
  .subtitle { margin: 0; color: #687080; font-size: 14px; }
  .form-panel, .error-panel, .success-panel, .danger-panel {
    border: 1px solid #d9dde5;
    border-radius: 8px;
    background: #ffffff;
  }
  .error-panel, .success-panel { margin-bottom: 16px; padding: 14px 16px; }
  .error-panel { color: #991b1b; background: #fff5f5; }
  .success-panel { color: #047857; background: #ecfdf5; }
  section { padding: 20px; border-bottom: 1px solid #eef0f4; }
  section[hidden] { display: none; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .couple-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .event-list, .story-list, .gift-list { display: grid; gap: 14px; }
  .event-card, .story-card, .couple-card, .gift-card-form { margin: 0; padding: 16px; border: 1px solid #eef0f4; border-radius: 8px; }
  .event-card legend, .story-card legend, .couple-card legend, .gift-card-form legend { padding: 0 6px; color: #687080; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  label { display: grid; gap: 7px; color: #394150; font-size: 13px; font-weight: 700; }
  label.wide { grid-column: 1 / -1; }
  input, select, textarea {
    width: 100%;
    min-height: 42px;
    padding: 9px 11px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font: inherit;
    font-weight: 400;
  }
  textarea { resize: vertical; }
  .toggle-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
  .toggle-grid label { display: flex; align-items: center; gap: 8px; padding: 10px; border: 1px solid #eef0f4; border-radius: 6px; }
