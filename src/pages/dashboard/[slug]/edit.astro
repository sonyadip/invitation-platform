            <!-- SECTION 9: RSVP & Countdown Media -->
            <section class="collapsible-section is-collapsed" id="sec-countdown">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">💌</span>
                  <div>
                    <h2>RSVP & Countdown Media</h2>
                    <p class="section-sub">Background banners and illustration assets for RSVP and countdown sections.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="form-grid">
                  <label class="wide">RSVP Image URL<input name="rsvpImageUrl" value={assets.rsvpImage || ''} placeholder="https://example.com/rsvp.jpg" /></label>
                  <label class="wide">Upload RSVP Image<input type="file" name="rsvpImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                  <label class="wide">Countdown Image URL<input name="countdownImageUrl" value={assets.countdownImage || ''} placeholder="https://example.com/countdown.jpg" /></label>
                  <label class="wide">Upload Countdown Image<input type="file" name="countdownImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                </div>
              </div>
