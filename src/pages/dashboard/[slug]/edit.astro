---
import { getSlugReportDetail } from '../../../services/dashboard-report';
import {
  parseInvitationForm,
  permanentlyDeleteInvitation,
  softDeleteInvitation,
  updateInvitation
} from '../../../services/dashboard-crud';
import { listTemplateKeys } from '../../../templates/registry';
import { hashPasswordSHA256 } from '../../../utils/security';

export const prerender = false;

const { slug } = Astro.params;
const dashboardPassword =
  import.meta.env.DASHBOARD_PASSWORD ||
  (typeof process !== 'undefined' ? process.env.DASHBOARD_PASSWORD : '') ||
  '';
const cookieName = 'dashboard_unlocked';
const templateOptions = listTemplateKeys();
const isUnlocked = !dashboardPassword ||
  Astro.cookies.get(cookieName)?.value === await hashPasswordSHA256(dashboardPassword);

if (!isUnlocked) {
  return Astro.redirect('/dashboard');
}

const toLocalInput = (value: string | null) => {
  if (!value) return '';
  const date = new Date(value);
  const offset = date.getTimezoneOffset();
  const local = new Date(date.getTime() - offset * 60 * 1000);
  return local.toISOString().slice(0, 16);
};

let detail = slug ? await getSlugReportDetail(slug) : null;
if (!detail) {
  return new Response('Report slug tidak ditemukan.', { status: 404 });
}

let errorMessage = '';
let successMessage = Astro.url.searchParams.get('created') ? 'Invitation created.' : '';
if (Astro.url.searchParams.get('duplicated')) {
  successMessage = 'Invitation duplicated. Review the copied data before publishing.';
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') || 'save');

  try {
    if (action === 'delete') {
      await softDeleteInvitation(detail.wedding.id);
      return Astro.redirect('/dashboard?deleted=1');
    }

    if (action === 'permanent-delete') {
      await permanentlyDeleteInvitation(detail.wedding.id);
      return Astro.redirect('/dashboard?permanentlyDeleted=1');
    }

    const parsed = parseInvitationForm(formData);
    const updatedSlug = await updateInvitation(detail.wedding.id, parsed);
    return Astro.redirect(`/dashboard/${updatedSlug}/edit?saved=1`);
  } catch (error) {
    console.error('Update invitation error:', error);
    errorMessage = error instanceof Error ? error.message : 'Failed to update invitation.';
  }
}

if (Astro.url.searchParams.get('saved')) {
  successMessage = 'Invitation saved.';
}

const settings = detail.settings;
const assets = settings?.assets || { heroImage: '', brideImage: '', groomImage: '' };
const galleryImageUrls = detail.galleryImages.map((image) => image.imageUrl).join('\n');
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit {detail.summary.slug} - Dashboard</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="shell">
      <header class="header">
        <div>
          <a class="back-link" href={`/dashboard/${detail.summary.slug}`}>Back to report</a>
          <p class="eyebrow">Dashboard CRUD</p>
          <h1>Edit Invitation</h1>
          <p class="subtitle">{detail.summary.slug} · {detail.summary.coupleName}</p>
        </div>
        <a class="secondary-action" href={`/${detail.summary.slug}`} target="_blank" rel="noopener noreferrer">Open invitation</a>
      </header>

      {successMessage && <div class="success-panel">{successMessage}</div>}
      {errorMessage && <div class="error-panel">{errorMessage}</div>}

      <form class="form-panel" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="action" value="save" />
        <section>
          <h2>Core Data</h2>
          <div class="form-grid">
            <label>Slug<input name="slug" value={detail.wedding.slug} required /></label>
            <label>Status
              <select name="status">
                <option value="draft" selected={detail.wedding.status === 'draft'}>Draft</option>
                <option value="published" selected={detail.wedding.status === 'published'}>Published</option>
                <option value="archived" selected={detail.wedding.status === 'archived'}>Archived</option>
              </select>
            </label>
            <label>Template
              <select name="template">
                {templateOptions.map((template) => (
                  <option value={template} selected={detail.wedding.template === template}>{template}</option>
                ))}
              </select>
            </label>
            <label>Wedding Date<input type="datetime-local" name="weddingDate" value={toLocalInput(detail.wedding.weddingDate)} required /></label>
            <label>Groom Name<input name="groomName" value={detail.wedding.groomName} required /></label>
            <label>Bride Name<input name="brideName" value={detail.wedding.brideName} required /></label>
            <label>Groom Full Name<input name="groomFullName" value={detail.wedding.groomFullName} required /></label>
            <label>Bride Full Name<input name="brideFullName" value={detail.wedding.brideFullName} required /></label>
            <label>Venue Name<input name="venueName" value={detail.wedding.venueName} required /></label>
            <label>Maps URL<input name="mapsUrl" value={detail.wedding.mapsUrl} required /></label>
            <label class="wide">Venue Address<textarea name="venueAddress" rows="3" required>{detail.wedding.venueAddress}</textarea></label>
            <label class="wide">Music URL<input name="musicUrl" value={detail.wedding.musicUrl || ''} /></label>
          </div>
        </section>

        <section>
          <h2>Images</h2>
          <div class="form-grid">
            <label class="wide">Hero / Cover Image URL<input name="heroImageUrl" value={assets.heroImage} placeholder="https://example.com/hero.jpg" /></label>
            <label class="wide">Upload Hero / Cover Image<input type="file" name="heroImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label>Bride Image URL<input name="brideImageUrl" value={assets.brideImage} placeholder="https://example.com/bride.jpg" /></label>
            <label>Upload Bride Image<input type="file" name="brideImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label>Groom Image URL<input name="groomImageUrl" value={assets.groomImage} placeholder="https://example.com/groom.jpg" /></label>
            <label>Upload Groom Image<input type="file" name="groomImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
            <label class="wide">Gallery Image URLs<textarea name="galleryImageUrls" rows="6" placeholder={"https://example.com/gallery-1.jpg\nhttps://example.com/gallery-2.jpg"}>{galleryImageUrls}</textarea></label>
            <label class="wide">Upload Gallery Images<input type="file" name="galleryImageFiles" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple /></label>
          </div>
        </section>

        <section>
          <h2>Settings</h2>
          <div class="toggle-grid">
            <label><input type="checkbox" name="rsvpEnabled" checked={settings?.rsvpEnabled ?? true} /> RSVP</label>
            <label><input type="checkbox" name="musicEnabled" checked={settings?.musicEnabled ?? true} /> Music</label>
            <label><input type="checkbox" name="countdownEnabled" checked={settings?.countdownEnabled ?? true} /> Countdown</label>
            <label><input type="checkbox" name="galleryEnabled" checked={settings?.galleryEnabled ?? true} /> Gallery</label>
            <label><input type="checkbox" name="wishesEnabled" checked={settings?.wishesEnabled ?? true} /> Wishes</label>
            <label><input type="checkbox" name="giftEnabled" checked={settings?.giftEnabled ?? true} /> Gift</label>
            <label><input type="checkbox" name="viewCounterEnabled" checked={settings?.viewCounterEnabled ?? true} /> View Counter</label>
            <label><input type="checkbox" name="maintenanceMode" checked={settings?.maintenanceMode ?? false} /> Maintenance</label>
            <label><input type="checkbox" name="passwordProtectionEnabled" checked={settings?.passwordProtectionEnabled ?? false} /> Password Protection</label>
          </div>
          <div class="form-grid">
            <label>Access Password<input name="accessPassword" /></label>
            <label>Expiration Date<input type="datetime-local" name="expirationDate" value={toLocalInput(settings?.expirationDate || null)} /></label>
          </div>
        </section>

        <footer class="form-actions">
          <a href={`/dashboard/${detail.summary.slug}`}>Cancel</a>
          <button type="submit">Save Changes</button>
        </footer>
      </form>

      <form class="danger-panel" method="POST">
        <input type="hidden" name="action" value="delete" />
        <div>
          <h2>Soft Delete Invitation</h2>
          <p>Soft delete hides this slug from public routes and reports without removing related RSVP or view data.</p>
        </div>
        <button type="submit" onclick="return confirm('Soft delete this invitation?')">Soft Delete</button>
      </form>

      <form class="danger-panel danger-panel--permanent" method="POST">
        <input type="hidden" name="action" value="permanent-delete" />
        <div>
          <h2>Permanent Delete Invitation</h2>
          <p>Permanently delete this slug, related database rows, and Supabase Storage images that are not used by another invitation.</p>
        </div>
        <button
          type="submit"
          onclick="return confirm('Permanently delete this invitation and unshared Supabase images? This cannot be undone.')"
        >
          Permanent Delete
        </button>
      </form>
    </main>
  </body>
</html>

<style lang="scss">
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f4f5f7;
    color: #20242c;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .shell { width: min(1100px, 100%); margin: 0 auto; padding: 28px; }
  .header { display: flex; justify-content: space-between; align-items: flex-end; gap: 18px; margin-bottom: 22px; }
  .back-link { display: inline-flex; margin-bottom: 18px; color: #2563eb; font-size: 13px; font-weight: 700; text-decoration: none; }
  .secondary-action { min-height: 40px; display: inline-flex; align-items: center; padding: 0 14px; border: 1px solid #d9dde5; border-radius: 6px; background: #ffffff; color: #394150; font-size: 13px; font-weight: 700; text-decoration: none; }
  .eyebrow { margin: 0 0 8px; color: #687080; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0 0 8px; font-size: 32px; }
  h2 { margin: 0 0 16px; font-size: 18px; }
  .subtitle { margin: 0; color: #687080; font-size: 14px; }
  .form-panel, .error-panel, .success-panel, .danger-panel {
    border: 1px solid #d9dde5;
    border-radius: 8px;
    background: #ffffff;
  }
  .error-panel, .success-panel { margin-bottom: 16px; padding: 14px 16px; }
  .error-panel { color: #991b1b; background: #fff5f5; }
  .success-panel { color: #047857; background: #ecfdf5; }
  section { padding: 20px; border-bottom: 1px solid #eef0f4; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  label { display: grid; gap: 7px; color: #394150; font-size: 13px; font-weight: 700; }
  label.wide { grid-column: 1 / -1; }
  input, select, textarea {
    width: 100%;
    min-height: 42px;
    padding: 9px 11px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font: inherit;
    font-weight: 400;
  }
  textarea { resize: vertical; }
  .toggle-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
  .toggle-grid label { display: flex; align-items: center; gap: 8px; padding: 10px; border: 1px solid #eef0f4; border-radius: 6px; }
  .toggle-grid input { width: 16px; min-height: 16px; }
  .form-actions, .danger-panel { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 20px; }
  .form-actions a, .form-actions button, .danger-panel button {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: 6px;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
  }
  .form-actions a { border: 1px solid #d9dde5; color: #394150; }
  .form-actions button { border: 0; background: #111827; color: #ffffff; cursor: pointer; }
  .danger-panel { margin-top: 18px; border-color: #fecdd3; background: #fff7f8; }
  .danger-panel h2 { margin-bottom: 6px; color: #9f1239; }
  .danger-panel p { margin: 0; color: #687080; font-size: 13px; }
  .danger-panel button { border: 0; background: #be123c; color: #ffffff; cursor: pointer; }
  .danger-panel--permanent { border-color: #991b1b; background: #fff1f2; }
  .danger-panel--permanent button { background: #7f1d1d; }
  @media (max-width: 720px) {
    .shell { padding: 18px; }
    .header, .form-actions, .danger-panel { align-items: flex-start; flex-direction: column; }
    .form-grid, .toggle-grid { grid-template-columns: 1fr; }
  }
</style>
