            <!-- SECTION 8: Gallery & Media -->
            <section class="collapsible-section is-collapsed" id="sec-gallery" data-setting-target="galleryEnabled">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">🖼️</span>
                  <div>
                    <h2>Photo & Video Gallery</h2>
                    <p class="section-sub">Prewedding photos, gallery grid, and embedded YouTube / Vimeo video URLs.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="badge-count">{galleryImageUrls.length} Photos</span>
                  <span class="chevron material-symbols-outlined">expand_more</span>
