              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">🎵</span>
                  <div>
                    <h2>Background Music</h2>
                    <p class="section-sub">Audio stream URL or uploaded background soundtrack.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="form-grid">
                  <label class="wide">Music Audio URL<input name="musicUrl" value={detail.wedding.musicUrl || ''} placeholder="https://example.com/audio.mp3" /></label>
                  <label class="wide">Upload Music File (MP3 / AAC / WAV)<input type="file" name="musicFile" accept="audio/*,.mp3,.wav,.ogg,.aac,.m4a,.webm" /></label>
