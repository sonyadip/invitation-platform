                        <label>Bank / E-Wallet Name<input name="giftBankName" value={gift.bankName} placeholder="BCA / Chase / PayPal" /></label>
                        <label>Account Number<input name="giftAccountNumber" value={gift.accountNumber} placeholder="1234567890" /></label>
                        <label>Account Holder Name<input name="giftAccountName" value={gift.accountName} placeholder="Account holder name" /></label>
