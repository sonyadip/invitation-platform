            <!-- SECTION 10: Gifts & Digital Accounts -->
            <section class="collapsible-section is-collapsed" id="sec-gifts" data-setting-target="giftEnabled">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">🎁</span>
                  <div>
                    <h2>Gifts & Bank Accounts</h2>
                    <p class="section-sub">Digital gift envelope accounts, bank transfers, QRIS, and thank you remarks.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="badge-count">{giftValues.length} Accounts</span>
