            <!-- SECTION 12: Revision Note -->
            <section class="collapsible-section memo-section is-collapsed" id="sec-revision">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">📝</span>
                  <div>
                    <h2>Revision Note / Memo (Optional)</h2>
                    <p class="section-sub">Summarize changes made in this version for version control audit history.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="form-grid single-col">
                  <label>
                    Version Memo Note
                    <input type="text" name="revisionNote" placeholder="e.g., Updated reception start time to 19:00 and added new gallery photos" />
                  </label>
                </div>
              </div>
            </section>

            <!-- Form Actions Footer -->
            <footer class="form-actions">
              <a class="cancel-link" href={`/dashboard/${detail.summary.slug}`}>Cancel</a>
              <button type="submit" class="save-primary-btn">Save Changes</button>
            </footer>
          </form>
        </div>

        <!-- Sticky Right Sidebar -->
        <aside class="editor-sidebar">
          <div class="sticky-box">
            <div class="sidebar-header">
              <div>
                <span class="sidebar-eyebrow">Quick Action Hub</span>
                <h4 class="sidebar-title">{detail.summary.slug}</h4>
              </div>
              <span class={`status-pill status-pill--${detail.wedding.status}`}>{detail.wedding.status}</span>
            </div>

            <!-- Primary Action Button -->
            <div class="sidebar-main-actions">
              <button type="button" class="sidebar-save-btn" id="sidebar-save-trigger">
                <span class="material-symbols-outlined">save</span>
                <span>Save Changes</span>
              </button>
              <p class="save-shortcut-hint">Shortcut: <kbd>Ctrl</kbd> + <kbd>S</kbd></p>
            </div>



            <!-- Section Toggle Bar -->
            <div class="sidebar-view-toggles">
              <span class="nav-heading">Section Visibility</span>
              <div class="toggle-btn-row">
                <button type="button" class="view-toggle-btn" id="sidebar-expand-btn">
                  <span class="material-symbols-outlined">unfold_more</span> Expand All
                </button>
                <button type="button" class="view-toggle-btn" id="sidebar-collapse-btn">
                  <span class="material-symbols-outlined">unfold_less</span> Collapse All
                </button>
              </div>
            </div>

            <!-- Danger Zone Action Buttons (Collapsible) -->
            <details class="sidebar-danger-zone">
              <summary class="danger-heading">
                <span>⚠️ Danger Zone</span>
                <span class="material-symbols-outlined danger-chevron">expand_more</span>
              </summary>
              <div class="danger-btn-list">
                <form method="POST">
                  <input type="hidden" name="action" value="reset-views" />
                  <button
                    type="submit"
                    class="sidebar-danger-btn"
                    data-confirm="Reset page views for this invitation to zero?"
                    data-confirm-title="Reset Page Views"
                    data-confirm-text="Reset Views"
                    data-cancel-text="Cancel"
                    data-confirm-variant="warning"
                  >
                    <span class="material-symbols-outlined">restart_alt</span>
                    <span>Reset Views</span>
                  </button>
                </form>

                <form method="POST">
                  <input type="hidden" name="action" value="reset-rsvps" />
                  <button
                    type="submit"
                    class="sidebar-danger-btn"
                    data-confirm="Delete all RSVPs and wishes for this invitation? This action cannot be undone."
                    data-confirm-title="Reset All RSVPs"
                    data-confirm-text="Reset RSVPs"
                    data-cancel-text="Cancel"
                    data-confirm-variant="danger"
                  >
                    <span class="material-symbols-outlined">delete_sweep</span>
                    <span>Reset RSVPs</span>
                  </button>
                </form>

                <form method="POST">
                  <input type="hidden" name="action" value="delete" />
                  <button
                    type="submit"
                    class="sidebar-danger-btn warning"
                    data-confirm="Soft delete this invitation? It will be moved to Deleted Invitations."
                    data-confirm-title="Soft Delete Invitation"
                    data-confirm-text="Soft Delete"
                    data-cancel-text="Cancel"
                    data-confirm-variant="warning"
                  >
                    <span class="material-symbols-outlined">archive</span>
                    <span>Soft Delete</span>
                  </button>
                </form>

                <form method="POST">
                  <input type="hidden" name="action" value="permanent-delete" />
                  <button
                    type="submit"
                    class="sidebar-danger-btn permanent"
                    data-confirm="Permanently delete this invitation and all associated media? This action cannot be undone."
                    data-confirm-title="Delete Permanently"
                    data-confirm-text="Delete Permanently"
                    data-cancel-text="Cancel"
                    data-confirm-variant="danger"
                  >
                    <span class="material-symbols-outlined">delete_forever</span>
                    <span>Delete Permanently</span>
                  </button>
                </form>
              </div>
            </details>
          </div>
        </aside>
      </div>

      <form id="resetClientForm" method="POST" style="display: none;">
        <input type="hidden" name="action" value="reset-client-password" />
      </form>
    </main>

    <!-- Dynamic Repeater Templates -->
    <template id="event_template">
      <fieldset class="event-card repeater-item">
        <legend>Event <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Event Name<input name="eventName" placeholder="Wedding Ceremony" /></label>
          <label>Date<input type="datetime-local" name="eventDate" /></label>
          <label>Start Time<input type="time" name="eventStartTime" /></label>
          <label>End Time<input name="eventEndTime" placeholder="Finish" /></label>
          <label>Venue Name<input name="eventVenueName" /></label>
          <label>Google Maps URL<input name="eventMapsUrl" /></label>
          <label class="wide">Venue Full Address<textarea name="eventVenueAddress" rows="3"></textarea></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Event</button>
      </fieldset>
    </template>

    <template id="story_template">
      <fieldset class="story-card repeater-item">
        <legend>Story Chapter <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Milestone Title<input name="storyTitle" placeholder="HOW WE MET" /></label>
          <label class="wide">Story Description<textarea name="storyDescription" rows="3"></textarea></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Story</button>
      </fieldset>
    </template>

    <template id="slider_template">
      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
        <label style="flex: 1; margin: 0;">Slider Image URL <span class="idx"></span><input name="sliderImageUrl" placeholder="https://example.com/slide.jpg" /></label>
        <button type="button" class="remove-btn secondary-action">Delete</button>
      </div>
    </template>

    <template id="gallery_template">
      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
        <label style="flex: 1; margin: 0;">Image URL <span class="idx"></span><input name="galleryImageUrl" placeholder="https://example.com/gallery.jpg" /></label>
        <button type="button" class="remove-btn secondary-action">Delete</button>
      </div>
    </template>

    <template id="gallery_video_template">
      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
        <label style="flex: 1; margin: 0;">Video URL <span class="idx"></span><input name="galleryVideoUrl" placeholder="https://www.youtube.com/watch?v=..." /></label>
        <button type="button" class="remove-btn secondary-action">Delete</button>
      </div>
    </template>

    <template id="gift_template">
      <fieldset class="gift-card-form repeater-item">
        <legend>Account / Gift Card <span class="idx"></span></legend>
        <div class="form-grid">
          <label>Bank / E-Wallet Name<input name="giftBankName" placeholder="BCA / Chase / PayPal" /></label>
          <label>Account Number<input name="giftAccountNumber" placeholder="1234567890" /></label>
          <label>Account Holder Name<input name="giftAccountName" placeholder="Account holder name" /></label>
          <label>QRIS Image URL<input name="giftQrisUrl" placeholder="https://example.com/qris.png" /></label>
        </div>
        <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Gift Card</button>
      </fieldset>
    </template>

    <script>
      // 1. Repeater Handler
      function setupRepeater(containerId, btnId, templateId) {
        const container = document.getElementById(containerId);
        const btn = document.getElementById(btnId);
        const template = document.getElementById(templateId);

        if (!container || !btn || !template) return;

        function updateIndexes() {
          const items = container.querySelectorAll('.repeater-item');
          items.forEach((item, index) => {
            const idxSpan = item.querySelector('.idx');
            if (idxSpan) idxSpan.textContent = index + 1;
          });
        }

        btn.addEventListener('click', () => {
          const clone = template.content.cloneNode(true);
          container.appendChild(clone);
          updateIndexes();
        });

        container.addEventListener('click', async (e) => {
          if (e.target.classList.contains('remove-btn')) {
            const confirmed = await window.showConfirm({
              title: 'Delete Item',
              message: 'Are you sure you want to delete this item?',
              confirmText: 'Delete',
              cancelText: 'Cancel',
              variant: 'danger',
              icon: 'delete'
            });
            if (!confirmed) return;
            const item = e.target.closest('.repeater-item');
            if (item) {
              item.remove();
              updateIndexes();
            }
          }
        });
      }

      setupRepeater('slider_container', 'add_slider_btn', 'slider_template');
      setupRepeater('events_container', 'add_event_btn', 'event_template');
      setupRepeater('stories_container', 'add_story_btn', 'story_template');
      setupRepeater('gallery_container', 'add_gallery_btn', 'gallery_template');
      setupRepeater('gallery_videos_container', 'add_gallery_video_btn', 'gallery_video_template');
      setupRepeater('gifts_container', 'add_gift_btn', 'gift_template');

      // 2. Feature Toggles & Conditional Display
      const settingTargets = document.querySelectorAll('[data-setting-target]');
      function syncSettingTargets() {
        settingTargets.forEach((target) => {
          const toggleName = target.getAttribute('data-setting-target');
          const toggle = toggleName ? document.querySelector(`input[name="${toggleName}"]`) : null;
          if (!(toggle instanceof HTMLInputElement)) return;

          target.hidden = !toggle.checked;
        });
      }
      document
        .querySelectorAll('.toggle-grid input[type="checkbox"]')
        .forEach((toggle) => toggle.addEventListener('change', syncSettingTargets));
      syncSettingTargets();

      // 3. Password Input helper
      const accessPasswordInput = document.getElementById('accessPasswordInput');
      const passwordProtectionToggle = document.getElementById('passwordProtectionToggle');
      if (accessPasswordInput && passwordProtectionToggle) {
        accessPasswordInput.addEventListener('input', () => {
          if (accessPasswordInput.value.trim().length > 0 && !(passwordProtectionToggle as HTMLInputElement).checked) {
            (passwordProtectionToggle as HTMLInputElement).checked = true;
          }
        });
      }

      // 4. Collapsible Section Handler
      const sections = document.querySelectorAll('.collapsible-section');
      sections.forEach(section => {
        const header = section.querySelector('.collapsible-header');
        if (header) {
          header.addEventListener('click', () => {
            section.classList.toggle('is-collapsed');
          });
        }
      });

      function expandAll() {
        sections.forEach(sec => sec.classList.remove('is-collapsed'));
      }
      function collapseAll() {
        sections.forEach(sec => sec.classList.add('is-collapsed'));
      }

      document.getElementById('global-expand-btn')?.addEventListener('click', expandAll);
      document.getElementById('global-collapse-btn')?.addEventListener('click', collapseAll);
      document.getElementById('sidebar-expand-btn')?.addEventListener('click', expandAll);
      document.getElementById('sidebar-collapse-btn')?.addEventListener('click', collapseAll);

      // 5. Automatic Smart OG Image Generator (1200x630)
      import { createOgImageBlob } from '../../../utils/og-generator';

      const heroUrlInput = document.getElementById('hero-image-url-input') as HTMLInputElement | null;
      const heroFileInput = document.getElementById('hero-image-file-input') as HTMLInputElement | null;
      const ogFileInput = document.getElementById('og-image-file-input') as HTMLInputElement | null;
      const ogUrlInput = document.getElementById('og-image-url-input') as HTMLInputElement | null;

      async function ensureOgImageGenerated() {
        const sourceFile = heroFileInput?.files?.[0];
        const sourceUrl = heroUrlInput?.value.trim();

        if (sourceFile) {
          try {
            const blob = await createOgImageBlob(sourceFile);
            if (ogFileInput) {
              const file = new File([blob], 'og-thumbnail.jpg', { type: 'image/jpeg' });
              const dt = new DataTransfer();
              dt.items.add(file);
              ogFileInput.files = dt.files;
            }
          } catch (err) {
            console.warn('Auto OG generation from file error:', err);
          }
        } else if (sourceUrl && !ogUrlInput?.value) {
          try {
            const blob = await createOgImageBlob(sourceUrl);
            if (ogFileInput) {
              const file = new File([blob], 'og-thumbnail.jpg', { type: 'image/jpeg' });
              const dt = new DataTransfer();
              dt.items.add(file);
              ogFileInput.files = dt.files;
            }
          } catch (err) {
            console.warn('Auto OG generation from URL error:', err);
          }
        }
      }

      // Auto generate in background as soon as hero file is selected
      heroFileInput?.addEventListener('change', () => {
        const file = heroFileInput.files?.[0];
        if (file) {
          createOgImageBlob(file).then((blob) => {
            if (ogFileInput) {
              const f = new File([blob], 'og-thumbnail.jpg', { type: 'image/jpeg' });
              const dt = new DataTransfer();
              dt.items.add(f);
              ogFileInput.files = dt.files;
            }
          }).catch(console.warn);
        }
      });

      // 6. Sidebar Save Button & Shortcut (Ctrl+S)
      const editForm = document.getElementById('edit-form') as HTMLFormElement;

      async function handleSaveSubmit() {
        if (!editForm) return;
        await ensureOgImageGenerated();
        if (typeof editForm.requestSubmit === 'function') {
          editForm.requestSubmit();
        } else {
          editForm.submit();
        }
      }

      document.getElementById('sidebar-save-trigger')?.addEventListener('click', () => {
        handleSaveSubmit();
      });

      editForm?.addEventListener('submit', async (e) => {
        const ogFileInput = document.getElementById('og-image-file-input') as HTMLInputElement | null;
        const heroFileInput = document.getElementById('hero-image-file-input') as HTMLInputElement | null;
        const heroUrlInput = document.getElementById('hero-image-url-input') as HTMLInputElement | null;
        const ogUrlInput = document.getElementById('og-image-url-input') as HTMLInputElement | null;
        const hasHero = heroFileInput?.files?.[0] || heroUrlInput?.value.trim();

        if (hasHero && !ogFileInput?.files?.length && !ogUrlInput?.value.trim()) {
          e.preventDefault();
          await ensureOgImageGenerated();
          editForm.submit();
        }
      });

      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
          e.preventDefault();
          handleSaveSubmit();
        }
      });
    </script>
  </body>
</html>

<style lang="scss">
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f1f5f9;
    color: #1e293b;
    font-family: 'Montserrat', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .shell {
    width: min(1560px, 96vw);
    margin: 0 auto;
    padding: 28px 16px 60px;
    font-family: 'Montserrat', sans-serif;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18px;
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid #e2e8f0;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 12px;
    color: #2563eb;
