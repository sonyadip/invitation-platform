---
import { getSlugReportDetail } from '../../../services/dashboard-report';
import {
  parseInvitationForm,
  permanentlyDeleteInvitation,
  softDeleteInvitation,
  updateInvitation,
  resetInvitationViews,
  resetInvitationRsvps
} from '../../../services/dashboard-crud';
import { listTemplateKeys } from '../../../templates/registry';
import { hashPasswordSHA256 } from '../../../utils/security';
import { generateSetupToken } from '../../../utils/token';
import { supabase } from '../../../lib/supabase';
import PopupDialog from '../../../components/common/PopupDialog.astro';

export const prerender = false;

const { slug } = Astro.params;
const templateOptions = listTemplateKeys();
const session = Astro.locals.session;

if (session?.role !== 'admin') {
  return Astro.redirect('/?login=admin');
}

const toLocalInput = (value: string | null) => {
  if (!value) return '';
  const date = new Date(value);
  const offset = date.getTimezoneOffset();
  const local = new Date(date.getTime() - offset * 60 * 1000);
  return local.toISOString().slice(0, 16);
};

let detail = slug ? await getSlugReportDetail(slug) : null;
if (!detail) {
  return new Response('Invitation slug report not found.', { status: 404 });
}

let errorMessage = '';
let successMessage = Astro.url.searchParams.get('created') ? 'Invitation created.' : '';
if (Astro.url.searchParams.get('duplicated')) {
  successMessage = 'Invitation duplicated. Review the copied data before publishing.';
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') || 'save');

  try {
    if (action === 'delete') {
      await softDeleteInvitation(detail.wedding.id);
      return Astro.redirect('/dashboard?deleted=1');
    }

    if (action === 'permanent-delete') {
      await permanentlyDeleteInvitation(detail.wedding.id);
      return Astro.redirect('/dashboard?permanentlyDeleted=1');
    }

    if (action === 'reset-views') {
      await resetInvitationViews(detail.wedding.id);
      return Astro.redirect(`/dashboard/${detail.summary.slug}/edit?resetViews=1`);
    }

    if (action === 'reset-rsvps') {
      await resetInvitationRsvps(detail.wedding.id);
      return Astro.redirect(`/dashboard/${detail.summary.slug}/edit?resetRsvps=1`);
    }

    if (action === 'reset-client-password') {
      const { getSupabaseAdmin } = await import('../../../lib/supabase-admin');
      const supabaseAdmin = await getSupabaseAdmin();
      await supabaseAdmin
        .from('weddings')
        .update({ client_password_hash: null })
        .eq('id', detail.wedding.id);
      return Astro.redirect(`/dashboard/${detail.summary.slug}/edit?resetClient=1`);
    }

    const parsed = parseInvitationForm(formData);
    const revisionNote = String(formData.get('revisionNote') || '').trim();
    const updatedSlug = await updateInvitation(detail.wedding.id, parsed, revisionNote);
    return Astro.redirect(`/dashboard/${updatedSlug}/edit?saved=1`);

  } catch (error) {
    console.error('Update invitation error:', error);
    errorMessage = error instanceof Error ? error.message : 'Failed to update invitation.';
  }
}

if (Astro.url.searchParams.get('saved')) {
  successMessage = 'Invitation saved.';
}

if (Astro.url.searchParams.get('resetViews')) {
  successMessage = 'Page views have been reset to zero.';
}

if (Astro.url.searchParams.get('resetRsvps')) {
  successMessage = 'All RSVPs have been successfully deleted.';
}

if (Astro.url.searchParams.get('resetClient')) {
  successMessage = 'Client password reset. A new setup link is ready to share.';
}

const settings = detail.settings;
const assets = settings?.assets || { heroImage: '', ogImage: '', brideImage: '', groomImage: '', logoImage: '' };
const content = settings?.content || {
  instagramUrl: '',
  whatsappUrl: '',
  groomInstagramUrl: '',
  brideInstagramUrl: '',
  groomFatherName: '',
  groomMotherName: '',
  groomChildNumber: '',
  groomAddress: '',
  brideFatherName: '',
  brideMotherName: '',
  brideChildNumber: '',
  brideAddress: '',
  giftDescription: '',
  thankYouMessage: ''
};
const galleryImageUrls = detail.galleryImages.map((image) => image.imageUrl);
const sliderImageUrls = assets.sliderImages || [];
const galleryVideoUrls = content.galleryVideoUrls || [];
const eventValues = detail.events;
const storyValues = detail.wedding.story.length ? detail.wedding.story : [];
const giftValues = detail.gifts.length
  ? detail.gifts.map((gift) => ({
      bankName: gift.bankName,
      accountNumber: gift.accountNumber,
      accountName: gift.accountName,
      qrisUrl: gift.qrisUrl || ''
    }))
  : [];

// Check if client has claimed their account (password is set)
const { data: wedAuth } = await supabase
  .from('weddings')
  .select('client_password_hash')
  .eq('id', detail.wedding.id)
  .single();

const isClaimed = !!wedAuth?.client_password_hash;
let setupUrl = '';
if (!isClaimed) {
  const token = await generateSetupToken(detail.summary.slug);
  setupUrl = `${Astro.url.origin}/setup?token=${token}`;
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit {detail.summary.slug} - Dashboard</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <PopupDialog />
    <main class="shell">
      <!-- Top Header -->
      <header class="header">
        <div>
          <a class="back-link" href={`/dashboard/${detail.summary.slug}`}>← Back to Report</a>
          <p class="eyebrow">Invitation Editor</p>
          <h1>Edit Invitation</h1>
          <p class="subtitle">
            Slug: <code>{detail.summary.slug}</code> • Couple: <strong>{detail.summary.coupleName}</strong>
          </p>
        </div>
        <div class="header-actions">
          <a class="action-btn secondary-action" href={`/dashboard/${detail.summary.slug}`}>
            <span class="material-symbols-outlined icon">analytics</span> RSVP & Analytics
          </a>
          <button type="button" class="action-btn secondary-action" id="global-expand-btn">
            <span class="material-symbols-outlined icon">unfold_more</span> Expand All
          </button>
          <button type="button" class="action-btn secondary-action" id="global-collapse-btn">
            <span class="material-symbols-outlined icon">unfold_less</span> Collapse All
          </button>
          <a class="action-btn secondary-action" href={`/dashboard/${detail.summary.slug}/revisions`}>
            <span class="material-symbols-outlined icon">history</span> Revisions
          </a>
          <a class="action-btn primary-action" href={`/${detail.summary.slug}`} target="_blank" rel="noopener noreferrer">
            <span class="material-symbols-outlined icon">open_in_new</span> Live Preview
          </a>
        </div>
      </header>

      {successMessage && (
        <div class="success-panel">
          <span class="material-symbols-outlined icon">check_circle</span>
          <div>
            <strong>Success:</strong> {successMessage}
          </div>
        </div>
      )}
      {errorMessage && (
        <div class="error-panel">
          <span class="material-symbols-outlined icon">error</span>
          <div>
            <strong>Error:</strong> {errorMessage}
          </div>
        </div>
      )}

      <!-- 2-Column Editor Layout -->
      <div class="editor-layout">
        <!-- Main Content Area (Form) -->
        <div class="editor-main">
          <form id="edit-form" class="form-panel" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="action" value="save" />

            <!-- SECTION 1: General Settings -->
            <section class="collapsible-section is-collapsed" id="sec-general">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">⚙️</span>
                  <div>
                    <h2>General Settings</h2>
                    <p class="section-sub">Slug URL, publication status, template theme, and validity date.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class={`status-pill status-pill--${detail.wedding.status}`}>{detail.wedding.status}</span>
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="form-grid">
                  <label>
                    Slug URL
                    <input name="slug" value={detail.wedding.slug} required />
                  </label>
                  <label>
                    Publication Status
                    <select name="status">
                      <option value="draft" selected={detail.wedding.status === 'draft'}>Draft</option>
                      <option value="published" selected={detail.wedding.status === 'published'}>Published</option>
                      <option value="archived" selected={detail.wedding.status === 'archived'}>Archived</option>
                    </select>
                  </label>
                  <label>
                    Template Theme
                    <select name="template">
                      {templateOptions.map((template) => (
                        <option value={template} selected={detail.wedding.template === template}>{template}</option>
                      ))}
                    </select>
                  </label>
                  <label>
                    Expiration Date
                    <input type="datetime-local" name="expirationDate" value={toLocalInput(settings?.expirationDate || null)} />
                  </label>
                </div>
              </div>
            </section>

            <!-- SECTION 2: Access & Client Security -->
            <section class="collapsible-section is-collapsed" id="sec-security">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">🔐</span>
                  <div>
                    <h2>Access & Client Security</h2>
                    <p class="section-sub">Guest password gate and client dashboard authentication.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  {isClaimed ? (
                    <span class="badge-active">Client Password Set</span>
                  ) : (
                    <span class="badge-pending">Setup Link Active</span>
                  )}
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <!-- Access Password (Guest Protection Gate) -->
                <div class="security-card">
                  <div class="security-card__top">
                    <label class="checkbox-label">
                      <input type="checkbox" name="passwordProtectionEnabled" id="passwordProtectionToggle" checked={settings?.passwordProtectionEnabled ?? false} />
                      <span class="checkbox-text">Enable Guest Password Protection (Password Gate)</span>
                    </label>
                    <span class="security-badge">Public Gate</span>
                  </div>
                  <div class="form-grid single-col">
                    <label>
                      Guest Access Password
                      <input name="accessPassword" id="accessPasswordInput" value={settings?.accessPassword || ''} placeholder="e.g. wedding2026" autocomplete="off" />
                      <span class="hint">When enabled, visitors must enter this password to view <code>/{detail.wedding.slug}</code>.</span>
                    </label>
                  </div>
                </div>

                <!-- Client Password (Client Dashboard Authentication) -->
                <div class="security-card">
                  <div class="security-card__top">
                    <div>
                      <strong>Client Dashboard Account</strong>
                      <p class="hint" style="margin:2px 0 0;">Authentication for the bride & groom to access their dashboard.</p>
                    </div>
                    {isClaimed ? (
                      <span class="badge-active">● Password Active</span>
                    ) : (
                      <span class="badge-pending">● Not Claimed Yet</span>
                    )}
                  </div>

                  <div class="form-grid single-col">
                    <label>
                      {isClaimed ? 'Change Client Password (leave empty to keep current):' : 'Set Client Password (or leave empty to use setup link):'}
                      <input name="clientPassword" type="password" placeholder={isClaimed ? "Type new password to change..." : "Set initial password (optional)..."} autocomplete="new-password" />
                    </label>
                  </div>

                  <div class="setup-link-box">
                    <div class="setup-link-header">
                      <strong>Client One-Time Onboarding Link</strong>
                      {isClaimed && (
                        <button
                          type="submit"
                          form="resetClientForm"
                          class="reset-link-btn"
                          data-confirm="Reset client password? A new setup link will be generated and existing client credentials will be invalidated."
                          data-confirm-title="Reset Client Password"
                          data-confirm-text="Reset Password"
                          data-cancel-text="Cancel"
                          data-confirm-variant="warning"
                        >
                          Reset & Generate New Link
                        </button>
                      )}
                    </div>
                    {isClaimed ? (
                      <p class="claimed-text">✓ Client account has been claimed and secured with SHA-256 encryption.</p>
                    ) : (
                      <div class="clipboard-row">
                        <input type="text" value={setupUrl} readonly id="setupLinkInput" />
                        <button type="button" class="copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('setupLinkInput').value); this.innerText='Copied!'; setTimeout(()=>this.innerText='Copy', 2000);">Copy Link</button>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </section>

            <!-- SECTION 3: Feature Toggles -->
            <section class="collapsible-section is-collapsed" id="sec-features">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">🎛️</span>
                  <div>
                    <h2>Features & Modules</h2>
                    <p class="section-sub">Enable or disable specific interactive sections on the live invitation.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="toggle-grid">
                  <label class="toggle-item"><input type="checkbox" name="rsvpEnabled" checked={settings?.rsvpEnabled ?? true} /> <span>RSVP Form</span></label>
                  <label class="toggle-item"><input type="checkbox" name="musicEnabled" checked={settings?.musicEnabled ?? true} /> <span>Background Music</span></label>
                  <label class="toggle-item"><input type="checkbox" name="countdownEnabled" checked={settings?.countdownEnabled ?? true} /> <span>Countdown Timer</span></label>
                  <label class="toggle-item"><input type="checkbox" name="galleryEnabled" checked={settings?.galleryEnabled ?? true} /> <span>Photo Gallery</span></label>
                  <label class="toggle-item"><input type="checkbox" name="wishesEnabled" checked={settings?.wishesEnabled ?? true} /> <span>Wishes & Guestbook</span></label>
                  <label class="toggle-item"><input type="checkbox" name="giftEnabled" checked={settings?.giftEnabled ?? true} /> <span>Gift / Digital Bank</span></label>
                  <label class="toggle-item"><input type="checkbox" name="storyEnabled" checked={settings?.storyEnabled ?? true} /> <span>Love Story</span></label>
                  <label class="toggle-item"><input type="checkbox" name="viewCounterEnabled" checked={settings?.viewCounterEnabled ?? true} /> <span>View Counter</span></label>
                  <label class="toggle-item"><input type="checkbox" name="videoEnabled" checked={settings?.videoEnabled ?? true} /> <span>Video Player</span></label>
                  <label class="toggle-item"><input type="checkbox" name="introAnimationEnabled" checked={settings?.introAnimationEnabled ?? true} /> <span>Intro Animation</span></label>
                  <label class="toggle-item toggle-item--danger"><input type="checkbox" name="maintenanceMode" checked={settings?.maintenanceMode ?? false} /> <span>Maintenance Mode</span></label>
                </div>
              </div>
            </section>

            <!-- SECTION 4: Opening & Hero Section -->
            <section class="collapsible-section is-collapsed" id="sec-opening">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">🌟</span>
                  <div>
                    <h2>Hero & Opening Section</h2>
                    <p class="section-sub">Branding logo, popup / hero image, intro video, and welcome quotes.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="form-grid">
                  <label class="wide">
                    Logo Image URL
                    <input name="logoImageUrl" value={assets.logoImage} placeholder="https://example.com/logo.png" />
                  </label>
                  <label class="wide">
                    Upload Logo Image (Overrides URL)
                    <input type="file" name="logoImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
                  </label>
                  <label class="wide">
                    Popup / Hero Image URL
                    <input name="heroImageUrl" id="hero-image-url-input" value={assets.heroImage} placeholder="https://example.com/hero.jpg" />
                  </label>
                  <label class="wide">
                    Upload Popup / Hero Image (Overrides URL)
                    <input type="file" name="heroImageFile" id="hero-image-file-input" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
                  </label>
                  <input type="hidden" name="ogImageUrl" id="og-image-url-input" value={assets.ogImage || ''} />
                  <input type="file" name="ogImageFile" id="og-image-file-input" style="display: none;" />
                  <label class="wide">
                    Hero Video URL
                    <input name="heroVideoUrl" value={assets.heroVideo || ''} placeholder="https://example.com/hero.mp4" />
                  </label>
                  <div style="grid-column: 1 / -1; margin-top: 16px; margin-bottom: 4px; padding-top: 16px; border-top: 1px solid var(--border, #e5e7eb);">
                    <h3 style="font-size: 15px; font-weight: 600; margin-bottom: 4px;">Image Slider / Slideshow Photos</h3>
                    <p class="section-sub" style="margin-bottom: 12px;">Opsional. Masukkan foto khusus untuk banner slider / slideshow. Jika dikosongkan, slider akan otomatis mengambil foto dari Photo Gallery.</p>
                  </div>
                  <div class="wide gallery-list" id="slider_container" style="grid-column: 1 / -1;">
                    {sliderImageUrls.map((url: string, index: number) => (
                      <div class="repeater-item form-grid" style="align-items: flex-end; margin-bottom: 12px;">
                        <label style="flex: 1; margin: 0;">Slider Image URL <span class="idx">{index + 1}</span><input name="sliderImageUrl" value={url} placeholder="https://example.com/slide.jpg" /></label>
                        <button type="button" class="remove-btn secondary-action">Delete</button>
                      </div>
                    ))}
                  </div>
                  <button type="button" id="add_slider_btn" class="secondary-action" style="grid-column: 1 / -1; margin-bottom: 16px; width: fit-content;">+ Add Slider Photo URL</button>
                  <label class="wide">
                    Upload Multiple Slider Images
                    <input type="file" name="sliderImageFiles" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple />
                  </label>
                  <label class="wide">
                    Intro Verse / Quotes
                    <textarea name="introVerse" rows="4" placeholder="Enter opening verse or religious quote...">{content.introVerse || ''}</textarea>
                  </label>
                  <label class="wide">
                    Intro Verse Source / Citation
                    <input name="introVerseSource" value={content.introVerseSource || ''} placeholder="(e.g., Rgveda : X.85.42 or 1 Corinthians 13:4)" />
                  </label>
                </div>
              </div>
            </section>

            <!-- SECTION 5: Couple Details -->
            <section class="collapsible-section is-collapsed" id="sec-couple">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">👥</span>
                  <div>
                    <h2>Couple Information</h2>
                    <p class="section-sub">Detailed profile, family pedigree, social links, and photos of the bride and groom.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="couple-grid">
                  <fieldset class="couple-card">
                    <legend>👨 Groom Details</legend>
                    <div class="form-grid">
                      <label>Groom Nickname<input name="groomName" value={detail.wedding.groomName} required /></label>
                      <label>Groom Full Name<input name="groomFullName" value={detail.wedding.groomFullName} required /></label>
                      <label>Father's Name<input name="groomFatherName" value={content.groomFatherName || ''} placeholder="Father's full name" /></label>
                      <label>Mother's Name<input name="groomMotherName" value={content.groomMotherName || ''} placeholder="Mother's full name" /></label>
                      <label>Child Order<input name="groomChildNumber" value={content.groomChildNumber || ''} placeholder="1st son of" /></label>
                      <label>Family Origin / City<input name="groomAddress" value={content.groomAddress || ''} placeholder="Origin or city" /></label>
                      <label>Photo URL<input name="groomImageUrl" value={assets.groomImage} placeholder="https://example.com/groom.jpg" /></label>
                      <label>Upload Photo<input type="file" name="groomImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                      <label class="wide">Instagram URL<input name="groomInstagramUrl" value={content.groomInstagramUrl || content.instagramUrl} placeholder="https://www.instagram.com/username" /></label>
                    </div>
                  </fieldset>

                  <fieldset class="couple-card">
                    <legend>👩 Bride Details</legend>
                    <div class="form-grid">
                      <label>Bride Nickname<input name="brideName" value={detail.wedding.brideName} required /></label>
                      <label>Bride Full Name<input name="brideFullName" value={detail.wedding.brideFullName} required /></label>
                      <label>Father's Name<input name="brideFatherName" value={content.brideFatherName || ''} placeholder="Father's full name" /></label>
                      <label>Mother's Name<input name="brideMotherName" value={content.brideMotherName || ''} placeholder="Mother's full name" /></label>
                      <label>Child Order<input name="brideChildNumber" value={content.brideChildNumber || ''} placeholder="2nd daughter of" /></label>
                      <label>Family Origin / City<input name="brideAddress" value={content.brideAddress || ''} placeholder="Origin or city" /></label>
                      <label>Photo URL<input name="brideImageUrl" value={assets.brideImage} placeholder="https://example.com/bride.jpg" /></label>
                      <label>Upload Photo<input type="file" name="brideImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                      <label class="wide">Instagram URL<input name="brideInstagramUrl" value={content.brideInstagramUrl || content.instagramUrl} placeholder="https://www.instagram.com/username" /></label>
                    </div>
                  </fieldset>
                </div>
              </div>
            </section>

            <!-- SECTION 6: Wedding Events -->
            <section class="collapsible-section is-collapsed" id="sec-events">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">📅</span>
                  <div>
                    <h2>Wedding Events Schedule</h2>
                    <p class="section-sub">Ceremony, reception, banquet, times, venue locations, and Google Maps links.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="badge-count">{eventValues.length} Events</span>
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="form-grid" style="margin-bottom: 20px;">
                  <label class="wide">Event Section Header Image URL<input name="eventImageUrl" value={assets.eventImage || ''} placeholder="https://example.com/event.jpg" /></label>
                  <label class="wide">Upload Event Header Image<input type="file" name="eventImageFile" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label>
                </div>
                <div class="event-list" id="events_container">
                  {eventValues.map((event, index) => (
                    <fieldset class="event-card repeater-item">
                      <legend>Event <span class="idx">{index + 1}</span></legend>
                      <div class="form-grid">
                        <label>Event Name<input name="eventName" value={event.name} required={index === 0} placeholder="Wedding Ceremony" /></label>
                        <label>Date<input type="datetime-local" name="eventDate" value={toLocalInput(event.date)} required={index === 0} /></label>
                        <label>Start Time<input type="time" name="eventStartTime" value={event.startTime} /></label>
                        <label>End Time<input name="eventEndTime" value={event.endTime} placeholder="Finish" /></label>
                        <label>Venue Name<input name="eventVenueName" value={event.venueName} /></label>
                        <label>Google Maps URL<input name="eventMapsUrl" value={event.mapsUrl} required={index === 0} /></label>
                        <label class="wide">Venue Full Address<textarea name="eventVenueAddress" rows="3" required={index === 0}>{event.venueAddress}</textarea></label>
                      </div>
                      {index > 0 && <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Event</button>}
                    </fieldset>
                  ))}
                </div>
                <button type="button" id="add_event_btn" class="secondary-action" style="margin-top: 16px;">+ Add Event</button>
              </div>
            </section>

            <!-- SECTION 7: Our Story -->
            <section class="collapsible-section is-collapsed" id="sec-story" data-setting-target="storyEnabled">
              <div class="collapsible-header">
                <div class="collapsible-header__title">
                  <span class="section-icon">📖</span>
                  <div>
                    <h2>Our Love Story</h2>
                    <p class="section-sub">Timeline journey of how the couple met, dated, and decided to marry.</p>
                  </div>
                </div>
                <div class="collapsible-header__right">
                  <span class="badge-count">{storyValues.length} Milestones</span>
                  <span class="chevron material-symbols-outlined">expand_more</span>
                </div>
              </div>
              <div class="collapsible-body">
                <div class="story-list" id="stories_container">
                  {storyValues.map((story, index) => (
                    <fieldset class="story-card repeater-item">
                      <legend>Story Chapter <span class="idx">{index + 1}</span></legend>
                      <div class="form-grid">
                        <label>Milestone Title<input name="storyTitle" value={story.title} placeholder="HOW WE MET" /></label>
                        <label class="wide">Story Description<textarea name="storyDescription" rows="3">{story.description}</textarea></label>
                      </div>
                      <button type="button" class="remove-btn secondary-action" style="margin-top: 10px;">Delete Story</button>
