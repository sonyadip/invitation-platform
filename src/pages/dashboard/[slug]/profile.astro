---
const { slug } = Astro.params;
const authRole = Astro.cookies.get('auth_role')?.value;
const authSlug = Astro.cookies.get('auth_slug')?.value;

if (!authRole || (authRole === 'client' && authSlug !== slug)) {
  return Astro.redirect('/?login=client');
}

import ClientLayout from "../../../layouts/ClientLayout.astro";
import { getSlugReportDetail } from "../../../services/dashboard-report";

const report = await getSlugReportDetail(slug);
if (!report) {
  return Astro.redirect('/dashboard');
}

const profileData = {
  name: report.summary.coupleName,
  template: report.summary.template,
  activeSince: new Date(report.summary.createdAt).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }),
  status: report.summary.status,
};

const templateName = report.summary.template || 'noir';
const coverModules = import.meta.glob('../../../templates/*/assets/cover.{jpg,png,webp,jpeg}', { eager: true }) as Record<string, { default: { src: string } }>;
const defaultCoverKey = Object.keys(coverModules).find(key => key.includes(`/${templateName}/assets/cover.`));
const defaultCoverSrc = defaultCoverKey ? coverModules[defaultCoverKey].default.src : 'https://images.unsplash.com/photo-1519741497674-611481863552?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80';

const coverImage = report.settings?.assets?.heroImage || report.settings?.assets?.coverImage || defaultCoverSrc;
---

<ClientLayout title="Profil">
  <div class="profile-layout">
  
  <div class="profile-left">
  <!-- Profile Header Section -->
  <section class="bento-card bento-card--center profile-header fade-in-bottom">
    <div class="profile-avatar-wrapper">
      <div class="profile-avatar-ring">
        <div class="profile-avatar">
          <img src={coverImage} alt="Profile" />
        </div>
      </div>
      <div class="profile-avatar-edit">
        <span class="material-symbols-outlined profile-avatar-edit__icon">edit</span>
      </div>
    </div>
    <h2 class="profile-name">{profileData.name}</h2>
    <p class="profile-date">Dibuat pada {profileData.activeSince}</p>
  </section>
  </div>

  <div class="profile-right">
  <!-- Wedding Details Form -->
  <section class="fade-in-bottom animate-on-scroll">
    <div class="bento-card">
      <h3 class="bento-card__title">Informasi Undangan</h3>
      
      <div class="info-field">
        <label class="info-field__label">Nama Pasangan</label>
        <div class="info-field__value">
          {profileData.name}
        </div>
      </div>
      
      <div class="info-field">
        <label class="info-field__label">Tema Undangan</label>
        <div class="info-field__value">
          <span>{profileData.template.toUpperCase()}</span>
          <span class="material-symbols-outlined info-field__icon">palette</span>
        </div>
      </div>
      
      <div class="info-field">
        <label class="info-field__label">Status Undangan</label>
        <div>
          {profileData.status === 'published' ? (
            <span class="status-tag status-tag--published">
              <span class="status-tag__dot"></span>
              PUBLISHED
            </span>
          ) : (
            <span class="status-tag status-tag--draft">
              <span class="status-tag__dot"></span>
              DRAFT
            </span>
          )}
        </div>
      </div>
      
      <p class="info-note">
        *Perubahan detail undangan dan foto hanya dapat dilakukan oleh Admin.
      </p>
    </div>
  </section>

  <!-- Version Info -->
  <div class="app-version fade-in-bottom animate-on-scroll">
    <p class="app-version__text">Senadda App v2.4.0</p>
  </div>
  </div>
  
  </div>
</ClientLayout>
