---
const { slug } = Astro.params;
const session = Astro.locals.session;

if (!session || (session.role === 'client' && session.slug !== slug)) {
  return Astro.redirect('/?login=client');
}

import ClientLayout from "../../../layouts/ClientLayout.astro";
import { getSlugReportDetail } from "../../../services/dashboard-report";

const report = await getSlugReportDetail(slug);
if (!report) {
  return Astro.redirect('/dashboard');
}

const coupleName = report.summary.coupleName;
const link = `${Astro.url.origin}/${slug}`;

const categories = ["Formal", "Teman", "Keluarga"];
const initialGuests = report.sentInvitations || [];
const initialTemplates = report.waTemplates || {};
const weddingId = report.summary.weddingId;
---

<ClientLayout title="Kirim Undangan">
  <div class="kirim-undangan-layout">
    <!-- Left Column: Template Ucapan -->
    <section class="bento-card fade-in-bottom animate-on-scroll kirim-left kirim-template">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 class="bento-card__title kirim-template__title" style="margin: 0;">Template Pesan</h3>
        <div style="display: flex; gap: 8px;">
          <button id="template-cancel-btn" class="filter-btn filter-btn--outline" style="height: 32px; padding: 0 16px; font-size: 12px; margin: 0; display: none;">Batal</button>
          <button id="template-edit-btn" class="btn-primary" style="height: 32px; padding: 0 16px; font-size: 12px; margin: 0;">Edit</button>
        </div>
      </div>
      
      <div class="filter-scroll no-scrollbar" id="category-filters">
        {categories.map((cat, i) => (
          <button class={`filter-btn ${i === 0 ? 'filter-btn--active' : 'filter-btn--outline'}`}>
            {cat}
          </button>
        ))}
      </div>

      <div class="kirim-template__preview-wrapper">
        <textarea id="wa-template-editor" style="display: none; width: 100%; height: 100%; min-height: 250px; padding: 12px; font-family: inherit; font-size: 14px; border-radius: 8px; border: 1px solid var(--color-outline-variant); resize: none;"></textarea>
        <p class="preview-card__text kirim-template__text" id="wa-template" style="white-space: pre-wrap;"></p>
      </div>
      <p class="kirim-template__hint">
        Gunakan kode <strong>[NAMA]</strong> untuk nama tamu dan <strong>[LINK]</strong> untuk link undangan personal (otomatis berubah per tamu saat dikirim).
        Anda juga bisa menyalin link personal setiap tamu melalui tombol <strong>Salin</strong> di daftar tamu.
      </p>
    </section>

    <!-- Right Column: Daftar Tamu -->
    <section class="bento-card fade-in-bottom animate-on-scroll kirim-right">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 8px; flex-wrap: wrap;">
        <h3 class="bento-card__title" style="margin: 0;">Daftar Tamu</h3>
        <div style="display: flex; gap: 8px;">
          <button id="export-template-btn" class="filter-btn filter-btn--outline rsvp-filter-btn rsvp-export-btn">
            <span class="material-symbols-outlined rsvp-filter-icon">download</span> Template
          </button>
          <button id="import-guest-btn" class="filter-btn filter-btn--outline rsvp-filter-btn rsvp-export-btn">
            <span class="material-symbols-outlined rsvp-filter-icon">upload_file</span> Import
          </button>
          <input type="file" id="import-guest-input" accept=".csv,.xlsx" style="display: none;" />
        </div>
      </div>

      <!-- Search Bar -->
      <div class="kirim-search">
        <input class="form-input kirim-search__input" placeholder="Ketik Nama Tamu..." type="text" />
        <input class="form-input kirim-search__input-wa" placeholder="No WA (Opsional)" type="tel" />
        <button class="kirim-search__btn">
          <span class="material-symbols-outlined kirim-search__icon">add</span>
        </button>
      </div>

      <!-- Status Filters -->
      <div class="guest-status-filters" id="guest-status-filters" style="display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;">
        <button class="filter-btn filter-btn--active" data-status="all">Semua (<span id="count-all">0</span>)</button>
        <button class="filter-btn filter-btn--outline" data-status="opened">Sudah Dibuka (<span id="count-opened">0</span>)</button>
        <button class="filter-btn filter-btn--outline" data-status="unopened">Belum Dibuka (<span id="count-unopened">0</span>)</button>
      </div>

      <!-- Guest List -->
      <div class="kirim-guests" id="kirim-guests-container">
        <!-- Rendered via JS to support localStorage -->
      </div>
      
      <!-- Pagination UI -->
      <div class="pagination-wrapper" style="border-top: none; padding: 16px 0 0 0;">
        <button class="pagination-btn" id="kirimPrev" disabled>Prev</button>
        <div class="pagination-numbers" id="kirimPageNumbers"></div>
        <button class="pagination-btn" id="kirimNext" disabled>Next</button>
      </div>
    </section>
  </div>
  
  <script is:inline define:vars={{ initialGuests, initialTemplates, weddingId, slug }}>
    document.addEventListener('DOMContentLoaded', () => {
      const guestsContainer = document.querySelector('.kirim-guests');
      let guestsData = initialGuests.map(g => ({
        id: g.id,
        name: g.guestName || g.name,
        phone: g.phone,
        openedAt: g.openedAt || null,
        lastOpenedAt: g.lastOpenedAt || null,
        openCount: Number(g.openCount || 0)
      }));
      
      let activeStatusFilter = 'all';
      let filteredData = [...guestsData];
      let currentPage = 1;
      const itemsPerPage = 10;

      function formatShortDate(isoStr) {
        if (!isoStr) return '';
        const d = new Date(isoStr);
        return d.toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'short',
          hour: '2-digit',
          minute: '2-digit'
        });
      }

      function updateFilterCounts() {
        const total = guestsData.length;
        const opened = guestsData.filter(g => Boolean(g.openedAt)).length;
        const unopened = total - opened;

        const countAll = document.getElementById('count-all');
        const countOpened = document.getElementById('count-opened');
        const countUnopened = document.getElementById('count-unopened');
        if (countAll) countAll.textContent = total;
        if (countOpened) countOpened.textContent = opened;
        if (countUnopened) countUnopened.textContent = unopened;
      }

      function applyFilters() {
        const addInput = document.querySelector('.kirim-search__input');
        const query = (addInput ? addInput.value : '').toLowerCase().trim();
        filteredData = guestsData.filter(g => {
          const matchSearch = !query || g.name.toLowerCase().includes(query) || (g.phone && g.phone.includes(query));
          if (!matchSearch) return false;
          if (activeStatusFilter === 'opened') return Boolean(g.openedAt);
          if (activeStatusFilter === 'unopened') return !g.openedAt;
          return true;
        });
        updateFilterCounts();
      }
      
      function renderGuests() {
        guestsContainer.innerHTML = '';
        
        let totalPages = Math.ceil(filteredData.length / itemsPerPage) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;
        
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const paginatedData = filteredData.slice(start, end);
        
        if (paginatedData.length === 0) {
          guestsContainer.innerHTML = `
            <div style="text-align: center; padding: 32px 16px; color: var(--color-on-surface-variant); font-size: 14px;">
              Tidak ada data tamu yang sesuai filter.
            </div>
          `;
        }

        paginatedData.forEach((guest, i) => {
          const newRow = document.createElement('div');
          newRow.className = `kirim-guests__item ${i < paginatedData.length - 1 ? 'kirim-guests__item--bordered' : ''}`;
          newRow.dataset.id = guest.id;
          
          let waButtonHtml = '';
          if (guest.phone) {
            waButtonHtml = `<a href="#" data-phone="${guest.phone}" class="kirim-guests__btn-wa">Kirim WA</a>`;
          }

          const isOpened = Boolean(guest.openedAt);
          const statusBadge = isOpened
            ? `<span class="guest-status-badge guest-status-badge--opened" title="${new Date(guest.openedAt).toLocaleString('id-ID')}">
                <span class="guest-status-dot guest-status-dot--opened"></span> Dibuka ${formatShortDate(guest.openedAt)}${guest.openCount > 1 ? ` (${guest.openCount}x)` : ''}
               </span>`
            : `<span class="guest-status-badge guest-status-badge--unopened">
                <span class="guest-status-dot guest-status-dot--unopened"></span> Belum dibuka
               </span>`;

          newRow.innerHTML = `
              <div class="kirim-guests__info">
                <h4 class="kirim-guests__name">${guest.name}</h4>
                ${statusBadge}
              </div>
              <div class="kirim-guests__actions">
                <button class="kirim-guests__btn-copy">Salin</button>
                ${waButtonHtml}
                <button class="kirim-guests__btn-delete">
                  <span class="material-symbols-outlined kirim-guests__delete-icon">close</span>
                </button>
              </div>
          `;
          guestsContainer.appendChild(newRow);
        });

        // Update Pagination UI
        const prevBtn = document.getElementById('kirimPrev');
        const nextBtn = document.getElementById('kirimNext');
        const pageNumbers = document.getElementById('kirimPageNumbers');

        if (prevBtn) prevBtn.disabled = currentPage === 1;
        if (nextBtn) nextBtn.disabled = currentPage === totalPages;

        if (pageNumbers) {
          pageNumbers.innerHTML = '';
          
          function createBtn(i) {
            const btn = document.createElement('button');
            btn.className = `pagination-num ${i === currentPage ? 'pagination-num--active' : ''}`;
            btn.innerText = i;
            btn.onclick = () => { currentPage = i; renderGuests(); };
            return btn;
          }
          function createEllipsis() {
            const span = document.createElement('span');
            span.className = 'pagination-ellipsis';
            span.innerText = '...';
            return span;
          }

          if (totalPages <= 5) {
            for (let i = 1; i <= totalPages; i++) pageNumbers.appendChild(createBtn(i));
          } else {
            if (currentPage <= 3) {
              for (let i = 1; i <= 4; i++) pageNumbers.appendChild(createBtn(i));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(totalPages));
            } else if (currentPage >= totalPages - 2) {
              pageNumbers.appendChild(createBtn(1));
              pageNumbers.appendChild(createEllipsis());
              for (let i = totalPages - 3; i <= totalPages; i++) pageNumbers.appendChild(createBtn(i));
            } else {
              pageNumbers.appendChild(createBtn(1));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(currentPage - 1));
              pageNumbers.appendChild(createBtn(currentPage));
              pageNumbers.appendChild(createBtn(currentPage + 1));
              pageNumbers.appendChild(createEllipsis());
              pageNumbers.appendChild(createBtn(totalPages));
            }
          }
        }
      }

      // --- TEMPLATE LOGIC ---
      const defaultTemplates = {
        "Formal": `Om Swastyastu,

Kepada Yth. *[NAMA]*,

Atas Asung Kertha Wara Nugraha Ida Sang Hyang Widhi Wasa/Tuhan Yang Maha Esa, kami bermaksud mengundang Bapak/Ibu/Saudara/i untuk hadir dan memberikan doa restu pada acara pawiwahan (pernikahan) kami.

Detail acara dan lokasi dapat dilihat melalui tautan undangan berikut:
[LINK]

Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir.

Om Shanti, Shanti, Shanti, Om.`,
        "Teman": `Om Swastyastu,

Halo *[NAMA]*!

Semoga kabarmu baik ya. Kami ingin mengundang kamu untuk hadir di acara pawiwahan (pernikahan) kami.

Cek detail acaranya melalui tautan ini:
[LINK]

Kehadiranmu bakal jadi kado terindah buat kami. Ditunggu kedatangannya ya!

Om Shanti, Shanti, Shanti, Om.`,
        "Keluarga": `Om Swastyastu,

Kepada Yth. *[NAMA]*, keluarga besar yang kami cintai.

Atas Asung Kertha Wara Nugraha Ida Sang Hyang Widhi Wasa, kami bermaksud mengundang Bapak/Ibu/Keluarga untuk hadir pada acara pawiwahan (pernikahan) kami.

Detail acara dapat dilihat melalui tautan undangan berikut:
[LINK]

Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Keluarga berkenan hadir untuk memberikan doa restu.

Om Shanti, Shanti, Shanti, Om.`
      };

      let templates = {};
      try {
        templates = { ...initialTemplates };
        for (const key in defaultTemplates) {
            if (!templates[key]) templates[key] = defaultTemplates[key];
        }
      } catch(e) {
        templates = { ...defaultTemplates };
      }

      function saveTemplates() {
        fetch('/api/templates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ weddingId, templates })
        }).catch(err => console.error("Gagal menyimpan template:", err));
      }

      let currentCategory = 'Formal';
      let isEditingTemplate = false;

      const templateP = document.getElementById('wa-template');
      const templateEditor = document.getElementById('wa-template-editor');
      const editBtn = document.getElementById('template-edit-btn');
      const cancelBtn = document.getElementById('template-cancel-btn');
      const filterContainer = document.getElementById('category-filters');

      function renderTemplate() {
        if (templateP) templateP.innerText = templates[currentCategory];
      }
      renderTemplate();

      if (editBtn) {
        editBtn.addEventListener('click', () => {
          if (isEditingTemplate) {
            // Save
            templates[currentCategory] = templateEditor.value;
            saveTemplates();
            renderTemplate();
            templateEditor.style.display = 'none';
            templateP.style.display = 'block';
            editBtn.innerText = 'Edit';
            if (cancelBtn) cancelBtn.style.display = 'none';
            filterContainer.style.pointerEvents = 'auto';
            filterContainer.style.opacity = '1';
          } else {
            // Edit
            templateEditor.value = templates[currentCategory];
            templateEditor.style.display = 'block';
            templateP.style.display = 'none';
            editBtn.innerText = 'Simpan';
            if (cancelBtn) cancelBtn.style.display = 'block';
            filterContainer.style.pointerEvents = 'none';
            filterContainer.style.opacity = '0.5';
          }
          isEditingTemplate = !isEditingTemplate;
        });
      }

      if (cancelBtn) {
        cancelBtn.addEventListener('click', () => {
          templateEditor.style.display = 'none';
          templateP.style.display = 'block';
          editBtn.innerText = 'Edit';
          cancelBtn.style.display = 'none';
          filterContainer.style.pointerEvents = 'auto';
          filterContainer.style.opacity = '1';
          isEditingTemplate = false;
        });
      }

      if (filterContainer) {
        const btns = filterContainer.querySelectorAll('.filter-btn');
        btns.forEach(btn => {
          btn.addEventListener('click', () => {
            if (isEditingTemplate) return;
            btns.forEach(b => {
              b.classList.remove('filter-btn--active');
              b.classList.add('filter-btn--outline');
            });
            btn.classList.add('filter-btn--active');
            btn.classList.remove('filter-btn--outline');
            currentCategory = btn.innerText.trim();
            renderTemplate();
          });
        });
      }

      // --- STATUS FILTER EVENTS ---
      const statusFilterContainer = document.getElementById('guest-status-filters');
      if (statusFilterContainer) {
        const sBtns = statusFilterContainer.querySelectorAll('.filter-btn');
        sBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            sBtns.forEach(b => {
              b.classList.remove('filter-btn--active');
              b.classList.add('filter-btn--outline');
            });
            btn.classList.add('filter-btn--active');
            btn.classList.remove('filter-btn--outline');
            activeStatusFilter = btn.getAttribute('data-status') || 'all';
            applyFilters();
            currentPage = 1;
            renderGuests();
          });
        });
      }

      // --- TAMBAH & CARI TAMU ---
      const addInput = document.querySelector('.kirim-search__input');
      const addWaInput = document.querySelector('.kirim-search__input-wa');
      const addBtn = document.querySelector('.kirim-search__btn');

      // Fungsi Search Live
      if (addInput) {
        addInput.addEventListener('input', () => {
          applyFilters();
          currentPage = 1;
          renderGuests();
        });
      }

      async function addGuest() {
        const name = addInput.value.trim();
        let phone = addWaInput ? addWaInput.value.trim() : '';
        if (!name) return;

        addBtn.disabled = true;
        addInput.disabled = true;
        if (addWaInput) addWaInput.disabled = true;

        if (phone.startsWith('0')) {
          phone = '62' + phone.substring(1);
        }
        phone = phone.replace(/[^0-9]/g, '');

        try {
          const response = await fetch('/api/guests', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ weddingId, name, phone })
          });
          const result = await response.json();
          if (result.success && result.item) {
            guestsData.unshift({
              id: result.item.id,
              name: result.item.guest_name,
              phone: result.item.phone,
              openedAt: null,
              lastOpenedAt: null,
              openCount: 0
            });
            
            addInput.value = '';
            if (addWaInput) addWaInput.value = '';
            
            applyFilters();
            currentPage = 1;
            renderGuests();
            window.showToast({ type: 'success', message: 'Tamu baru berhasil ditambahkan.' });
          } else {
            window.showToast({ type: 'error', message: result.error || 'Gagal menambahkan tamu.' });
          }
        } catch (error) {
          console.error(error);
          window.showToast({ type: 'error', message: 'Terjadi kesalahan jaringan. Periksa koneksi internet Anda.' });
        } finally {
          addBtn.disabled = false;
          addInput.disabled = false;
          if (addWaInput) addWaInput.disabled = false;
          addInput.focus();
        }
      }

      if (addBtn) addBtn.addEventListener('click', addGuest);
      if (addInput) {
        addInput.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') addGuest();
        });
      }

      // --- HAPUS & SALIN (Event Delegation) ---
      if (guestsContainer) {
        guestsContainer.addEventListener('click', async (e) => {
          // Tombol Hapus
          const deleteBtn = e.target.closest('.kirim-guests__btn-delete');
          if (deleteBtn) {
            const row = deleteBtn.closest('.kirim-guests__item');
            const guestName = row?.querySelector('.kirim-guests__name')?.innerText?.trim() || 'tamu ini';

            const confirmed = await window.showConfirm({
              title: 'Hapus Data Tamu',
              message: `Apakah Anda yakin ingin menghapus data tamu "${guestName}"?`,
              confirmText: 'Hapus Tamu',
              cancelText: 'Batal',
              variant: 'danger',
              icon: 'delete'
            });
            if (!confirmed) return;

            if (row && row.dataset.id) {
              const id = row.dataset.id;
              
              fetch('/api/guests', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
              }).catch(err => console.error("Gagal menghapus:", err));

              guestsData = guestsData.filter(g => String(g.id) !== String(id));
              applyFilters();
              renderGuests();
              window.showToast({ type: 'success', message: 'Data tamu berhasil dihapus.' });
            }
            return;
          }
          
          // Tombol Salin
          const copyBtn = e.target.closest('.kirim-guests__btn-copy');
          if (copyBtn) {
             const row = copyBtn.closest('.kirim-guests__item');
             const nameEl = row.querySelector('.kirim-guests__name');
             const templateEl = document.getElementById('wa-template');
             
             if (nameEl && templateEl) {
                const guestNameText = nameEl.innerText.trim();
                const guestLink = `${window.location.origin}/${slug}?to=${encodeURIComponent(guestNameText)}`;
                let text = templateEl.innerText;
                text = text.replace(/\[NAMA\]/g, guestNameText);
                text = text.replace(/\[LINK\]/g, guestLink);
                
                navigator.clipboard.writeText(text).then(() => {
                   const originalText = copyBtn.innerText;
                   copyBtn.innerText = 'Tersalin!';
                   setTimeout(() => { copyBtn.innerText = originalText; }, 2000);
                });
             }
             return;
          }

          // Tombol Kirim WA
          const waBtn = e.target.closest('.kirim-guests__btn-wa');
          if (waBtn) {
             e.preventDefault();
             const row = waBtn.closest('.kirim-guests__item');
             const nameEl = row.querySelector('.kirim-guests__name');
             const templateEl = document.getElementById('wa-template');
             
             if (nameEl && templateEl) {
                const guestNameText = nameEl.innerText.trim();
                const guestLink = `${window.location.origin}/${slug}?to=${encodeURIComponent(guestNameText)}`;
                let text = templateEl.innerText;
                text = text.replace(/\[NAMA\]/g, guestNameText);
                text = text.replace(/\[LINK\]/g, guestLink);
                
                let phone = waBtn.getAttribute('data-phone') || '';
                const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
                window.open(waUrl, '_blank');
             }
             return;
          }
        });
      }

      // --- EXPORT TEMPLATE XLSX ---
      const exportTemplateBtn = document.getElementById('export-template-btn');
      if (exportTemplateBtn) {
        exportTemplateBtn.addEventListener('click', async () => {
          // Load SheetJS on-demand
          if (!window.XLSX) {
            await new Promise((resolve, reject) => {
              const s = document.createElement('script');
              s.src = 'https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
              s.onload = resolve;
              s.onerror = reject;
              document.head.appendChild(s);
            });
          }
          const XLSX = window.XLSX;
          // Template data: header + 3 contoh baris
          const rows = [
            ['Nama', 'No. WA'],
            ['Budi Santoso', '08123456789'],
            ['Siti Rahayu', '08987654321'],
            ['Ahmad Fauzi', '08567891234'],
          ];
          const ws = XLSX.utils.aoa_to_sheet(rows);
          // Lebar kolom supaya mudah dibaca
          ws['!cols'] = [{ wch: 30 }, { wch: 20 }];
          const wb = XLSX.utils.book_new();
          XLSX.utils.book_append_sheet(wb, ws, 'Tamu');
          XLSX.writeFile(wb, 'template-tamu.xlsx');
        });
      }

      // --- IMPORT CSV / XLSX LOGIC ---
      const importBtn = document.getElementById('import-guest-btn');
      const importInput = document.getElementById('import-guest-input');

      async function ensureXLSX() {
        if (!window.XLSX) {
          await new Promise((resolve, reject) => {
            const s = document.createElement('script');
            s.src = 'https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
            s.onload = resolve;
            s.onerror = reject;
            document.head.appendChild(s);
          });
        }
        return window.XLSX;
      }

      if (importBtn && importInput) {
        importBtn.addEventListener('click', () => {
          importInput.click();
        });

        importInput.addEventListener('change', async (e) => {
          const file = e.target.files[0];
          if (!file) return;

          const isXlsx = file.name.endsWith('.xlsx') || file.name.endsWith('.xls');
          let rows = []; // [{name, phone}]

          if (isXlsx) {
            const XLSX = await ensureXLSX();
            const buf = await file.arrayBuffer();
            const wb = XLSX.read(buf, { type: 'array' });
            const ws = wb.Sheets[wb.SheetNames[0]];
            const data = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });
            // Cari baris header (ada kata 'nama')
            let startIdx = 0;
            if (data.length > 0 && String(data[0][0]).toLowerCase().includes('nama')) startIdx = 1;
            for (let i = startIdx; i < data.length; i++) {
              const name = String(data[i][0] ?? '').trim();
              if (!name) continue;
              rows.push({ name, phone: String(data[i][1] ?? '').trim() });
            }
          } else {
            // CSV path
            const text = await file.text();
            const lines = text.split('\n');
            let startIndex = 0;
            if (lines.length > 0 && lines[0].toLowerCase().includes('nama')) startIndex = 1;
            for (let i = startIndex; i < lines.length; i++) {
              const line = lines[i].trim();
              if (!line) continue;
              const sep = line.includes(';') ? ';' : ',';
              const parts = line.split(sep);
              const name = parts[0] ? parts[0].replace(/^"|"$/g, '').trim() : '';
              if (!name) continue;
              rows.push({ name, phone: parts[1] ? parts[1].replace(/^"|"$/g, '').trim() : '' });
            }
          }

          if (rows.length === 0) {
            window.showToast({ type: 'warning', message: 'Tidak ada data tamu yang ditemukan.' });
            importInput.value = '';
            return;
          }

          importBtn.disabled = true;
          importBtn.innerText = 'Mengimpor...';

          try {
            const formattedGuests = rows.map(r => {
              let p = r.phone || '';
              if (p.startsWith('0')) p = '62' + p.substring(1);
              p = p.replace(/[^0-9]/g, '');
              return { name: r.name, phone: p };
            });

            const response = await fetch('/api/guests', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ weddingId, guests: formattedGuests })
            });

            const result = await response.json();
            if (result.success && Array.isArray(result.items)) {
              const newGuests = result.items.map(item => ({
                id: item.id,
                name: item.guest_name,
                phone: item.phone,
                openedAt: item.opened_at || null,
                lastOpenedAt: item.last_opened_at || null,
                openCount: Number(item.open_count || 0)
              }));

              guestsData = [...newGuests, ...guestsData];
              applyFilters();
              currentPage = 1;
              renderGuests();
              window.showToast({ type: 'success', message: `Berhasil mengimpor ${newGuests.length} tamu.` });
            } else {
              window.showToast({ type: 'error', message: result.error || 'Gagal mengimpor data tamu.' });
            }
          } catch (err) {
            console.error('Gagal mengimpor tamu:', err);
            window.showToast({ type: 'error', message: 'Terjadi kesalahan saat mengimpor data tamu.' });
          } finally {
            importInput.value = '';
            importInput.disabled = false;
            importBtn.disabled = false;
            importBtn.innerHTML = '<span class="material-symbols-outlined rsvp-filter-icon">upload_file</span> Import';
          }
        });
      }

      const prevBtn = document.getElementById('kirimPrev');
      const nextBtn = document.getElementById('kirimNext');
      
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            renderGuests();
          }
        });
      }
      
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          let totalPages = Math.ceil(filteredData.length / itemsPerPage) || 1;
          if (currentPage < totalPages) {
            currentPage++;
            renderGuests();
          }
        });
      }

      // Initialize on load
      applyFilters();
      renderGuests();
    });
  </script>
</ClientLayout>
