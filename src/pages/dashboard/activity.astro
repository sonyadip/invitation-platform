---
import { getActivityLogs, getActivityStats } from '../../services/activity-log';
import { getDashboardReport } from '../../services/dashboard-report';
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const session = Astro.locals.session;
if (session?.role !== 'admin') {
  return Astro.redirect('/?login=admin');
}

const url = Astro.url;
const searchParam = url.searchParams.get('q') || '';
const slugParam = url.searchParams.get('slug') || '';
const actionParam = url.searchParams.get('action') || '';
const actorParam = url.searchParams.get('actor') || '';
const pageParam = parseInt(url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;
const pageSize = 30;
const offset = (currentPage - 1) * pageSize;

const [stats, logsResponse, report] = await Promise.all([
  getActivityStats(),
  getActivityLogs({
    search: searchParam || undefined,
    slug: slugParam || undefined,
    action: actionParam || undefined,
    actorType: actorParam || undefined,
    limit: pageSize,
    offset
  }),
  getDashboardReport().catch(() => null)
]);

const totalPages = Math.ceil(logsResponse.total / pageSize) || 1;
const allSlugs = (report?.reports || []).map(r => r.slug).sort();

function getActionBadge(action: string): { label: string; bg: string; color: string; border: string; icon: string } {
  switch (action) {
    case 'invitation.create':
      return { label: 'Create Invitation', bg: '#f0fdf4', color: '#15803d', border: '#bbf7d0', icon: '✨' };
    case 'invitation.update':
      return { label: 'Update Data', bg: '#f0f9ff', color: '#0369a1', border: '#bae6fd', icon: '✏️' };
    case 'invitation.duplicate':
      return { label: 'Duplicate', bg: '#fefce8', color: '#a16207', border: '#fef08a', icon: '📋' };
    case 'invitation.soft_delete':
      return { label: 'Soft Delete', bg: '#fef2f2', color: '#b91c1c', border: '#fecaca', icon: '🗑️' };
    case 'invitation.restore':
      return { label: 'Restore Invitation', bg: '#faf5ff', color: '#7e22ce', border: '#e9d5ff', icon: '♻️' };
    case 'invitation.permanent_delete':
      return { label: 'Permanent Delete', bg: '#fef2f2', color: '#991b1b', border: '#fca5a5', icon: '🔥' };
    case 'invitation.reset_activities':
    case 'invitation.reset_views':
      return { label: 'Reset Aktivitas', bg: '#f4f4f5', color: '#3f3f46', border: '#e4e4e7', icon: '🔄' };
    case 'invitation.reset_rsvps':
      return { label: 'Reset RSVPs', bg: '#fef2f2', color: '#991b1b', border: '#fecaca', icon: '🧹' };
    case 'rsvp.submit':
      return { label: 'Guest RSVP', bg: '#f0fdf4', color: '#166534', border: '#bbf7d0', icon: '💌' };
    case 'rsvp.delete':
      return { label: 'Delete RSVP', bg: '#fef2f2', color: '#991b1b', border: '#fecaca', icon: '❌' };
    case 'platform.update':
      return { label: 'Platform Settings', bg: '#fff7ed', color: '#c2410c', border: '#fed7aa', icon: '⚙️' };
    case 'revision.restore':
      return { label: 'Rollback Revision', bg: '#fdf4ff', color: '#86198f', border: '#f5d0fe', icon: '⏪' };
    case 'revision.checkpoint':
      return { label: 'Checkpoint', bg: '#eef2ff', color: '#3730a3', border: '#c7d2fe', icon: '🔖' };
    case 'auth.login':
      return { label: 'Login Success', bg: '#f4f4f5', color: '#18181b', border: '#e4e4e7', icon: '🔑' };
    case 'auth.login_failed':
      return { label: 'Login Failed', bg: '#fef2f2', color: '#991b1b', border: '#fecaca', icon: '⚠️' };
    case 'auth.logout':
      return { label: 'Logout', bg: '#f4f4f5', color: '#71717a', border: '#e4e4e7', icon: '🚪' };
    case 'auth.setup':
      return { label: 'Client Setup', bg: '#eff6ff', color: '#1d4ed8', border: '#bfdbfe', icon: '🎉' };
    default:
      return { label: action, bg: '#f4f4f5', color: '#52525b', border: '#e4e4e7', icon: '📌' };
  }
}

function getActorBadge(actorType: string): { label: string; bg: string; color: string; border: string } {
  switch (actorType) {
    case 'admin':
      return { label: 'Admin', bg: '#18181b', color: '#ffffff', border: '#18181b' };
    case 'client':
      return { label: 'Client', bg: '#f3e8ff', color: '#6b21a8', border: '#d8b4fe' };
    case 'guest':
      return { label: 'Guest', bg: '#ecfdf5', color: '#047857', border: '#a7f3d0' };
    default:
      return { label: 'System', bg: '#f4f4f5', color: '#52525b', border: '#e4e4e7' };
  }
}

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'Just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}

function formatFullDate(dateStr: string): string {
  return new Date(dateStr).toLocaleString('en-US', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  });
}
---

<AdminLayout
  title="Activity Log"
  activeNav="activity"
  breadcrumbs={[{ label: "Dashboard", href: "/dashboard" }, { label: "Activity Log" }]}
>
  <header class="admin-page-header">
    <div class="admin-page-header__left">
      <h1 class="admin-page-header__title">Activity Log</h1>
      <p class="admin-page-header__description">
        System audit trail, administrative actions, client updates, and security events.
      </p>
    </div>

    <div class="admin-page-header__actions">
      <a href="/dashboard" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="7" height="9" x="3" y="3" rx="1"></rect>
          <rect width="7" height="5" x="14" y="3" rx="1"></rect>
          <rect width="7" height="9" x="14" y="12" rx="1"></rect>
          <rect width="7" height="5" x="3" y="16" rx="1"></rect>
        </svg>
        Dashboard Overview
      </a>
      <a href="/dashboard/settings" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
        </svg>
        Platform Settings
      </a>
    </div>
  </header>

  <section class="metric-grid" aria-label="Activity summary statistics">
    <div class="metric-card">
      <div class="metric-card__top">
        <span class="metric-card__label">Total Logs</span>
        <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
        </svg>
      </div>
      <div class="metric-card__value">{stats.totalLogs.toLocaleString('en-US')}</div>
      <p class="metric-card__sub">All recorded events in database</p>
    </div>

    <div class="metric-card">
      <div class="metric-card__top">
        <span class="metric-card__label">Activities (24h)</span>
        <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="metric-card__value">{stats.recent24h.toLocaleString('en-US')}</div>
      <p class="metric-card__sub">Events logged in past 24 hours</p>
    </div>

    <div class="metric-card">
      <div class="metric-card__top">
        <span class="metric-card__label">Revisions (24h)</span>
        <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
      </div>
      <div class="metric-card__value">{stats.revisionCount24h.toLocaleString('en-US')}</div>
      <p class="metric-card__sub">Snapshots created recently</p>
    </div>

    <div class="metric-card">
      <div class="metric-card__top">
        <span class="metric-card__label">Admin Actions (24h)</span>
        <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <polyline points="16 11 18 13 22 9"></polyline>
        </svg>
      </div>
      <div class="metric-card__value">{stats.adminActions24h.toLocaleString('en-US')}</div>
      <p class="metric-card__sub">Administrative modifications</p>
    </div>
  </section>

  <section class="shadcn-card" style="margin-bottom: 24px;">
    <div class="shadcn-card__header">
      <div class="shadcn-card__title-wrap">
        <h2 class="shadcn-card__title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px;">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
          Filter Activity Logs
        </h2>
        <p class="shadcn-card__description">Filter records by keyword, invitation slug, action category, or actor role.</p>
      </div>
    </div>

    <div class="shadcn-card__content" style="padding: 20px 24px;">
      <form method="GET" class="filter-form" style="display: flex; flex-direction: column; gap: 16px;">
        <div class="form-grid" style="grid-template-columns: repeat(4, 1fr);">
          <div class="field-group" style="grid-column: span 1;">
            <label for="q">Keyword Search</label>
            <input
              type="text"
              id="q"
              name="q"
              placeholder="Search keyword or description..."
              value={searchParam}
            />
          </div>

          <div class="field-group" style="grid-column: span 1;">
            <label for="slug">Invitation (Slug)</label>
            <select id="slug" name="slug">
              <option value="">-- All Slugs --</option>
              {allSlugs.map(slug => (
                <option value={slug} selected={slugParam === slug}>{slug}</option>
              ))}
            </select>
          </div>

          <div class="field-group" style="grid-column: span 1;">
            <label for="action">Action Type</label>
            <select id="action" name="action">
              <option value="">-- All Actions --</option>
              <option value="invitation.create" selected={actionParam === 'invitation.create'}>✨ Create Invitation</option>
              <option value="invitation.update" selected={actionParam === 'invitation.update'}>✏️ Update Invitation</option>
              <option value="invitation.duplicate" selected={actionParam === 'invitation.duplicate'}>📋 Duplicate Invitation</option>
              <option value="invitation.soft_delete" selected={actionParam === 'invitation.soft_delete'}>🗑️ Soft Delete</option>
              <option value="invitation.restore" selected={actionParam === 'invitation.restore'}>♻️ Restore Invitation</option>
              <option value="revision.restore" selected={actionParam === 'revision.restore'}>⏪ Rollback Revision</option>
              <option value="rsvp.submit" selected={actionParam === 'rsvp.submit'}>💌 Guest RSVP</option>
              <option value="platform.update" selected={actionParam === 'platform.update'}>⚙️ Platform Settings</option>
              <option value="auth.login" selected={actionParam === 'auth.login'}>🔑 Login Success</option>
              <option value="auth.login_failed" selected={actionParam === 'auth.login_failed'}>⚠️ Login Failed</option>
              <option value="auth.logout" selected={actionParam === 'auth.logout'}>🚪 Logout</option>
              <option value="auth.setup" selected={actionParam === 'auth.setup'}>🎉 Client Setup</option>
            </select>
          </div>

          <div class="field-group" style="grid-column: span 1;">
            <label for="actor">Role Type</label>
            <select id="actor" name="actor">
              <option value="">-- All Roles --</option>
              <option value="admin" selected={actorParam === 'admin'}>Admin</option>
              <option value="client" selected={actorParam === 'client'}>Client</option>
              <option value="guest" selected={actorParam === 'guest'}>Guest</option>
            </select>
          </div>
        </div>

        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
          {(searchParam || slugParam || actionParam || actorParam) && (
            <a href="/dashboard/activity" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">
              Reset Filters
            </a>
          )}
          <button type="submit" class="btn-shadcn btn-shadcn--primary btn-shadcn--sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            Apply Filters
          </button>
        </div>
      </form>
    </div>
  </section>

  <section class="shadcn-card">
    <div class="shadcn-card__header">
      <div class="shadcn-card__title-wrap">
        <h2 class="shadcn-card__title">
          Audit Records
          <span class="shadcn-badge shadcn-badge--outline">
            {logsResponse.total} total
          </span>
        </h2>
        <p class="shadcn-card__description">
          Showing {logsResponse.items.length} records on current page
        </p>
      </div>
    </div>

    {logsResponse.items.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <p class="empty-state__title">No activity logs found</p>
        <p class="empty-state__sub">Try adjusting your filters or keyword query.</p>
      </div>
    ) : (
      <div class="shadcn-table-wrap">
        <table class="shadcn-table">
          <thead>
            <tr>
              <th style="width: 170px;">Timestamp</th>
              <th style="width: 110px;">Role</th>
              <th style="width: 170px;">Action</th>
              <th style="width: 150px;">Invitation</th>
              <th>Description</th>
              <th style="width: 80px; text-align: center;">Details</th>
            </tr>
          </thead>
          <tbody>
            {logsResponse.items.map((log) => {
              const actionBadge = getActionBadge(log.action);
              const actorBadge = getActorBadge(log.actor_type);
              const hasMeta = log.metadata && Object.keys(log.metadata).length > 0;

              return (
                <tr>
                  <td>
                    <div style="display: flex; flex-direction: column; gap: 2px;">
                      <strong style="font-size: 13px; font-weight: 600; color: var(--admin-zinc-950);">{timeAgo(log.created_at)}</strong>
                      <span style="font-size: 11px; color: var(--admin-text-muted);">{formatFullDate(log.created_at)}</span>
                    </div>
                  </td>
                  <td>
                    <span
                      class="shadcn-badge"
                      style={`background: ${actorBadge.bg}; color: ${actorBadge.color}; border: 1px solid ${actorBadge.border};`}
                    >
                      {log.actor_name || actorBadge.label}
                    </span>
                  </td>
                  <td>
                    <span
                      class="shadcn-badge"
                      style={`background: ${actionBadge.bg}; color: ${actionBadge.color}; border: 1px solid ${actionBadge.border};`}
                    >
                      <span>{actionBadge.icon}</span>
                      <span>{actionBadge.label}</span>
                    </span>
                  </td>
                  <td>
                    {log.slug ? (
                      <div style="display: flex; flex-direction: column; gap: 2px;">
                        <a href={`/dashboard/${log.slug}`} style="font-weight: 600; color: var(--admin-zinc-900); text-decoration: none;">
                          {log.slug}
                        </a>
                        <div style="display: flex; align-items: center; gap: 6px; font-size: 11px;">
                          <a href={`/dashboard/${log.slug}/edit`} style="color: var(--admin-text-muted); text-decoration: none;">Edit</a>
                          <span style="color: var(--admin-zinc-300);">•</span>
                          <a href={`/dashboard/${log.slug}/revisions`} style="color: var(--admin-text-muted); text-decoration: none;">Revisions</a>
                        </div>
                      </div>
                    ) : (
                      <span style="font-size: 12px; color: var(--admin-text-dim);">Global</span>
                    )}
                  </td>
                  <td>
                    <p style="margin: 0; font-size: 13px; color: var(--admin-zinc-700); line-height: 1.4;">
                      {log.description}
                    </p>
                  </td>
                  <td style="text-align: center;">
                    {hasMeta ? (
                      <details style="display: inline-block; position: relative;">
                        <summary
                          class="btn-shadcn btn-shadcn--outline btn-shadcn--sm"
                          style="cursor: pointer; list-style: none; padding: 3px 8px; font-size: 11px; font-weight: 600;"
                        >
                          JSON
                        </summary>
                        <div style="position: absolute; right: 0; top: 100%; margin-top: 6px; z-index: 50; width: 320px; background: #ffffff; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-md); box-shadow: var(--admin-shadow-md); padding: 12px; text-align: left; max-height: 240px; overflow: auto;">
                          <pre style="margin: 0; font-size: 11px; color: var(--admin-zinc-800); font-family: monospace; white-space: pre-wrap;">{JSON.stringify(log.metadata, null, 2)}</pre>
                        </div>
                      </details>
                    ) : (
                      <span style="color: var(--admin-zinc-300);">-</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    <div class="shadcn-card__footer">
      <span>
        Page <strong>{currentPage}</strong> of <strong>{totalPages}</strong>
      </span>

      {totalPages > 1 && (
        <div style="display: flex; align-items: center; gap: 8px;">
          {currentPage > 1 ? (
            <a
              class="btn-shadcn btn-shadcn--outline btn-shadcn--sm"
              href={`/dashboard/activity?page=${currentPage - 1}${searchParam ? `&q=${encodeURIComponent(searchParam)}` : ''}${slugParam ? `&slug=${encodeURIComponent(slugParam)}` : ''}${actionParam ? `&action=${encodeURIComponent(actionParam)}` : ''}${actorParam ? `&actor=${encodeURIComponent(actorParam)}` : ''}`}
            >
              ← Previous
            </a>
          ) : (
            <span class="btn-shadcn btn-shadcn--outline btn-shadcn--sm" style="opacity: 0.5; pointer-events: none;">
              ← Previous
            </span>
          )}

          {currentPage < totalPages ? (
            <a
              class="btn-shadcn btn-shadcn--outline btn-shadcn--sm"
              href={`/dashboard/activity?page=${currentPage + 1}${searchParam ? `&q=${encodeURIComponent(searchParam)}` : ''}${slugParam ? `&slug=${encodeURIComponent(slugParam)}` : ''}${actionParam ? `&action=${encodeURIComponent(actionParam)}` : ''}${actorParam ? `&actor=${encodeURIComponent(actorParam)}` : ''}`}
            >
              Next →
            </a>
          ) : (
            <span class="btn-shadcn btn-shadcn--outline btn-shadcn--sm" style="opacity: 0.5; pointer-events: none;">
              Next →
            </span>
          )}
        </div>
      )}
    </div>
  </section>
</AdminLayout>
