---
import { getPlatformSettings, savePlatformSettings } from '../../services/platform-settings';
import { hashPasswordSHA256 } from '../../utils/security';
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const session = Astro.locals.session;
if (session?.role !== 'admin') {
  return Astro.redirect('/?login=admin');
}

let successMessage = '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const val = (name: string) => String(formData.get(name) || '').trim();

  try {
    await savePlatformSettings({
      site_name: val('site_name'),
      site_tagline: val('site_tagline'),
      logo_url: val('logo_url'),
      logo_dark_url: val('logo_dark_url'),
      whatsapp_url: val('whatsapp_url'),
      instagram_url: val('instagram_url'),
      email: val('email'),
      facebook_url: val('facebook_url'),
      tiktok_url: val('tiktok_url'),
      youtube_url: val('youtube_url'),
      home_heading_1: val('home_heading_1'),
      home_heading_2: val('home_heading_2'),
      home_heading_3: val('home_heading_3'),
      home_description: val('home_description'),
      home_cta_label: val('home_cta_label'),
      home_templates_eyebrow: val('home_templates_eyebrow'),
      home_templates_heading: val('home_templates_heading'),
      home_booking_eyebrow: val('home_booking_eyebrow'),
      home_booking_heading: val('home_booking_heading'),
      home_booking_cta: val('home_booking_cta'),
      home_hero_seal_text: val('home_hero_seal_text'),
      home_stat_number: val('home_stat_number'),
      home_stat_label: val('home_stat_label'),
      home_template_cards: JSON.parse(val('home_template_cards') || '[]'),
      meta_title: val('meta_title'),
      meta_description: val('meta_description'),
      google_analytics_id: val('google_analytics_id'),
      google_tag_manager_id: val('google_tag_manager_id'),
    });
    successMessage = 'Platform settings have been saved successfully.';
  } catch (error) {
    errorMessage = error instanceof Error ? error.message : 'Failed to save settings.';
  }
}

const settings = await getPlatformSettings();
---

<AdminLayout
  title="Platform Settings"
  activeNav="settings"
  breadcrumbs={[{ label: "Dashboard", href: "/dashboard" }, { label: "Platform Settings" }]}
>
  <!-- Page Header -->
  <header class="admin-page-header">
    <div class="admin-page-header__left">
      <h1 class="admin-page-header__title">Platform Settings</h1>
      <p class="admin-page-header__description">
        Manage brand identity, contact channels, homepage content, and SEO metadata.
      </p>
    </div>

    <div class="admin-page-header__actions">
      <a href="/" target="_blank" rel="noopener noreferrer" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        View Public Landing Page
      </a>
    </div>
  </header>

  <!-- Alerts -->
  {successMessage && (
    <div class="shadcn-alert shadcn-alert--success" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <div>
        <strong>Settings Saved</strong>
        <p>{successMessage}</p>
      </div>
    </div>
  )}

  {errorMessage && (
    <div class="shadcn-alert shadcn-alert--error" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <div>
        <strong>Error</strong>
        <p>{errorMessage}</p>
      </div>
    </div>
  )}

  <form class="form-panel" method="POST">
    <!-- SECTION 1: IDENTITY -->
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">🏢</span>
        <div>
          <h2>Platform Identity</h2>
          <p>Name, tagline, and brand logos displayed across public pages.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field-group">
          <label>Platform Name <span class="required">*</span></label>
          <input name="site_name" value={settings.site_name} placeholder="Senadda" required />
        </div>
        <div class="field-group">
          <label>Tagline</label>
          <input name="site_tagline" value={settings.site_tagline} placeholder="Digital Wedding Invitation Platform" />
        </div>
        <div class="field-group wide">
          <label>Logo URL (Light Theme)</label>
          <input name="logo_url" value={settings.logo_url} placeholder="/images/senadda-logo.png" />
          {settings.logo_url && (
            <div style="margin-top: 8px; padding: 8px; background: #fafafa; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); display: inline-block;">
              <img src={settings.logo_url} alt="Logo Preview" style="height: 24px; width: auto; object-fit: contain; display: block;" />
            </div>
          )}
        </div>
        <div class="field-group wide">
          <label>Logo URL (Dark / Alternative)</label>
          <input name="logo_dark_url" value={settings.logo_dark_url} placeholder="https://example.com/logo-dark.png" />
          {settings.logo_dark_url && (
            <div style="margin-top: 8px; padding: 8px; background: #18181b; border: 1px solid var(--admin-zinc-800); border-radius: var(--admin-radius-sm); display: inline-block;">
              <img src={settings.logo_dark_url} alt="Dark Logo Preview" style="height: 24px; width: auto; object-fit: contain; display: block;" />
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- SECTION 2: SOCIAL MEDIA & CONTACT -->
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">📱</span>
        <div>
          <h2>Contact & Social Media</h2>
          <p>Links used in CTA buttons, footer, and social media channels.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field-group">
          <label>WhatsApp URL</label>
          <input name="whatsapp_url" value={settings.whatsapp_url} placeholder="https://wa.me/6281234567890" />
          <span class="hint">Format: https://wa.me/62812xxxxx</span>
        </div>
        <div class="field-group">
          <label>Official Email</label>
          <input type="email" name="email" value={settings.email} placeholder="hello@senadda.id" />
        </div>
        <div class="field-group">
          <label>Instagram URL</label>
          <input name="instagram_url" value={settings.instagram_url} placeholder="https://instagram.com/senadda" />
        </div>
        <div class="field-group">
          <label>Facebook URL</label>
          <input name="facebook_url" value={settings.facebook_url} placeholder="https://facebook.com/senadda" />
        </div>
        <div class="field-group">
          <label>TikTok URL</label>
          <input name="tiktok_url" value={settings.tiktok_url} placeholder="https://tiktok.com/@senadda" />
        </div>
        <div class="field-group">
          <label>YouTube URL</label>
          <input name="youtube_url" value={settings.youtube_url} placeholder="https://youtube.com/@senadda" />
        </div>
      </div>
    </div>

    <!-- SECTION 3: HOMEPAGE CONTENT -->
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">🏠</span>
        <div>
          <h2>Homepage Content</h2>
          <p>Hero texts, descriptions, and button labels on the main landing page.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field-group">
          <label>Heading Word 1</label>
          <input name="home_heading_1" value={settings.home_heading_1} placeholder="Wedding" />
        </div>
        <div class="field-group">
          <label>Heading Word 2</label>
          <input name="home_heading_2" value={settings.home_heading_2} placeholder="Digital" />
        </div>
        <div class="field-group">
          <label>Heading Word 3</label>
          <input name="home_heading_3" value={settings.home_heading_3} placeholder="Invitations" />
        </div>
        <div class="field-group">
          <label>CTA Button Label</label>
          <input name="home_cta_label" value={settings.home_cta_label} placeholder="View Collection" />
        </div>
        <div class="field-group wide">
          <label>Animated Seal Text</label>
          <input name="home_hero_seal_text" value={settings.home_hero_seal_text} placeholder="SENADDA • DIGITAL STUDIO • INVITATION •" />
        </div>
        <div class="field-group wide">
          <label>Hero Description</label>
          <textarea name="home_description" rows="3" placeholder="Enter landing hero description...">{settings.home_description}</textarea>
        </div>
      </div>
    </div>

    <!-- SECTION 4: HERO STATS -->
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">📈</span>
        <div>
          <h2>Hero Statistics</h2>
          <p>Stat metric and label displayed in the landing hero section.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field-group">
          <label>Statistic Number</label>
          <input name="home_stat_number" value={settings.home_stat_number} placeholder="5+" />
        </div>
        <div class="field-group">
          <label>Statistic Label</label>
          <input name="home_stat_label" value={settings.home_stat_label} placeholder="Exclusive Designs" />
        </div>
      </div>
    </div>

    <!-- SECTION 5: TEMPLATES COLLECTION -->
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">🎨</span>
        <div>
          <h2>Design Collection</h2>
          <p>Catalog cards and texts for the template showcase section.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field-group">
          <label>Eyebrow Subtitle</label>
          <input name="home_templates_eyebrow" value={settings.home_templates_eyebrow} placeholder="Design Collection" />
        </div>
        <div class="field-group">
          <label>Heading</label>
          <input name="home_templates_heading" value={settings.home_templates_heading} placeholder="Choose Your Theme." />
        </div>
        <div class="field-group wide">
          <label>Design Catalog Cards</label>
          <input type="hidden" name="home_template_cards" id="template_cards_input" value={JSON.stringify(settings.home_template_cards)} />
          <div id="template_cards_container" style="display: flex; flex-direction: column; gap: 12px; margin-top: 6px;"></div>
          <div style="margin-top: 12px;">
            <button type="button" id="add_template_card_btn" class="btn-shadcn btn-shadcn--outline btn-shadcn--sm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
              Add Card
            </button>
          </div>
          <span class="hint" style="display: block; margin-top: 8px;">
            Default template keys: lumiere, lumiere-metatah, lumiere-metatah-v2, deauville, air, editorial, noir, atelier, sage, ochre, ivory.
          </span>
        </div>
      </div>
    </div>

    <!-- SECTION 6: BOOKING & CONTACT SECTION -->
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">💬</span>
        <div>
          <h2>Booking & Contact Section</h2>
          <p>Texts for the booking inquiry call-to-action.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field-group">
          <label>Eyebrow Subtitle</label>
          <input name="home_booking_eyebrow" value={settings.home_booking_eyebrow} placeholder="Next Steps" />
        </div>
        <div class="field-group">
          <label>Heading</label>
          <input name="home_booking_heading" value={settings.home_booking_heading} placeholder="Tell us about your wedding." />
        </div>
        <div class="field-group wide">
          <label>WhatsApp Button Label</label>
          <input name="home_booking_cta" value={settings.home_booking_cta} placeholder="Contact via WhatsApp" />
        </div>
      </div>
    </div>

    <!-- SECTION 7: SEO -->
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">🔍</span>
        <div>
          <h2>SEO & Metadata</h2>
          <p>Meta title and description displayed in search engines and social cards.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field-group wide">
          <label>Meta Title</label>
          <input name="meta_title" value={settings.meta_title} placeholder="Senadda - Digital Wedding Invitations" />
        </div>
        <div class="field-group wide">
          <label>Meta Description</label>
          <textarea name="meta_description" rows="3" placeholder="Enter meta description for search engines...">{settings.meta_description}</textarea>
        </div>
      </div>
    </div>

    <!-- SECTION 8: ANALYTICS & TRACKING -->
    <div class="form-card">
      <div class="form-card__header">
        <span class="section-icon">📊</span>
        <div>
          <h2>Analytics & Tracking</h2>
          <p>Tracking IDs for Google Analytics 4 (GA4) and Google Tag Manager (GTM).</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field-group wide">
          <label>Google Analytics 4 Measurement ID</label>
          <input name="google_analytics_id" value={settings.google_analytics_id || ''} placeholder="G-PS8CJGKXWG" />
          <span class="hint">Example: G-PS8CJGKXWG. Automatically injected into landing page and wedding invitations in production.</span>
        </div>
        <div class="field-group wide">
          <label>Google Tag Manager Container ID (Optional)</label>
          <input name="google_tag_manager_id" value={settings.google_tag_manager_id || ''} placeholder="GTM-XXXXXXX" />
          <span class="hint">Leave blank if only using GA4 measurement ID.</span>
        </div>
      </div>
    </div>

    <!-- Sticky Bottom Actions Bar -->
    <div class="form-actions-bar">
      <a href="/dashboard" class="btn-shadcn btn-shadcn--outline">Cancel</a>
      <button type="submit" class="btn-shadcn btn-shadcn--primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        Save Settings
      </button>
    </div>
  </form>
</AdminLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('template_cards_container');
    const input = document.getElementById('template_cards_input');
    const addBtn = document.getElementById('add_template_card_btn');
    const form = document.querySelector('.form-panel');

    let cards = [];
    try {
      cards = JSON.parse(input?.value || '[]');
    } catch (e) {
      cards = [];
    }

    function render() {
      if (!container) return;
      container.innerHTML = '';
      cards.forEach((card, index) => {
        const row = document.createElement('div');
        row.style.cssText = 'background: #fafafa; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-md); padding: 16px; position: relative;';
        row.innerHTML = `
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 12px;">
            <div class="field-group">
              <label style="font-size: 11px;">Theme Key</label>
              <input type="text" placeholder="lumiere" value="${card.key || ''}" data-idx="${index}" data-field="key" />
            </div>
            <div class="field-group">
              <label style="font-size: 11px;">Card Name</label>
              <input type="text" placeholder="Lumiere" value="${card.name || ''}" data-idx="${index}" data-field="name" />
            </div>
            <div class="field-group">
              <label style="font-size: 11px;">Category</label>
              <select data-idx="${index}" data-field="category">
                <option value="pernikahan" ${card.category !== 'metatah' ? 'selected' : ''}>Pernikahan</option>
                <option value="metatah" ${card.category === 'metatah' ? 'selected' : ''}>Metatah</option>
              </select>
            </div>
            <div class="field-group">
              <label style="font-size: 11px;">Price</label>
              <input type="text" placeholder="Rp 450.000" value="${card.price || ''}" data-idx="${index}" data-field="price" />
            </div>
            <div class="field-group">
              <label style="font-size: 11px;">Promo Price</label>
              <input type="text" placeholder="Rp 300.000" value="${card.promoPrice || ''}" data-idx="${index}" data-field="promoPrice" />
            </div>
            <div class="field-group">
              <label style="font-size: 11px;">Image URL</label>
              <input type="text" placeholder="(Optional)" value="${card.image || ''}" data-idx="${index}" data-field="image" />
            </div>
          </div>
          <div style="display: flex; justify-content: flex-end;">
            <button type="button" class="btn-shadcn btn-shadcn--destructive-outline btn-shadcn--sm remove-card-btn" data-idx="${index}">
              Delete Card
            </button>
          </div>
        `;
        container.appendChild(row);
      });
    }

    const handleFieldChange = (e) => {
      const target = e.target;
      if (target && target.dataset && target.dataset.idx !== undefined && target.dataset.field) {
        cards[target.dataset.idx][target.dataset.field] = target.value;
      }
    };

    container?.addEventListener('input', handleFieldChange);
    container?.addEventListener('change', handleFieldChange);

    container?.addEventListener('click', (e) => {
      const btn = e.target.closest('.remove-card-btn');
      if (btn) {
        const idx = btn.dataset.idx;
        cards.splice(idx, 1);
        render();
      }
    });

    addBtn?.addEventListener('click', () => {
      cards.push({ key: '', name: '', category: 'pernikahan', price: '', promoPrice: '', image: '' });
      render();
    });

    form?.addEventListener('submit', () => {
      const validCards = cards.filter(c => c.key || c.name);
      if (input) input.value = JSON.stringify(validCards);
    });

    render();
  });
</script>
