---
export const prerender = false;

import airCover from "../templates/air/assets/air-hero-1.webp";
import deauvilleCover from "../templates/deauville/assets/deauville-1-photo-1.jpg";
import ivoryCover from "../templates/ivory/assets/bg-hero.webp";
import noirCover from "../templates/noir/assets/bg-hero.webp";
import ochreMotionCover from "../templates/ochre/assets/gallery-8.webp";
import sageCover from "../templates/sage/assets/bg-hero.webp";

const bookingUrl = "#booking";

const navItems = [
    ["Template", "#templates"],
    ["Alur", "#booking"],
    ["Booking", "#booking"],
];
const stats = [
    ["06", "Template\nPremium"],
    // ["05", "Menit\nPilih"],
    // ["01", "Chat\nBooking"],
];
const headingWords = ["Undangan", "Elegan", "Instan"];
const templateCards = [
    {
        key: "noir",
        name: "Noir",
        tone: "Dark editorial",
        copy: "Tegas, modern, dan berkelas.",
        image: noirCover.src,
    },
    // {
    //   key: "ivory",
    //   name: "Ivory",
    //   tone: "Soft classic",
    //   copy: "Lembut, bersih, dan timeless.",
    //   image: ivoryCover.src,
    // },
    // {
    //   key: "sage",
    //   name: "Sage",
    //   tone: "Natural calm",
    //   copy: "Natural, tenang, dan intimate.",
    //   image: sageCover.src,
    // },
    {
        key: "ochre",
        name: "Ochre",
        tone: "Warm premium",
        copy: "Hangat, premium, dan berkarakter.",
        image: ochreMotionCover.src,
    },
    {
        key: "air",
        name: "Air",
        tone: "Clean airy",
        copy: "Ringan, luas, dan modern.",
        image: airCover.src,
    },
    {
        key: "deauville",
        name: "Deauville",
        tone: "Romantic journal",
        copy: "Romantis, personal, dan editorial.",
        image: deauvilleCover.src,
    },
];
const heroMotionCards = templateCards;
---

<!doctype html>
<html lang="id" class="intro-scroll-lock">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Aura Invite - Platform Undangan Digital</title>
        <meta
            name="description"
            content="Platform undangan digital modular dengan template premium, RSVP, wishes, map, musik, dan amplop digital."
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Onest:wght@600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body id="top" class="intro-enter">
        <div class="intro-animation" data-intro aria-hidden="true"></div>

        <main>
            <nav class="hero-nav" aria-label="Navigasi utama">
                <a
                    class="brand-mark motion-down"
                    style="--i: 0"
                    href="#top"
                    aria-label="Kembali ke atas"
                >
                    <span class="brand-mark__dot"></span>
                    <span class="brand-mark__top">Top</span>
                </a>

                <div class="nav-links" aria-label="Menu desktop">
                    {
                        navItems.map(([label, href], index) => (
                            <a
                                class="motion-down"
                                style={`--i: ${index + 1}`}
                                href={href}
                            >
                                {label}
                            </a>
                        ))
                    }
                </div>

                <a
                    class="nav-action motion-down"
                    style="--i: 4"
                    href="#booking"
                >
                    Book Now
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 17 17 7"></path>
                        <path d="M8 7h9v9"></path>
                    </svg>
                </a>
            </nav>
            <div class="hero-shell-placeholder" aria-hidden="true"></div>
            <section class="hero-shell section-observe is-visible" data-section>
                <div class="hero-sticky">
                    <div class="hero-motion-wrap" aria-hidden="true">
                        <div class="hero-motion">
                            {
                                heroMotionCards.map((template, index) => (
                                    <figure
                                        class={`hero-motion__card${index === 0 ? " is-active" : ""}`}
                                        data-hero-motion-card
                                    >
                                        <img
                                            src={template.image}
                                            alt=""
                                            loading={
                                                index === 0 ? "eager" : "lazy"
                                            }
                                        />
                                    </figure>
                                ))
                            }
                        </div>
                        <div class="hero-motion-seal">
                            <svg viewBox="0 0 120 120">
                                <defs>
                                    <path
                                        id="hero-motion-seal-path"
                                        d="M60 60 m -43 0 a 43 43 0 1 1 86 0 a 43 43 0 1 1 -86 0"
                                    ></path>
                                </defs>
                                <text>
                                    <textPath
                                        href="#hero-motion-seal-path"
                                        startOffset="0%"
                                    >
                                        Aura Invite - Undangan - Elegan - Instan
                                    </textPath>
                                </text>
                            </svg>
                        </div>
                    </div>

                    <div class="stats-row" aria-label="Statistik platform">
                        <div class="stats-row__inner">
                            {
                                stats.map(([number, label], index) => (
                                    <div
                                        class="stat-item motion-up"
                                        style={`--i: ${index + 2}`}
                                    >
                                        <strong>
                                            <span>+</span>
                                            {number}
                                        </strong>
                                        <p>{label}</p>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <div class="bottom-content" aria-label="Hero content">
                        <div class="bottom-content__top">
                            <!-- <p class="tagline motion-up" style="--i: 5">
                Pilih Template<br />Book Jadwal<br />Kami Setup
              </p> -->

                            <a
                                class="hero-cta motion-up"
                                style="--i: 6"
                                href="#templates"
                            >
                                Lihat Template
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M7 17 17 7"></path>
                                    <path d="M8 7h9v9"></path>
                                </svg>
                            </a>
                        </div>

                        <div class="bottom-content__main">
                            <p class="description motion-up" style="--i: 7">
                                Website undangan premium. Pilih template, kirim
                                data, kami siapkan.
                            </p>

                            <h1 aria-label="Undangan Elegan Instan">
                                {
                                    headingWords.map((word, index) => (
                                        <span class="heading-mask">
                                            <span
                                                class="heading-word"
                                                style={`--word-i: ${index}`}
                                            >
                                                {word}
                                            </span>
                                        </span>
                                    ))
                                }
                            </h1>
                        </div>
                    </div>
                </div>
            </section>

            <section
                class="template-list section-observe"
                id="templates"
                data-section
            >
                <div class="section-heading">
                    <p>Templates</p>
                    <h2>Pilih tampilanmu.</h2>
                </div>

                <div class="template-grid">
                    {
                        templateCards.map((template, index) => (
                            <article
                                class="template-card"
                                style={`--template-i: ${index}`}
                            >
                                <div class="template-card__media">
                                    <img
                                        src={template.image}
                                        alt={`Preview template ${template.name}`}
                                        loading="lazy"
                                    />
                                </div>
                                <div class="template-card__body">
                                    <strong>{template.name}</strong>
                                    {/* <p>{template.copy}</p> */}
                                    <span class="template-card__price">
                                        Rp100.000
                                    </span>
                                    <div class="template-card__actions">
                                        <a
                                            href={`/preview/${template.key}`}
                                            target="_blank"
                                            rel="noreferrer"
                                        >
                                            Preview
                                        </a>
                                        <a href="#booking">Book</a>
                                    </div>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </section>

            <section class="start section-observe" id="booking" data-section>
                <p class="reveal-blur">Siap mulai?</p>
                <h2 class="reveal-blur" style="--delay: 100ms">
                    BOOK TEMPLATE PILIHANMU VIA WHATSAPP.
                </h2>
                <a
                    class="start__button reveal-blur"
                    style="--delay: 190ms"
                    href={bookingUrl}>Book via WhatsApp</a
                >
            </section>
        </main>

        <script>
            if ("scrollRestoration" in history) {
                history.scrollRestoration = "manual";
            }
            window.scrollTo({ top: 0, left: 0, behavior: "auto" });

            const sections = document.querySelectorAll("[data-section]");
            const parallaxItems = document.querySelectorAll("[data-parallax]");
            const heroSection = document.querySelector(".hero-shell");
            const heroPlaceholder = document.querySelector(
                ".hero-shell-placeholder",
            );
            const heroMotionCards = Array.from(
                document.querySelectorAll("[data-hero-motion-card]"),
            );
            const anchorLinks = document.querySelectorAll('a[href^="#"]');
            const heroRevealDuration = 1800;
            const heroRevealInterval = 3500;
            const heroIntroRevealDuration = 650;
            const heroIntroRevealInterval = 820;
            const introEnterDuration = 1100;
            const introHoldDuration = 700;
            const introRingShrinkDuration = 1500;
            const introExitDuration = 1250;
            const introTotalDuration =
                introEnterDuration +
                introHoldDuration +
                introRingShrinkDuration +
                introExitDuration;
            const postIntroRevealDelay = 1800;
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            let lastScrollY = 0;
            let activeHeroMotionCard = 0;
            let isHeroMotionAnimating = false;

            const isIntroScrollLocked = () =>
                document.documentElement.classList.contains(
                    "intro-scroll-lock",
                );

            const keepIntroAtTop = (event) => {
                if (!isIntroScrollLocked()) return;
                event?.preventDefault();
                window.scrollTo({ top: 0, left: 0, behavior: "auto" });
            };

            window.addEventListener("pageshow", () => keepIntroAtTop());
            window.addEventListener("wheel", keepIntroAtTop, {
                passive: false,
            });
            window.addEventListener("touchmove", keepIntroAtTop, {
                passive: false,
            });
            window.addEventListener(
                "keydown",
                (event) => {
                    if (
                        [
                            " ",
                            "ArrowDown",
                            "ArrowUp",
                            "PageDown",
                            "PageUp",
                            "Home",
                            "End",
                        ].includes(event.key)
                    ) {
                        keepIntroAtTop(event);
                    }
                },
                { passive: false },
            );

            const completeIntro = () => {
                document.body.classList.remove(
                    "intro-enter",
                    "intro-hold",
                    "intro-ring-shrink",
                    "intro-exit",
                );
                document.body.classList.add("intro-complete");
                document.documentElement.classList.remove("intro-scroll-lock");
                window.scrollTo({ top: 0, left: 0, behavior: "auto" });
                lastScrollY = 0;
                setScrollState();
            };

            const syncHeroFixed = () => {
                if (
                    !(heroSection instanceof HTMLElement) ||
                    !(heroPlaceholder instanceof HTMLElement)
                )
                    return;

                heroSection.classList.remove("hero-shell--fixed");
                heroPlaceholder.style.height = "";

                if (window.innerWidth >= 768) {
                    heroPlaceholder.style.height = `${window.innerHeight * 2}px`;
                    heroSection.classList.add("hero-shell--fixed");
                }
            };

            const setScrollState = () => {
                const currentScrollY = window.scrollY;
                const heroHidePoint =
                    (heroSection?.clientHeight || window.innerHeight) * 0.6;
                const heroProgress = Math.min(
                    currentScrollY / window.innerHeight,
                    1,
                );
                const isScrollingDown =
                    currentScrollY > lastScrollY &&
                    currentScrollY > heroHidePoint;

                heroSection?.style.setProperty(
                    "--hero-scroll",
                    String(heroProgress),
                );
                document.body.classList.toggle("nav-hidden", isScrollingDown);
                document.body.classList.toggle(
                    "has-scrolled",
                    currentScrollY > 8,
                );
                lastScrollY = Math.max(currentScrollY, 0);

                parallaxItems.forEach((item) => {
                    const rect = item.getBoundingClientRect();
                    const centerOffset =
                        (rect.top + rect.height / 2 - window.innerHeight / 2) /
                        window.innerHeight;
                    item.style.setProperty(
                        "--shift",
                        `${centerOffset * -42}px`,
                    );
                });
            };

            const revealObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting)
                            entry.target.classList.add("is-visible");
                    });
                },
                { threshold: 0.22, rootMargin: "0px 0px -8% 0px" },
            );

            const scrollToTarget = (targetId) => {
                const target = document.querySelector(targetId);
                if (!target) return;

                document.body.classList.remove("nav-hidden");
                target.classList.add("is-visible");

                requestAnimationFrame(() => {
                    target.scrollIntoView({
                        behavior: "smooth",
                        block: "start",
                    });
                    window.setTimeout(
                        () =>
                            target.scrollIntoView({
                                behavior: "smooth",
                                block: "start",
                            }),
                        1000,
                    );
                });
            };

            anchorLinks.forEach((link) => {
                link.addEventListener("click", (event) => {
                    const targetId = link.getAttribute("href");
                    if (!targetId || targetId === "#") return;

                    event.preventDefault();
                    history.pushState(null, "", targetId);
                    scrollToTarget(targetId);
                });
            });

            const revealNextHeroMotionCard = (
                duration = heroRevealDuration,
            ) => {
                if (heroMotionCards.length <= 1 || isHeroMotionAnimating)
                    return;

                const previous = heroMotionCards[activeHeroMotionCard];
                activeHeroMotionCard =
                    (activeHeroMotionCard + 1) % heroMotionCards.length;
                const next = heroMotionCards[activeHeroMotionCard];
                if (!previous || !next) return;

                isHeroMotionAnimating = true;
                previous.classList.remove("is-revealing");
                next.classList.add("is-next");

                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        next.classList.add("is-revealing");
                    });
                });

                const completeReveal = () => {
                    previous.classList.remove("is-active", "is-revealing");
                    next.classList.remove("is-next");
                    next.classList.add("is-active", "is-revealing");
                    isHeroMotionAnimating = false;
                };

                window.setTimeout(completeReveal, duration);
            };

            if (heroMotionCards.length > 1) {
                let introRevealTimer = 0;
                const startNormalHeroReveal = () => {
                    window.setTimeout(() => {
                        revealNextHeroMotionCard(heroRevealDuration);
                        window.setInterval(
                            () => revealNextHeroMotionCard(heroRevealDuration),
                            heroRevealInterval,
                        );
                    }, postIntroRevealDelay);
                };

                if (!reduceMotion) {
                    window.setTimeout(() => {
                        revealNextHeroMotionCard(heroIntroRevealDuration);
                        introRevealTimer = window.setInterval(
                            () =>
                                revealNextHeroMotionCard(
                                    heroIntroRevealDuration,
                                ),
                            heroIntroRevealInterval,
                        );
                    }, 260);
                    window.setTimeout(
                        () => window.clearInterval(introRevealTimer),
                        introEnterDuration + introHoldDuration - 120,
                    );
                }
                window.setTimeout(
                    startNormalHeroReveal,
                    reduceMotion ? 0 : introTotalDuration,
                );
            }

            sections.forEach((section) => revealObserver.observe(section));
            if (reduceMotion) {
                completeIntro();
            } else {
                window.setTimeout(() => {
                    document.body.classList.remove("intro-enter");
                    document.body.classList.add("intro-hold");
                }, introEnterDuration);
                window.setTimeout(() => {
                    document.body.classList.remove("intro-hold");
                    document.body.classList.add("intro-ring-shrink");
                }, introEnterDuration + introHoldDuration);
                window.setTimeout(
                    () => {
                        document.body.classList.remove("intro-ring-shrink");
                        document.body.classList.add("intro-exit");
                    },
                    introEnterDuration +
                        introHoldDuration +
                        introRingShrinkDuration,
                );
                window.setTimeout(() => {
                    completeIntro();
                }, introTotalDuration);
            }
            syncHeroFixed();
            setScrollState();
            window.addEventListener("scroll", setScrollState, {
                passive: true,
            });
            window.addEventListener("resize", () => {
                syncHeroFixed();
                setScrollState();
            });
        </script>
    </body>
</html>

<style lang="scss">
    :root {
        color-scheme: light;
        scroll-behavior: smooth;
        // --accent: #5e0ed7;
        --accent: #f44bca;
        --black: #000;
        --white: #fff;
        --grey: #8d8d8d;
        --dark-grey: #606060;
        --line: rgba(0, 0, 0, 0.2);
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --ease-soft: cubic-bezier(0.29, 0.73, 0.45, 1);
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        min-width: 320px;
        background: var(--white);
        color: var(--black);
        font-family: "Onest", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-weight: 600;
        letter-spacing: 0.16em;
        line-height: 1.1;
        overflow-x: clip;
        overflow-y: visible;
        text-transform: uppercase;
    }

    html.intro-scroll-lock,
    html.intro-scroll-lock body {
        overflow: hidden;
        overscroll-behavior: none;
    }

    html.intro-scroll-lock body {
        touch-action: none;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    button {
        border: 0;
        color: inherit;
        cursor: pointer;
        font: inherit;
    }

    p,
    h1,
    h2 {
        margin: 0;
    }

    svg {
        width: 1em;
        height: 1em;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 2;
    }

    main {
        position: relative;
        z-index: 0;
        isolation: isolate;
        background: var(--white);
    }

    body.intro-enter main,
    body.intro-hold main,
    body.intro-ring-shrink main,
    body.intro-exit main,
    body.intro-complete main {
        z-index: 220;
    }

    .section-observe:not(.hero-shell) {
        position: relative;
        background: var(--white);
    }

    .hero-shell-placeholder {
        display: block;
    }

    .intro-animation {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: grid;
        place-items: center;
        background: var(--white);
        color: var(--black);
        pointer-events: auto;
        transition:
            opacity 0.9s var(--ease) 0.16s,
            filter 0.9s var(--ease) 0.16s,
            visibility 0s linear 1.12s;
    }

    body.intro-complete .intro-animation {
        opacity: 0;
        filter: none;
        visibility: hidden;
        pointer-events: none;
        transition: none;
    }

    .hero-shell {
        --hero-scroll: 0;
        --hero-overlay: calc(var(--hero-scroll) * 1);
        position: relative;
        z-index: 0;
        isolation: isolate;
        height: 200svh;
        background: var(--white);
    }

    body.intro-enter .hero-shell,
    body.intro-hold .hero-shell,
    body.intro-ring-shrink .hero-shell,
    body.intro-exit .hero-shell {
        --hero-reveal-duration: 650ms;
        z-index: 220;
    }

    .hero-shell--fixed {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100svh;
    }

    .hero-shell--fixed + .template-list {
        margin-top: -100svh;
    }

    .hero-shell--fixed .hero-sticky {
        position: relative;
    }

    .hero-sticky {
        position: sticky;
        top: 0;
        display: flex;
        height: 100svh;
        flex-direction: column;
        overflow: hidden;
        background: var(--white);
    }

    .hero-motion-wrap {
        position: absolute;
        top: 82px;
        left: 20px;
        z-index: 0;
        width: min(36vw, 520px);
        min-width: 320px;
        aspect-ratio: 4 / 5;
        transform: translate3d(0, 0, 0) scale(1);
        transition:
            top 1.25s cubic-bezier(0.76, 0, 0.24, 1),
            left 1.25s cubic-bezier(0.76, 0, 0.24, 1),
            width 1.25s cubic-bezier(0.76, 0, 0.24, 1),
            min-width 1.25s cubic-bezier(0.76, 0, 0.24, 1),
            transform 1.25s cubic-bezier(0.76, 0, 0.24, 1);
        will-change: top, left, width, transform;
    }

    body.intro-enter .hero-motion-wrap {
        top: 50%;
        left: 50%;
        z-index: 140;
        width: min(42vw, 540px);
        min-width: 340px;
        transform: translate3d(-50%, -50%, 0) scale(0.96);
    }

    body.intro-hold .hero-motion-wrap {
        top: 50%;
        left: 50%;
        z-index: 140;
        width: min(42vw, 540px);
        min-width: 340px;
        transform: translate3d(-50%, -50%, 0) scale(0.96);
    }

    body.intro-ring-shrink .hero-motion-wrap {
        top: 50%;
        left: 50%;
        z-index: 140;
        width: min(42vw, 540px);
        min-width: 340px;
        transform: translate3d(-50%, -50%, 0) scale(0.96);
    }

    body.intro-exit .hero-motion-wrap {
        z-index: 140;
    }

    body.intro-enter .hero-motion__card img,
    body.intro-hold .hero-motion__card img,
    body.intro-ring-shrink .hero-motion__card img {
        --hero-image-parallax: 0px;

        transform: translate3d(0, 0, 0) scale(1.08);
        transition: transform 1.25s cubic-bezier(0.76, 0, 0.24, 1);
    }

    .hero-motion {
        position: absolute;
        inset: 0;
        overflow: hidden;
        // border-radius: 5px;
        box-shadow: 0 30px 90px rgba(44, 18, 85, 0.16);
    }

    .hero-motion__card {
        position: absolute;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: #f4f1f7;
        clip-path: inset(0 0 100% 0);
        transition: clip-path var(--hero-reveal-duration, 1800ms)
            cubic-bezier(0.76, 0, 0.24, 1);
        will-change: clip-path;
    }

    .hero-motion__card.is-active {
        z-index: 2;
        clip-path: inset(0 0 0 0);
    }

    .hero-motion__card.is-next {
        z-index: 3;
        clip-path: inset(0 0 100% 0);
    }

    .hero-motion__card.is-next.is-revealing {
        clip-path: inset(0 0 0 0);
    }

    .hero-motion__card img {
        --hero-image-parallax: calc(var(--hero-scroll) * -42px);

        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.94) contrast(1.04);
        transform: translate3d(0, var(--hero-image-parallax), 0) scale(1.14);
        transition: transform 0.12s linear;
        will-change: transform;
    }

    .hero-motion-seal {
        --seal-size: 104px;

        position: absolute;
        top: -32px;
        left: -52px;
        z-index: 3;
        display: grid;
        width: var(--seal-size);
        height: var(--seal-size);
        place-items: center;
        border-radius: 999px;
        color: var(--accent);
        pointer-events: none;
        transform: translate3d(0, 0, 0);
        transition:
            top 1.25s cubic-bezier(0.76, 0, 0.24, 1),
            left 1.25s cubic-bezier(0.76, 0, 0.24, 1),
            width 1.5s cubic-bezier(0.76, 0, 0.24, 1),
            height 1.5s cubic-bezier(0.76, 0, 0.24, 1),
            transform 1.25s cubic-bezier(0.76, 0, 0.24, 1);
        will-change: top, left, width, height, transform;
    }

    body.intro-enter .hero-motion-seal,
    body.intro-hold .hero-motion-seal {
        --seal-size: 680px;

        top: 50%;
        left: 50%;
        transform: translate3d(-50%, -50%, 0);
    }

    body.intro-ring-shrink .hero-motion-seal {
        --seal-size: 220px;

        top: 50%;
        left: 50%;
        transform: translate3d(-50%, -50%, 0);
    }

    body.intro-exit .hero-motion-seal {
        z-index: 4;
    }

    .hero-motion-seal svg {
        grid-area: 1 / 1;
        display: block;
        width: 100%;
        height: 100%;
        animation: sealRotate 12s linear infinite;
    }

    .hero-motion-seal text {
        fill: currentColor;
        font-size: 10px;
        letter-spacing: 0.22em;
    }

    // .hero-sticky::after {
    //   position: absolute;
    //   inset: 0;
    //   z-index: 1;
    //   background:
    //     linear-gradient(
    //       90deg,
    //       rgba(255, 255, 255, 0.42),
    //       rgba(255, 255, 255, 0.74) 46%,
    //       rgba(255, 255, 255, 0.92)
    //     ),
    //     rgba(255, 255, 255, 0.18);
    //   content: "";
    //   pointer-events: none;
    // }

    .hero-sticky::before {
        position: absolute;
        inset: 0;
        z-index: 1000;
        // background: rgba(0, 0, 0, var(--hero-overlay));
        content: "";
        pointer-events: none;
    }

    .hero-nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 80;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 20px 12px;
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.72),
            rgba(255, 255, 255, 0)
        );
        backdrop-filter: blur(14px);
        transition:
            opacity 0.28s ease,
            transform 0.28s ease,
            background 0.28s ease;
        will-change: transform, opacity;
    }

    .nav-hidden .hero-nav {
        opacity: 0;
        pointer-events: none;
        transform: translateY(-100%);
    }

    .brand-mark {
        display: grid;
        width: 32px;
        height: 32px;
        flex: 0 0 auto;
        place-items: center;
        border: 2px solid var(--accent);
        border-radius: 999px;
        color: var(--accent);
        overflow: hidden;
        transition:
            width 0.28s ease,
            background 0.28s ease,
            color 0.28s ease,
            border-color 0.28s ease;
    }

    .brand-mark__dot {
        grid-area: 1 / 1;
        width: 10px;
        height: 10px;
        border-radius: inherit;
        background: currentColor;
        opacity: 1;
        transform: scale(1);
        transition:
            opacity 0.22s ease,
            transform 0.22s ease;
    }

    .brand-mark__top {
        grid-area: 1 / 1;
        opacity: 0;
        color: currentColor;
        font-size: 10px;
        letter-spacing: 0.16em;
        line-height: 1;
        transform: translateY(8px);
        transition:
            opacity 0.22s ease,
            transform 0.22s ease;
    }

    .has-scrolled .brand-mark {
        width: 54px;
        background: var(--accent);
        color: var(--white);
        border-color: var(--accent);
    }

    .has-scrolled .brand-mark__dot {
        opacity: 0;
        transform: scale(0.4);
    }

    .has-scrolled .brand-mark__top {
        opacity: 1;
        transform: translateY(0);
    }

    .nav-links {
        display: none;
        align-items: center;
        gap: 36px;
        font-size: 14px;
        letter-spacing: 0.18em;
    }

    .nav-links a,
    .hero-cta,
    .nav-action {
        transition:
            opacity 0.22s ease,
            color 0.22s ease;
    }

    .nav-links a:hover,
    .nav-action:hover {
        opacity: 0.62;
    }

    .nav-action {
        display: inline-flex;
        min-height: 36px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        border-radius: 999px;
        background: var(--black);
        color: var(--white);
        font-size: 11px;
        letter-spacing: 0.14em;
        white-space: nowrap;
    }

    .nav-action svg {
        width: 14px;
        height: 14px;
    }

    .stats-row {
        position: relative;
        z-index: 2;
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: flex-end;
        padding: 32px 20px;
    }

    .stats-row__inner {
        display: flex;
        justify-content: flex-end;
        gap: 20px;
        text-align: right;
    }

    .stat-item {
        display: grid;
        gap: 8px;
        justify-items: end;
    }

    .stat-item strong {
        display: flex;
        align-items: flex-start;
        gap: 1px;
        font-size: clamp(1.5rem, 5vw, 3.5rem);
        letter-spacing: 0;
    }

    .stat-item strong span {
        color: var(--accent);
        font-size: 0.5em;
        line-height: 1.15;
    }

    .stat-item p {
        font-size: 10px;
        line-height: 1.15;
        white-space: pre-line;
    }

    .bottom-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding: 0 20px 32px;
    }

    .bottom-content__top,
    .bottom-content__main {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .bottom-content__main {
        align-items: flex-end;
        gap: 12px;
    }

    .tagline {
        max-width: 130px;
        font-size: 10px;
        line-height: 1.35;
        opacity: 0 !important;
    }

    .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--accent);
        font-size: 16px;
        white-space: nowrap;
        margin-left: auto;
    }

    .hero-cta svg {
        width: 18px;
        height: 18px;
    }

    .description {
        width: 120px;
        flex: 0 0 auto;
        font-size: 9px;
        line-height: 1.3;
        text-align: left;
    }

    h1 {
        display: grid;
        justify-items: end;
        font-size: clamp(2rem, 9vw, 9rem);
        letter-spacing: 0;
        line-height: 0.88;
        text-align: right;
    }

    .heading-mask {
        display: block;
        overflow: hidden;
    }

    .heading-word {
        display: block;
        transform: translateY(110%);
    }

    .motion-down {
        opacity: 0;
        transform: translateY(-20px);
    }

    .motion-up {
        opacity: 0;
        transform: translateY(32px);
    }

    .intro-complete .heading-word {
        animation: headingIn 0.7s var(--ease) forwards;
        animation-delay: calc(0.28s + (var(--word-i) * 0.1s));
    }

    .intro-complete .motion-down {
        animation: fadeDown 0.5s var(--ease) forwards;
        animation-delay: calc(0.22s + (var(--i) * 0.07s));
    }

    .intro-complete .motion-up {
        animation: fadeUp 0.6s var(--ease) forwards;
        animation-delay: calc(0.3s + (var(--i) * 0.08s));
    }

    .template-list {
        position: relative;
        z-index: 2;
        display: grid;
        margin-top: -100svh;
        gap: 42px;
        padding: 110px 20px 90px;
        background: var(--white);
        scroll-margin-top: 84px;
    }

    .section-heading {
        display: grid;
        gap: 10px;
        max-width: 1120px;
        opacity: 1;
        transform: none;
    }

    .section-heading p,
    .booking-cta__inner p {
        color: var(--accent);
        font-size: 11px;
        line-height: 1.3;
    }

    .section-heading h2,
    .booking-cta__inner h2 {
        max-width: 980px;
        font-size: clamp(42px, 6vw, 104px);
        line-height: 0.9;
        letter-spacing: 0;
    }

    .section-heading span,
    .booking-cta__actions span {
        max-width: 520px;
        color: var(--dark-grey);
        font-size: 12px;
        line-height: 1.45;
    }

    .template-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 34px 22px;
    }

    .template-card {
        --template-enter-y: 34px;
        --template-reveal-y: var(--template-enter-y);
        --template-offset-y: 0px;
        --template-hover-y: 0px;

        display: grid;
        grid-template-rows: auto 1fr;
        min-height: 0;
        overflow: visible;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--black);
        opacity: 1;
        filter: none;
        transform: translate3d(
            0,
            calc(var(--template-offset-y) + var(--template-hover-y)),
            0
        );
        transition:
            opacity 0.3s ease,
            filter 0.3s ease,
            transform 0.35s ease;
        will-change: transform;
    }

    .template-card:hover {
        --template-hover-y: -3px;
    }

    .template-card__media {
        aspect-ratio: 4 / 5;
        min-height: 0;
        overflow: hidden;
        border-radius: 5px;
        background: #ece8ef;
        box-shadow: 0 26px 70px rgba(33, 21, 48, 0.12);
        transition:
            box-shadow 0.35s ease,
            transform 0.35s ease;
        will-change: transform;
    }

    .template-card__media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: translate3d(0, 0, 0) scale(1);
        transition: transform 0.6s var(--ease);
        will-change: transform;
    }

    .template-card:hover .template-card__media img {
        transform: translate3d(0, 0, 0) scale(1.05);
    }

    .template-card:hover .template-card__media {
        box-shadow: 0 30px 84px rgba(44, 18, 85, 0.18);
        transform: translateY(-2px);
    }

    .template-card__body {
        display: grid;
        align-content: start;
        gap: 8px;
        padding: 14px 2px 0;
    }

    .template-card__body strong {
        max-width: 92%;
        font-size: clamp(30px, 3.7vw, 58px);
        line-height: 0.88;
        letter-spacing: 0;
    }

    .template-card__price {
        color: rgba(0, 0, 0, 0.54);
        font-size: 10px;
        line-height: 1.2;
        letter-spacing: 0.12em;
    }

    .template-card__body p {
        color: var(--dark-grey);
        font-size: 11px;
        line-height: 1.45;
    }

    .template-card__actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        align-self: end;
        padding-top: 6px;
    }

    .template-card__actions a {
        display: inline-flex;
        min-height: 36px;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0, 0, 0, 0.16);
        border-radius: 999px;
        color: var(--black);
        font-size: 10px;
        line-height: 1;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        backdrop-filter: blur(10px);
        transition:
            background 0.22s ease,
            border-color 0.22s ease,
            transform 0.22s ease,
            color 0.22s ease;
    }

    .template-card__actions a:first-child {
        background: var(--black);
        color: var(--white);
        border-color: var(--black);
    }

    .template-card__actions a:hover {
        border-color: var(--accent);
        background: var(--accent);
        color: var(--white);
        transform: translateY(-1px);
    }

    .booking-cta {
        display: grid;
        min-height: 86svh;
        align-items: end;
        padding: 90px 20px 42px;
        background: var(--black);
        color: var(--white);
    }

    .booking-cta__inner {
        display: grid;
        gap: 22px;
    }

    .booking-cta__inner h2 {
        max-width: 1180px;
    }

    .booking-cta__actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-top: 24px;
    }

    .booking-button {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 20px;
        border-radius: 999px;
        background: var(--accent);
        color: var(--white);
        font-size: 13px;
        white-space: nowrap;
        transition:
            background 0.24s ease,
            transform 0.24s ease;
    }

    .booking-button:hover {
        background: #4709ac;
        transform: translateY(-2px);
    }

    .booking-button svg {
        width: 18px;
        height: 18px;
    }

    .details {
        display: grid;
        grid-template-columns: 1fr 1.04fr;
        gap: 68px;
        min-height: 100svh;
        align-items: center;
        padding: 120px 20px 80px;
        background: var(--white);
    }

    .details,
    .experience,
    .feature-strip {
        display: none;
    }

    .details__copy {
        align-self: stretch;
        display: grid;
        align-content: space-between;
        gap: 70px;
        padding: 88px 0 84px;
    }

    .details__copy p {
        max-width: 880px;
        font-size: clamp(32px, 3.05vw, 58px);
        line-height: 1.04;
        letter-spacing: 0;
    }

    .details__copy small {
        max-width: 380px;
        color: var(--grey);
        font-size: 14px;
        line-height: 1.35;
    }

    .details__media,
    .experience__image {
        position: relative;
        overflow: hidden;
        background-image: var(--image);
        background-position: center calc(50% + var(--shift, 0px));
        background-size: cover;
        will-change: background-position, filter, transform;
    }

    .details__media {
        height: 78svh;
        min-height: 560px;
        border-radius: 5px;
    }

    .image-reveal {
        opacity: 0;
        filter: blur(28px);
        transform: scale(1.035);
        clip-path: inset(10% 0 10% 0 round 5px);
        transition:
            opacity 1.2s var(--ease),
            filter 1.35s var(--ease),
            transform 1.35s var(--ease),
            clip-path 1.35s var(--ease);
    }

    .is-visible .image-reveal {
        opacity: 1;
        filter: blur(0);
        transform: scale(1);
        clip-path: inset(0 round 5px);
    }

    .panel-button,
    .start__button {
        border-radius: 5px;
        transition:
            background 0.3s ease,
            color 0.3s ease;
    }

    .panel-button {
        position: absolute;
        left: 0;
        bottom: 0;
        display: inline-flex;
        min-width: 210px;
        min-height: 60px;
        align-items: center;
        padding: 0 12px;
        background: rgba(242, 242, 242, 0.82);
        color: var(--black);
        font-size: 11px;
        backdrop-filter: blur(20px);
    }

    .experience {
        position: relative;
        min-height: 112svh;
        overflow: hidden;
        padding: 0 20px 90px;
        background: var(--black);
        color: var(--white);
    }

    .experience__mast {
        position: absolute;
        inset: 0 20px auto;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
        font-size: clamp(62px, 10vw, 176px);
        line-height: 0.76;
        letter-spacing: 0;
        white-space: nowrap;
    }

    .experience__grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1.04fr 0.96fr;
        gap: 56px;
        min-height: 100svh;
        align-items: end;
        padding-top: 42svh;
    }

    .experience__image {
        height: 52svh;
        min-height: 420px;
        border-radius: 5px;
    }

    .experience__text {
        align-self: start;
        padding-top: 8px;
    }

    .experience__text p {
        max-width: 900px;
        font-size: clamp(28px, 3.15vw, 62px);
        line-height: 1.08;
        letter-spacing: 0;
    }

    .feature-strip {
        overflow: hidden;
        border-block: 1px solid var(--line);
        background: var(--white);
    }

    .feature-strip div {
        display: flex;
        width: max-content;
        animation: marqueeMove 28s linear infinite;
    }

    .feature-strip span {
        padding: 24px 36px;
        color: var(--black);
        font-size: 12px;
        white-space: nowrap;
    }

    .start {
        position: relative;
        z-index: 2;
        display: grid;
        min-height: 74svh;
        place-items: center;
        gap: 18px;
        padding: 80px 20px;
        background: var(--white);
        scroll-margin-top: 84px;
        text-align: center;
    }

    .start p {
        color: var(--grey);
        font-size: 11px;
    }

    .start h2 {
        max-width: 1120px;
        font-size: clamp(52px, 8vw, 148px);
        line-height: 0.86;
        letter-spacing: 0;
    }

    .start__button {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        padding: 0 18px;
        background: var(--black);
        color: var(--white);
        font-size: 11px;
    }

    .start__button:hover {
        background: #333;
    }

    .reveal-blur {
        opacity: 0;
        filter: blur(22px);
        transform: translateY(34px);
        transition:
            opacity 1s var(--ease),
            filter 1.1s var(--ease),
            transform 1.1s var(--ease);
        transition-delay: var(--delay, 0ms);
    }

    .is-visible .reveal-blur {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
    }

    @keyframes fadeDown {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes headingIn {
        to {
            transform: translateY(0);
        }
    }

    @keyframes sealRotate {
        to {
            transform: rotate(1turn);
        }
    }

    @keyframes marqueeMove {
        to {
            transform: translateX(-50%);
        }
    }

    @media (min-width: 640px) {
        .hero-nav {
            padding: 20px 32px 12px;
        }
        .hero-motion-wrap {
            left: 32px;
            min-width: 360px;
        }
        .hero-motion-seal {
            left: -52px;
        }
        .stats-row {
            padding-inline: 32px;
        }
        .stats-row__inner {
            gap: 32px;
        }
        .stat-item p,
        .tagline,
        .description {
            font-size: 12px;
        }
        .bottom-content {
            padding-inline: 32px;
        }
        .tagline {
            max-width: 160px;
        }
        .hero-cta {
            font-size: 20px;
        }
        .hero-cta svg {
            width: 22px;
            height: 22px;
        }
        .description {
            width: 180px;
        }
        .template-list {
            padding-inline: 32px;
        }
        .booking-cta {
            padding-inline: 32px;
        }
    }

    @media (min-width: 768px) {
        .hero-nav {
            padding: 24px 48px 14px;
        }
        .hero-motion-wrap {
            top: 102px;
            left: 48px;
            width: min(40vw, 560px);
        }
        .hero-motion-seal {
            --seal-size: 112px;

            top: -32px;
            left: -56px;
        }
        .nav-links {
            display: flex;
        }
        .stats-row {
            padding-block: 0;
            padding-inline: 48px;
        }
        .stats-row__inner {
            gap: 40px;
        }
        .stat-item p,
        .tagline,
        .description {
            font-size: 14px;
        }
        .bottom-content {
            gap: 48px;
            padding: 0 48px 48px;
        }
        .tagline {
            max-width: 320px;
        }
        .hero-cta {
            font-size: 24px;
        }
        .bottom-content__main {
            gap: 16px;
        }
        .description {
            width: 300px;
            text-align: right;
        }
        .template-list {
            padding: 120px 48px 100px;
        }
        .booking-cta {
            padding: 100px 48px 48px;
        }
    }

    @media (max-width: 960px) {
        .template-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .details,
        .experience__grid {
            grid-template-columns: 1fr;
        }

        .details {
            gap: 30px;
            padding-top: 72px;
        }

        .details__copy {
            gap: 42px;
            padding: 0;
        }

        .details__media {
            height: 62svh;
            min-height: 430px;
        }

        .experience__mast {
            display: grid;
            gap: 8px;
            font-size: clamp(58px, 16vw, 150px);
        }

        .experience__grid {
            padding-top: 38svh;
        }
    }

    @media (max-width: 640px) {
        .hero-nav {
            padding: 14px 12px 10px;
        }

        .hero-motion-wrap {
            top: 135px;
            left: 12px;
            width: min(75vw, 260px);
            min-width: 172px;
        }

        body.intro-enter .hero-motion-wrap {
            top: 50%;
            left: 50%;
            width: min(76vw, 290px);
            min-width: 0;
            transform: translate3d(-50%, -50%, 0) scale(1);
        }

        body.intro-hold .hero-motion-wrap {
            top: 50%;
            left: 50%;
            width: min(76vw, 290px);
            min-width: 0;
            transform: translate3d(-50%, -50%, 0) scale(1);
        }

        body.intro-ring-shrink .hero-motion-wrap {
            top: 50%;
            left: 50%;
            width: min(76vw, 290px);
            min-width: 0;
            transform: translate3d(-50%, -50%, 0) scale(1);
        }

        .hero-motion__card img {
            --hero-image-parallax: calc(var(--hero-scroll) * -28px);
        }
        .hero-motion-seal {
            --seal-size: 82px;

            top: -24px;
            left: -18px;
        }

        body.intro-enter .hero-motion-seal,
        body.intro-hold .hero-motion-seal {
            --seal-size: min(140vw, 560px);
        }

        body.intro-ring-shrink .hero-motion-seal {
            --seal-size: 150px;
