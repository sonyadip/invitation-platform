    align-items: center;
    padding: 0 14px;
    border-radius: 6px;
    background: #111827;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
  }

  .row-actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 8px;
  }

  .row-actions form {
    margin: 0;
  }

  .row-actions a,
  .row-actions button {
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    border: 1px solid #d9dde5;
    border-radius: 6px;
    color: #394150;
