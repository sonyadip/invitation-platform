    height: 44px;
    margin-top: 16px;
    border: 0;
    border-radius: 6px;
    background: #111827;
    color: #ffffff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .form-error {
    margin: 12px 0 0;
    color: #b91c1c;
    font-size: 13px;
  }

  @media (max-width: 1100px) {
    .metric-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .row-actions {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 720px) {
    .dashboard-shell {
      padding: 18px;
    }

    .dashboard-header,
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .generated-at {
      width: 100%;
      text-align: left;
    }

    .metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .table-wrap {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
    }

    table,
    thead,
    tbody,
    tr,
    th,
    td {
      display: block;
      width: 100%;
    }

    thead {
      display: none;
    }

    tr {
      padding: 12px;
      border-bottom: 1px solid #eef0f4;
    }

    td {
      display: grid;
      grid-template-columns: 94px minmax(0, 1fr);
      gap: 12px;
      padding: 8px 0;
      border-bottom: 0;
    }

    td::before {
      color: #687080;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    td:nth-child(1)::before {
      content: "Slug";
    }

    td:nth-child(2)::before {
      content: "Couple";
    }

    td:nth-child(3)::before {
      content: "Status";
    }

    td:nth-child(4)::before {
      content: "Date";
    }

    td:nth-child(5)::before {
      content: "Actions";
    }

    .deleted-section td:nth-child(5)::before {
      content: "Deleted At";
    }

    .deleted-section td:nth-child(6)::before {
      content: "Deleted By";
    }

    .deleted-section td:nth-child(7)::before {
      content: "Actions";
    }

    .row-actions {
      gap: 6px;
    }

    .table-wrap table {
      display: table;
      min-width: 760px;
      table-layout: fixed;
    }

    .table-wrap .report-table--deleted {
      min-width: 980px;
    }

    .table-wrap thead {
      display: table-header-group;
    }

    .table-wrap tbody {
      display: table-row-group;
