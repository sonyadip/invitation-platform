---
import {
  duplicateInvitation,
  permanentlyDeleteInvitation,
  restoreInvitation,
  softDeleteInvitation
} from '../services/dashboard-crud';
import { getDashboardReport } from '../services/dashboard-report';
import { hashPasswordSHA256 } from '../utils/security';

export const prerender = false;

const dashboardPassword =
  import.meta.env.DASHBOARD_PASSWORD ||
  (typeof process !== 'undefined' ? process.env.DASHBOARD_PASSWORD : '') ||
  '';

const cookieName = 'dashboard_unlocked';
let errorMessage = '';
let duplicateError = '';
let successMessage = '';
const postFormData = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
const postAction = String(postFormData?.get('action') || '');
const formatUnknownError = (error: unknown, fallback: string) => {
  if (error instanceof Error) return error.message;
  if (error && typeof error === 'object') return JSON.stringify(error);
  return fallback;
};

const authRole = Astro.cookies.get('auth_role')?.value;
const isUnlocked = authRole === 'admin';

if (!isUnlocked) {
  return Astro.redirect('/?login=admin');
}

if (isUnlocked && postAction === 'duplicate') {
  try {
    const weddingId = String(postFormData?.get('weddingId') || '');
    if (!weddingId) throw new Error('Wedding ID is required.');
    const duplicatedSlug = await duplicateInvitation(weddingId);
    return Astro.redirect(`/dashboard/${duplicatedSlug}/edit?duplicated=1`);
  } catch (error) {
    console.error('Duplicate invitation error:', error);
    duplicateError = formatUnknownError(error, 'Failed to duplicate invitation.');
  }
}

if (isUnlocked && postAction === 'soft-delete') {
  try {
    const weddingId = String(postFormData?.get('weddingId') || '');
    if (!weddingId) throw new Error('Wedding ID is required.');
    await softDeleteInvitation(weddingId);
    return Astro.redirect('/dashboard?deleted=1');
  } catch (error) {
    console.error('Soft delete invitation error:', error);
    duplicateError = formatUnknownError(error, 'Failed to soft delete invitation.');
  }
}

if (isUnlocked && postAction === 'restore') {
  try {
    const weddingId = String(postFormData?.get('weddingId') || '');
    if (!weddingId) throw new Error('Wedding ID is required.');
    await restoreInvitation(weddingId);
    return Astro.redirect('/dashboard?restored=1');
  } catch (error) {
    console.error('Restore invitation error:', error);
    duplicateError = formatUnknownError(error, 'Failed to restore invitation.');
  }
}

if (isUnlocked && postAction === 'permanent-delete') {
  try {
    const weddingId = String(postFormData?.get('weddingId') || '');
    if (!weddingId) throw new Error('Wedding ID is required.');
    await permanentlyDeleteInvitation(weddingId);
    return Astro.redirect('/dashboard?permanentlyDeleted=1');
  } catch (error) {
    console.error('Permanent delete invitation error:', error);
    duplicateError = formatUnknownError(error, 'Failed to permanently delete invitation.');
  }
}

if (isUnlocked && Astro.url.searchParams.get('deleted')) {
  successMessage = 'Invitation soft deleted.';
}

if (isUnlocked && Astro.url.searchParams.get('permanentlyDeleted')) {
  successMessage = 'Invitation permanently deleted and unshared Supabase images were removed.';
}

if (isUnlocked && Astro.url.searchParams.get('restored')) {
  successMessage = 'Invitation restored to active dashboard.';
}

const formatNumber = (value: number) => new Intl.NumberFormat('en-US').format(value);
const formatDate = (value: string | null) => value
  ? new Date(value).toLocaleDateString('en-US', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    })
  : '-';
const formatDateTime = (value: string | null) => value
  ? new Date(value).toLocaleString('en-US', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })
  : '-';

let report = null;
let loadError = '';

if (isUnlocked) {
  try {
    report = await getDashboardReport();
  } catch (error) {
    console.error('Dashboard report load error:', error);
    loadError = formatUnknownError(error, 'Failed to load dashboard report.');
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Report - Invitation Platform</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    {isUnlocked ? (
      <main class="dashboard-shell">
        <header class="dashboard-header">
          <div>
            <p class="eyebrow">Admin Console</p>
            <h1>Dashboard Overview</h1>
            <p class="subtitle">Performance metrics, invitation records, and RSVP analytics across all slugs.</p>
          </div>
          <div class="header-actions">
            <a class="settings-action" href="/dashboard/activity">📋 Activity Log</a>
            <a class="settings-action" href="/dashboard/settings">⚙ Platform Settings</a>
            {report && (
              <div class="generated-at">
                <span>Last Updated</span>
                <strong>{formatDateTime(report.generatedAt)}</strong>
              </div>
            )}
          </div>
        </header>

        {loadError ? (
          <section class="error-panel">
            <strong>Failed to load report</strong>
            <p>{loadError}</p>
          </section>
        ) : report && (
          <>
            {successMessage && (
              <section class="success-panel">
                <strong>Dashboard Updated</strong>
                <p>{successMessage}</p>
              </section>
            )}
            {duplicateError && (
              <section class="error-panel">
                <strong>Duplicate Operation Failed</strong>
                <p>{duplicateError}</p>
              </section>
            )}
            <section class="metric-grid" aria-label="Dashboard summary">
              <div class="metric">
                <span>Total Slugs</span>
                <strong>{formatNumber(report.totals.invitations)}</strong>
              </div>
              <div class="metric">
                <span>Published</span>
                <strong>{formatNumber(report.totals.published)}</strong>
              </div>
              <div class="metric">
                <span>Total Views</span>
                <strong>{formatNumber(report.totals.views)}</strong>
              </div>
              <div class="metric">
                <span>Total RSVPs</span>
                <strong>{formatNumber(report.totals.rsvps)}</strong>
              </div>
              <div class="metric">
                <span>Total Guests (Pax)</span>
                <strong>{formatNumber(report.totals.guests)}</strong>
              </div>
              <div class="metric">
                <span>Wishes</span>
                <strong>{formatNumber(report.totals.wishes)}</strong>
              </div>
              <div class="metric">
                <span>Soft Deleted</span>
                <strong>{formatNumber(report.totals.deleted)}</strong>
              </div>
            </section>

            <section class="report-section">
              <div class="section-heading">
                <div>
                  <h2>Invitations</h2>
                  <p>{formatNumber(report.reports.length)} active invitation records</p>
                </div>
                <a class="primary-action" href="/dashboard/new">+ Create Invitation</a>
              </div>

              <div class="table-wrap">
                <table class="report-table report-table--active">
                  <thead>
                    <tr>
                      <th>Slug</th>
                      <th>Couple</th>
                      <th>Status</th>
                      <th>Wedding Date</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {report.reports.map((item) => (
                      <tr>
                        <td>
                          <span class="slug-text">{item.slug}</span>
                          {item.customDomain && <span class="domain">{item.customDomain}</span>}
                        </td>
                        <td>{item.coupleName}</td>
                        <td>
                          <span class={`status status--${item.status}`}>{item.status}</span>
                        </td>
                        <td>{formatDate(item.weddingDate)}</td>
                        <td>
                          <div class="row-actions">
                            <a href={`/dashboard/${item.slug}`}>Analytics</a>
                            <a href={`/dashboard/${item.slug}/edit`}>Edit</a>
                            <form method="POST">
                              <input type="hidden" name="action" value="duplicate" />
                              <input type="hidden" name="weddingId" value={item.weddingId} />
                              <button type="submit">Duplicate</button>
                            </form>
                            <form method="POST">
                              <input type="hidden" name="action" value="soft-delete" />
                              <input type="hidden" name="weddingId" value={item.weddingId} />
                              <button
                                class="warning-action"
                                type="submit"
                                onclick="return confirm('Soft delete this invitation? It will move to Deleted Invitations.')"
                              >
                                Soft Delete
                              </button>
                            </form>
                            <a href={`/${item.slug}`} target="_blank" rel="noopener noreferrer">Preview</a>
                          </div>
                        </td>
                      </tr>
                    ))}

                  </tbody>
                </table>
              </div>
            </section>

            <section class="report-section deleted-section">
              <div class="section-heading">
                <div>
                  <h2>Deleted Invitations</h2>
                  <p>{formatNumber(report.deletedReports.length)} soft-deleted invitation records</p>
                </div>
              </div>

              <div class="table-wrap">
                <table class="report-table report-table--deleted">
                  <thead>
                    <tr>
                      <th>Slug</th>
                      <th>Couple</th>
                      <th>Status</th>
                      <th>Wedding Date</th>
                      <th>Deleted At</th>
                      <th>Deleted By</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {report.deletedReports.map((item) => (
                      <tr>
                        <td><span class="slug-text">{item.slug}</span></td>
                        <td>{item.coupleName}</td>
                        <td><span class={`status status--${item.status}`}>{item.status}</span></td>
                        <td>{formatDate(item.weddingDate)}</td>
                        <td>{formatDateTime(item.deletedAt)}</td>
                        <td>{item.deletedBy || '-'}</td>
                        <td>
                          <div class="row-actions">
                            <form method="POST">
                              <input type="hidden" name="action" value="restore" />
                              <input type="hidden" name="weddingId" value={item.weddingId} />
                              <button type="submit">Restore</button>
                            </form>
                            <form method="POST">
                              <input type="hidden" name="action" value="permanent-delete" />
                              <input type="hidden" name="weddingId" value={item.weddingId} />
                              <button
                                class="danger-action"
                                type="submit"
                                onclick="return confirm('Permanently delete this soft-deleted invitation and unshared images? This action cannot be undone.')"
                              >
                                Delete Permanently
                              </button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    ))}
                    {!report.deletedReports.length && (
                      <tr>
                        <td colspan="7" class="empty-row">No soft-deleted invitations.</td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          </>
        )}
      </main>
    ) : (
      <main class="login-shell">
        <form class="login-card" method="POST">
          <input type="hidden" name="action" value="login" />
          <p class="eyebrow">Admin Console</p>
          <h1>Dashboard Login</h1>
          <p class="subtitle">Enter dashboard password to manage invitations and access reports.</p>
          <label for="password">Password</label>
          <input id="password" type="password" name="password" required autofocus />
          {errorMessage && <p class="form-error">{errorMessage}</p>}
          <button type="submit">Log In</button>
        </form>
      </main>
    )}
  </body>
</html>

<style lang="scss">
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f4f5f7;
    color: #20242c;
    font-family: Montserrat, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .dashboard-shell {
    width: min(1440px, 100%);
