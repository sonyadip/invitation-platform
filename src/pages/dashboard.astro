    background: #fff1f2;
  }

  .row-actions .warning-action {
    border-color: #fed7aa;
    color: #c2410c;
    background: #fff7ed;
  }

  .empty-row {
    color: #687080;
  }

  .domain {
    display: block;
    margin-top: 4px;
    color: #687080;
    font-size: 12px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    background: #eef2ff;
    color: #3730a3;
    font-size: 11px;
    font-weight: 700;
    text-transform: capitalize;
  }

  .status--published {
    background: #ecfdf5;
    color: #047857;
  }

  .status--draft {
    background: #fff7ed;
    color: #c2410c;
  }

  .status--archived {
    background: #f3f4f6;
    color: #4b5563;
  }

  .error-panel {
    padding: 18px;
    color: #991b1b;
    background: #fff5f5;
  }

  .success-panel {
    margin-bottom: 18px;
