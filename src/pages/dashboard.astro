  }

  .report-table--deleted th:nth-child(3),
  .report-table--deleted td:nth-child(3) {
    width: 11%;
  }

  .report-table--deleted th:nth-child(4),
  .report-table--deleted td:nth-child(4) {
    width: 13%;
  }

  .report-table--deleted th:nth-child(5),
  .report-table--deleted td:nth-child(5) {
    width: 16%;
  }

  .report-table--deleted th:nth-child(6),
  .report-table--deleted td:nth-child(6) {
