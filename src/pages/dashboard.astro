    padding: 28px;
    font-family: 'Montserrat', sans-serif;
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 22px;
  }

  .header-actions {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    flex-shrink: 0;
  }

  .settings-action {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border: 1px solid #d9dde5;
    border-radius: 6px;
    background: #ffffff;
    color: #394150;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    font-family: 'Montserrat', sans-serif;
  }


  .eyebrow {
    margin: 0 0 8px;
    color: #687080;
