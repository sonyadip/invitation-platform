---
import {
  duplicateInvitation,
  permanentlyDeleteInvitation,
  restoreInvitation,
  softDeleteInvitation
} from '../services/dashboard-crud';
import { getDashboardReport } from '../services/dashboard-report';
import { hashPasswordSHA256 } from '../utils/security';
import AdminLayout from '../layouts/AdminLayout.astro';

export const prerender = false;

const session = Astro.locals.session;
const isUnlocked = session?.role === 'admin';

if (!isUnlocked) {
  return Astro.redirect('/?login=admin');
}

let duplicateError = '';
let successMessage = '';
const postFormData = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
const postAction = String(postFormData?.get('action') || '');

const formatUnknownError = (error: unknown, fallback: string) => {
  if (error instanceof Error) return error.message;
  if (error && typeof error === 'object') return JSON.stringify(error);
  return fallback;
};

if (isUnlocked && postAction === 'duplicate') {
  try {
    const weddingId = String(postFormData?.get('weddingId') || '');
    if (!weddingId) throw new Error('Wedding ID is required.');
    const duplicatedSlug = await duplicateInvitation(weddingId);
    return Astro.redirect(`/dashboard/${duplicatedSlug}/edit?duplicated=1`);
  } catch (error) {
    console.error('Duplicate invitation error:', error);
    duplicateError = formatUnknownError(error, 'Failed to duplicate invitation.');
  }
}

if (isUnlocked && postAction === 'soft-delete') {
  try {
    const weddingId = String(postFormData?.get('weddingId') || '');
    if (!weddingId) throw new Error('Wedding ID is required.');
    await softDeleteInvitation(weddingId);
    return Astro.redirect('/dashboard?deleted=1');
  } catch (error) {
    console.error('Soft delete invitation error:', error);
    duplicateError = formatUnknownError(error, 'Failed to soft delete invitation.');
  }
}

if (isUnlocked && postAction === 'restore') {
  try {
    const weddingId = String(postFormData?.get('weddingId') || '');
    if (!weddingId) throw new Error('Wedding ID is required.');
    await restoreInvitation(weddingId);
    return Astro.redirect('/dashboard?restored=1');
  } catch (error) {
    console.error('Restore invitation error:', error);
    duplicateError = formatUnknownError(error, 'Failed to restore invitation.');
  }
}

if (isUnlocked && postAction === 'permanent-delete') {
  try {
    const weddingId = String(postFormData?.get('weddingId') || '');
    if (!weddingId) throw new Error('Wedding ID is required.');
    await permanentlyDeleteInvitation(weddingId);
    return Astro.redirect('/dashboard?permanentlyDeleted=1');
  } catch (error) {
    console.error('Permanent delete invitation error:', error);
    duplicateError = formatUnknownError(error, 'Failed to permanently delete invitation.');
  }
}

if (isUnlocked && Astro.url.searchParams.get('deleted')) {
  successMessage = 'Invitation successfully moved to trash.';
}

if (isUnlocked && Astro.url.searchParams.get('permanentlyDeleted')) {
  successMessage = 'Invitation permanently deleted and unshared assets were removed.';
}

if (isUnlocked && Astro.url.searchParams.get('restored')) {
  successMessage = 'Invitation restored to active dashboard.';
}

const formatNumber = (value: number) => new Intl.NumberFormat('en-US').format(value);
const formatDate = (value: string | null) => value
  ? new Date(value).toLocaleDateString('en-US', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    })
  : '-';
const formatDateTime = (value: string | null) => value
  ? new Date(value).toLocaleString('en-US', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })
  : '-';

let report: any = null;
let loadError = '';

if (isUnlocked) {
  try {
    report = await getDashboardReport();
  } catch (error) {
    console.error('Dashboard report load error:', error);
    loadError = formatUnknownError(error, 'Failed to load dashboard report.');
  }
}
---

<AdminLayout
  title="Dashboard Overview"
  activeNav="overview"
>
  <header class="admin-page-header">
    <div class="admin-page-header__left">
      <h1 class="admin-page-header__title">Dashboard Overview</h1>
      <p class="admin-page-header__description">
        Performance metrics, invitation records, and RSVP analytics across all slugs.
      </p>
    </div>

    {report && (
      <div class="admin-page-header__updated">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Updated {formatDateTime(report.generatedAt)}</span>
      </div>
    )}
  </header>

  {successMessage && (
    <div class="shadcn-alert shadcn-alert--success" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <div>
        <strong>Success</strong>
        <p>{successMessage}</p>
      </div>
    </div>
  )}

  {duplicateError && (
    <div class="shadcn-alert shadcn-alert--error" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <div>
        <strong>Operation Failed</strong>
        <p>{duplicateError}</p>
      </div>
    </div>
  )}

  {loadError && (
    <div class="shadcn-alert shadcn-alert--error" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <div>
        <strong>Failed to load report</strong>
        <p>{loadError}</p>
      </div>
    </div>
  )}

  {report && (
    <>
      <section class="metric-grid" aria-label="Key platform metrics">
        <div class="metric-card">
          <div class="metric-card__top">
            <span class="metric-card__label">Total Slugs</span>
            <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
            </svg>
          </div>
          <div class="metric-card__value">{formatNumber(report.totals.invitations)}</div>
        </div>

        <div class="metric-card">
          <div class="metric-card__top">
            <span class="metric-card__label">Published</span>
            <svg class="metric-card__icon" style="color: #10b981;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div class="metric-card__value">{formatNumber(report.totals.published)}</div>
        </div>

        <div class="metric-card">
          <div class="metric-card__top">
            <span class="metric-card__label">Total Views</span>
            <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <div class="metric-card__value">{formatNumber(report.totals.views)}</div>
        </div>

        <div class="metric-card">
          <div class="metric-card__top">
            <span class="metric-card__label">Total RSVPs</span>
            <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div class="metric-card__value">{formatNumber(report.totals.rsvps)}</div>
        </div>
      </section>

      <section class="metric-grid metric-grid--secondary" aria-label="Detailed statistics">
        <div class="metric-card">
          <div class="metric-card__top">
            <span class="metric-card__label">Total Guests (Pax)</span>
            <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="metric-card__value">{formatNumber(report.totals.guests)}</div>
        </div>

        <div class="metric-card">
          <div class="metric-card__top">
            <span class="metric-card__label">Wishes & Prayers</span>
            <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
            </svg>
          </div>
          <div class="metric-card__value">{formatNumber(report.totals.wishes)}</div>
        </div>

        <div class="metric-card">
          <div class="metric-card__top">
            <span class="metric-card__label">Archived in Trash</span>
            <svg class="metric-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"></path>
              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
            </svg>
          </div>
          <div class="metric-card__value">{formatNumber(report.totals.deleted)}</div>
        </div>
      </section>

      <section class="shadcn-card" id="invitations-section">
        <div class="shadcn-card__header">
          <div class="shadcn-card__title-wrap">
            <h2 class="shadcn-card__title">
              Active Invitations
              <span class="shadcn-badge shadcn-badge--outline" id="active-badge-count">
                {formatNumber(report.reports.length)} records
              </span>
            </h2>
            <p class="shadcn-card__description">
              Manage invitation details, domains, analytics, and publication status.
            </p>
          </div>

          <a href="/dashboard/new" class="btn-shadcn btn-shadcn--primary btn-shadcn--sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Invitation
          </a>
        </div>

        <div class="table-toolbar">
          <div class="table-toolbar__left">
            <div class="search-field">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="search-input"
                placeholder="Filter by slug, couple, or template..."
                autocomplete="off"
              />
            </div>
          </div>

          <div class="table-toolbar__right">
            <div class="filter-pills" role="tablist" aria-label="Status filters">
              <button type="button" class="filter-pill active" data-filter="all">All</button>
              <button type="button" class="filter-pill" data-filter="published">Published</button>
              <button type="button" class="filter-pill" data-filter="draft">Draft</button>
              <button type="button" class="filter-pill" data-filter="archived">Archived</button>
            </div>
          </div>
        </div>

        <div class="shadcn-table-wrap">
          <table class="shadcn-table" id="invitations-table">
            <thead>
              <tr>
                <th style="width: 28%;" class="col-slug">Slug</th>
                <th style="width: 16%;" class="col-template">Template</th>
                <th style="width: 14%;" class="col-status">Status</th>
                <th style="width: 18%;" class="col-date">Wedding Date</th>
                <th style="width: 24%; text-align: right;" class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="invitations-tbody">
              {report.reports.map((item: any) => (
                <tr
                  class="invitation-row"
                  data-slug={item.slug.toLowerCase()}
                  data-couple={item.coupleName.toLowerCase()}
                  data-status={item.status.toLowerCase()}
                  data-template={(item.template || '').toLowerCase()}
                  data-edit-url={`/dashboard/${item.slug}/edit`}
                  title={`Click to edit "${item.slug}"`}
                >
                  <td class="col-slug">
                    <div class="slug-badge">
                      <span class="slug-badge__text">{item.slug}</span>
                      {item.customDomain && (
                        <span class="slug-badge__domain">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                          </svg>
                          {item.customDomain}
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="col-template">
                    <span class="template-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                        <path d="M3 9h18"></path>
                        <path d="M9 21V9"></path>
                      </svg>
                      <span>{(item.template || 'noir').replace(/-/g, ' ')}</span>
                    </span>
                  </td>
                  <td class="col-status">
                    <span class={`shadcn-badge shadcn-badge--${item.status}`}>
                      <span class="shadcn-badge__dot"></span>
                      {item.status}
                    </span>
                  </td>
                  <td class="col-date">
                    <span class="date-cell">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                      {formatDate(item.weddingDate)}
                    </span>
                  </td>
                  <td class="col-actions">
                    <div class="row-actions-group">
                      <!-- Default Action 1: Live Preview -->
                      <a
                        href={`/${item.slug}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-shadcn btn-shadcn--outline btn-shadcn--sm"
                        title="Live Preview"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                          <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        Preview
                      </a>

                      <!-- Default Action 2: Analytics -->
                      <a
                        href={`/dashboard/${item.slug}`}
                        class="btn-shadcn btn-shadcn--outline btn-shadcn--sm"
                        title="View Analytics"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 3v18h18"></path>
                          <path d="m19 9-5 5-4-4-3 3"></path>
                        </svg>
                        Analytics
                      </a>

                      <!-- More Options Dropdown -->
                      <div class="dropdown-wrap">
                        <button
                          type="button"
                          class="btn-shadcn btn-shadcn--ghost btn-shadcn--icon dropdown-trigger"
                          aria-label="More options"
                          data-dropdown-id={`dropdown-${item.slug}`}
                          title="More options"
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="1"></circle>
                            <circle cx="19" cy="12" r="1"></circle>
                            <circle cx="5" cy="12" r="1"></circle>
                          </svg>
                        </button>

                        <div id={`dropdown-${item.slug}`} class="dropdown-menu">
                          <a href={`/dashboard/${item.slug}/edit`} class="dropdown-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                            </svg>
                            Edit Invitation
                          </a>

                          <form method="POST" style="margin: 0; width: 100%;">
                            <input type="hidden" name="action" value="duplicate" />
                            <input type="hidden" name="weddingId" value={item.weddingId} />
                            <button type="submit" class="dropdown-item">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                              </svg>
                              Duplicate
                            </button>
                          </form>

                          <div class="dropdown-separator"></div>

                          <form method="POST" style="margin: 0; width: 100%;">
                            <input type="hidden" name="action" value="soft-delete" />
                            <input type="hidden" name="weddingId" value={item.weddingId} />
                            <button
                              type="submit"
                              class="dropdown-item dropdown-item--destructive"
                              data-confirm={`Pindahkan undangan "${item.slug}" ke Deleted Invitations?`}
                              data-confirm-title="Confirm Soft Delete"
                              data-confirm-text="Soft Delete"
                              data-cancel-text="Batal"
                              data-confirm-variant="warning"
                            >
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 6h18"></path>
                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                              </svg>
                              Move to Trash
                            </button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>

          <div id="no-search-results" class="empty-state" style="display: none;">
            <div class="empty-state__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <p class="empty-state__title">No invitations found</p>
            <p class="empty-state__sub">Try adjusting your search keyword or status filter.</p>
          </div>
        </div>

        <div class="shadcn-card__footer">
          <span id="showing-count">Showing {report.reports.length} of {report.reports.length} invitations</span>
        </div>
      </section>

      <section class="shadcn-card" id="deleted-section">
        <div class="shadcn-card__header">
          <div class="shadcn-card__title-wrap">
            <h2 class="shadcn-card__title">
              Deleted Invitations
              <span class="shadcn-badge shadcn-badge--destructive">
                {formatNumber(report.deletedReports.length)} archived
              </span>
            </h2>
            <p class="shadcn-card__description">
              Soft-deleted invitations. You can restore them back to active status or permanently wipe them.
            </p>
          </div>
        </div>

        <div class="shadcn-table-wrap">
          <table class="shadcn-table">
            <thead>
              <tr>
                <th style="width: 22%;" class="col-slug">Slug</th>
                <th style="width: 12%;">Status</th>
                <th style="width: 16%;">Wedding Date</th>
                <th style="width: 18%;">Deleted At</th>
                <th style="width: 14%;">Deleted By</th>
                <th style="width: 18%; text-align: right;" class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              {report.deletedReports.map((item: any) => (
                <tr>
                  <td class="col-slug">
                    <span class="slug-badge__text">{item.slug}</span>
                  </td>
                  <td>
                    <span class={`shadcn-badge shadcn-badge--${item.status}`}>
                      <span class="shadcn-badge__dot"></span>
                      {item.status}
                    </span>
                  </td>
                  <td>
                    <span class="date-cell">{formatDate(item.weddingDate)}</span>
                  </td>
                  <td>
                    <span class="date-cell">{formatDateTime(item.deletedAt)}</span>
                  </td>
                  <td>
                    <span style="font-size: 12px; color: var(--admin-zinc-600);">{item.deletedBy || '-'}</span>
                  </td>
                  <td class="col-actions">
                    <div class="row-actions" style="justify-content: flex-end;">
                      <form method="POST">
                        <input type="hidden" name="action" value="restore" />
                        <input type="hidden" name="weddingId" value={item.weddingId} />
                        <button type="submit" class="btn-shadcn btn-shadcn--success-outline btn-shadcn--sm" title="Restore Invitation">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1 4 1 10 7 10"></polyline>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                          </svg>
                          Restore
                        </button>
                      </form>

                      <form method="POST">
                        <input type="hidden" name="action" value="permanent-delete" />
                        <input type="hidden" name="weddingId" value={item.weddingId} />
                        <button
                          type="submit"
                          class="btn-shadcn btn-shadcn--destructive-outline btn-shadcn--sm"
                          data-confirm={`Hapus permanen undangan "${item.slug}" dan seluruh aset foto unshared? Tindakan ini TIDAK DAPAT DIBATALKAN.`}
                          data-confirm-title="Delete Permanently"
                          data-confirm-text="Delete Permanently"
                          data-cancel-text="Batal"
                          data-confirm-variant="danger"
                          title="Delete Permanently"
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18"></path>
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                            <line x1="10" y1="11" x2="10" y2="17"></line>
                            <line x1="14" y1="11" x2="14" y2="17"></line>
                          </svg>
                          Purge
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}

              {!report.deletedReports.length && (
                <tr>
                  <td colspan="6">
                    <div class="empty-state">
                      <div class="empty-state__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                      </div>
                      <p class="empty-state__title">Trash is empty</p>
                      <p class="empty-state__sub">No soft-deleted invitations in archive.</p>
                    </div>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}
</AdminLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const filterPills = document.querySelectorAll('.filter-pill');
    const rows = document.querySelectorAll('.invitation-row');
    const emptyState = document.getElementById('no-search-results');
    const showingCount = document.getElementById('showing-count');
    const totalCount = rows.length;

    let currentFilter = 'all';
    let currentSearch = '';

    function applyFilter() {
      let visible = 0;

      rows.forEach(row => {
        const slug = row.getAttribute('data-slug') || '';
        const couple = row.getAttribute('data-couple') || '';
        const status = row.getAttribute('data-status') || '';
        const template = row.getAttribute('data-template') || '';

        const matchesSearch = !currentSearch ||
          slug.includes(currentSearch) ||
          couple.includes(currentSearch) ||
          template.includes(currentSearch);
        const matchesStatus = currentFilter === 'all' || status === currentFilter;

        if (matchesSearch && matchesStatus) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visible === 0 ? 'flex' : 'none';
      }

      if (showingCount) {
        showingCount.textContent = `Showing ${visible} of ${totalCount} invitations`;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.trim().toLowerCase();
        applyFilter();
      });
    }

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentFilter = pill.getAttribute('data-filter') || 'all';
        applyFilter();
      });
    });

    // Row click navigation to Edit
    rows.forEach(row => {
      row.addEventListener('click', (e) => {
        // Ignore if clicking interactive controls
        if (e.target.closest('a, button, form, input, select, textarea, .dropdown-menu, .dropdown-trigger')) {
          return;
        }
        // Ignore if user is highlighting text
        const selection = window.getSelection();
        if (selection && selection.toString().trim().length > 0) {
          return;
        }
        const editUrl = row.getAttribute('data-edit-url');
        if (editUrl) {
          if (e.ctrlKey || e.metaKey) {
            window.open(editUrl, '_blank');
          } else {
            window.location.href = editUrl;
          }
        }
      });

      row.addEventListener('auxclick', (e) => {
        if (e.button === 1) { // Middle click
          if (e.target.closest('a, button, form, input, select, textarea, .dropdown-menu, .dropdown-trigger')) {
            return;
          }
          const editUrl = row.getAttribute('data-edit-url');
          if (editUrl) {
            window.open(editUrl, '_blank');
          }
        }
      });
    });

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.dropdown-trigger');
      const openMenu = e.target.closest('.dropdown-menu');

      if (trigger) {
        e.stopPropagation();
        const menuId = trigger.getAttribute('data-dropdown-id');
        const menu = document.getElementById(menuId);
        const isShown = menu?.classList.contains('show');

        document.querySelectorAll('.dropdown-menu.show').forEach(m => {
          if (m !== menu) {
            m.classList.remove('show');
            m.closest('tr')?.classList.remove('dropdown-active');
            m.closest('td')?.classList.remove('dropdown-active');
          }
        });

        if (menu) {
          const willShow = !isShown;
          menu.classList.toggle('show', willShow);
          trigger.closest('tr')?.classList.toggle('dropdown-active', willShow);
          trigger.closest('td')?.classList.toggle('dropdown-active', willShow);
        }
        return;
      }

      if (!openMenu) {
        document.querySelectorAll('.dropdown-menu.show').forEach(m => {
          m.classList.remove('show');
          m.closest('tr')?.classList.remove('dropdown-active');
          m.closest('td')?.classList.remove('dropdown-active');
        });
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.dropdown-menu.show').forEach(m => {
          m.classList.remove('show');
          m.closest('tr')?.classList.remove('dropdown-active');
          m.closest('td')?.classList.remove('dropdown-active');
        });
      }
    });
  });
</script>
