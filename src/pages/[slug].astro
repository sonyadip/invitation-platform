---
import { getInvitationByDomainOrSlug } from '../services/invitation';
import {
  getClientIp,
  getInvitationAccessState,
  handlePasswordUnlock,
  isInvitationUnlocked,
  resolveInvitationIdentifier
} from '../services/invitation-runtime';
import { shouldTrackInvitationView, trackInvitationView } from '../services/view-tracking';
import { loadTemplate } from '../templates/registry';
import { extractClientContext } from '../utils/analytics';

// Force dynamic SSR execution for Cloudflare Pages serverless runtime
export const prerender = false;

const { slug } = Astro.params;

const { identifier, isDomain } = resolveInvitationIdentifier(Astro.url, slug);
const data = await getInvitationByDomainOrSlug(identifier, isDomain);

if (!data) {
  return new Response('Undangan tidak ditemukan atau telah dihapus.', { status: 404 });
}

const { wedding, settings } = data;
const now = new Date();
const unlockResult = await handlePasswordUnlock({
  request: Astro.request,
  cookies: Astro.cookies,
  url: Astro.url,
  weddingId: wedding.id,
  accessPassword: settings.access_password
});

if (unlockResult.success && unlockResult.redirectUrl) {
  return Astro.redirect(unlockResult.redirectUrl);
}

const errorMessage = unlockResult.errorMessage;
const isUnlocked = await isInvitationUnlocked(Astro.cookies, wedding.id, settings.access_password);
const { isMaintenance, isExpired, isPasswordLocked } = getInvitationAccessState(settings, isUnlocked, now);
const guestName = Astro.url.searchParams.get('to') || null;

if (shouldTrackInvitationView(settings, wedding.status, isMaintenance, isPasswordLocked)) {
  const clientCtx = extractClientContext(Astro.request);
  trackInvitationView({
    weddingId: wedding.id,
    clientIp: getClientIp(Astro.request, Astro.clientAddress),
    userAgent: clientCtx.userAgent || 'Unknown',
    guestName,
    deviceType: clientCtx.deviceType,
    os: clientCtx.os,
    browser: clientCtx.browser,
    city: clientCtx.city,
    country: clientCtx.country,
    referrer: clientCtx.referrer,
    now
  }).catch(console.error);
}

const loadedTemplate = await loadTemplate(wedding.template);
const ActiveTemplate = loadedTemplate.component as any;

if (!ActiveTemplate) {
  return new Response(
    `Template "${loadedTemplate.key}" was not found. Make sure src/templates/${loadedTemplate.key}/ follows the template convention.`,
    { status: 404 }
  );
}

---

{(!isMaintenance && !isExpired && !isPasswordLocked) ? (
  <ActiveTemplate data={data} guestName={guestName} />
) : (
  <html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Senadda Wedding</title>
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/fonts/SaolDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    {(isMaintenance || isExpired) ? (
      <main class="status-layout">
        <section class="status-section">
          {isMaintenance ? (
            <>
              <div class="status-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
              </div>
              <h1 class="status-title">Sedang Dalam<br/>Pemeliharaan</h1>
              <p class="status-desc">Undangan pernikahan ini sedang dalam proses pemeliharaan.<br/>Silakan kunjungi kembali beberapa saat lagi.</p>
            </>
          ) : (
            <>
              <p class="status-eyebrow">Masa Aktif Berakhir</p>
              <h1 class="status-title">Undangan Telah<br/>Berakhir</h1>
              <p class="status-desc">Masa aktif undangan online ini telah berakhir.<br/>Daftar RSVP & Konfirmasi telah dinonaktifkan.</p>
            </>
          )}
        </section>
      </main>
    ) : (
      <main class="status-layout">
        <section class="status-section">
          <p class="status-eyebrow">Akses Terbatas</p>
          <h1 class="status-title">Halaman<br/>Terproteksi</h1>
          <p class="status-desc">Masukkan kata sandi untuk membuka undangan pernikahan ini.</p>
          <form method="POST" class="gate-form">
            <input type="hidden" name="action" value="unlock" />
            <div class="gate-form__field">
              <label for="gate-password" class="gate-form__label">Kata Sandi Akses</label>
              <input type="password" id="gate-password" name="password" required placeholder="Masukkan kata sandi..." class="gate-form__input" />
            </div>
            {errorMessage && (
              <div class="gate-form__error">{errorMessage}</div>
            )}
            <button type="submit" class="gate-form__submit">Buka Undangan</button>
          </form>
        </section>
      </main>
    )}
  </body>
  </html>
)}

<style lang="scss">
  @font-face {
    font-family: "SaolDisplay-Regular";
    src: url("/fonts/SaolDisplay-Regular.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .status-layout {
    color-scheme: light;
    --ink-charcoal: #17160f;
    --deep-charcoal: #2f2e25;
    --ivory-paper: #f7f5ea;
    --soft-parchment: #efeddf;
    --warm-taupe: #b8aa92;
    --muted-clay: #a9785f;
    --accent: var(--muted-clay);
    --black: var(--ink-charcoal);
    --white: var(--ivory-paper);
    --grey: var(--warm-taupe);
    --font-heading: "SaolDisplay-Regular", serif;
    --font-body: "Montserrat", sans-serif;
    --ease-soft: cubic-bezier(0.29, 0.73, 0.45, 1);

    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: var(--white);
    color: var(--black);
    font-family: var(--font-body);
    box-sizing: border-box;
  }
  
  .status-layout *, .status-layout *::before, .status-layout *::after {
    box-sizing: inherit;
  }

  /* ── Nav ── */
  .hero-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 12px;
    background: linear-gradient(180deg, rgba(247,245,234,0.9), rgba(247,245,234,0));
    backdrop-filter: blur(14px);

    @media (max-width: 768px) { padding: 14px 12px 10px; }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    width: 140px;
    @media (max-width: 768px) { width: 110px; }
  }
  .brand-logo__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .nav-action {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    border: none;
    font-family: var(--font-body);
    transition: opacity 0.22s ease;
    &:hover { opacity: 0.65; }
  }

  /* ── Status Section ── */
  .status-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 24px;
    min-height: 100svh;
  }

  .status-eyebrow {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
  }

  .status-icon {
    color: var(--accent);
    margin-bottom: 16px;
    svg {
      width: 42px;
      height: 42px;
    }
  }

  .status-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 16px;
    color: var(--black);
  }

  .status-desc {
    font-size: clamp(0.875rem, 2vw, 1rem);
    color: var(--deep-charcoal);
    line-height: 1.6;
    max-width: 400px;
    margin: 0 0 32px;
  }

  .status-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 36px;
    background: var(--black);
    color: var(--white);
    text-decoration: none;
    border-radius: 40px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
    &:hover { background-color: var(--accent); transform: translateY(-2px); }
  }

  /* ── Gate Form (password) ── */
  .gate-form {
    width: 100%;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: left;
    margin-top: 8px;
  }

  .gate-form__field { display: flex; flex-direction: column; gap: 6px; }

  .gate-form__label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--grey);
  }

  .gate-form__input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 8px;
    background: var(--soft-parchment);
    border: 1px solid var(--warm-taupe);
    color: var(--black);
    font-size: 14px;
    font-family: var(--font-body);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    &::placeholder { color: var(--warm-taupe); }
    &:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(169, 120, 95, 0.15);
    }
  }

  .gate-form__error {
    font-size: 12px;
    color: #c0392b;
    background: rgba(192, 57, 43, 0.08);
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid rgba(192, 57, 43, 0.2);
  }

  .gate-form__submit {
    width: 100%;
    padding: 13px;
    background: var(--black);
    color: var(--white);
    border: none;
    border-radius: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background 0.2s var(--ease-soft);
    &:hover { background: var(--accent); }
  }
</style>


