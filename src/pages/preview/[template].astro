---
import { loadTemplate } from '../../templates/registry';
import { getInvitationByDomainOrSlug } from '../../services/invitation';
import type { FullInvitationData } from '../../types';
import { COMMON_ASSETS } from '../../utils/cdn';
import metatahPreviewBg from '../../templates/lumiere-metatah-v2/assets/metatah-bg.webp';
import sidebarPreviewBg from '../../templates/lumiere-metatah-v2/assets/sidebar-bg.webp';

export const prerender = false;

const { template } = Astro.params;
const templateKey = (template || 'noir').toLowerCase();
const now = new Date().toISOString();
const weddingDate = new Date(Date.now() + 1000 * 60 * 60 * 24 * 45).toISOString();

const isMetatahTanpaFoto = templateKey === 'lumiere-metatah-tanpa-foto' || templateKey === 'lumiere-metatah-v2-tanpa-foto';
const isMetatahV2 = templateKey === 'lumiere-metatah-v2' || isMetatahTanpaFoto;
const isMetatahFamily = templateKey === 'lumiere-metatah' || isMetatahV2;
const actualTemplateKey = isMetatahTanpaFoto ? 'lumiere-metatah-v2' : templateKey;

const CLIENT_PREVIEW_MAP: Record<string, string> = {
  deauville: 'andi-ayu',
  editorial: 'yudis-ami',
  noir: 'yudi-meita',
  lumiere: 'abdi-eka',
  allure: 'yudi-meita',
  velvet: 'yudi-meita'
};

const defaultData: FullInvitationData = {
  wedding: {
    id: `preview-${templateKey}`,
    slug: `preview-${templateKey}`,
    bride_name: 'Ayu',
    groom_name: 'Rama',
    bride_full_name: 'Ni Putu Ayu Lestari',
    groom_full_name: 'I Made Rama Pratama',
    wedding_date: weddingDate,
    venue_name: 'The Royal Garden',
    venue_address: 'Jl. Pantai Indah No. 8, Bali',
    maps_url: 'https://maps.google.com',
    story: [
      { year: '2019', title: 'Pertama Bertemu', description: 'Sebuah pertemuan sederhana yang menjadi awal cerita kami.' },
      { year: '2026', title: 'Hari Bahagia', description: 'Kami mengundang keluarga dan sahabat untuk merayakan momen ini.' }
    ],
    music_url: 'https://media.senadda.id/audio/banda-neira-sampai-jadi-debu.mp3',
    template: actualTemplateKey,
    status: 'published',
    deleted_at: null,
    deleted_by: null,
    created_at: now,
    updated_at: now
  },
  settings: {
    id: `settings-${templateKey}`,
    wedding_id: `preview-${templateKey}`,
    rsvp_enabled: true,
    music_enabled: true,
    music_autoplay: false,
    countdown_enabled: true,
    gallery_enabled: true,
    wishes_enabled: true,
    gift_enabled: true,
    share_enabled: true,
    view_counter_enabled: false,
    maintenance_mode: false,
    expiration_date: null,
    password_protection_enabled: false,
    access_password: null,
    sections: {
      hero: true,
      countdown: true,
      coupleInfo: true,
      eventDetails: true,
      story: true,
      gallery: true,
      rsvp: true,
      wishes: true,
      gift: true,
      music: true,
      video: true,
      share: true,
      livestream: false,
      introAnimation: true
    },
    theme_config: {
      theme: {
        primaryColor: '#5E0ED7',
        secondaryColor: '#111111',
        textColor: '#111111',
        bgColor: '#ffffff',
        fontHeading: 'Onest',
        fontBody: 'Onest'
      },
      layout: {
        heroStyle: 'centered',
        galleryColumns: 3
      },
      assets: {
        heroVideo: ['lumiere', 'editorial', 'atelier'].includes(templateKey) ? COMMON_ASSETS.PREVIEW_VIDEO : undefined,
        videoUrl: 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm'
      },
      content: {
        groomFatherName: 'Bapak Mempelai',
        groomMotherName: 'Ibu Mempelai',
        groomParents: 'Putra dari Bapak Mempelai & Ibu Mempelai',
        brideFatherName: 'Bapak Mempelai',
        brideMotherName: 'Ibu Mempelai',
        brideParents: 'Putri dari Bapak Mempelai & Ibu Mempelai',
        groomAddress: 'Denpasar, Bali',
        brideAddress: 'Gianyar, Bali',
        instagramUrl: 'https://www.instagram.com/senadda.id',
        groomInstagramUrl: 'https://www.instagram.com/senadda.id',
        brideInstagramUrl: 'https://www.instagram.com/senadda.id',
        groomIg: 'senadda.id',
        brideIg: 'senadda.id',
        participantInstagramUrl: 'https://www.instagram.com/senadda.id',
        participantIg: 'senadda.id'
      }
    },
    created_at: now,
    updated_at: now
  },
  events: [
    {
      id: 'event-1',
      wedding_id: `preview-${templateKey}`,
      event_name: 'Akad Nikah',
      event_date: weddingDate,
      start_time: '09:00',
      end_time: '11:00',
      venue_name: 'The Royal Garden',
      venue_address: 'Jl. Pantai Indah No. 8, Bali',
      maps_url: 'https://maps.google.com',
      sort_order: 1,
      created_at: now
    },
    ...(['blush', 'deauville'].includes(templateKey)
      ? []
      : [
          {
            id: 'event-2',
            wedding_id: `preview-${templateKey}`,
            event_name: 'Resepsi',
            event_date: weddingDate,
            start_time: '18:00',
            end_time: 'Selesai',
            venue_name: 'The Royal Garden',
            venue_address: 'Jl. Pantai Indah No. 8, Bali',
            maps_url: 'https://maps.google.com',
            sort_order: 2,
            created_at: now
          }
        ])
  ],
  gallery: [],
  gifts: [
    {
      id: 'gift-1',
      wedding_id: `preview-${templateKey}`,
      bank_name: 'BCA',
      account_number: '0123 456 789',
      account_name: 'Rama Pratama',
      qris_url: null,
      sort_order: 1,
      created_at: now
    }
  ],
  wishes: Array.from({ length: 40 }, (_, i) => ({
    id: `wish-${i + 1}`,
    wedding_id: `preview-${templateKey}`,
    guest_name: ['Sahabat', 'Budi Santoso', 'Siti Rahma', 'Dimas Anggara', 'Rina Wulandari', 'Andi Pratama', 'Maya Putri', 'Eko Prasetyo', 'Dewi Lestari', 'Fajar Ramadhan'][i % 10] + ` #${i + 1}`,
    attendance_status: (i % 3 === 0 ? 'attending' : (i % 3 === 1 ? 'tentative' : 'declined')) as any,
    guest_count: (i % 3) + 1,
    message: [
      'Selamat menempuh hidup baru, semoga bahagia selalu!',
      'Selamat ya! Semoga lancar sampai hari H dan langgeng selamanya.'
    ][i % 4],
    created_at: new Date(Date.now() - i * 3600000).toISOString()
  }))
};

if (isMetatahFamily) {
  defaultData.wedding.music_url = COMMON_ASSETS.METATAH_MUSIC;
  defaultData.wedding.groom_name = 'Rama';
  defaultData.wedding.bride_name = 'Ayu';
  defaultData.wedding.groom_full_name = 'I Made Rama Pratama';
  defaultData.wedding.bride_full_name = 'Ni Putu Ayu Lestari';
  defaultData.wedding.story = [
    { year: 'Makna', title: 'Upacara Mepandes / Metatah', description: 'Upacara Manusa Yadnya dalam tradisi Hindu Bali untuk menyucikan diri dan mengendalikan Sad Ripu (enam musuh dalam diri manusia).' },
    { year: 'Doa', title: 'Penyucian Diri Menuju Kedewasaan', description: 'Sebagai simbol peralihan menuju kedewasaan, memohon keselamatan, ketenangan batin, serta keharmonisan lahir dan batin kepada Ida Sang Hyang Widhi Wasa.' }
  ];
  defaultData.settings.theme_config.content = {
    ...defaultData.settings.theme_config?.content,
    groomFatherName: 'I Wayan Sudarma',
    groomMotherName: 'Ni Made Sukerti',
    groomParents: 'I Wayan Sudarma & Ni Made Sukerti',
    brideFatherName: 'I Wayan Sudarma',
    brideMotherName: 'Ni Made Sukerti',
    brideParents: 'I Wayan Sudarma & Ni Made Sukerti',
    fatherName: 'I Wayan Sudarma',
    motherName: 'Ni Made Sukerti',
    participantFatherName: 'I Wayan Sudarma',
    participantMotherName: 'Ni Made Sukerti',
    participantParents: 'I Wayan Sudarma & Ni Made Sukerti',
    brideChildNumber: 2
  };

  if (isMetatahV2) {
    const participantPhoto = isMetatahTanpaFoto ? null : metatahPreviewBg.src;
    const participantPhotoAlt = isMetatahTanpaFoto ? null : sidebarPreviewBg.src;

    const rawParticipants = [
      { name: 'Rama', fullName: 'I Made Rama Pratama', nickname: 'Rama', role: 'Putra Pertama', instagram: 'senadda.id', photo: participantPhoto },
      { name: 'Ayu', fullName: 'Ni Putu Ayu Lestari', nickname: 'Ayu', role: 'Putri Pertama', instagram: 'senadda.id', photo: participantPhotoAlt },
      { name: 'Wayan', fullName: 'I Wayan Gede Aditya', nickname: 'Wayan', role: 'Putra Pertama', instagram: 'senadda.id', photo: participantPhoto },
      { name: 'Kadek', fullName: 'Ni Kadek Dwi Cahyani', nickname: 'Kadek', role: 'Putri Kedua', instagram: 'senadda.id', photo: participantPhotoAlt },
      { name: 'Komang', fullName: 'I Komang Tri Wiguna', nickname: 'Komang', role: 'Putra Ketiga', instagram: 'senadda.id', photo: participantPhoto },
      { name: 'Ketut', fullName: 'Ni Ketut Candra Dewi', nickname: 'Ketut', role: 'Putri Keempat', instagram: 'senadda.id', photo: participantPhotoAlt },
      { name: 'Gede', fullName: 'I Gede Bayu Permana', nickname: 'Gede', role: 'Putra Pertama', instagram: 'senadda.id', photo: participantPhoto },
      { name: 'Putu', fullName: 'Ni Putu Intan Sari', nickname: 'Putu', role: 'Putri Pertama', instagram: 'senadda.id', photo: participantPhotoAlt },
      { name: 'Made', fullName: 'I Made Surya Darma', nickname: 'Made', role: 'Putra Kedua', instagram: 'senadda.id', photo: participantPhoto },
      { name: 'Nyoman', fullName: 'Ni Nyoman Ayu Manik', nickname: 'Nyoman', role: 'Putri Ketiga', instagram: 'senadda.id', photo: participantPhotoAlt },
      { name: 'Agus', fullName: 'I Ketut Agus Wirawan', nickname: 'Agus', role: 'Putra Keempat', instagram: 'senadda.id', photo: participantPhoto },
      { name: 'Sari', fullName: 'Ni Luh Made Sari Dewi', nickname: 'Sari', role: 'Putri Kedua', instagram: 'senadda.id', photo: participantPhotoAlt },
      { name: 'Bagus', fullName: 'I Wayan Bagus Mahardika', nickname: 'Bagus', role: 'Putra Pertama', instagram: 'senadda.id', photo: participantPhoto },
      { name: 'Ratih', fullName: 'Ni Kadek Ratih Purwani', nickname: 'Ratih', role: 'Putri Kedua', instagram: 'senadda.id', photo: participantPhotoAlt },
      { name: 'Dharma', fullName: 'I Komang Dharma Putra', nickname: 'Dharma', role: 'Putra Ketiga', instagram: 'senadda.id', photo: participantPhoto }
    ];

    const participantsList = isMetatahTanpaFoto
      ? rawParticipants.slice(0, 8)
      : rawParticipants;

    const requestedTitle = Astro.url.searchParams.get('title')?.toLowerCase() || (isMetatahTanpaFoto ? 'default' : 'family');

    let previewTitleMode = 'family';
    let previewCoverTitle = 'Keluarga Pande Ceria';
    let previewIntroTitle = 'Keluarga Pande Ceria';
    let previewIntroAnimationName = 'Keluarga Pande Ceria';

    if (requestedTitle === 'default' || requestedTitle === 'ceremony' || requestedTitle === 'metatah') {
      previewTitleMode = 'default';
      previewCoverTitle = 'Metatah';
      previewIntroTitle = 'Metatah';
      previewIntroAnimationName = 'Metatah';
    } else if (requestedTitle === 'participants' || requestedTitle === 'peserta') {
      previewTitleMode = 'participants';
      previewCoverTitle = '';
      previewIntroTitle = '';
      previewIntroAnimationName = '';
    } else {
      previewTitleMode = 'family';
      previewCoverTitle = 'Keluarga Pande Ceria';
      previewIntroTitle = 'Keluarga Pande Ceria';
      previewIntroAnimationName = 'Keluarga Pande Ceria';
    }

    defaultData.settings.theme_config.content = {
      ...defaultData.settings.theme_config?.content,
      titleMode: previewTitleMode,
      coverTitle: previewCoverTitle,
      introTitle: previewIntroTitle,
      introAnimationName: previewIntroAnimationName,
      mediaCaption: 'Kebersamaan Peserta Upacara Metatah',
      participants: participantsList
    };
  }
  defaultData.settings.theme_config.assets = {
    ...defaultData.settings.theme_config?.assets,
    coverImage: metatahPreviewBg.src,
    heroImage: metatahPreviewBg.src,
    sidebarImage: sidebarPreviewBg.src,
    groomImage: isMetatahTanpaFoto ? null : metatahPreviewBg.src,
    brideImage: isMetatahTanpaFoto ? null : sidebarPreviewBg.src,
    eventImage: isMetatahTanpaFoto ? undefined : metatahPreviewBg.src,
    rsvpImage: sidebarPreviewBg.src,
    closingImage: isMetatahTanpaFoto ? null : metatahPreviewBg.src,
    countdownImage: sidebarPreviewBg.src,
    videoUrl: '',
    sliderImages: [
      metatahPreviewBg.src,
      sidebarPreviewBg.src
    ]
  };

  defaultData.events = [
    {
      id: 'event-1',
      wedding_id: `preview-${templateKey}`,
      event_name: 'Metatah',
      event_date: weddingDate,
      start_time: '08:00',
      end_time: '12:00',
      venue_name: 'Griya Agung Sukawati',
      venue_address: 'Jl. Raya Sukawati, Gianyar, Bali',
      maps_url: 'https://maps.google.com',
      sort_order: 1,
      created_at: now
    },
    {
      id: 'event-2',
      wedding_id: `preview-${templateKey}`,
      event_name: 'Resepsi',
      event_date: weddingDate,
      start_time: '13:00',
      end_time: 'Selesai',
      venue_name: 'Griya Agung Sukawati',
      venue_address: 'Jl. Raya Sukawati, Gianyar, Bali',
      maps_url: 'https://maps.google.com',
      sort_order: 2,
      created_at: now
    }
  ];

  if (isMetatahTanpaFoto) {
    defaultData.settings.sections = {
      ...defaultData.settings.sections,
      gallery: false,
      media: false
    };
    defaultData.settings.gallery_enabled = false;
    defaultData.gallery = [];
  } else {
    defaultData.gallery = [
      { id: '1', wedding_id: `preview-${templateKey}`, image_url: metatahPreviewBg.src, sort_order: 1, created_at: now },
      { id: '2', wedding_id: `preview-${templateKey}`, image_url: sidebarPreviewBg.src, sort_order: 2, created_at: now },
      { id: '3', wedding_id: `preview-${templateKey}`, image_url: metatahPreviewBg.src, sort_order: 3, created_at: now },
      { id: '4', wedding_id: `preview-${templateKey}`, image_url: sidebarPreviewBg.src, sort_order: 4, created_at: now },
      { id: '5', wedding_id: `preview-${templateKey}`, image_url: metatahPreviewBg.src, sort_order: 5, created_at: now },
      { id: '6', wedding_id: `preview-${templateKey}`, image_url: sidebarPreviewBg.src, sort_order: 6, created_at: now }
    ];
  }
  defaultData.wishes = Array.from({ length: 40 }, (_, i) => ({
    id: `wish-${i + 1}`,
    wedding_id: `preview-${templateKey}`,
    guest_name: ['Sahabat', 'Budi Santoso', 'Siti Rahma', 'Dimas Anggara', 'Rina Wulandari', 'Andi Pratama', 'Maya Putri', 'Eko Prasetyo', 'Dewi Lestari', 'Fajar Ramadhan'][i % 10] + ` #${i + 1}`,
    attendance_status: (i % 3 === 0 ? 'attending' : (i % 3 === 1 ? 'tentative' : 'declined')) as any,
    guest_count: (i % 3) + 1,
    message: [
      'Selamat melaksanakan upacara Metatah / Potong Gigi. Semoga senantiasa diberkahi kerahayuan dan kedamaian.',
      'Rahajeng nyanggra Upacara Metatah. Dumogi rahayu sareng sami lan mamargi antar.',
      'Selamat dan sukses atas upacara Metatah putra-putri tercinta. Semoga menjadi pribadi yang berbudi luhur.',
      'Dumogi asung kertha wara nugraha Ida Sang Hyang Widhi Wasa menyertai seluruh rangkaian upacara.'
    ][i % 4],
    created_at: new Date(Date.now() - i * 3600000).toISOString()
  }));
  defaultData.gifts = [
    {
      id: 'gift-1',
      wedding_id: `preview-${templateKey}`,
      bank_name: 'BCA',
      account_number: '0123 456 789',
      account_name: 'Rama Pratama',
      qris_url: null,
      sort_order: 1,
      created_at: now
    }
  ];
}

let data: FullInvitationData = defaultData;

const clientSlug = CLIENT_PREVIEW_MAP[templateKey];
if (clientSlug) {
  try {
    const clientData = await getInvitationByDomainOrSlug(clientSlug, false);
    if (clientData) {
      const wedding = {
        ...defaultData.wedding,
        ...clientData.wedding,
        id: `preview-${templateKey}`,
        slug: `preview-${templateKey}`,
        venue_name: defaultData.wedding.venue_name,
        venue_address: defaultData.wedding.venue_address,
        maps_url: defaultData.wedding.maps_url,
        story: (clientData.wedding.story && clientData.wedding.story.length > 0)
          ? clientData.wedding.story
          : defaultData.wedding.story,
        music_url: defaultData.wedding.music_url,
        template: templateKey,
        status: 'published' as const
      };

      const settings = {
        ...defaultData.settings,
        ...clientData.settings,
        id: `settings-${templateKey}`,
        wedding_id: `preview-${templateKey}`,
        maintenance_mode: false,
        password_protection_enabled: false,
        sections: {
          ...defaultData.settings.sections,
          ...(clientData.settings.sections || {}),
          hero: true,
          countdown: true,
          coupleInfo: true,
          eventDetails: true,
          story: true,
          gallery: true,
          rsvp: true,
          wishes: true,
          gift: true,
          music: true,
          video: true,
          share: true,
          livestream: false,
          introAnimation: true
        },
        theme_config: {
          ...defaultData.settings.theme_config,
          ...(clientData.settings.theme_config || {}),
          assets: {
            ...defaultData.settings.theme_config?.assets,
            ...(clientData.settings.theme_config?.assets || {}),
            coverImage: (templateKey === 'allure' || templateKey === 'velvet')
              ? (clientData.gallery?.find(g => typeof g.image_url === 'string' && g.image_url.includes('gallery-6.webp'))?.image_url || clientData.settings.theme_config?.assets?.coverImage)
              : clientData.settings.theme_config?.assets?.coverImage,
            eventImage: (templateKey === 'allure' || templateKey === 'velvet')
              ? (clientData.settings.theme_config?.assets?.coverImage || clientData.settings.theme_config?.assets?.heroImage)
              : clientData.settings.theme_config?.assets?.eventImage,
            heroVideo: clientData.settings.theme_config?.assets?.heroVideo || defaultData.settings.theme_config?.assets?.heroVideo,
            videoUrl: clientData.settings.theme_config?.assets?.videoUrl || defaultData.settings.theme_config?.assets?.videoUrl
          },
          content: {
            ...defaultData.settings.theme_config?.content,
            ...(clientData.settings.theme_config?.content || {}),
            groomFatherName: 'Bapak Mempelai',
            groomMotherName: 'Ibu Mempelai',
            groomParents: 'Putra dari Bapak Mempelai & Ibu Mempelai',
            brideFatherName: 'Bapak Mempelai',
            brideMotherName: 'Ibu Mempelai',
            brideParents: 'Putri dari Bapak Mempelai & Ibu Mempelai',
            groomAddress: 'Denpasar, Bali',
            brideAddress: 'Gianyar, Bali',
            groomCity: 'Denpasar',
            brideCity: 'Gianyar',
            groomOrigin: 'Denpasar, Bali',
            brideOrigin: 'Gianyar, Bali',
            participantAddress: 'Denpasar, Bali',
            familyAddress: 'Gianyar, Bali',
            instagramUrl: 'https://www.instagram.com/senadda.id',
            groomInstagramUrl: 'https://www.instagram.com/senadda.id',
            brideInstagramUrl: 'https://www.instagram.com/senadda.id',
            groomIg: 'senadda.id',
            brideIg: 'senadda.id',
            participantInstagramUrl: 'https://www.instagram.com/senadda.id',
            participantIg: 'senadda.id'
          }
        }
      };

      let events = (clientData.events && clientData.events.length > 0)
        ? clientData.events.map((evt, idx) => ({
            ...evt,
            start_time: (evt.start_time && evt.start_time.trim() !== '')
              ? evt.start_time
              : (idx === 0 && clientData.events.length > 1 ? '09:00' : '18:00'),
            end_time: (evt.end_time && evt.end_time.trim() !== '')
              ? evt.end_time
              : (idx === 0 && clientData.events.length > 1 ? '11:00' : 'Selesai'),
            venue_name: defaultData.wedding.venue_name,
            venue_address: defaultData.wedding.venue_address,
            maps_url: defaultData.wedding.maps_url
          }))
        : defaultData.events;

      if (events.length === 1 && !['blush', 'deauville', 'allure', 'velvet'].includes(templateKey)) {
        const firstEvt = events[0];
        const isFirstResepsi = firstEvt.event_name.toLowerCase().includes('resepsi');
        const isHindu = /rgveda|veda|hindu|om swastyastu/i.test(
          `${clientData.settings.theme_config?.content?.verse || ''} ${clientData.settings.theme_config?.content?.verseSource || ''}`
        );
        const ceremonyName = (templateKey === 'allure' || templateKey === 'velvet') ? 'Akad Nikah' : (isHindu ? 'Pawiwahan' : 'Akad Nikah');
        const complementaryEvent = {
          id: 'event-complementary',
          wedding_id: `preview-${templateKey}`,
          event_name: isFirstResepsi ? ceremonyName : 'Resepsi',
          event_date: firstEvt.event_date || clientData.wedding.wedding_date,
          start_time: (templateKey === 'allure' || templateKey === 'velvet') ? '08:00' : (isFirstResepsi ? '09:00' : '18:00'),
          end_time: isFirstResepsi ? '11:00' : 'Selesai',
          venue_name: (templateKey === 'allure' || templateKey === 'velvet') ? 'KEDIAMAN MEMPELAI WANITA' : defaultData.wedding.venue_name,
          venue_address: (templateKey === 'allure' || templateKey === 'velvet') ? 'Ds Pagu, Wates, Kediri, Jawa Timur' : defaultData.wedding.venue_address,
          maps_url: defaultData.wedding.maps_url,
          sort_order: isFirstResepsi ? 0 : 2,
          created_at: now
        };
        events = isFirstResepsi ? [complementaryEvent, firstEvt] : [firstEvt, complementaryEvent];
      }
      if (['blush', 'deauville', 'allure', 'velvet'].includes(templateKey)) {
        events = events.slice(0, 1);
      }

      const EXCLUDED_PREVIEW_IMAGES: Record<string, string[]> = {
        lumiere: [
          'DMS01223.webp', 'DMS01226.webp', 'DMS01331.webp', 'DMS01449.webp',
          'DMS01151.webp', 'DMS01352.webp', 'DMS01413.webp', 'DMS01316.webp'
        ],
        allure: [
          'gallery-11.webp',
          'gallery-13.webp'
        ],
        velvet: [
          'gallery-11.webp',
          'gallery-13.webp'
        ]
      };
      const excludedImages = EXCLUDED_PREVIEW_IMAGES[templateKey] || [];
      const rawGallery = (clientData.gallery && clientData.gallery.length > 0)
        ? clientData.gallery
        : defaultData.gallery;

      const gallery = rawGallery.filter((item) => {
        const url = typeof item.image_url === 'string' ? item.image_url : (item.image_url as any)?.src || '';
        return !excludedImages.some((filename) => url.includes(filename));
      });

      // Selalu gunakan 1 rekening dummy untuk preview agar data pribadi rekening klien tidak terekspos
      const gifts = [
        {
          id: 'gift-1',
          wedding_id: `preview-${templateKey}`,
          bank_name: 'BCA',
          account_number: '0123 456 789',
          account_name: wedding.groom_name || defaultData.wedding.groom_name,
          qris_url: null,
          sort_order: 1,
          created_at: now
        }
      ];

      const wishes = (clientData.wishes && clientData.wishes.length > 0)
        ? clientData.wishes
        : defaultData.wishes;

      data = {
        wedding,
        settings,
        events,
        gallery,
        gifts,
        wishes
      };
    }
  } catch (err) {
    console.error(`Error loading client preview data for ${clientSlug}:`, err);
  }
}

const loadedTemplate = await loadTemplate(actualTemplateKey);
const ActiveTemplate = loadedTemplate.component as any;

if (!ActiveTemplate) {
  return new Response(`Template "${actualTemplateKey}" tidak ditemukan.`, { status: 404 });
}

const guestName = Astro.url.searchParams.get('to') || null;
---

<ActiveTemplate data={data} guestName={guestName} />
