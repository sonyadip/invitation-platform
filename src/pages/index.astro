      <dialog id="login-modal" class="login-modal">
        <div class="login-modal__backdrop" id="login-modal-close"></div>
        <div class="login-modal__content">
          <button class="login-modal__close-btn" id="login-modal-close-btn" aria-label="Tutup">
            <svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
          <div class="login-modal__header">
            <h2>Login</h2>
            <p>Masuk ke dashboard akun Anda.</p>
          </div>
          
          <form id="login-form-unified" class="login-modal__form" method="POST" action="/api/auth/login">
            <div class="form-group">
              <label for="username">Username</label>
              <input type="text" id="username" name="username" required placeholder="Masukkan username" />
            </div>
            <div class="form-group">
              <label for="password">Password</label>
              <input type="password" id="password" name="password" required placeholder="••••••••" />
            </div>
            <button type="submit" class="submit-btn">Login</button>
          </form>
        </div>
      </dialog>
    </main>

    <script>
      const loginBtn = document.getElementById("login-btn");
      const loginModal = document.getElementById("login-modal");
      const loginModalClose = document.getElementById("login-modal-close");
      const loginModalCloseBtn = document.getElementById("login-modal-close-btn");
      const loginFormUnified = document.getElementById("login-form-unified");

      if (loginBtn && loginModal && loginModalClose && loginModalCloseBtn) {
        loginBtn.addEventListener("click", () => {
          loginModal.setAttribute("open", "true");
          document.body.style.overflow = "hidden";
        });

        const closeModal = () => {
          loginModal.removeAttribute("open");
          document.body.style.overflow = "";
        };

        loginModalClose.addEventListener("click", closeModal);
        loginModalCloseBtn.addEventListener("click", closeModal);
      }
      
      if (loginFormUnified) {
        // Handle auto-open for ?login=admin or ?login=client
        const urlParams = new URLSearchParams(window.location.search);
        const loginType = urlParams.get('login');
        if (loginType === 'admin' || loginType === 'client') {
          loginBtn.click();
          if (loginType === 'admin') {
            document.getElementById("username").value = "admin";
          }
          
          if (urlParams.get('error') === '1') {
            if (!document.getElementById("admin-error")) {
              const errorMsg = document.createElement("p");
              errorMsg.id = "admin-error";
              errorMsg.style.color = "#b91c1c";
              errorMsg.style.fontSize = "13px";
              errorMsg.style.marginTop = "0.5rem";
              errorMsg.innerText = "Username atau Password salah.";
              loginFormUnified.insertBefore(errorMsg, loginFormUnified.querySelector(".submit-btn"));
            }
          }
        }
      }
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo({ top: 0, left: 0, behavior: "auto" });

      const sections = document.querySelectorAll("[data-section]");
      const parallaxItems = document.querySelectorAll("[data-parallax]");
      const heroSection = document.querySelector(".hero-shell");
      const heroPlaceholder = document.querySelector(".hero-shell-placeholder");
      const heroMotionCards = Array.from(
        document.querySelectorAll("[data-hero-motion-card]"),
      );
      const anchorLinks = document.querySelectorAll('a[href^="#"]');

      const heroRevealDuration = 3600;
      const heroRevealInterval = 6000;
      const heroIntroRevealDuration = 650;
      const heroIntroRevealInterval = 820;

      const introEnterDuration = 1100;
      const introHoldDuration = 700;
      const introRingShrinkDuration = 1500;
      const introExitDuration = 1250;
      const introTotalDuration =
        introEnterDuration +
        introHoldDuration +
        introRingShrinkDuration +
        introExitDuration;
      const postIntroRevealDelay = 1800;

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      let lastScrollY = 0;
      let activeHeroMotionCard = 0;
      let isHeroMotionAnimating = false;

      const isIntroScrollLocked = () =>
        document.documentElement.classList.contains("intro-scroll-lock");

      const keepIntroAtTop = (event) => {
        if (!isIntroScrollLocked()) return;
        event?.preventDefault();
        window.scrollTo({ top: 0, left: 0, behavior: "auto" });
      };

      window.addEventListener("pageshow", () => keepIntroAtTop());
      window.addEventListener("wheel", keepIntroAtTop, {
        passive: false,
      });
      window.addEventListener("touchmove", keepIntroAtTop, {
        passive: false,
      });
      window.addEventListener(
        "keydown",
        (event) => {
          if (
            [
              " ",
              "ArrowDown",
              "ArrowUp",
              "PageDown",
              "PageUp",
              "Home",
              "End",
            ].includes(event.key)
          ) {
            keepIntroAtTop(event);
          }
        },
        { passive: false },
      );

      const completeIntro = () => {
        document.body.classList.remove(
          "intro-enter",
          "intro-hold",
          "intro-ring-shrink",
          "intro-exit",
        );
        document.body.classList.add("intro-complete");
        document.documentElement.classList.remove("intro-scroll-lock");
        window.scrollTo({ top: 0, left: 0, behavior: "auto" });
        lastScrollY = 0;
        setScrollState();
      };

      const syncHeroFixed = () => {
        if (
          !(heroSection instanceof HTMLElement) ||
          !(heroPlaceholder instanceof HTMLElement)
        )
          return;

        heroSection.classList.remove("hero-shell--fixed");
        heroPlaceholder.style.height = "";

        if (window.innerWidth >= 768) {
          heroPlaceholder.style.height = `${window.innerHeight * 2}px`;
          heroSection.classList.add("hero-shell--fixed");
        }
      };

      const setScrollState = () => {
        const currentScrollY = window.scrollY;
        const heroHidePoint =
          (heroSection?.clientHeight || window.innerHeight) * 0.6;
        const heroProgress = Math.min(currentScrollY / window.innerHeight, 1);

        const isScrollingDown =
          currentScrollY > lastScrollY && currentScrollY > heroHidePoint;

        heroSection?.style.setProperty("--hero-scroll", String(heroProgress));
        document.body.classList.toggle("nav-hidden", isScrollingDown);
        document.body.classList.toggle("has-scrolled", currentScrollY > 8);
        lastScrollY = Math.max(currentScrollY, 0);

        parallaxItems.forEach((item) => {
          const rect = item.getBoundingClientRect();
          const centerOffset =
            (rect.top + rect.height / 2 - window.innerHeight / 2) /
            window.innerHeight;
          item.style.setProperty("--shift", `${centerOffset * -42}px`);
        });
      };

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
      );

      const elementsToObserve = document.querySelectorAll(".section-observe, .reveal-blur, .template-card, .feature-item");
      elementsToObserve.forEach((el) => revealObserver.observe(el));

      const scrollToTarget = (targetId) => {
        const target = document.querySelector(targetId);
        if (!target) return;
        document.body.classList.remove("nav-hidden");
        target.classList.add("is-visible");

        requestAnimationFrame(() => {
          target.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
          window.setTimeout(
            () =>
              target.scrollIntoView({
                behavior: "smooth",
                block: "start",
              }),
            1000,
          );
        });
      };

      anchorLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          const targetId = link.getAttribute("href");
          if (!targetId || targetId === "#") return;
          event.preventDefault();
          history.pushState(null, "", targetId);
          scrollToTarget(targetId);
        });
      });

      const revealNextHeroMotionCard = (duration = heroRevealDuration) => {
        if (heroMotionCards.length <= 1 || isHeroMotionAnimating) return;

        const previous = heroMotionCards[activeHeroMotionCard];
        activeHeroMotionCard =
          (activeHeroMotionCard + 1) % heroMotionCards.length;
        const next = heroMotionCards[activeHeroMotionCard];

        if (!previous || !next) return;
        isHeroMotionAnimating = true;

        previous.classList.remove("is-revealing");
        next.classList.add("is-next");
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            next.classList.add("is-revealing");
          });
        });

        const completeReveal = () => {
          previous.classList.remove("is-active", "is-revealing");
          next.classList.remove("is-next");
          next.classList.add("is-active", "is-revealing");
          isHeroMotionAnimating = false;
        };
        window.setTimeout(completeReveal, duration);
      };

      if (heroMotionCards.length > 1) {
        let introRevealTimer = 0;
        const startNormalHeroReveal = () => {
          window.setTimeout(() => {
            revealNextHeroMotionCard(heroRevealDuration);
            window.setInterval(
              () => revealNextHeroMotionCard(heroRevealDuration),
              heroRevealInterval,
            );
          }, postIntroRevealDelay);
        };

        if (!reduceMotion) {
          window.setTimeout(() => {
            revealNextHeroMotionCard(heroIntroRevealDuration);
            introRevealTimer = window.setInterval(
              () => revealNextHeroMotionCard(heroIntroRevealDuration),
              heroIntroRevealInterval,
            );
          }, 260);

          window.setTimeout(
            () => window.clearInterval(introRevealTimer),
            introEnterDuration + introHoldDuration - 120,
          );
        }
        window.setTimeout(
          startNormalHeroReveal,
          reduceMotion ? 0 : introTotalDuration,
        );
      }

      sections.forEach((section) => revealObserver.observe(section));

      if (reduceMotion) {
        completeIntro();
      } else {
        window.setTimeout(() => {
          document.body.classList.remove("intro-enter");
          document.body.classList.add("intro-hold");
        }, introEnterDuration);

        window.setTimeout(() => {
          document.body.classList.remove("intro-hold");
          document.body.classList.add("intro-ring-shrink");
        }, introEnterDuration + introHoldDuration);

        window.setTimeout(
          () => {
            document.body.classList.remove("intro-ring-shrink");
            document.body.classList.add("intro-exit");
          },
          introEnterDuration + introHoldDuration + introRingShrinkDuration,
        );

        window.setTimeout(() => {
          completeIntro();
        }, introTotalDuration);
      }

      syncHeroFixed();
      setScrollState();
      window.addEventListener("scroll", setScrollState, {
        passive: true,
      });
      window.addEventListener("resize", () => {
        syncHeroFixed();
        setScrollState();
      });

      /* Dashboard tabs — segmented control */
      (() => {
        const nav = document.querySelector('.dashboard-tabs__nav');
        if (!nav) return;
        const indicator = nav.querySelector('.dashboard-tabs__indicator');
        const btns = nav.querySelectorAll('.dashboard-tabs__btn');

        const moveIndicator = (btn) => {
          const navPad = parseFloat(getComputedStyle(nav).paddingLeft);
          indicator.style.width = btn.offsetWidth + 'px';
          indicator.style.left = (btn.offsetLeft) + 'px';
        };

        // init on next frame so layout is settled
        requestAnimationFrame(() => {
          const activeBtn = nav.querySelector('.dashboard-tabs__btn.is-active');
          if (activeBtn) moveIndicator(activeBtn);
        });

        btns.forEach(btn => {
          btn.addEventListener('click', () => {
            const tab = btn.dataset.tab;
            btns.forEach(b => b.classList.remove('is-active'));
            document.querySelectorAll('.dashboard-tabs__panel').forEach(p => p.classList.remove('is-active'));
            btn.classList.add('is-active');
            document.querySelector(`[data-panel="${tab}"]`).classList.add('is-active');
            moveIndicator(btn);
          });
        });

        window.addEventListener('resize', () => {
          const cur = nav.querySelector('.dashboard-tabs__btn.is-active');
          if (cur) moveIndicator(cur);
        });
      })();
    </script>
  </body>
</html>

