---
export const prerender = false;
Astro.response.headers.set('Link', '</llms.txt>; rel="describedby"');

import airCover from "../templates/air/assets/cover.webp";
import deauvilleCover from "../templates/deauville/assets/cover.webp";
import ivoryCover from "../templates/ivory/assets/bg-hero.webp";
import noirCover from "../templates/noir/assets/cover.webp";
import ochreMotionCover from "../templates/ochre/assets/gallery-8.webp";
import sageCover from "../templates/sage/assets/bg-hero.webp";
import editorialCover from "../templates/editorial/assets/cover.webp";
import lumiereCover from "../templates/lumiere/assets/cover.webp";
import { getPlatformSettings } from "../services/platform-settings";

const siteSettings = await getPlatformSettings();
const bookingUrl = siteSettings.whatsapp_url || "https://wa.me/6281234567890";

const navItems = [
  ["Koleksi", "#templates"],
  ["Fitur", "#features"],
  ["Konsultasi", "#booking"],
];

const headingWords = [
  siteSettings.home_heading_1 || "Undangan",
  siteSettings.home_heading_2 || "Pernikahan",
  siteSettings.home_heading_3 || "Digital",
];

const imageMap: Record<string, string> = {
  lumiere: lumiereCover.src,
  deauville: deauvilleCover.src,
  air: airCover.src,
  editorial: editorialCover.src,
  noir: noirCover.src,
  sage: sageCover.src,
  ochre: ochreMotionCover.src,
  ivory: ivoryCover.src
};

const defaultTemplateCards = [
  { key: "lumiere", name: "Lumiere", price: "Rp 200.000", image: lumiereCover.src },
  { key: "deauville", name: "Deauville", price: "Rp 175.000", image: deauvilleCover.src },
  { key: "editorial", name: "Editorial", price: "Rp 175.000", image: editorialCover.src },
  { key: "air", name: "Air", price: "Rp 125.000", image: airCover.src },
  { key: "noir", name: "Noir", price: "Rp 125.000", image: noirCover.src },
];

const templateCards = (siteSettings.home_template_cards && siteSettings.home_template_cards.length > 0)
  ? siteSettings.home_template_cards.map((c: any) => ({
      ...c,
      image: c.image || imageMap[c.key] || ''
    }))
  : defaultTemplateCards;

const stats = [
  [siteSettings.home_stat_number || `${templateCards.length}+`, siteSettings.home_stat_label || "Koleksi\nEksklusif"],
  // ["24J", "Proses\nPengerjaan"],
];

const heroMotionCards = templateCards;

const features = [
  "Tamu Tanpa Batas",
  "RSVP & Ucapan",
  "Amplop Digital",
  "Navigasi Maps",
  "Total 12 Foto",
  "Musik Latar",
  "Hitung Mundur",
  "Kisah Cinta",
  "Total 1 Video",
  "Simpan Kalender",
  "Link Instagram",
  "Aktif 1 Bulan",
  "Dashboard Analytics",
  "Export Data Tamu",
];

const addons = [
  { name: "Prioritas 24 jam", price: "+ 50.000" },
  { name: "Tambah Foto", price: "+ 5.000 / foto" },
  { name: "Tambah Video", price: "+ 20.000 / video" },
];
---

<!doctype html>
<html lang="id" class="intro-scroll-lock">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{siteSettings.meta_title || "Senadda - Undangan Pernikahan Digital"}</title>
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="title" content={siteSettings.meta_title || "Senadda - Undangan Pernikahan Digital"} />
    <meta name="description" content={siteSettings.meta_description || "Bagikan momen bahagia Anda lewat undangan pernikahan digital yang elegan, tanpa batas jarak dan waktu."} />
    <meta name="keywords" content="undangan digital, undangan pernikahan online, senadda, senadda.id, wedding invitation, platform undangan, undangan digital pernikahan, undangan pernikahan digital" />
    <meta name="author" content="Senadda" />
    <link rel="canonical" href="https://senadda.id/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://senadda.id/" />
    <meta property="og:title" content={siteSettings.meta_title || "Senadda - Undangan Pernikahan Digital"} />
    <meta property="og:description" content={siteSettings.meta_description || "Bagikan momen bahagia Anda lewat undangan pernikahan digital yang elegan, tanpa batas jarak dan waktu."} />
    <meta property="og:image" content={siteSettings.logo_url || "https://senadda.id/images/senadda-logo.png"} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://senadda.id/" />
    <meta property="twitter:title" content={siteSettings.meta_title || "Senadda - Undangan Pernikahan Digital"} />
    <meta property="twitter:description" content={siteSettings.meta_description || "Bagikan momen bahagia Anda lewat undangan pernikahan digital yang elegan, tanpa batas jarak dan waktu."} />
    <meta property="twitter:image" content={siteSettings.logo_url || "https://senadda.id/images/senadda-logo.png"} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://db.onlinewebfonts.com/c/4c4c08af466e9ad071b6d69cf44093df?family=SaolDisplay-Regular"
      rel="stylesheet"
    />
  </head>
  <body id="top" class="intro-enter">
    <div class="intro-animation" data-intro aria-hidden="true"></div>

    <main>
      <nav class="hero-nav" aria-label="Navigasi utama">
        <a
          class="brand-logo motion-down"
          style="--i: 0"
          href="#top"
          aria-label="Kembali ke atas"
        >
          <img
            src={siteSettings.logo_url || "/images/senadda-logo.png"}
            alt={siteSettings.site_name + " Logo"}
            class="brand-logo__image"
          />
        </a>

        <div class="nav-links" aria-label="Menu desktop">
          {
            navItems.map(([label, href], index) => (
              <a class="motion-down" style={`--i: ${index + 1}`} href={href}>
                {label}
              </a>
            ))
          }
        </div>

        <button
          class="nav-action motion-down"
          style="--i: 4"
          id="login-btn"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          Login
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
        </button>
      </nav>

      <div class="hero-shell-placeholder" aria-hidden="true"></div>

      <section class="hero-shell section-observe is-visible" data-section>
        <div class="hero-sticky">
          <div class="hero-motion-wrap" aria-hidden="true">
            <div class="hero-motion">
              {
                heroMotionCards.map((template, index) => (
                  <figure
                    class={`hero-motion__card${index === 0 ? " is-active" : ""}`}
                    data-hero-motion-card
                  >
                    <img
                      src={template.image}
                      alt=""
                      loading={index === 0 ? "eager" : "lazy"}
                    />
                  </figure>
                ))
              }
            </div>

            <div class="hero-motion-seal">
              <svg viewBox="0 0 120 120">
                <defs>
                  <path
                    id="hero-motion-seal-path"
                    d="M60 60 m -43 0 a 43 43 0 1 1 86 0 a 43 43 0 1 1 -86 0"
                  ></path>
                </defs>
                <text>
                  <textPath href="#hero-motion-seal-path" startOffset="0%">
                    {siteSettings.home_hero_seal_text || "SENADDA • DIGITAL STUDIO • UNDANGAN •"}
                  </textPath>
                </text>
              </svg>
            </div>
          </div>

          <div class="stats-row" aria-label="Statistik platform">
            <div class="stats-row__inner">
              {
                stats.map(([number, label], index) => (
                  <div class="stat-item motion-up" style={`--i: ${index + 2}`}>
                    <strong>
                      <span>+</span>
                      {number}
                    </strong>
                    <p>{label}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="bottom-content" aria-label="Hero content">
            <div class="bottom-content__top">
              <a class="hero-cta motion-up" style="--i: 6" href="#templates">
                {siteSettings.home_cta_label || "Lihat Koleksi"}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M8 7h9v9"></path>
                </svg>
              </a>
            </div>

            <div class="bottom-content__main">
              <p class="description motion-up" style="--i: 7">
                {siteSettings.home_description || "Bagikan momen bahagia Anda lewat undangan digital yang elegan, tanpa batas jarak dan waktu."}
              </p>
              <h1 aria-label={headingWords.join(' ')}>
                {
                  headingWords.map((word, index) => (
                    <span class="heading-mask">
                      <span class="heading-word" style={`--word-i: ${index}`}>
                        {word}
                      </span>
                    </span>
                  ))
                }
              </h1>
            </div>
          </div>
        </div>
      </section>

      <section
        class="template-list section-observe"
        id="templates"
        data-section
      >
        <div class="section-heading">
          <p>{siteSettings.home_templates_eyebrow || "Koleksi Desain"}</p>
          <h2>{siteSettings.home_templates_heading || "Pilih Nuansa."}</h2>
        </div>

        <div class="template-grid">
          {
            templateCards.map((template, index) => (
              <article class="template-card" style={`--template-i: ${index}`}>
                <div class="template-card__media">
                  <img
                    src={template.image}
                    alt={`Preview template ${template.name}`}
                    loading="lazy"
                  />
                </div>
                <div class="template-card__body">
                  <div class="template-card__meta">
                    <strong>{template.name}</strong>
                    <span class="template-card__price">{template.price}</span>
                  </div>
                  <div class="template-card__actions">
                    <a
                      href={`/preview/${template.key}`}
                      target="_blank"
                      rel="noreferrer"
                    >
                      Preview
                    </a>
                    <a href={bookingUrl} target="_blank" rel="noreferrer">
                      Pesan
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="dashboard-showcase section-observe"
        id="dashboard"
        data-section
      >
        <div class="section-heading-centered reveal-blur">
          <p style="color: var(--accent); font-size: 11px; margin-bottom: 6px;">Dashboard</p>
          <h2 style="color: var(--black);">Kelola Undanganmu.</h2>
        </div>

        <div class="dashboard-tabs">
          <div class="dashboard-tabs__nav">
            <span class="dashboard-tabs__indicator"></span>
            <button class="dashboard-tabs__btn is-active" data-tab="home">
              <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Dashboard
            </button>
            <button class="dashboard-tabs__btn" data-tab="kirim">
              <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Kirim Undangan
            </button>
            <button class="dashboard-tabs__btn" data-tab="rsvp">
              <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              RSVP
            </button>
          </div>

          <div class="dashboard-tabs__panels">
            <div class="dashboard-tabs__panel is-active" data-panel="home">
              <div class="dashboard-tabs__screenshot">
                <img src="/images/dashboard/dashboard-home.png" alt="Dashboard Home" loading="eager" />
              </div>
              <div class="dashboard-tabs__info">
                <h3>Pantau Semuanya</h3>
                <p>Lihat ringkasan lengkap undangan: statistik RSVP, jumlah tamu, countdown hari H, rangkaian acara, dan ucapan terbaru dalam satu halaman.</p>
              </div>
            </div>

            <div class="dashboard-tabs__panel" data-panel="kirim">
              <div class="dashboard-tabs__screenshot">
                <img src="/images/dashboard/dashboard-kirim.png" alt="Kirim Undangan" loading="eager" />
              </div>
              <div class="dashboard-tabs__info">
                <h3>Kirim dengan Mudah</h3>
                <p>Pilih template pesan sesuai nada (Formal, Teman, Keluarga), kelola daftar tamu, dan kirim undangan langsung via WhatsApp. Satu klik, langsung terkirim.</p>
              </div>
            </div>

            <div class="dashboard-tabs__panel" data-panel="rsvp">
              <div class="dashboard-tabs__screenshot">
                <img src="/images/dashboard/dashboard-rsvp.png" alt="RSVP" loading="eager" />
              </div>
              <div class="dashboard-tabs__info">
                <h3>Lacak Kehadiran</h3>
                <p>Ringkasan RSVP real-time: siapa yang hadir, berapa total pax, filter berdasarkan status, dan export data tamu kapan saja.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        class="features-list section-observe"
        id="features"
        data-section
      >
        <div class="features-container">
          <div class="section-heading-centered reveal-blur">
            <h2>Features</h2>
          </div>

          <ul class="features-grid-simple">
            {
              features.map((feature, index) => (
                <li class="feature-item dark-item" style={`--feature-i: ${index}`}>
                  <div class="addon-left">
                    <svg viewBox="0 0 24 24" class="check-box-icon" fill="none" stroke="currentColor">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                      <path d="M9 12l2 2 4-4" />
                    </svg>
                    {feature}
                  </div>
                </li>
              ))
            }
          </ul>

          <div class="section-heading-centered reveal-blur" style="margin-top: 60px;">
            <h2>Addon</h2>
          </div>

          <ul class="addon-list">
            {
              addons.map((addon, index) => (
                <li class="feature-item dark-item" style={`--feature-i: ${index + features.length}`}>
                  <div class="addon-left">
                    <svg viewBox="0 0 24 24" class="check-box-icon" fill="none" stroke="currentColor">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    </svg>
                    {addon.name}
                  </div>
                  <span class="addon-price">{addon.price}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="faq-section section-observe" id="faq" data-section>
        <div class="faq-section-inner">
          <div class="section-heading-centered reveal-blur" style="margin-bottom: 50px;">
            <h2 style="color: var(--black);">FAQ</h2>
          </div>
        
        <style>
        /* =========================================
           -1. RESPONSIVE SECTION PADDING
           ========================================= */
        /* =========================================
           -1. RESPONSIVE SECTION PADDING
           ========================================= */
        .faq-section {
            background-color: var(--white);
            position: relative;
            z-index: 2;
            padding: 110px 20px;
        }
        .faq-section-inner {
            max-width: 1000px;
            margin: 0 auto;
        }
        @media (min-width: 768px) {
            .faq-section {
                padding: 120px 48px;
            }
        }
        @media (max-width: 640px) {
            .faq-section {
                padding: 60px 16px;
            }
        }

        /* =========================================
           0. RESET BOX SIZING
           ========================================= */
        .faq-container,
        .faq-container *,
        .faq-container *::before,
        .faq-container *::after {
            box-sizing: border-box !important;
        }

        /* =========================================
           1. FAQ WRAPPER (Grid Fisik 2 Kolom)
           ========================================= */
        .faq-container {
            width: 100%;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr; /* Mobile: Tumpuk ke bawah */
            gap: 16px;
        }

        @media (min-width: 768px) {
            .faq-container {
                grid-template-columns: repeat(2, 1fr); /* Desktop: 2 Kolom terpisah */
                align-items: start; /* PENTING: Mencegah kolom melar mengikuti sebelah */
            }
        }

        /* Pembungkus spesifik tiap kolom */
        .faq-col {
            display: flex;
            flex-direction: column;
            gap: 16px; /* Jarak atas-bawah antar FAQ */
        }

        /* =========================================
           2. FAQ ITEM BOX
           ========================================= */
        .faq-item {
            background-color: var(--white) !important; 
            border: 1px solid var(--line) !important; 
            border-radius: 6px;
            overflow: hidden;
            transition: border-color 0.3s var(--ease), opacity 1s var(--ease), transform 1.1s var(--ease), filter 1s var(--ease);
            width: 100%;
        }

        .faq-item:hover {
            border-color: var(--accent) !important;
        }

        .faq-item.active {
            border-color: var(--accent) !important; 
            box-shadow: 0 10px 30px rgba(23, 22, 15, 0.05) !important;
        }

        /* =========================================
           3. TOMBOL PERTANYAAN
           ========================================= */
        .faq-btn {
            width: 100%;
            text-align: left;
            background: transparent !important; 
            border: none !important;
            padding: 24px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            cursor: pointer;
            outline: none !important; 
            box-shadow: none !important;
            -webkit-tap-highlight-color: transparent !important;
        }

        .faq-btn:focus,
        .faq-btn:active {
            outline: none !important;
            background: transparent !important;
        }

        .faq-question {
            font-family: var(--font-body) !important;
            font-size: 18px !important;
            font-weight: 500 !important;
            color: var(--black) !important; 
            margin: 0 !important;
            padding-right: 15px;
            line-height: 1.4 !important;
            transition: color 0.3s var(--ease);
            flex: 1 1 auto !important; 
            white-space: normal !important;
            word-wrap: break-word !important; 
            word-break: break-word !important;
            min-width: 0 !important;
        }

        /* Ikon Animasi Plus/Minus */
        .faq-icon {
            position: relative;
            width: 24px;
            height: 24px;
            flex-shrink: 0;
            margin-top: 2px;
        }
        .faq-icon::before,
        .faq-icon::after {
            content: '';
            position: absolute;
            background-color: var(--black) !important; 
            transition: transform 0.4s var(--ease), background-color 0.4s var(--ease);
        }
        .faq-icon::before { top: 11px; left: 4px; right: 4px; height: 2px; }
        .faq-icon::after { top: 4px; bottom: 4px; left: 11px; width: 2px; }

        .faq-item.active .faq-icon::after {
            transform: rotate(90deg);
            background-color: var(--accent) !important;
        }
        .faq-item.active .faq-icon::before {
            background-color: var(--accent) !important;
        }

        /* =========================================
           4. AREA JAWABAN
           ========================================= */
        .faq-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s var(--ease);
        }

        .faq-answer {
            font-family: var(--font-body) !important;
            font-size: 15px !important;
            color: var(--deep-charcoal) !important; 
            line-height: 1.7 !important;
            margin: 0 !important;
            padding: 0 24px 24px 24px !important; 
        }

        /* =========================================
           5. RESPONSIVE MOBILE
           ========================================= */
        @media (max-width: 767px) {
            .faq-btn { padding: 20px 16px; }
            .faq-question { font-size: 16px !important; line-height: 1.5 !important; }
            .faq-answer { font-size: 14px !important; padding: 0 16px 20px 16px !important; }
        }
        </style>

        <div class="faq-container">
            <div class="faq-col">
                <div class="faq-item reveal-blur">
                    <button class="faq-btn">
                        <h3 class="faq-question">Waktu Pengerjaan Undangan</h3>
                        <span class="faq-icon"></span>
                    </button>
                    <div class="faq-content" style="">
                        <p class="faq-answer">Proses pembuatan biasanya memakan waktu 3 hari setelah semua data dan foto kami terima dengan lengkap.</p>
                    </div>
                </div>
                <div class="faq-item reveal-blur">
                    <button class="faq-btn">
                        <h3 class="faq-question">Pengganti Video Background</h3>
                        <span class="faq-icon"></span>
                    </button>
                    <div class="faq-content">
                        <p class="faq-answer">Jika template memiliki background video tapi Anda tidak punya video, kami bisa menggantinya dengan fitur image slider (slideshow) yang akan memutar foto-foto Anda secara bergantian.</p>
                    </div>
                </div>
                <div class="faq-item reveal-blur">
                    <button class="faq-btn">
                        <h3 class="faq-question">Fasilitas Revisi Minor</h3>
                        <span class="faq-icon"></span>
                    </button>
                    <div class="faq-content">
                        <p class="faq-answer">Kami memberikan fasilitas revisi minor sepuasnya. Ini berlaku untuk perbaikan typo nama, ganti lagu, ganti foto, ganti quotes, penyesuaian lokasi, hingga menghapus section tertentu.</p>
                    </div>
                </div>
                <div class="faq-item reveal-blur">
                    <button class="faq-btn">
                        <h3 class="faq-question">Fasilitas Revisi Mayor</h3>
                        <span class="faq-icon"></span>
                    </button>
                    <div class="faq-content">
                        <p class="faq-answer">Untuk revisi mayor, kami sediakan jatah satu kali. Perlu dicatat, Anda tidak bisa mengganti tema undangan, tapi Anda diperbolehkan merombak ulang posisi atau susunan section-nya.</p>
                    </div>
                </div>
                <div class="faq-item reveal-blur">
                    <button class="faq-btn">
                        <h3 class="faq-question">Masa Aktif Tautan Undangan</h3>
                        <span class="faq-icon"></span>
                    </button>
                    <div class="faq-content">
                        <p class="faq-answer">Link undangan akan tetap aktif sampai satu bulan setelah acara selesai, jadi Anda masih punya banyak waktu untuk membaca ulang ucapan-ucapan dari para tamu.</p>
                    </div>
                </div>
            </div>

            <div class="faq-col">
                <div class="faq-item reveal-blur">
                    <button class="faq-btn">
                        <h3 class="faq-question">Cara Membagikan Undangan</h3>
                        <span class="faq-icon"></span>
                    </button>
                    <div class="faq-content">
                        <p class="faq-answer">Anda akan mendapat akses dashboard khusus untuk memasukkan daftar nama tamu. Dari situ, sistem bisa langsung men-generate link unik per orang untuk Anda sebar via WhatsApp.</p>
                    </div>
                </div>
                <div class="faq-item reveal-blur">
