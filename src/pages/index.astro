<script>
  if ('modelContext' in navigator) {
    const controller = new AbortController();
    
    // The WebMCP API is evolving, so we check for both provideContext and registerTool
    if (typeof (navigator as any).modelContext.provideContext === 'function') {
      (navigator as any).modelContext.provideContext({
        tools: [
          {
            name: "get_templates",
            description: "Get a list of available wedding invitation templates",
            inputSchema: { type: "object", properties: {} },
            execute: async () => {
              return { success: true, templates: ["Lumiere", "Deauville", "Air", "Editorial", "Noir"] };
            }
          }
        ]
      }, { signal: controller.signal });
    } else if (typeof (navigator as any).modelContext.registerTool === 'function') {
      (navigator as any).modelContext.registerTool({
        name: "get_templates",
        description: "Get a list of available wedding invitation templates",
        inputSchema: { type: "object", properties: {} },
        execute: async () => {
          return { success: true, templates: ["Lumiere", "Deauville", "Air", "Editorial", "Noir"] };
        }
      }, { signal: controller.signal });
    }
  }
</script>
