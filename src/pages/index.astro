  .hero-motion {
    position: absolute;
    inset: 0;
    overflow: hidden;
    box-shadow: 0 30px 90px rgba(44, 18, 85, 0.16);
  }

  .hero-motion__card {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--soft-parchment);
    clip-path: inset(0 0 100% 0);
    transition: clip-path var(--hero-reveal-duration, 3600ms)
      cubic-bezier(0.76, 0, 0.24, 1);
    will-change: clip-path;
  }
  .hero-motion__card.is-active {
    z-index: 2;
    clip-path: inset(0 0 0 0);
  }
  .hero-motion__card.is-next {
    z-index: 3;
    clip-path: inset(0 0 100% 0);
  }
  .hero-motion__card.is-next.is-revealing {
    clip-path: inset(0 0 0 0);
  }

  .hero-motion__card img {
    --hero-image-parallax: calc(var(--hero-scroll) * -42px);
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.04);
    transform: translate3d(0, var(--hero-image-parallax), 0) scale(1.05);
    transition: transform 0.12s linear;
    will-change: transform;
  }

  .hero-motion-seal {
    --seal-size: 104px;
    position: absolute;
    top: -32px;
    left: -52px;
    z-index: 3;
    display: grid;
    width: var(--seal-size);
    height: var(--seal-size);
    place-items: center;
    border-radius: 999px;
    color: var(--accent);
    pointer-events: none;
    transform: translate3d(0, 0, 0);
    transition:
      top 1.25s cubic-bezier(0.76, 0, 0.24, 1),
      left 1.25s cubic-bezier(0.76, 0, 0.24, 1),
      width 1.5s cubic-bezier(0.76, 0, 0.24, 1),
      height 1.5s cubic-bezier(0.76, 0, 0.24, 1),
      transform 1.25s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: top, left, width, height, transform;
  }

  body.intro-enter .hero-motion-seal,
  body.intro-hold .hero-motion-seal {
    --seal-size: 780px;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
  }
  body.intro-ring-shrink .hero-motion-seal {
    --seal-size: 320px;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
  }
  body.intro-exit .hero-motion-seal {
    z-index: 4;
  }

  .hero-motion-seal svg {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    animation: sealRotate 12s linear infinite;
  }

  .hero-motion-seal text {
    fill: currentColor;
    font-size: 10px;
    letter-spacing: 0.22em;
  }

  .hero-sticky::before {
    position: absolute;
    inset: 0;
    z-index: 1000;
    content: "";
    pointer-events: none;
  }

  .hero-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 12px;
    background: linear-gradient(
      180deg,
      rgba(247, 245, 234, 0.9),
      rgba(247, 245, 234, 0)
    );
    backdrop-filter: blur(14px);
    transition:
      opacity 0.28s ease,
      transform 0.28s ease,
      background 0.28s ease;
    will-change: transform, opacity;
  }
  .nav-hidden .hero-nav {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 20px;
    margin-top: 5px;
    transition: transform 0.3s ease;
  }

  .brand-logo__image {
    height: 100%;
    width: auto;
    object-fit: contain;
    /* Elegant floating motion aligned with UX skill recommendations */
    animation: floatElegantly 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    transform-origin: center;
    transition: transform 0.4s var(--ease-soft);
  }

  .brand-logo:hover .brand-logo__image {
    animation-play-state: paused;
    transform: scale(0.95);
  }

  @keyframes floatElegantly {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  .has-scrolled .brand-logo {
    transform: scale(0.85);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 36px;
    font-size: 13px;
    letter-spacing: 0.14em;
  }

  .nav-links a,
  .hero-cta,
  .nav-action {
    transition:
      opacity 0.22s ease,
      color 0.22s ease;
  }
  .nav-links a:hover,
  .nav-action:hover {
    opacity: 0.62;
  }

  .nav-action {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    font-size: 11px;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }
  .nav-action svg {
    width: 14px;
    height: 14px;
  }

  .stats-row {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    padding: 32px 20px;
  }
  .stats-row__inner {
    display: flex;
    justify-content: flex-end;
    gap: 20px;
    text-align: right;
  }

  .stat-item {
    display: grid;
    gap: 8px;
    justify-items: end;
  }
  .stat-item strong {
    display: flex;
    align-items: flex-start;
    gap: 1px;
    font-size: clamp(1.5rem, 5vw, 3.5rem);
    letter-spacing: 0;
  }
  .stat-item strong span {
    color: var(--accent);
    font-size: 0.5em;
    line-height: 1.15;
  }
  .stat-item p {
    font-size: 10px;
    line-height: 1.15;
    max-width: 60%;
  }

  .bottom-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 0 20px 32px;
  }
  .bottom-content__top,
  .bottom-content__main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .bottom-content__main {
    align-items: flex-end;
    gap: 12px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-size: 16px;
    white-space: nowrap;
    margin-left: auto;
  }
  .hero-cta svg {
    width: 18px;
    height: 18px;
  }

  .description {
    width: 120px;
    flex: 0 0 auto;
    font-size: 9px;
    line-height: 1.3;
    text-align: left;
  }

  h1 {
    display: grid;
    justify-items: end;
    font-family: var(--font-heading);
    font-size: clamp(42px, 7vw, 110px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.0;
    text-align: right;
  }

  .heading-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.25em;
    margin-bottom: -0.25em;
    padding-top: 0.1em;
    margin-top: -0.1em;
  }
  .heading-word {
    display: block;
    transform: translateY(140%);
  }

  .motion-down {
    opacity: 0;
    transform: translateY(-20px);
  }
  .motion-up {
    opacity: 0;
    transform: translateY(32px);
  }

  .intro-complete .heading-word {
    animation: headingIn 0.7s var(--ease) forwards;
    animation-delay: calc(0.28s + (var(--word-i) * 0.1s));
  }
  .intro-complete .motion-down {
    animation: fadeDown 0.5s var(--ease) forwards;
    animation-delay: calc(0.22s + (var(--i) * 0.07s));
  }
  .intro-complete .motion-up {
    animation: fadeUp 0.6s var(--ease) forwards;
    animation-delay: calc(0.3s + (var(--i) * 0.08s));
  }

  .template-list {
    position: relative;
    z-index: 2;
    display: grid;
    margin-top: -100svh;
    gap: 42px;
    padding: 110px 20px 90px;
    background: var(--white);
    scroll-margin-top: 84px;
  }

  .section-heading {
    display: grid;
    gap: 10px;
    max-width: 1120px;
    opacity: 0;
    transform: translateY(34px);
    transition:
      opacity 1s var(--ease),
      transform 1.1s var(--ease);
  }
  .is-visible .section-heading {
    opacity: 1;
    transform: translateY(0);
  }
  .section-heading p,
  .booking-cta__inner p {
    color: var(--accent);
    font-size: 11px;
    line-height: 1.3;
  }
  .section-heading h2,
  .booking-cta__inner h2 {
    max-width: 980px;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(48px, 7vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .section-heading span,
  .booking-cta__actions span {
    max-width: 520px;
    color: var(--dark-grey);
    font-size: 12px;
    line-height: 1.45;
  }

  .template-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 34px 22px;
  }

  .template-card {
    --template-enter-y: 34px;
    --template-reveal-y: var(--template-enter-y);
    --template-offset-y: 0px;
    --template-hover-y: 0px;

    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--black);
    opacity: 0;
    transform: translate3d(
      0,
      calc(
        var(--template-offset-y) + var(--template-hover-y) +
          var(--template-reveal-y)
      ),
      0
    );
    transition:
      transform 1s var(--ease),
      opacity 1s var(--ease);
    will-change: transform;
  }
  .template-card:hover {
    --template-hover-y: -3px;
    transition-duration: 0.3s;
  }
  .template-card.is-visible {
    opacity: 1;
    --template-reveal-y: 0px;
  }

  .template-card__media {
    aspect-ratio: 4 / 5;
    min-height: 0;
    overflow: hidden;
    border-radius: 5px;
    background: var(--soft-parchment);
    box-shadow: 0 26px 70px rgba(33, 21, 48, 0.12);
    transition:
      box-shadow 0.35s ease,
      transform 0.35s ease;
    will-change: transform;
  }
  .template-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate3d(0, 0, 0) scale(1);
    transition: transform 0.6s var(--ease);
    will-change: transform;
  }

  .template-card:hover .template-card__media img {
    transform: translate3d(0, 0, 0) scale(1.05);
  }
  .template-card:hover .template-card__media {
    box-shadow: 0 30px 84px rgba(44, 18, 85, 0.18);
    transform: translateY(-2px);
  }

  .template-card__body {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 14px 2px 0;
  }
  .template-card__body strong {
    max-width: 92%;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(24px, 3.5vw, 48px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .template-card__meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
  }
  .template-card__price {
    flex-shrink: 0;
    color: var(--black);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.06em;
  }
  .template-card__body p {
    color: var(--dark-grey);
    font-size: 11px;
    line-height: 1.45;
  }

  .template-card__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    align-self: end;
    padding-top: 6px;
  }
  .template-card__actions a {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 0, 0, 0.16);
    border-radius: 999px;
    color: var(--black);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.16em;
    backdrop-filter: blur(10px);
    transition:
      background 0.22s ease,
      border-color 0.22s ease,
      transform 0.22s ease,
      color 0.22s ease;
  }
  .template-card__actions a:first-child {
    background: var(--black);
    color: var(--white);
    border-color: var(--black);
  }
  .template-card__actions a:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--white);
    transform: translateY(-1px);
  }

  .start {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 74svh;
    place-items: center;
    gap: 18px;
    padding: 80px 20px;
    background: var(--white);
    scroll-margin-top: 84px;
    text-align: center;
  }
  .start p {
    color: var(--grey);
    font-size: 11px;
  }
  .start h2 {
    max-width: 1120px;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(56px, 9vw, 160px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .start__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    font-size: 13px;
    letter-spacing: 1.4px;
    transition: background 0.3s ease;
  }
  .start__button:hover {
    background: #333;
  }

  .reveal-blur {
    opacity: 0;
    transform: translateY(34px);
    transition:
      opacity 1s var(--ease),
      transform 1.1s var(--ease);
    transition-delay: var(--delay, 0ms);
  }
  .reveal-blur.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .features-list {
    position: relative;
    z-index: 2;
    padding: 110px 20px;
    background-color: #414238 !important;
    scroll-margin-top: 84px;
    color: var(--white);
  }

  .features-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-heading-centered {
    text-align: center;
    margin-bottom: 40px;
  }

  .section-heading-centered h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(36px, 7vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--white);
  }

  .features-grid-simple {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 40px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .addon-list {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .feature-item.dark-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--white);
    opacity: 0;
    filter: blur(8px);
    transform: translateY(16px);
    transition: opacity 0.8s var(--ease), filter 0.8s var(--ease), transform 0.8s var(--ease);
  }

  .feature-item.is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  .addon-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .check-box-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--white);
    stroke-width: 1.5;
  }

  .addon-price {
    font-size: 14px;
    opacity: 0.9;
  }

  @keyframes fadeDown {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes headingIn {
    to {
      transform: translateY(0);
    }
  }
  @keyframes sealRotate {
    to {
      transform: rotate(1turn);
    }
  }

  @media (min-width: 640px) {
    .hero-nav {
      padding: 20px 32px 12px;
    }
    .hero-motion-wrap {
      left: 32px;
      min-width: 360px;
    }
    .hero-motion-seal {
      left: -52px;
    }
    .stats-row {
      padding-inline: 32px;
    }
    .stats-row__inner {
      gap: 32px;
    }
    .stat-item p,
    .description {
      font-size: 12px;
    }
    .bottom-content {
      padding-inline: 32px;
    }
    .hero-cta {
      font-size: 20px;
    }
    .hero-cta svg {
      width: 22px;
      height: 22px;
    }
    .description {
      width: 180px;
    }
    .template-list, .features-list {
      padding-inline: 32px;
    }
  }

  @media (min-width: 768px) {
    .hero-nav {
      padding: 24px 48px 14px;
    }
    .hero-motion-wrap {
      top: 102px;
      left: 48px;
      width: min(40vw, 560px);
    }
    .hero-motion-seal {
      --seal-size: 112px;
      top: -32px;
      left: -56px;
    }
    .nav-links {
      display: flex;
    }
    .stats-row {
      padding-block: 0;
      padding-inline: 48px;
    }
    .stats-row__inner {
      gap: 40px;
    }
    .stat-item p,
    .description {
      font-size: 14px;
    }
    .bottom-content {
      gap: 48px;
      padding: 0 48px 48px;
    }
    .hero-cta {
      font-size: 24px;
    }
    .bottom-content__main {
      gap: 16px;
    }
    .description {
      width: 300px;
      text-align: right;
    }
    .template-list {
      padding: 120px 48px 100px;
    }
    .features-list {
      padding: 120px 48px;
    }
  }

  @media (max-width: 960px) {
    .template-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero-nav {
      padding: 14px 12px 10px;
    }
    .hero-motion-wrap {
      top: 135px;
      left: 12px;
      width: min(75vw, 350px);
      min-width: 172px;

      @media (max-height: 900px) {
        width: min(75vw, 320px);
      }

      @media (max-height: 800px) {
        width: min(75vw, 290px);
      }
      @media (max-height: 700px) {
        width: min(75vw, 260px);
      }
    }
    body.intro-enter .hero-motion-wrap {
      top: 50%;
      left: 50%;
      width: min(76vw, 290px);
      min-width: 0;
      transform: translate3d(-50%, -50%, 0) scale(1);
    }
    body.intro-hold .hero-motion-wrap {
      top: 50%;
      left: 50%;
      width: min(76vw, 290px);
      min-width: 0;
      transform: translate3d(-50%, -50%, 0) scale(1);
    }
    body.intro-ring-shrink .hero-motion-wrap {
      top: 50%;
      left: 50%;
      width: min(76vw, 290px);
      min-width: 0;
      transform: translate3d(-50%, -50%, 0) scale(1);
    }

    .hero-motion__card img {
      --hero-image-parallax: calc(var(--hero-scroll) * -28px);
    }
    .hero-motion-seal {
      --seal-size: 82px;
      top: -24px;
      left: -18px;
    }
    body.intro-enter .hero-motion-seal,
    body.intro-hold .hero-motion-seal {
      --seal-size: min(140vw, 560px);
    }
    body.intro-ring-shrink .hero-motion-seal {
      --seal-size: 150px;
    }
    .hero-motion-seal text {
      font-size: 9px;
      letter-spacing: 0.205em;
    }
    .stats-row {
      padding-inline: 12px;
    }
    .stats-row__inner {
      gap: 14px;
    }
    .stat-item p {
      font-size: 11px;
      letter-spacing: 0.05em;
    }
    .bottom-content {
      gap: 20px;
      padding: 0 12px 18px;

      @media (max-height: 700px) {
        gap: 6px;
      }
    }
    .hero-cta {
      font-size: 13px;
      letter-spacing: 0.11em;
    }
    .description {
      width: 140px;
      font-size: 10px;
      letter-spacing: 0.02em;
      margin-bottom: 4px;
    }

    h1 {
      font-size: clamp(32px, 11vw, 48px);
      line-height: 1.0;
    }
    .template-list {
      gap: 24px;
      padding: 58px 12px 70px;
      // box-shadow: 0 2px 20px rgba(23, 22, 15, 0.08);
    }
    .features-list {
      padding: 60px 16px;
    }
    .section-heading {
      gap: 10px;
    }
    .section-heading p {
      font-size: 12px;
      line-height: 1.25;
    }
    .section-heading h2 {
      max-width: 94%;
      font-size: clamp(32px, 9vw, 51px);
      line-height: 0.96;
    }
    .template-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: 28px 10px;
      overflow: visible;
    }
    .features-grid-simple {
      gap: 0 16px;
    }
    .feature-item.dark-item {
      font-size: 13px;
      padding-bottom: 12px;
      margin-bottom: 12px;
    }
    .addon-left {
      gap: 10px;
    }
    .check-box-icon {
      width: 18px;
      height: 18px;
    }
