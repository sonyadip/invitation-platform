---
import { getPlatformSettings } from "../services/platform-settings";

const siteSettings = await getPlatformSettings();
const bookingUrl = siteSettings.whatsapp_url || "https://wa.me/6281234567890";

const navItems = [
  ["Beranda", "/"],
  ["Koleksi", "/#templates"],
  ["Fitur", "/#features"],
  ["FAQ", "/#faq"],
  ["Konsultasi", "/#booking"],
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Halaman Tidak Ditemukan | {siteSettings.meta_title || "Senadda"}</title>
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://db.onlinewebfonts.com/c/4c4c08af466e9ad071b6d69cf44093df?family=SaolDisplay-Regular"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <nav class="hero-nav" aria-label="Navigasi utama">
        <a class="brand-logo" href="/" aria-label="Beranda">
          <img
            src={siteSettings.logo_url || "/images/senadda-logo.png"}
            alt={siteSettings.site_name + " Logo"}
            class="brand-logo__image"
          />
        </a>

        <div class="nav-links" aria-label="Menu desktop">
          {
            navItems.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))
          }
        </div>
        <button
          class="nav-action motion-down"
          style="--i: 4"
          id="login-btn"
          aria-haspopup="dialog"
          aria-expanded="false"
          onclick="window.location.href='/'"
        >
          Login
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
        </button>
      </nav>

      <section class="not-found-section">
        <h1>404</h1>
        <p>Halaman yang Anda tuju tidak ditemukan.</p>
        <a href="/" class="back-btn">Kembali ke Beranda</a>
      </section>
    </main>

    <style lang="scss">
      :root {
        color-scheme: light;
        
        /* Primary Palette */
        --ink-charcoal: #17160f;
        --deep-charcoal: #2f2e25;
        --ivory-paper: #f7f5ea;
        --soft-parchment: #efeddf;
        --warm-taupe: #b8aa92;
        --muted-clay: #a9785f;

        --accent: var(--muted-clay);
        --black: var(--ink-charcoal);
        --white: var(--ivory-paper);
        --grey: var(--warm-taupe);
        
        /* Typography */
        --font-heading: "SaolDisplay-Regular", serif;
        --font-body: "Montserrat", sans-serif;
        
        --ease-soft: cubic-bezier(0.29, 0.73, 0.45, 1);
      }
      
      * {
        box-sizing: border-box;
      }
      
      body {
        margin: 0;
        font-family: var(--font-body);
        background-color: var(--white);
        color: var(--black);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
        background: var(--white);
      }
      
      .hero-nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 80;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 20px 12px;
        background: linear-gradient(
          180deg,
          rgba(247, 245, 234, 0.9),
          rgba(247, 245, 234, 0)
        );
        backdrop-filter: blur(14px);
        
        @media (max-width: 768px) {
          padding: 14px 12px 10px;
        }
      }
      
      .brand-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        width: 140px;
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        transform-origin: left center;
      }
      .brand-logo__image {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
      }
      
      .nav-links {
        display: flex;
        align-items: center;
        gap: 36px;
        font-size: 13px;
        letter-spacing: 0.14em;
        
        a {
          color: var(--black);
          text-decoration: none;
          transition: color 0.3s;
          
          &:hover {
            color: var(--accent);
          }
        }
      }

      .nav-action {
        display: inline-flex;
        min-height: 36px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        border-radius: 999px;
        background: var(--black);
        color: var(--white);
        font-size: 11px;
        letter-spacing: 0.14em;
        white-space: nowrap;
        cursor: pointer;
        border: none;
        text-transform: uppercase;
        transition: opacity 0.22s ease, color 0.22s ease;
      }
      
      .nav-action:hover {
        opacity: 0.62;
      }
      
      .nav-action svg {
        width: 14px;
        height: 14px;
      }
      
      .not-found-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 120px 20px 60px;
        min-height: 100svh;
        
        h1 {
          font-family: var(--font-heading);
          font-size: clamp(6rem, 15vw, 12rem);
          margin: 0;
          line-height: 1;
          color: #17160f;
          font-weight: 400;
        }
        
        p {
          font-size: clamp(1rem, 3vw, 1.25rem);
          margin: 1.5rem 0 3rem;
          color: var(--deep-charcoal);
          max-width: 400px;
          line-height: 1.6;
        }

        .back-btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          padding: 14px 32px;
          background: var(--black);
          color: var(--white);
          text-decoration: none;
          border-radius: 40px;
          font-size: 13px;
          font-weight: 500;
          letter-spacing: 0.05em;
          text-transform: uppercase;
          transition: background-color 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
          
          &:hover {
            background-color: var(--accent);
            transform: translateY(-2px);
          }
        }
      }
    </style>
  </body>
</html>
