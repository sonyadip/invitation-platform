---
import type { GiftAccount } from '../../types';

interface Props {
  gifts: GiftAccount[];
  hidden?: boolean;
}
const { gifts, hidden = false } = Astro.props;
---
<div class="gift-grid" data-gift-grid hidden={hidden}>
  {gifts.map((gift) => {
    let logoUrl = gift.bank_logo;
    if (!logoUrl) {
      const b = gift.bank_name.toLowerCase();
      if (b.includes("bca")) logoUrl = "/images/banks/bca.svg";
      else if (b.includes("bni")) logoUrl = "/images/banks/bni.svg";
      else if (b.includes("bri")) logoUrl = "/images/banks/bri.svg";
      else if (b.includes("bsi")) logoUrl = "/images/banks/bsi.svg";
      else if (b.includes("cimb")) logoUrl = "/images/banks/cimb_niaga.svg";
      else if (b.includes("danamon")) logoUrl = "/images/banks/danamon.svg";
      else if (b.includes("mandiri")) logoUrl = "/images/banks/mandiri.svg";
      else if (b.includes("permata")) logoUrl = "/images/banks/permata_bank.svg";
    }
    
    return (
    <article class="gift-card" data-animate>
      <div class="gift-card__body">
        {logoUrl ? (
          <img src={logoUrl} alt={gift.bank_name} class="gift-card__bank-logo" />
        ) : (
          <span class="gift-card__bank">{gift.bank_name}</span>
        )}
        <p class="gift-card__number">{gift.account_number}</p>
        <p class="gift-card__holder">a.n. {gift.account_name}</p>
      </div>
      <div class="gift-card__actions">
        <button class="gift-btn gift-btn--copy" data-copy-btn data-value={gift.account_number} type="button">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
          </svg>
          <span>Salin</span>
        </button>
        
      </div>
    </article>
    );
  })}
</div>

<script>
  function initGiftInteractions() {
    const copyBtns = document.querySelectorAll('[data-copy-btn]');
    copyBtns.forEach((btn) => {
      if ((btn as HTMLElement).dataset.initialized === 'true') return;
      (btn as HTMLElement).dataset.initialized = 'true';
      
      btn.addEventListener('click', async () => {
        const value = btn.getAttribute('data-value') || '';
        const textSpan = btn.querySelector('span');
        const originalText = textSpan?.textContent || 'Salin';

        try {
          await navigator.clipboard.writeText(value);
          btn.classList.add('is-copied');
          if (textSpan) textSpan.textContent = 'Tersalin';
          setTimeout(() => {
            btn.classList.remove('is-copied');
            if (textSpan) textSpan.textContent = originalText;
          }, 1800);
        } catch (error) {
          console.error('Failed to copy:', error);
        }
      });
    });
  }
  
  document.addEventListener('astro:page-load', initGiftInteractions);
  initGiftInteractions();
</script>
