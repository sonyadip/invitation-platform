---
interface Props {
  fontHeading: string;
  fontBody: string;
}

const { fontHeading, fontBody } = Astro.props;

const formatFont = (font: string) => {
  return font.trim().replace(/\s+/g, '+');
};

const headingParam = formatFont(fontHeading || 'Playfair Display');
const bodyParam = formatFont(fontBody || 'Inter');

const customFonts = ['Roller+Coaster'];
const fontsToLoad = [];

if (!customFonts.includes(headingParam)) {
  fontsToLoad.push(`family=${headingParam}:ital,wght@0,400;0,600;0,700;1,400`);
}
if (!customFonts.includes(bodyParam)) {
  fontsToLoad.push(`family=${bodyParam}:wght@400;500;600;700`);
}

// Generate premium loading string covering standard styling weights
const googleFontsUrl = fontsToLoad.length > 0 
  ? `https://fonts.googleapis.com/css2?${fontsToLoad.join('&')}&display=swap`
  : null;
---

{googleFontsUrl && (
  <>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={googleFontsUrl} />
    <link href={googleFontsUrl} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href={googleFontsUrl} rel="stylesheet" /></noscript>
  </>
)}
