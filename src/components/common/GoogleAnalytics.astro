---
import { getPlatformSettings } from "../../services/platform-settings";

interface Props {
  id?: string;
  gtmId?: string;
}

const isProd = import.meta.env.PROD;
const hostname = (Astro.url.hostname || "").toLowerCase();

// Cek apakah lingkungan lokal / development
const isLocal =
  !isProd ||
  hostname === "localhost" ||
  hostname === "127.0.0.1" ||
  hostname === "0.0.0.0" ||
  hostname === "::1" ||
  hostname.endsWith(".test") ||
  hostname.endsWith(".local") ||
  hostname.endsWith(".internal") ||
  /^192\.168\./.test(hostname) ||
  /^10\./.test(hostname) ||
  /^172\.(1[6-9]|2[0-9]|3[0-1])\./.test(hostname);

// Aktif hanya pada production/live domain (bisa di-override jika dibutuhkan dengan PUBLIC_FORCE_ANALYTICS=true)
const forceEnable = import.meta.env.PUBLIC_FORCE_ANALYTICS === "true";
const isLive = forceEnable || (isProd && !isLocal);

let gaId = "";
let gtmId = "";

if (isLive) {
  const settings = await getPlatformSettings();
  gaId = Astro.props.id || settings.google_analytics_id || import.meta.env.PUBLIC_GA_ID || "G-PS8CJGKXWG";
  gtmId = Astro.props.gtmId || settings.google_tag_manager_id || import.meta.env.PUBLIC_GTM_ID;
}
---

{isLive && gtmId && (
  <!-- Google Tag Manager -->
  <script is:inline define:vars={{ gtmId }}>
    (function(w,d,s,l,i){
      var h = (w.location.hostname || '').toLowerCase();
      if (h === 'localhost' || h === '127.0.0.1' || h.endsWith('.test') || h.endsWith('.local')) return;
      w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtmId);
  </script>
  <!-- End Google Tag Manager -->
)}

{isLive && gaId && (
  <>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      (function() {
        var h = (window.location.hostname || '').toLowerCase();
        if (h === 'localhost' || h === '127.0.0.1' || h.endsWith('.test') || h.endsWith('.local')) return;
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());

        gtag('config', gaId);
      })();
    </script>
  </>
)}
