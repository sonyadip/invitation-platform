---
import { getPlatformSettings } from "../../services/platform-settings";

interface Props {
  id?: string;
  gtmId?: string;
}

const settings = await getPlatformSettings();
const gaId = Astro.props.id || settings.google_analytics_id || import.meta.env.PUBLIC_GA_ID || "G-PS8CJGKXWG";
const gtmId = Astro.props.gtmId || settings.google_tag_manager_id || import.meta.env.PUBLIC_GTM_ID;
---

{gtmId && (
  <!-- Google Tag Manager -->
  <script is:inline define:vars={{ gtmId }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtmId);
  </script>
  <!-- End Google Tag Manager -->
)}

{gaId && (
  <>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', gaId);
    </script>
  </>
)}
