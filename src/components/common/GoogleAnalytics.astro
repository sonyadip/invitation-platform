---
import { getPlatformSettings } from "../../services/platform-settings";
import { isLiveTrackingEnvironment } from "../../utils/analytics";

interface Props {
  id?: string;
  gtmId?: string;
}

const isLive = isLiveTrackingEnvironment(Astro.url.hostname);

let gaId = "";
let gtmId = "";

if (isLive) {
  const settings = await getPlatformSettings();
  gaId = Astro.props.id || settings.google_analytics_id || import.meta.env.PUBLIC_GA_ID || "G-PS8CJGKXWG";
  gtmId = Astro.props.gtmId || settings.google_tag_manager_id || import.meta.env.PUBLIC_GTM_ID;
}
---

{isLive && gtmId && (
  <!-- Google Tag Manager -->
  <script is:inline define:vars={{ gtmId }}>
    (function(w,d,s,l,i){
      var h = (w.location.hostname || '').toLowerCase();
      if (h === 'localhost' || h === '127.0.0.1' || h.endsWith('.test') || h.endsWith('.local')) return;
      w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtmId);
  </script>
  <!-- End Google Tag Manager -->
)}

{isLive && gaId && (
  <>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      (function() {
        var h = (window.location.hostname || '').toLowerCase();
        if (h === 'localhost' || h === '127.0.0.1' || h.endsWith('.test') || h.endsWith('.local')) return;
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());

        gtag('config', gaId);
      })();
    </script>
  </>
)}
