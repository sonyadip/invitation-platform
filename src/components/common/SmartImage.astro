---
import { Image } from 'astro:assets';
import { toCdnUrl } from '../../utils/cdn';

interface Props {
  src: string | ImageMetadata | undefined | null;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number | string;
  height?: number | string;
  [key: string]: any;
}

const { src, alt, class: className, loading = 'lazy', fetchpriority, width, height, ...rest } = Astro.props;

// If src is falsy, just render nothing or a placeholder
if (!src) return null;

const isString = typeof src === 'string';
const resolvedSrc = isString ? toCdnUrl(src as string) : src;
const isVideo = isString && (String(resolvedSrc).endsWith('.mp4') || String(resolvedSrc).endsWith('.webm'));
---

{isVideo ? (
  <video
    src={resolvedSrc as string}
    class={className}
    autoplay
    loop
    muted
    playsinline
    {...rest}
  ></video>
) : isString ? (
  <img 
    src={resolvedSrc as string} 
    alt={alt} 
    class={className} 
    loading={loading} 
    fetchpriority={fetchpriority} 
    decoding="async"
    width={width} 
    height={height} 
    {...rest} 
  />
) : (
  <Image 
    src={src as any} 
    alt={alt} 
    class={className} 
    loading={loading} 
    fetchpriority={fetchpriority} 
    decoding="async"
    width={width as any} 
    height={height as any} 
    {...rest} 
  />
)}
