---
export interface Props {
  groomName: string;
  brideName?: string;
  subtitle?: string;
  coverImage?: string;
  fontClass?: string;
  textColor?: string;
}

const {
  groomName,
  brideName = "",
  subtitle = "Wedding Invitation",
  textColor = "#ffffff",
} = Astro.props;

const displayName = brideName ? `${groomName} & ${brideName}` : groomName;
---

<div id="intro-awal" style={`color: ${textColor};`}>
  <div class="intro-container">
    <h2 class="subtitle intro-element">{subtitle}</h2>
    <h2 class="names intro-element">{displayName}</h2>
    <h2 class="progresbar intro-element">0%</h2>
  </div>
</div>

<script>
  import { animate, stagger } from "framer-motion";

  function setMetaThemeColor(color: string) {
    let meta = document.querySelector('meta[name="theme-color"]') as HTMLMetaElement | null;
    if (!meta) {
      meta = document.createElement('meta');
      meta.name = 'theme-color';
      meta.id = 'meta-theme-color';
      document.head.appendChild(meta);
    }
    meta.setAttribute('content', color);
  }

  function initClassicIntro() {
    const intro = document.getElementById("intro-awal");
    const progresbar = document.querySelector(".progresbar");
    const layout = document.querySelector("[data-template-layout]") as HTMLElement;
    const elements = document.querySelectorAll(".intro-element");
    const minDisplayTime = 3000;

    if (intro && progresbar && elements.length > 0) {
      // Ensure mobile system and browser bars match intro black immediately
      setMetaThemeColor('#000000');
      document.documentElement.style.backgroundColor = '#000000';
      document.body.style.backgroundColor = '#000000';

      if (layout) {
        layout.style.opacity = "0";
      }
      animate(
        elements,
        { opacity: [0, 1], y: [15, 0] },
        { 
          duration: 1.2, 
          ease: [0.33, 1, 0.68, 1], 
          delay: stagger(0.25)
        }
      );

      let progress = 0;
      const interval = 10;
      const steps = minDisplayTime / interval;
      const stepIncrement = 100 / steps;

      const progressInterval = setInterval(() => {
        progress += stepIncrement;
        progresbar.textContent = `${Math.min(Math.floor(progress), 100)}%`;

        if (progress >= 100) {
          clearInterval(progressInterval);
        }
      }, interval);

      setTimeout(() => {
        animate(
          elements,
          { opacity: 0 },
          { 
            duration: 1, 
            ease: "easeInOut"
          }
        );

        setTimeout(() => {
          // Transition mobile system and browser bars to the main page theme
          document.body.classList.add("is-intro-finished");
          document.documentElement.classList.add("is-intro-finished");
          document.documentElement.style.backgroundColor = '';
          document.body.style.backgroundColor = '';

          const targetBg = document.body.dataset.themeBg 
            || getComputedStyle(document.body).getPropertyValue('--template-bg').trim() 
            || '#f1e9de';
          setMetaThemeColor(targetBg);

          animate(
            intro,
            { opacity: 0 },
            { 
              duration: 1.2, 
              ease: "easeInOut",
              onComplete: () => {
                intro.remove();
              }
            }
          );

          if (layout) {
            layout.style.transition = "opacity 1.5s ease";
            layout.style.opacity = "1";
          }
        }, 800);
      }, minDisplayTime + 400);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initClassicIntro);
  } else {
    initClassicIntro();
  }
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Baskervville:ital@0;1&family=Inter:wght@300;400;500&display=swap');

  html:has(#intro-awal):not(.is-intro-finished),
  body:has(#intro-awal):not(.is-intro-finished) {
    background-color: #000000 !important;
    overflow: hidden;
  }

  body:has(#intro-awal):not(.is-intro-finished) [data-template-layout] {
    opacity: 0 !important;
    pointer-events: none;
  }

  #intro-awal { 
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    z-index: 99999;
    background-color: #000000;
    align-items: center;
    justify-content: center;
    will-change: opacity;
  }

  .intro-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 20px 0 8vh;
  }

  .intro-element {
    opacity: 0;
    will-change: opacity, transform;
  }

  .subtitle {
    font-family: 'Baskervville', serif;
    font-size: clamp(0.9rem, 3vw, 1.05rem);
    margin: 0 0 1rem 0;
    font-weight: normal;
    letter-spacing: 0.08em;
  }

  .names {
    font-family: 'Baskervville', serif;
    font-size: clamp(1.1rem, 4vw, 1.6rem);
    margin: 0 0 4rem 0;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: normal;
  }

  .progresbar {
    color: #fff !important;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-align: center;
    margin: 0;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
  }
</style>
