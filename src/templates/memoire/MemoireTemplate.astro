---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClassicIntro from "../../components/common/ClassicIntro.astro";
import SmartImage from "../../components/common/SmartImage.astro";
import CountdownTimer from "../../components/common/CountdownTimer.astro";
import type { FullInvitationData } from '../../types';
import { getPlatformSettings } from '../../services/platform-settings';
import { toCdnUrl } from '../../utils/cdn';

import bgHero from '../noir/assets/bg-hero.webp';
import coupleBride from '../noir/assets/couple-bride.jpg';
import coupleGroom from '../noir/assets/couple-groom.jpg';
import galleryOne from '../noir/assets/gallery-1.jpg';
import galleryTwo from '../noir/assets/gallery-2.jpg';
import galleryThree from '../noir/assets/gallery-3.jpg';
import galleryFour from '../noir/assets/gallery-4.jpg';
import galleryFive from '../noir/assets/gallery-5.jpg';
import gallerySix from '../noir/assets/gallery-6.jpg';
import gallerySeven from '../noir/assets/gallery-7.jpg';

import '@fancyapps/ui/dist/fancybox/fancybox.css';
import styleUrl from './style.scss?url';

import {
  formatChildPrefix,
  formatDate,
  buildGoogleCalendarUrl,
  getInstagramUsername,
  formatWishDate,
  generatePaginationItems,
  decodeHtmlEntities,
  getBankLogoUrl
} from '../../utils/template-helpers';

interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings, events, gallery, gifts, wishes } = data;
const sections = settings.sections || ({} as any);

const isPreview = wedding.id.startsWith('preview-');

const groomNickname = (wedding.groom_name === 'Rah Agus' ? 'Agus' : wedding.groom_name) || 'Agus';
const brideNickname = wedding.bride_name || 'Meita';
const groomFullName = wedding.groom_full_name || wedding.groom_name || 'I Wayan Yudi Artayasa';
const brideFullName = wedding.bride_full_name || wedding.bride_name || 'Ni Kadek Meita Widiantari';

const themeConfig = (settings.theme_config || {
  theme: {},
  layout: { galleryColumns: 3 },
  assets: {}
}) as any;
const themeContent = themeConfig.content || {};
const platformSettings = await getPlatformSettings();

const overrideSettings = {
  ...settings,
  theme_config: {
    ...themeConfig,
    theme: {
      ...themeConfig.theme,
      primaryColor: '#c2c2c2',
      secondaryColor: '#262627',
      textColor: '#ffffff',
      bgColor: '#0f0f10',
      fontHeading: 'Cormorant Garamond',
      fontBody: 'Montserrat'
    }
  }
};

const weddingDateStr = wedding.wedding_date || '2026-12-22';
const fullFormattedDate = formatDate(weddingDateStr);

const activeEvents = events && events.length > 0
  ? events
  : [
      {
        id: 'event-akad',
        event_name: 'Akad Nikah',
        event_date: weddingDateStr,
        start_time: '13:00 WITA',
        end_time: 'Selesai',
        venue_name: 'The Royal Garden',
        venue_address: 'Jl. Pantai Indah No. 8, Bali',
        maps_url: wedding.maps_url || 'https://maps.google.com',
        sort_order: 1,
        wedding_id: wedding.id,
        created_at: ''
      }
    ];

const primaryEvent = activeEvents[0];
const primaryEventDateObj = new Date(primaryEvent?.event_date || weddingDateStr);
const validPrimaryEventDate = isNaN(primaryEventDateObj.getTime()) ? new Date('2026-12-22') : primaryEventDateObj;
const primaryDayName = validPrimaryEventDate.toLocaleDateString('id-ID', { weekday: 'long', timeZone: 'Asia/Makassar' }).toUpperCase();
const primaryFullDate = validPrimaryEventDate.toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'Asia/Makassar' }).toUpperCase();
const heroDateParts = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: '2-digit',
  timeZone: 'Asia/Makassar'
}).formatToParts(validPrimaryEventDate);
const heroDayStr = heroDateParts.find((p) => p.type === 'day')?.value || '22';
const heroMonthStr = heroDateParts.find((p) => p.type === 'month')?.value || '12';
const heroYearShortStr = heroDateParts.find((p) => p.type === 'year')?.value || '26';

function formatCleanTime(startTime?: string, endTime?: string): string {
  if (!startTime) return '';
  const s = startTime.trim().replace(/^pukul\s*:\s*/i, '');
  const e = endTime ? endTime.trim().replace(/^pukul\s*:\s*/i, '') : '';
  if (!e) return s;
  return `${s} - ${e}`;
}

const themeAssets = themeConfig.assets || {};
const coverImage = themeAssets.coverImage || themeAssets.heroImage || (isPreview ? 'https://media.senadda.id/rah-agus-komala/gallery/DMS09888.webp' : bgHero.src);
const heroImage = themeAssets.heroImage || bgHero.src;
const brideImage = themeAssets.brideImage || coupleBride.src;
const groomImage = themeAssets.groomImage || coupleGroom.src;
const closingImage = themeAssets.closingImage || themeAssets.heroImage || (isPreview ? 'https://media.senadda.id/rah-agus-komala/closing/closing.webp' : coverImage);
const heroVideo = themeAssets.heroVideo ? toCdnUrl(themeAssets.heroVideo) : '';
const videoUrl = toCdnUrl(themeAssets.videoUrl || themeAssets.heroVideo || '');
const videoPoster = themeAssets.videoPoster || themeAssets.posterImage || heroImage || coverImage;

const googleCalendarUrl = primaryEvent ? buildGoogleCalendarUrl(wedding as any, primaryEvent as any) : '';

const defaultGallery = [
  { id: '1', image_url: galleryOne.src },
  { id: '2', image_url: galleryTwo.src },
  { id: '3', image_url: galleryThree.src },
  { id: '4', image_url: galleryFour.src },
  { id: '5', image_url: galleryFive.src },
  { id: '6', image_url: gallerySix.src },
  { id: '7', image_url: gallerySeven.src }
];

const activeGallery = gallery && gallery.length > 0
  ? gallery.map((image) => ({
      id: image.id,
      image_url: typeof image.image_url === 'string' ? image.image_url : (image.image_url as any)?.src || galleryOne.src
    }))
  : defaultGallery;

const countdownImage = themeAssets.countdownImage || activeGallery[0]?.image_url || heroImage || coverImage;

const _themeName = 'Memoire';

const rawSliderImages = [
  coverImage,
  ...(themeAssets.bgSliderImages && themeAssets.bgSliderImages.length > 0
    ? themeAssets.bgSliderImages
    : (themeAssets.sliderImages && themeAssets.sliderImages.length > 0
        ? themeAssets.sliderImages
        : (activeGallery && activeGallery.length > 0
            ? activeGallery.map((g: any) => g.image_url).filter(Boolean)
            : [heroImage, brideImage, groomImage, galleryOne.src, galleryTwo.src])))
].filter(Boolean);

const seenSliderUrls = new Set<string>();
const sliderImages = rawSliderImages.filter((url) => {
  const key = typeof url === 'string' ? url : (url as any)?.src || '';
  if (!key || seenSliderUrls.has(key)) return false;
  seenSliderUrls.add(key);
  return true;
});
if (sliderImages.length === 0 && coverImage) sliderImages.push(coverImage);

const brideFather = themeContent.brideFatherName || 'Bapak Mempelai';
const brideMother = themeContent.brideMotherName || 'Ibu Mempelai';
const brideChildVal = themeContent.brideChildNumber || (wedding as any).bride_child_position || themeContent.brideChildPosition;
const bridePrefix = formatChildPrefix(brideChildVal, 'Putri', null, isPreview ? 'Putri Pertama dari' : 'Putri dari');
const brideAddressText = themeContent.brideAddress || themeContent.brideCity || themeContent.brideOrigin || '';

const groomFather = themeContent.groomFatherName || 'Bapak Mempelai';
const groomMother = themeContent.groomMotherName || 'Ibu Mempelai';
const groomChildVal = themeContent.groomChildNumber || (wedding as any).groom_child_position || themeContent.groomChildPosition;
const groomPrefix = formatChildPrefix(groomChildVal, 'Putra', null, isPreview ? 'Putra Kedua dari' : 'Putra dari');
const groomAddressText = themeContent.groomAddress || themeContent.groomCity || themeContent.groomOrigin || '';

const formatIgUrl = (val?: string | null) => {
  if (!val) return null;
  const s = val.trim();
  if (!s || s === '#') return null;
  if (s.startsWith('http://') || s.startsWith('https://')) return s;
  return `https://instagram.com/${s.replace(/^@/, '')}`;
};
const brideInstagramUrl = formatIgUrl(themeContent.brideInstagramUrl || (wedding as any).bride_instagram);
const groomInstagramUrl = formatIgUrl(themeContent.groomInstagramUrl || (wedding as any).groom_instagram);

const openingVerse = themeContent.verse || themeContent.quoteText || themeContent.openingVerse || `"Ihaiva stam mā vi yaustam, Visvām āyur vyasnutam. Krindantau putrair naptrbhih, Modamānau sve grhe."`;
const openingVerseSource = themeContent.verseSource || themeContent.quoteSource || themeContent.openingVerseSource || (themeContent.verse || themeContent.quoteText ? '' : '(Rgveda : X.85.42)');
const cleanVerse = openingVerse.replace(/^["“”]/, '').replace(/["“”]$/, '').trim();
const formattedVerseSource = openingVerseSource ? (openingVerseSource.startsWith('(') ? openingVerseSource : `(${openingVerseSource})`) : '';

const defaultStory = [
  {
    year: 'Awal Pertemuan',
    title: 'Pertemuan Pertama',
    description: 'Semua berawal dari sebuah perkenalan sederhana yang perlahan menumbuhkan rasa nyaman dan keyakinan untuk melangkah bersama.'
  },
  {
    year: 'Menjalani Bersama',
    title: 'Bertumbuh & Saling Menguatkan',
    description: 'Melalui tawa, doa, dan berbagai cerita kehidupan, kami belajar bahwa rumah terbaik adalah saling menggenggam satu sama lain.'
  },
  {
    year: 'Hari Bahagia',
    title: 'Menuju Pernikahan',
    description: 'Kini kami melangkah menuju babak baru kehidupan untuk menyatukan dua hati dalam ikatan suci pernikahan.'
  }
];

const activeStory = wedding.story && wedding.story.length > 0
  ? wedding.story
  : (isPreview ? defaultStory : []);

const showCouple = sections.coupleInfo !== false;
const showStory = sections.story !== false && activeStory.length > 0;
const showEvents = sections.eventDetails !== false;
const showCountdown = sections.countdown !== false && settings.countdown_enabled !== false;
const showRsvp = sections.rsvp !== false && settings.rsvp_enabled !== false;
const showGift = sections.gift !== false && settings.gift_enabled !== false;
const showGallery = sections.gallery !== false && settings.gallery_enabled !== false && activeGallery.length > 0;
const showVideo = sections.video !== false && Boolean(videoUrl);

const instagramUrl = themeContent.instagramUrl || platformSettings?.instagram_url || 'https://instagram.com/senadda.id';
const _baseWa = themeContent.whatsappUrl || platformSettings?.whatsapp_url || '';
const whatsappUrl = _baseWa ? `${_baseWa}${_baseWa.includes('?') ? '&' : '?'}text=${encodeURIComponent('Halo Admin, saya tertarik untuk membuat undangan digital dengan tema *' + _themeName + '*. Boleh minta informasi mengenai cara pemesanannya?')}` : '';
const closingTitle = themeContent.thankYouTitle || themeContent.closingTitle || 'Terima Kasih';
const closingMessage = themeContent.thankYouMessage || themeContent.closingMessage || 'Merupakan suatu kebahagiaan dan kehormatan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu di hari bahagia kami.';

const defaultGifts = [
  {
    id: 'gift-1',
    bank_name: 'BCA',
    account_number: '0123 456 789',
    account_name: groomFullName,
    bank_logo: undefined
  },
  {
    id: 'gift-2',
    bank_name: 'MANDIRI',
    account_number: '123 456 7891',
    account_name: brideFullName,
    bank_logo: undefined
  }
];

const activeGifts = gifts && gifts.length > 0
  ? gifts.map((g) => ({
      id: g.id,
      bank_name: g.bank_name,
      account_number: g.account_number,
      account_name: g.account_name,
      bank_logo: (g as any).bank_logo
    }))
  : defaultGifts;

const displayedWishes = wishes && wishes.length > 0 ? wishes.slice(0, 4) : [];
const isWishesEmpty = !wishes || wishes.length === 0;
const totalWishPages = Math.ceil((wishes?.length || 0) / 4);

const activeMusicUrl = wedding.music_url || themeAssets.musicUrl || (isPreview ? 'https://media.senadda.id/audio/banda-neira-sampai-jadi-debu.mp3' : undefined);

const navItems = [
  { id: 'beranda', label: 'Beranda' },
  ...(showCouple ? [{ id: 'mempelai-pria', label: 'Mempelai' }] : []),
  ...(showEvents ? [{ id: 'acara', label: 'Acara' }] : []),
  ...(showGallery ? [{ id: 'galeri', label: 'Galeri' }] : []),
  ...(showRsvp ? [{ id: 'rsvp', label: 'RSVP & Ucapan' }] : [])
];
---

<BaseLayout
  wedding={wedding}
  settings={overrideSettings}
  to={guestName}
  templateClass={`template-memoire${sections.introAnimation !== false ? " has-intro" : ""}`}
  image={coverImage}
  styleUrl={styleUrl}
>
  <div class="invitation-root" data-template-root data-lenis-prevent>
    {sections.introAnimation !== false && (
      <ClassicIntro
        groomName={groomNickname}
        brideName={brideNickname}
        subtitle="The Wedding Of"
      />
    )}

    <div class="cover" data-template-cover>
      <SmartImage class="cover__bg" src={coverImage} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
      <div class="cover__scrim" aria-hidden="true"></div>

      <div class="cover__inner">
        <div class="cover__top-block">
          <p class="cover__eyebrow">{themeContent.heroEyebrow || 'The Wedding Of'}</p>
          <h1 class="cover__names">
            <span>{groomNickname} &amp;</span>
            <span>{brideNickname}</span>
          </h1>
          <p class="cover__date">{fullFormattedDate}</p>
        </div>

        <div class="cover__bottom-block">
          <p class="cover__dear">Kepada Yth.</p>
          <h2 class="cover__guest-name">{guestName || 'Tamu Undangan'}</h2>

          <button class="cover__btn" data-template-open type="button" aria-label="Buka Undangan">
            <span>Buka Undangan</span>
          </button>
        </div>
      </div>
    </div>

    <div class="layout" data-template-layout>
      <aside class="sidebar">
        <SmartImage class="sidebar__bg" src={coverImage} alt="" aria-hidden="true" />
        <div class="sidebar__overlay" aria-hidden="true"></div>
        <div class="sidebar__caption">
          <p class="sidebar__names" data-animate="fade-up" style="--animate-delay: 250ms;">
            {groomNickname} &amp; {brideNickname}
          </p>
        </div>
      </aside>

      <div class="stage-shell">
        <div class="main-bg-layer" aria-hidden="true">
          {heroVideo ? (
            <video
              class="main-bg-layer__video"
              src={heroVideo}
              poster={typeof coverImage === 'string' ? coverImage : (coverImage as any)?.src}
              preload="metadata"
              autoplay
              muted
              loop
              playsinline
            ></video>
          ) : (
            <div class="main-bg-slider" data-main-bg-slider>
              <div class="main-bg-slider__slides">
                {sliderImages.map((slide: string, index: number) => (
                  <SmartImage
                    class={`main-bg-slider__slide ${index === 0 ? 'is-active' : ''}`}
                    src={slide}
                    alt=""
                    aria-hidden="true"
                  />
                ))}
              </div>
            </div>
          )}
          <div class="main-bg-layer__scrim"></div>
        </div>

        <button
          type="button"
          class="nav-menu-trigger"
          data-menu-toggle
          aria-label="Buka menu navigasi"
          aria-expanded="false"
        >
          <span class="nav-menu-trigger__lines" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
        </button>

        <nav class="nav-popover" data-menu-drawer aria-label="Menu Navigasi">
          {navItems.map((item) => (
            <button
              type="button"
              class="nav-popover__link"
              data-nav-target={`#${item.id}`}
            >
              {item.label}
            </button>
          ))}
        </nav>

        {sections.music !== false && activeMusicUrl && (
          <button class="audio-toggle" data-template-audio-toggle type="button" aria-label="Play or pause music">
            <div class="audio-icon-wrapper">
              <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <rect x="6" y="4" width="4" height="16"></rect>
                <rect x="14" y="4" width="4" height="16"></rect>
              </svg>
            </div>
            <audio data-template-audio loop preload="none" src={activeMusicUrl}></audio>
          </button>
        )}

        <main class="horizontal-track" data-horizontal-track data-lenis-prevent>
          <section class="h-slide h-slide--hero" id="beranda" data-slide-label="Beranda">
            <div class="hero-editorial">
              <div class="hero-editorial__left" data-animate="fade-right" style="--animate-delay: 160ms;">
                <span class="hero-editorial__vertical-script">
                  {groomNickname} + {brideNickname}
                </span>
              </div>

              <div class="hero-editorial__right">
                <div class="hero-editorial__ornament">
                  <span class="hero-editorial__vline" aria-hidden="true" data-animate="expand-y" data-animate-origin="top" style="--animate-delay: 220ms;"></span>
                  <div class="hero-editorial__date-stacked" data-animate="fade-up" style="--animate-delay: 380ms;">
                    <span>{heroDayStr}</span>
                    <span class="hero-editorial__dot" aria-hidden="true">&bull;</span>
                    <span>{heroMonthStr}</span>
                    <span class="hero-editorial__dot" aria-hidden="true">&bull;</span>
                    <span>{heroYearShortStr}</span>
                  </div>
                  <span class="hero-editorial__vline" aria-hidden="true" data-animate="expand-y" data-animate-origin="bottom" style="--animate-delay: 320ms;"></span>
                </div>

                <div class="hero-editorial__details">
                  <h1 class="hero-editorial__names" data-animate="fade-left" style="--animate-delay: 320ms;">
                    <span>{groomNickname} &amp;</span>
                    <span>{brideNickname}</span>
                  </h1>

                  <div class="hero-editorial__quote" data-animate="fade-left" style="--animate-delay: 520ms;">
                    <p class="hero-editorial__quote-text">"{cleanVerse}"</p>
                    {formattedVerseSource && (
                      <p class="hero-editorial__quote-source">{formattedVerseSource.replace(/^\(|\)$/g, '')}</p>
                    )}
                  </div>
                </div>
              </div>
            </div>

            <button
              type="button"
              class="hero-scroll-indicator"
              data-track-next-cue
              data-animate="fade-right"
              style="--animate-delay: 760ms;"
              aria-label="Geser ke samping"
            >
              <span class="scroll-text">GESER</span>
              <span class="scroll-line" aria-hidden="true"></span>
            </button>
          </section>

          {showCouple && (
            <section class="h-slide h-slide--couple" id="mempelai-pria" data-slide-label="Mempelai">
              <div class="couple-slide__bg-wrap">
                <SmartImage class="couple-slide__bg-img" src={groomImage} alt={groomNickname} data-animate="blur-scale" />
                <div class="couple-slide__scrim"></div>
              </div>

              <span class="couple-slide__role" data-animate="fade-right" style="--animate-delay: 120ms;">The Groom</span>

              <div class="couple-slide__body">
                <h2 class="couple-slide__nickname" data-animate="fade-up" style="--animate-delay: 240ms;">{groomNickname}</h2>
                <p class="couple-slide__fullname" data-animate="fade-up" style="--animate-delay: 340ms;">{groomFullName}</p>
                <div class="couple-slide__prefix-row" data-animate="fade-up" style="--animate-delay: 420ms;">
                  <p class="couple-slide__prefix">{groomPrefix || 'Putra dari'}</p>
                  <div class="couple-slide__rule" data-animate="expand-x" data-animate-origin="left"></div>
                </div>
                <p class="couple-slide__parents" data-animate="fade-up" style="--animate-delay: 580ms;">
                  {groomFather} &amp; {groomMother}
                  {groomAddressText && <><br />{groomAddressText}</>}
                </p>

                {(groomInstagramUrl || isPreview) && (
                  <a
                    class="couple-slide__ig"
                    href={groomInstagramUrl || 'https://instagram.com'}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-animate="fade-up"
                    style="--animate-delay: 680ms;"
                  >
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                    <span>@{getInstagramUsername(groomInstagramUrl) || wedding.groom_instagram || 'instagram'}</span>
                  </a>
                )}
              </div>
            </section>
          )}

          {showCouple && (
            <section class="h-slide h-slide--couple" id="mempelai-wanita" data-slide-label="Mempelai">
              <div class="couple-slide__bg-wrap">
                <SmartImage class="couple-slide__bg-img" src={brideImage} alt={brideNickname} data-animate="blur-scale" />
                <div class="couple-slide__scrim"></div>
              </div>

              <span class="couple-slide__role" data-animate="fade-right" style="--animate-delay: 120ms;">The Bride</span>

              <div class="couple-slide__body">
                <h2 class="couple-slide__nickname" data-animate="fade-up" style="--animate-delay: 240ms;">{brideNickname}</h2>
                <p class="couple-slide__fullname" data-animate="fade-up" style="--animate-delay: 340ms;">{brideFullName}</p>
                <div class="couple-slide__prefix-row" data-animate="fade-up" style="--animate-delay: 420ms;">
                  <p class="couple-slide__prefix">{bridePrefix || 'Putri dari'}</p>
                  <div class="couple-slide__rule" data-animate="expand-x" data-animate-origin="left"></div>
                </div>
                <p class="couple-slide__parents" data-animate="fade-up" style="--animate-delay: 580ms;">
                  {brideFather} &amp; {brideMother}
                  {brideAddressText && <><br />{brideAddressText}</>}
                </p>

                {(brideInstagramUrl || isPreview) && (
                  <a
                    class="couple-slide__ig"
                    href={brideInstagramUrl || 'https://instagram.com'}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-animate="fade-up"
                    style="--animate-delay: 680ms;"
                  >
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                    <span>@{getInstagramUsername(brideInstagramUrl) || wedding.bride_instagram || 'instagram'}</span>
                  </a>
                )}
              </div>
            </section>
          )}

          {showStory && (
            <section class="h-slide h-slide--story-host" id="kisah-cinta" data-slide-label="Kisah Cinta" data-story-host>
              <div class="v-story-track" data-story-vertical-track>
                {activeStory.map((item, idx) => {
                  const storyPhoto = activeGallery[idx % activeGallery.length]?.image_url || heroImage || coverImage;
                  const isLastStory = idx === activeStory.length - 1;
                  return (
                    <article class="v-story-slide" data-story-slide data-story-index={idx}>
                      <div class="story-slide__inner">
                        {idx === 0 && (
                          <h2 class="story-slide__lead" data-animate="fade-up" style="--animate-delay: 120ms;">
                            Our Story
                          </h2>
                        )}

                        <h3 class="story-slide__heading" data-animate="fade-up" style="--animate-delay: 220ms;">
                          {item.year || item.title}
                        </h3>

