					<script>
// ==========================================
// 1. SCRIPT MONITOR RSVP (VERSI REVISI)
// ==========================================
document.addEventListener('DOMContentLoaded', function() {
    
    console.log("✅ Script Monitor RSVP Aktif (Versi HTML Widget)");

    // Pastikan jQuery ada (JetFormBuilder butuh jQuery)
    if (typeof jQuery !== 'undefined') {
        
        jQuery(document).on('jet-form-builder/ajax/on-success', function(event, response) {
            
            console.log("🚀 Sinyal Form Sukses Diterima!");
            
            // Masukkan ID Listing Grid Anda di sini (TANPA TANDA PAGAR)
            var targetID = 'list-ucapan'; 
            
            var container = document.getElementById(targetID);

            if (container) {
                console.log("Target Listing ditemukan, memulai update...");
                container.style.opacity = '0.5';
                container.style.transition = 'opacity 0.3s';

                // Teknik fetch background
                var freshUrl = window.location.href + (window.location.href.indexOf('?') > -1 ? '&' : '?') + 'nocache=' + new Date().getTime();

                fetch(freshUrl)
                    .then(res => res.text())
                    .then(html => {
                        // Parse hasil HTML
                        var parser = new DOMParser();
                        var doc = parser.parseFromString(html, "text/html");
                        var newContent = doc.getElementById(targetID);

                        if (newContent) {
                            // Ganti isi HTML-nya
                            container.innerHTML = newContent.innerHTML;
                            console.log("✨ Selesai! Data baru ditampilkan.");

                            // --- PENAWAR 1: BUKA GEMBOK ANIMASI ---
                            // Karena elemen baru tidak terpantau Observer, kita paksa mereka muncul!
                            var ucapanBaru = container.querySelectorAll('.jet-listing-grid__item');
                            ucapanBaru.forEach(function(item, index) {
                                // Kita beri efek domino kecil saat memunculkan ucapan baru
                                setTimeout(function() {
                                    item.classList.add('pinvite-masuk-sekarang');
                                }, index * 100); 
                            });

                            // --- PENAWAR 2: BANGUNKAN JETENGINE & ELEMENTOR ---
                            // Agar layout Masonry/Slider (jika ada) tidak hancur setelah direfresh
                            setTimeout(function() {
                                jQuery(document).trigger('jet-engine/listing-grid/init');
                                jQuery(window).trigger('jet-engine/frontend/init');
                                if (typeof elementorFrontend !== 'undefined') {
                                    elementorFrontend.elementsHandler.runReadyTrigger(jQuery(container));
                                }
                            }, 50);

                        } else {
                            console.log("⚠️ Gagal menemukan elemen ID di data baru.");
                        }
                        container.style.opacity = '1';
                    })
                    .catch(err => {
                        console.error("Error fetch:", err);
                        container.style.opacity = '1';
                    });
            } else {
                console.log("❌ ERROR: ID '" + targetID + "' tidak ditemukan di Elementor. Cek Tab Advanced Listing Grid!");
            }
        });

    } else {
        console.log("⚠️ jQuery tidak terdeteksi. Script tidak bisa jalan.");
    }
});
</script>

<script>
// ==========================================
// 2. SCRIPT PAX VISIBILITY (TETAP SAMA)
// ==========================================
document.addEventListener('DOMContentLoaded', function() {
    // 1. Identifikasi Field Status dan Field Pax
    const statusField = document.querySelector('[name="form_status"]');
    const paxField = document.querySelector('[name="form_pax"]');

    if (!statusField || !paxField) return;

    // 2. Ambil "Row" terluar (Induk dari Label & Input)
    const paxRow = paxField.closest('.jet-form-builder-row');

    if (!paxRow) return;

    function handleVisibility() {
        if (statusField.value === 'hadir') {
            // Tampilkan baris secara utuh
            paxRow.style.setProperty('display', 'flex', 'important');
        } else {
            // Sembunyikan baris secara utuh (Label + Input hilang)
            paxRow.style.setProperty('display', 'none', 'important');
        }
    }

    // Jalankan saat ada perubahan
    statusField.addEventListener('change', handleVisibility);
    
    // Jalankan saat halaman pertama kali dimuat
    handleVisibility();
});
</script>				</div>
