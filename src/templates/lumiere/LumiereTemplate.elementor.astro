                    $('#awal-undangan, #awal-undangan [data-settings]').each(function() {
                        var el = $(this);
                        var setRaw = el.attr('data-settings');
                        
                        // Validasi apakah elemen ini punya animasi
                        if (setRaw && setRaw.indexOf('animation') !== -1) {
                            try {
                                var settings = JSON.parse(setRaw);
                                var animName = settings._animation || settings.animation;
                                var delay = settings._animation_delay || settings.animation_delay || 0;
                                
                                if (animName) {
                                    // Tarik mundur ke posisi awal
                                    el.removeClass('animated ' + animName).addClass('elementor-invisible');
                                    
