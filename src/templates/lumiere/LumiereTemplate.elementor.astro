    <style>
    .pinvite-copy-tooltip {
        position: absolute;
        bottom: 120%;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        background-color: #111111;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        pointer-events: none;
        z-index: 999;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
    .pinvite-copy-tooltip::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: #111111 transparent transparent transparent;
    }
    .pinvite-copy-tooltip.show-tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }
    </style>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        
        function aktifkanTombolCopy(pembungkus, pakaiTooltip) {
            const tombolLink = pembungkus.querySelector('a.elementor-button');
            if (!tombolLink) return;

            if (pakaiTooltip) {
                tombolLink.style.position = 'relative';
            }

            tombolLink.addEventListener('click', function(e) {
                e.preventDefault(); 

                const hrefAsli = this.getAttribute('href');
                if (!hrefAsli || !hrefAsli.includes('#copy-')) return;

                const dataMentah = hrefAsli.split('#copy-')[1];
                const teksDiCopy = decodeURIComponent(dataMentah).trim();

                if (teksDiCopy) {
                    navigator.clipboard.writeText(teksDiCopy).then(() => {
                        
                        const spanTeks = this.querySelector('.elementor-button-text');
                        const warnaAsli = this.style.backgroundColor;
                        let teksAsli = '';

                        if (!pakaiTooltip) {
                            // LOGIKA GAYA LAMA: Ubah warna background hijau & ubah teks tombol
                            if (spanTeks) {
                                teksAsli = spanTeks.innerText;
                                spanTeks.innerText = 'Tersalin!';
                            }
                            this.style.backgroundColor = '#059669'; 
                            this.style.transition = 'all 0.3s ease';
                        } else {
                            // LOGIKA GAYA TOOLTIP: Background aman, hanya munculkan tooltip
                            let tooltip = this.querySelector('.pinvite-copy-tooltip');
                            if (!tooltip) {
                                tooltip = document.createElement('span');
                                tooltip.className = 'pinvite-copy-tooltip';
                                tooltip.innerText = 'Disalin!';
                                this.appendChild(tooltip);
                            }
                            setTimeout(() => tooltip.classList.add('show-tooltip'), 10);
                        }

                        // KEMBALIKAN KE KONDISI SEMULA SETELAH 2 DETIK
                        setTimeout(() => {
                            if (!pakaiTooltip) {
                                if (spanTeks) spanTeks.innerText = teksAsli;
                                this.style.backgroundColor = warnaAsli;
                            } else {
                                let tooltip = this.querySelector('.pinvite-copy-tooltip');
                                if (tooltip) tooltip.classList.remove('show-tooltip');
                            }
                        }, 2000);
                        
                    }).catch(err => {
                        console.error('Gagal copy:', err);
                        alert('Oops! Browser Anda tidak mendukung auto-copy.');
                    });
                }
            });
        }

        // Aktifkan tombol gaya lama (Hijau)
        const tombolLama = document.querySelectorAll('.pinvite-btn-salin');
        tombolLama.forEach(pembungkus => aktifkanTombolCopy(pembungkus, false));

        // Aktifkan tombol gaya baru (Tooltip Premium)
        const tombolBaru = document.querySelectorAll('.pinvite-btn-salin-tooltip');
        tombolBaru.forEach(pembungkus => aktifkanTombolCopy(pembungkus, true));

    });
    </script>
        
    <style>
    /* 1. Kunci gambar di posisi sembunyi. 
          PENTING: body:not(.elementor-editor-active) memastikan ini HANYA jalan di web asli, BUKAN di editor! */
    body:not(.elementor-editor-active) .e-gallery-item > *, 
    body:not(.elementor-editor-active) .gallery-item > *, 
    body:not(.elementor-editor-active) .jet-listing-grid__item > *, 
    body:not(.elementor-editor-active) .jet-gallery__item > * {
        opacity: 0 !important;
        transform: translateY(40px) scale(0.95) !important;
        transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
    }

    /* 2. Class pemantik saat di-scroll (gambar muncul & naik) */
    body:not(.elementor-editor-active) .e-gallery-item.pinvite-masuk-sekarang > *, 
    body:not(.elementor-editor-active) .gallery-item.pinvite-masuk-sekarang > *, 
    body:not(.elementor-editor-active) .jet-listing-grid__item.pinvite-masuk-sekarang > *, 
    body:not(.elementor-editor-active) .jet-gallery__item.pinvite-masuk-sekarang > * {
        opacity: 1 !important;
        transform: translateY(0) scale(1) !important;
    }
    </style>

    
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // 1. Cari semua elemen beranimasi + Galeri/Listing Grid
        const elemenAnimasi = document.querySelectorAll('[data-settings*="animation"], .e-gallery-item, .gallery-item, .jet-listing-grid__item, .jet-gallery__item');

        // 2. Siapkan "Mata-Mata" (Observer) yang lebih stabil
        const observer = new IntersectionObserver((entries) => {
            
            // Variabel delay untuk membuat efek domino pada galeri
            let jedaAntreanGaleri = 0; 

            entries.forEach(entry => {
                const el = entry.target;
                
                // --- SENSOR 1: PENGECUALIAN DESKTOP (STICKY) ---
                if (el.closest('.desktop')) return;

                // --- SENSOR 2: LINDUNGI HERO SAAT COVER DITUTUP ---
                if (document.body.classList.contains('kunci-animasi-hero')) {
                    if (el.closest('#awal-undangan')) return;
                }

                // ========================================================
                // MODUL BARU: ANIMASI GALERI DOMINO (SUPPORT LOOPING)
                // ========================================================
                const isGalleryItem = el.classList.contains('e-gallery-item') || el.classList.contains('gallery-item') || el.classList.contains('jet-listing-grid__item') || el.classList.contains('jet-gallery__item');
                
                if (isGalleryItem) {
                    const isiGambar = el.firstElementChild; // Ambil elemen gambar di dalamnya
                    
                    if (entry.isIntersecting) {
                        // KONDISI A: Masuk layar
                        if (isiGambar) isiGambar.style.transitionDelay = jedaAntreanGaleri + 'ms';
                        el.classList.add('pinvite-masuk-sekarang');
                        jedaAntreanGaleri += 150; 
                    } else {
                        // KONDISI B: Keluar layar (Reset agar bisa di-scroll berulang kali)
                        el.classList.remove('pinvite-masuk-sekarang');
                        if (isiGambar) isiGambar.style.transitionDelay = '0ms'; 
                    }
                    return; // Stop di sini khusus untuk galeri
                }
                // ========================================================

                // --- MODUL BAWAAN BOS: ANIMASI ELEMENTOR BIASA ---
                let settings;
                try {
                    settings = JSON.parse(el.getAttribute('data-settings'));
                } catch(e) { return; } 

                const namaAnimasi = settings._animation || settings.animation;
                const delay = settings._animation_delay || settings.animation_delay || 0; 
                
                if (!namaAnimasi) return;

                // KONDISI A: Saat elemen MASUK ke layar
                if (entry.isIntersecting) {
                    el.loopTimeout = setTimeout(() => {
                        el.classList.remove('elementor-invisible');
                        el.classList.add('animated', namaAnimasi);
                    }, parseInt(delay) + 10);
                } 
                // KONDISI B: Saat elemen KELUAR dari layar
                else {
                    clearTimeout(el.loopTimeout); 
                    el.classList.remove('animated', namaAnimasi);
                    el.classList.add('elementor-invisible');
                }
            });
        }, {
            root: null,
            threshold: 0.1, 
            rootMargin: "0px" 
        });

        // 3. Pasang Observer HANYA ke elemen yang bukan .desktop
        elemenAnimasi.forEach(el => {
            if (!el.closest('.desktop')) {
                observer.observe(el);
            }
        });

    });
    </script>
    
  
