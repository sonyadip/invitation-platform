							<div class="elementor-shortcode">    <div id="pinvite-video-bg-node" class="pinvite-video-sticky-node" style="opacity: 0; transition: opacity 0.8s ease;">
        <video 
            id="bgVideoFinal"
            autoplay loop muted playsinline webkit-playsinline preload="auto"
            class="pinvite-video-element"> 
            <source src="/wp-content/uploads/2026/04/daniel-ranggi-video-compressed-2.mp4" type="video/mp4">
        </video>
        <div class="pinvite-video-overlay"></div>
    </div>

        <script>
    document.addEventListener("DOMContentLoaded", function() {
        const videoNode = document.getElementById("pinvite-video-bg-node");
        const video = document.getElementById("bgVideoFinal");
        if (!videoNode || !video) return;

        // ========================================================
        // TRIK INJECTION: Pindahkan video ke akar .area-scroll
        // ========================================================
        const areaScroll = videoNode.closest('.area-scroll') || document.querySelector('.area-scroll');
        
        if (areaScroll) {
            // Jadikan video sebagai anak pertama di dalam .area-scroll
            areaScroll.insertBefore(videoNode, areaScroll.firstChild);
        } else {
            console.warn('Kontainer dengan class .area-scroll tidak ditemukan!');
        }

        // ========================================================
        // LOGIKA AUTOPLAY HP
        // ========================================================
        function forcePlayVideo() {
            video.play().then(() => {
                videoNode.style.opacity = "1"; 
                window.removeEventListener('touchstart', forcePlayVideo);
                window.removeEventListener('scroll', forcePlayVideo);
                window.removeEventListener('mousemove', forcePlayVideo);
            }).catch(e => console.log("Menunggu interaksi user..."));
        }

        video.play().then(() => {
            videoNode.style.opacity = "1";
        }).catch(() => {
            window.addEventListener('touchstart', forcePlayVideo, { once: true });
            window.addEventListener('scroll', forcePlayVideo, { once: true });
            window.addEventListener('mousemove', forcePlayVideo, { once: true });
        });
    });
    </script>
    
    <style>
        /* ========================================================
           1. STICKY NODE (Hanya aktif di Live Website, bukan di Editor)
           ======================================================== */
        body:not(.elementor-editor-active) .pinvite-video-sticky-node {
            position: -webkit-sticky; 
            position: sticky;
            top: 0; left: 0; 
            width: 100%; 
            height: 100vh; height: 100dvh; 
            height: 100dvh;
            
            /* RAHASIA UTAMA: Menarik konten di bawahnya agar naik ke atas menutupi video */
            margin-bottom: -100vh; margin-bottom: -100dvh; 
            
            z-index: 0; 
            pointer-events: none; overflow: hidden;
        }

        /* ========================================================
           2. KHUSUS EDITOR ELEMENTOR (Tampilan Background Sempurna)
           ======================================================== */
        .elementor-editor-active .pinvite-video-sticky-node {
            position: fixed; /* Ubah jadi fixed agar tidak mendorong widget lain */
            top: 0; left: 0;
            width: 100vw; 
            height: 100vh; 
            height: 100dvh;
            z-index: -999; /* Lempar ke paling belakang iframe Editor */
            pointer-events: none; /* Klik tembus ke elemen di depannya */
        }

        /* ========================================================
           3. VIDEO COVER (Kebal Zoom & Responsif)
           ======================================================== */
        .pinvite-video-element {
            position: absolute; top: 0; left: 0; 
            width: 100%; height: 100%; 
            object-fit: cover; object-position: center center; z-index: 1;
        }

        .pinvite-video-overlay {
            position: absolute; top: 0; left: 0; 
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5); z-index: 2;
        }
        
        video::-webkit-media-controls, video::-webkit-media-controls-start-playback-button {
            display: none !important; -webkit-appearance: none;
        }

        /* Pastikan konten di dalam .area-scroll (selain video) berada di atas video */
        .area-scroll > *:not(#pinvite-video-bg-node) {
            position: relative;
            z-index: 1;
        }
    </style>
