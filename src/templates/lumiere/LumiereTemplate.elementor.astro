---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { FullInvitationData } from '../../types';

interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings } = data;
const themeConfig = (settings.theme_config || { theme: {}, layout: {}, assets: {} }) as any;
const themeAssets = themeConfig.assets || {};

const coverImage = themeAssets.coverImage || '/wp-content/uploads/2026/04/10.webp';
