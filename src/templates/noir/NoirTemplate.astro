---
import CinematicIntro from '../../components/common/CinematicIntro.astro';
import BaseLayout from "../../layouts/BaseLayout.astro";
import SmartImage from "../../components/common/SmartImage.astro";
import type { FullInvitationData } from '../../types';
import { getPlatformSettings } from '../../services/platform-settings';
import bgHero from './assets/bg-hero.webp';
import coupleBride from './assets/couple-bride.jpg';
import coupleGroom from './assets/couple-groom.jpg';
import galleryOne from './assets/gallery-1.jpg';
import galleryTwo from './assets/gallery-2.jpg';
import galleryThree from './assets/gallery-3.jpg';
import galleryFour from './assets/gallery-4.jpg';
import galleryFive from './assets/gallery-5.jpg';
import gallerySix from './assets/gallery-6.jpg';
import gallerySeven from './assets/gallery-7.jpg';
import galleryEight from './assets/gallery-8.webp';
import '@fancyapps/ui/dist/fancybox/fancybox.css';
import './style.scss';

import {
  buildParentText,
  formatDate,
  formatEventDate,
  buildGoogleCalendarUrl,
  formatWishDate
} from '../../utils/template-helpers';
import CountdownTimer from '../../components/common/CountdownTimer.astro';
import GiftGrid from '../../components/common/GiftGrid.astro';
interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings, events, gallery, gifts, wishes } = data;
const sections = settings.sections;
// Override gallery with custom local images for Noir template
const customGallery = [
  { id: '1', image_url: galleryOne, variant: 'full-16x10' },
  { id: '2', image_url: galleryTwo, variant: 'half' },
  { id: '3', image_url: galleryThree, variant: 'half' },
  { id: '4', image_url: galleryFour, variant: 'half' },
  { id: '5', image_url: galleryFive, variant: 'half' },
  { id: '6', image_url: gallerySix, variant: 'full-16x10' },
  { id: '7', image_url: gallerySeven, variant: 'half' },
  { id: '8', image_url: galleryEight, variant: 'half' }
];
const themeConfig = (settings.theme_config || {
  theme: {},
  layout: { galleryColumns: 3 },
  assets: {}
}) as any;
const themeContent = themeConfig.content || {};
const platformSettings = await getPlatformSettings();

// Override font & color settings for the Noir theme
const overrideSettings = {
  ...settings,
  theme_config: {
    ...themeConfig,
    theme: {
      ...themeConfig.theme,
      primaryColor: '#FFFFFF', // Noir White
      secondaryColor: '#111111',
      textColor: '#FFFFFF',
      bgColor: '#111111',
      fontHeading: 'CVR',
      fontBody: 'Josefin Sans'
    }
  }
};

const formattedDate = formatDate(wedding.wedding_date);

const activeEvents = events && events.length > 0
  ? events
  : [{
      id: 'fallback',
      event_name: 'Akad Nikah',
      event_date: wedding.wedding_date,
      start_time: '09:00',
      end_time: 'Selesai',
      venue_name: wedding.venue_name,
      venue_address: wedding.venue_address,
      maps_url: wedding.maps_url,
      sort_order: 0,
      wedding_id: wedding.id,
      created_at: ''
    }];

const googleCalendarUrl = buildGoogleCalendarUrl(wedding as any, activeEvents[0] as any);

const themeAssets = themeConfig.assets || {};
const heroImage = themeAssets.heroImage || bgHero.src;
const heroSlides = [
  themeAssets.heroImage || bgHero,
  themeAssets.heroImageTwo || galleryOne,
  themeAssets.heroImageThree || gallerySix.src
].filter(Boolean);
const videoUrl = themeAssets.videoUrl || themeAssets.heroVideo || 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm';
const videoPoster = themeAssets.videoPoster || themeAssets.posterImage || heroImage;
const brideImage = themeAssets.brideImage || coupleBride.src;
const groomImage = themeAssets.groomImage || coupleGroom.src;
const instagramUrl = themeContent.instagramUrl || platformSettings.instagram_url || 'https://instagram.com';
const _baseWa = themeContent.whatsappUrl || platformSettings.whatsapp_url || '';
const _themeName = (wedding.template || 'Template').charAt(0).toUpperCase() + (wedding.template || 'Template').slice(1);
const whatsappUrl = _baseWa ? `${_baseWa}${_baseWa.includes('?') ? '&' : '?'}text=${encodeURIComponent('Halo Admin, saya tertarik untuk membuat undangan digital dengan tema *' + _themeName + '*. Boleh minta informasi mengenai cara pemesanannya?')}` : '';
const groomInstagramUrl = themeContent.groomInstagramUrl || instagramUrl;
const brideInstagramUrl = themeContent.brideInstagramUrl || instagramUrl;
const giftDescription = themeContent.giftDescription || 'Bagi Bapak/Ibu/Saudara/i yang ingin mengirimkan hadiah kasih, dapat melalui transfer rekening berikut:';
const thankYouMessage = themeContent.closingMessage || 'Merupakan suatu kebahagiaan dan kehormatan bagi kami, apabila Bapak/Ibu/Saudara/i berkenan hadir di hari bahagia kami.';
const buildParentLines = (
  roleText: string,
  fatherName: string | undefined,
  motherName: string | undefined,
  fallbackFamily: string
) => {
  const parents = [
    fatherName ? `Bapak ${fatherName}` : '',
    motherName ? `Ibu ${motherName}` : ''
  ].filter(Boolean).join(' & ');

  return parents ? [roleText, parents] : [roleText, fallbackFamily];
};
const brideParentLines = buildParentLines(
  'Putri dari',
  themeContent.brideFatherName,
  themeContent.brideMotherName,
  'Keluarga Mempelai Wanita'
);
const groomParentLines = buildParentLines(
  'Putra dari',
  themeContent.groomFatherName,
  themeContent.groomMotherName,
  'Keluarga Mempelai Pria'
);
const activeGallery = gallery && gallery.length > 0
  ? gallery.map((image, index) => ({
      id: image.id,
      image_url: image.image_url,
      variant: index === 0 || index === 5 ? 'full-16x10' : 'half'
    }))
  : customGallery;
const galleryColumns = themeConfig.layout?.galleryColumns || 3;
const galleryColClass = galleryColumns === 2
  ? 'gallery-grid--col2'
  : galleryColumns === 4
    ? 'gallery-grid--col4'
    : 'gallery-grid--col3';

const isWishesEmpty = !wishes || wishes.length === 0;
const displayedWishes = wishes ? wishes.slice(0, 3) : [];
const hasMoreWishes = wishes ? wishes.length > displayedWishes.length : false;

const activeGifts = gifts && gifts.length > 0
  ? gifts
  : [
      { id: '1', bank_name: 'BCA', account_number: '1234567890', account_name: 'Sony Pratama', qris_url: null },
      { id: '2', bank_name: 'Bank Mandiri', account_number: '0987654321', account_name: 'Pratiwi Indah', qris_url: null }
    ];

---

<BaseLayout
  wedding={wedding}
  settings={overrideSettings}
  to={guestName}
  templateClass="template-noir"
  image={heroImage}
>
  <div class="invitation-root" data-template-root>
    <CinematicIntro
      groomName={wedding.groom_name}
      brideName={wedding.bride_name}
      coverImage={heroImage}
    />
    <!-- ===================== COVER SCREEN ===================== -->
    <div class="cover-section" data-template-cover>
      <SmartImage class="section-bg section-bg--cover" src={heroImage} alt="" aria-hidden="true" />
      <div class="cover-section__body">
        <p class="cover-section__eyebrow">The Wedding Of</p>
        <h2 class="cover-section__names">
          {wedding.groom_name}
          <span class="cover-section__amp">&amp;</span>
          {wedding.bride_name}
        </h2>
        <div class="cover-section__divider"></div>
        <div class="cover-section__guest">
          <p class="cover-section__guest-label">Kepada Yth.</p>
          <p class="cover-section__guest-name">{guestName || 'Nama Tamu'}</p>
          <button class="cover-section__btn" data-template-open aria-label="Open Invitation">
            Open Invitation
          </button>
        </div>
      </div>
    </div>

    <!-- ===================== MAIN LAYOUT ===================== -->
    <div class="invitation-layout" data-template-layout>

      <!-- LEFT FIXED SIDEBAR (desktop only) -->
      <div class="sidebar-section-wrap">
        <aside class="sidebar-section">
          <SmartImage class="section-bg section-bg--sidebar" src={heroImage} alt="" aria-hidden="true" />
          <div class="sidebar-section__inner" data-animate="fade-up" style="--animate-delay: 300ms;">
            <p class="sidebar-section__eyebrow">The Wedding Of</p>
            <h2 class="sidebar-section__groom">{wedding.groom_name}</h2>
            <div class="sidebar-section__sep">&amp;</div>
            <h2 class="sidebar-section__bride">{wedding.bride_name}</h2>
            <div class="sidebar-section__divider">
              <span class="sidebar-section__date">{formattedDate}</span>
            </div>
          </div>
        </aside>
      </div>

      <!-- RIGHT SCROLLABLE CONTENT -->
      <main class="invitation-main">

        <!-- Hero (right column top) -->
        <div class="hero-section" data-noir-hero-slider>
          <div class="hero-section__slides" aria-hidden="true">
            {heroSlides.map((slide, index) => (
              <SmartImage class={`hero-section__slide ${index === 0 ? 'is-active' : ''}`} src={slide} alt="" />
            ))}
          </div>
          <div class="hero-section__inner" data-animate="fade-up" style="--animate-delay: 400ms;">
            <p class="hero-section__eyebrow">The Wedding Of</p>
            <h3 class="hero-section__groom">{wedding.groom_name}</h3>
            <div class="hero-section__divider"><span>&amp;</span></div>
            <h3 class="hero-section__bride">{wedding.bride_name}</h3>
            <div class="hero-section__arrow">
              <a href="#template-content" aria-label="Scroll down">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 5v14M19 12l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Opening verse -->
        <div class="opening-section" data-animate="fade-up" style="--animate-delay: 300ms;">
          <div class="opening-section__ornament"></div>
          <p class="opening-section__verse">
            "Ihaiva stam mā vi yaustam, Visvām āyur vyasnutam. Krindantau putrair naptrbhih, Modamānau sve grhe."
            <strong>(Rgveda : X.85.42)</strong>
          </p>
        </div>

        <div id="template-content" class="sections-stack">

          <!-- ===== COUPLE SECTION ===== -->
          {sections.coupleInfo && (
            <section class="couple-section" id="mempelai">
              {/* <div class="couple-section__greeting">
                <p>
                  <strong>Assalamu'alaikum Warahmatullahi Wabarakatuh</strong><br /><br />
                  Maha Suci Allah yang telah menciptakan makhluk-Nya berpasang-pasangan.
                  Ya Allah semoga ridho-Mu tercurah mengiringi pernikahan kami.
                </p>
              </div> */}

              <div class="couple-section__row">
                <!-- Bride card -->
                <div class="person-card" data-animate="fade-right" style="--animate-delay: 500ms;">
                  <div class="person-card__photo-wrap">
                    <SmartImage
                      class="person-card__photo"
                      src={brideImage}
                      alt={wedding.bride_name}
                      loading="lazy"
                    />
                  </div>
                  <p class="person-card__role">Bride</p>
                  <p class="person-card__fullname">{wedding.bride_full_name}</p>
                  <p class="person-card__parents">
                    {brideParentLines.map((line, index) => (
                      <>
                        {index > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </p>
                  <a class="person-card__social" href={brideInstagramUrl} target="_blank" rel="noopener noreferrer" aria-label={`${wedding.bride_name} Instagram`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                      <circle cx="12" cy="12" r="4"></circle>
                      <circle cx="17.5" cy="6.5" r="1"></circle>
                    </svg>
                    <span>Instagram</span>
                  </a>
                </div>

                <!-- Ampersand -->
                <div class="couple-section__amp" data-animate="zoom-in" style="--animate-delay: 500ms;">&amp;</div>

                <!-- Groom card -->
                <div class="person-card" data-animate="fade-left" style="--animate-delay: 800ms;">
                  <div class="person-card__photo-wrap">
                    <SmartImage
                      class="person-card__photo"
                      src={groomImage}
                      alt={wedding.groom_name}
                      loading="lazy"
                    />
                  </div>
                  <p class="person-card__role">Groom</p>
                  <p class="person-card__fullname">{wedding.groom_full_name}</p>
                  <p class="person-card__parents">
                    {groomParentLines.map((line, index) => (
                      <>
                        {index > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </p>
                  <a class="person-card__social" href={groomInstagramUrl} target="_blank" rel="noopener noreferrer" aria-label={`${wedding.groom_name} Instagram`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                      <circle cx="12" cy="12" r="4"></circle>
                      <circle cx="17.5" cy="6.5" r="1"></circle>
                    </svg>
                    <span>Instagram</span>
                  </a>
                </div>
              </div>
            </section>
          )}

          <!-- ===== EVENT DETAILS ===== -->
          {sections.eventDetails && (
            <section class="events-section">
              <div class="events-section__header" data-animate="fade-up" data-stagger-heading style="--animate-delay: 200ms;">
                {/* <p class="section-eyebrow">Wedding Events</p> */}
                <h3 class="section-title">Save<br>The Date</h3>
              </div>

              <div class="events-section__cards">
                {activeEvents.map((evt, index) => (
                  <div class="event-card" data-animate="fade-up" style={`--animate-delay: ${300 + index * 250}ms;`}>
                    <div class="event-card__icon">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                    </div>
                    <p class="event-card__name">{evt.event_name}</p>
                    <div class="event-card__sep"></div>
                    <div>
                      <p class="event-card__date">{formatDate(evt.event_date)}</p>
                      <p class="event-card__time">{evt.start_time} - {evt.end_time}</p>
                    </div>
                    <div>
                      <p class="event-card__venue-name">{evt.venue_name}</p>
                      <p class="event-card__venue-addr">{evt.venue_address}</p>
                    </div>
                    <a
                      href={evt.maps_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="event-card__map-btn"
                    >
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                      Open Maps
                    </a>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- ===== COUNTDOWN ===== -->
        {sections.countdown && (
          <div class="countdown-section">
            {/* <h2 class="countdown-section__title">Save The Date</h2> */}
            {settings.countdown_enabled && (
              <div class="countdown-section__timer" data-animate="fade-up" style="--animate-delay: 300ms;">
                <div class="countdown-card glassmorphism">
                  <CountdownTimer date={wedding.wedding_date} />
                </div>
              </div>
            )}
            <a
              href={googleCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="countdown-section__calendar-btn"
              data-animate="zoom-in"
              style="--animate-delay: 500ms;"
              aria-label="Save wedding date to Google Calendar"
            >
              Save to Google Calendar
            </a>
          </div>
        )}

          <!-- ===== VIDEO ===== -->
          <section class="video-section">
            <div class="video-section__frame" data-template-video data-animate="blur-up" style="--animate-delay: 300ms;">
              <video class="video-section__media" src={videoUrl} poster={videoPoster} playsinline preload="metadata"></video>
              <button class="video-section__play" type="button" data-template-video-play aria-label="Play wedding video">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5.14v13.72c0 .78.86 1.26 1.53.84l10.78-6.86a1 1 0 0 0 0-1.68L9.53 4.3A1 1 0 0 0 8 5.14Z"></path>
                </svg>
              </button>
            </div>
          </section>

          <!-- ===== GALLERY ===== -->
          {sections.gallery && (
            settings.gallery_enabled && (
              <>
                <section class="gallery-section">
                  <div class="gallery-container">
                    <div class="gallery-header" data-animate="fade-up" data-stagger-heading style="--animate-delay: 200ms;">
                      <h2 class="section-title">Our Gallery</h2>
                      <div class="section-rule"></div>
                    </div>

                    <div class={`gallery-grid ${galleryColClass}`}>
                      {activeGallery.map((img, index) => (
                        <a
                          href={typeof img.image_url === 'string' ? img.image_url : img.image_url.src}
                          class={`gallery-item gallery-item--${img.variant}`}
                          data-animate="zoom-in"
                          style={`--animate-delay: ${200 + (index % galleryColumns) * 200}ms;`}
                          data-fancybox="gallery-section"
                        >
                          <SmartImage src={img.image_url} alt="Wedding Gallery Moment" loading="lazy" class="gallery-item__img" />
                          <div class="gallery-item__overlay">
                            <div class="gallery-item__zoom">
                              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                              </svg>
                            </div>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                </section>
              </>
            )
          )}

          <!-- ===== RSVP & WISHES ===== -->
          {sections.rsvp && (
            settings.rsvp_enabled && (
              <section class="rsvp-section" data-rsvp-section>
                <div class="rsvp-container">
                  <div class="rsvp-header" data-animate="fade-up" data-stagger-heading style="--animate-delay: 200ms;">
                    <h3 class="section-title">RSVP & Wishes</h3>
                    <p class="rsvp-subtitle">Mohon konfirmasi kehadiran Anda dan berikan doa restu.</p>
                  </div>

                  <div class="rsvp-panel" data-animate="fade-up" style="--animate-delay: 400ms;">
                    <div class="rsvp-card">
                      <div class="rsvp-success" data-rsvp-success style="display:none;">
                        <div class="rsvp-success__icon">
                          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                        </div>
                        <h4 class="rsvp-success__title">Terima Kasih!</h4>
                        <p class="rsvp-success__desc">Konfirmasi kehadiran dan ucapan Anda telah berhasil kami simpan.</p>
                      </div>

                      <form class="rsvp-form" data-rsvp-form>
                        <input type="hidden" name="weddingId" value={wedding.id} />
                        <div class="rsvp-form__field">
                          <input type="text" id="rsvp-name" name="name" required placeholder="Nama" class="rsvp-form__input" />
                        </div>
                        <div class="rsvp-form__field">
                          <select id="rsvp-attendance" name="attendance" required class="rsvp-form__select" data-rsvp-attendance>
                            <option value="" disabled>Konfirmasi Kehadiran</option>
                            <option value="attending" selected>Hadir</option>
                      <option value="tentative">Ragu</option>
                            <option value="declined">Tidak Hadir</option>
                          </select>
                        </div>
                        <div class="rsvp-form__field">
                          <select name="count" class="rsvp-form__select">
                            <option value="1" selected>1 Orang</option>
                            <option value="2">2 Orang</option>
                            <option value="3">3 Orang</option>
                            <option value="4">4 Orang</option>
                            <option value="5">5 Orang</option>
                          </select>
                        </div>
                        <div class="rsvp-form__field">
                          <textarea id="rsvp-message" name="message" rows="4" placeholder="Ucapan" class="rsvp-form__textarea"></textarea>
                        </div>
                        <div class="rsvp-form__error" data-rsvp-error style="display:none;"></div>
                        <button type="submit" class="rsvp-form__submit" data-rsvp-submit>Submit</button>
                      </form>
                    </div>

                    <div class="wishes-list" data-wishes-list>
                      <div class="wishes-empty" data-wishes-empty style={isWishesEmpty ? '' : 'display:none;'}>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <span>Belum ada ucapan. Jadilah yang pertama memberikan doa restu!</span>
                      </div>

                      {displayedWishes.map((wish, index) => (
                        <div
                          class="wish-card animate-fade-in-up"
                          data-animate="fade-up"
                          style={`--animate-delay: ${200 + index * 200}ms;`}
                          data-wish-id={wish.id}
                          data-wish-key={wish.id || `${wish.created_at}|${wish.guest_name}|${wish.message || ''}`}
                        >
                          <div class="wish-card__header">
                            <div class="wish-card__meta">
                              <span class="wish-card__name">{wish.guest_name}</span>
                              <span class={`wish-card__badge ${wish.attendance_status === "attending" ? "wish-card__badge--attend" : wish.attendance_status === "tentative" ? "wish-card__badge--tentative" : "wish-card__badge--absent"}`}>
                                {wish.attendance_status === "attending" ? "Hadir" : wish.attendance_status === "tentative" ? "Ragu" : "Absen"}
                              </span>
                            </div>
                            <span class="wish-card__date">{formatWishDate(wish.created_at)}</span>
                          </div>
                          <p class="wish-card__message">{wish.message}</p>
                        </div>
                      ))}
                    </div>
                    {hasMoreWishes && (
                      <button class="wishes-load-more" data-wishes-load-more data-offset={displayedWishes.length} data-wedding-id={wedding.id}>
                        Load More
                      </button>
                    )}
                  </div>
                </div>
              </section>
            )
          )}

          <!-- ===== GIFT ===== -->
          {sections.gift && (
            settings.gift_enabled && (
              <>
                <section class="gift-section" data-gift-section>
                  <div class="gift-container">
                    <div class="gift-header" data-animate="fade-up" data-stagger-heading style="--animate-delay: 200ms;">
                      <h3 class="section-title">Wedding Gift</h3>
                      <p class="gift-desc">{giftDescription}</p>
                      <div class="section-rule"></div>
                    </div>

                    <GiftGrid gifts={activeGifts} />
                  </div>
                </section>

                </>
            )
          )}

        </div>

        <!-- Thank You -->
        <section class="thankyou-section">
          <SmartImage class="thankyou-section__bg" src={heroImage} alt="" aria-hidden="true" />
          <div class="thankyou-section__inner" data-animate="fade-up" style="--animate-delay: 300ms;">
            <h2 class="thankyou-section__title">Terima Kasih</h2>
            <div class="thankyou-section__socials">
              <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" xmlns="http://www.w3.org/2000/svg">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1"></circle>
                </svg>
              </a>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
                class="social-link"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Zm4.23-5.78c-.23-.12-1.37-.68-1.58-.75-.21-.08-.37-.12-.52.12-.16.23-.6.75-.74.9-.14.16-.27.18-.5.06-.23-.12-.98-.36-1.86-1.15-.69-.61-1.15-1.36-1.28-1.59-.14-.23-.02-.36.1-.48.11-.11.23-.27.35-.41.12-.14.16-.23.23-.39.08-.16.04-.29-.02-.41-.06-.12-.52-1.25-.71-1.71-.19-.45-.38-.39-.52-.4h-.45c-.16 0-.41.06-.62.29-.21.23-.81.79-.81 1.93 0 1.14.83 2.24.95 2.4.12.16 1.64 2.5 3.98 3.51.56.24.99.38 1.33.49.56.18 1.07.15 1.47.09.45-.07 1.37-.56 1.57-1.1.19-.54.19-1 .14-1.1-.06-.1-.21-.16-.44-.28Z"
                  ></path>
                </svg>
              </a>
              <a href="/" aria-label="Website" class="social-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path></svg>
              </a>
            </div>
            <p class="thankyou-section__brand-text">wedding invitation by <span>Senadda</span></p>
          </div>
        </section>

      </main>
    </div>

    <!-- Floating Audio Player -->
    {sections.music && (
              <button class="audio-toggle" data-template-audio-toggle type="button" aria-label="Play or pause music">
          <div class="audio-icon-wrapper">
            <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
          </div>
          {settings.music_enabled && wedding.music_url && (
            <audio data-template-audio loop src={wedding.music_url}></audio>
          )}
        </button>
    )}

  </div>
</BaseLayout>

<script>
  import './script.js';
</script>



