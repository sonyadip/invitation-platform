---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClassicIntro from "../../components/common/ClassicIntro.astro";
import SmartImage from "../../components/common/SmartImage.astro";
import CountdownTimer from "../../components/common/CountdownTimer.astro";
import type { FullInvitationData } from '../../types';
import { getPlatformSettings } from '../../services/platform-settings';

import bgHero from '../noir/assets/bg-hero.webp';
import coupleBride from '../noir/assets/couple-bride.jpg';
import coupleGroom from '../noir/assets/couple-groom.jpg';
import coverImg from './assets/cover.webp';
import galleryOne from '../noir/assets/gallery-1.jpg';
import galleryTwo from '../noir/assets/gallery-2.jpg';
import galleryThree from '../noir/assets/gallery-3.jpg';
import galleryFour from '../noir/assets/gallery-4.jpg';
import galleryFive from '../noir/assets/gallery-5.jpg';
import gallerySix from '../noir/assets/gallery-6.jpg';
import gallerySeven from '../noir/assets/gallery-7.jpg';
import galleryEight from '../noir/assets/gallery-8.webp';

import dividerFlourish from './assets/divider-flower.png';

import '@fancyapps/ui/dist/fancybox/fancybox.css';
import styleUrl from './style.scss?url';

import {
  formatChildPrefix,
  buildCoupleLines,
  formatDate,
  buildGoogleCalendarUrl,
  getInstagramUsername,
  formatWishDate,
  generatePaginationItems,
  decodeHtmlEntities,
  getBankLogoUrl
} from '../../utils/template-helpers';

interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings, events, gallery, gifts, wishes } = data;
const sections = settings.sections || ({} as any);

const isPreview = wedding.id.startsWith('preview-');

const groomNickname = (wedding.groom_name === 'Rah Agus' ? 'Agus' : wedding.groom_name) || 'Agus';
const brideNickname = wedding.bride_name || 'Meita';
const groomFullName = wedding.groom_full_name || wedding.groom_name || 'I Wayan Yudi Artayasa';
const brideFullName = wedding.bride_full_name || wedding.bride_name || 'Ni Kadek Meita Widiantari';

const themeConfig = (settings.theme_config || {
  theme: {},
  layout: { galleryColumns: 3 },
  assets: {}
}) as any;
const themeContent = themeConfig.content || {};
const platformSettings = await getPlatformSettings();

const overrideSettings = {
  ...settings,
  theme_config: {
    ...themeConfig,
    theme: {
      ...themeConfig.theme,
      primaryColor: '#121212',
      secondaryColor: '#444444',
      textColor: '#444444',
      bgColor: '#FFFFFF',
      fontHeading: 'Gallery Modern',
      fontBody: 'Montserrat'
    }
  }
};

const wDate = new Date(wedding.wedding_date || '2026-12-22');
const dayStr = String(wDate.getDate()).padStart(2, '0');
const monthStr = String(wDate.getMonth() + 1).padStart(2, '0');
const yearStr = String(wDate.getFullYear());
const yearShortStr = yearStr.slice(-2);
const spacedDotDate = `${dayStr} • ${monthStr} • ${yearStr}`;

const activeEvents = events && events.length > 0
  ? events
  : [
      {
        id: 'event-ceremony',
        event_name: 'Pernikahan',
        event_date: '2026-12-22',
        start_time: '08:00',
        end_time: '12:00 WITA',
        venue_name: 'The Royal Garden',
        venue_address: 'Jl. Pantai Indah No. 8, Bali',
        maps_url: wedding.maps_url || 'https://maps.google.com',
        sort_order: 1,
        wedding_id: wedding.id,
        created_at: ''
      },
      {
        id: 'event-reception',
        event_name: 'Resepsi',
        event_date: '2026-12-22',
        start_time: '13:00 WITA',
        end_time: 'Selesai',
        venue_name: 'The Royal Garden',
        venue_address: 'Jl. Pantai Indah No. 8, Bali',
        maps_url: wedding.maps_url || 'https://maps.google.com',
        sort_order: 2,
        wedding_id: wedding.id,
        created_at: ''
      }
    ];

const ceremonyEvent = activeEvents[0];
const receptionEvent = activeEvents.length > 1 ? activeEvents[1] : activeEvents[0];

const ceremonyDateObj = new Date(ceremonyEvent?.event_date || wedding.wedding_date || '2026-12-22');
const ceremonyDayName = ceremonyDateObj.toLocaleDateString('id-ID', { weekday: 'long' }).toUpperCase();
const ceremonyDayNum = String(ceremonyDateObj.getDate()).padStart(2, '0');
const ceremonyMonthYear = ceremonyDateObj.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }).toUpperCase();

const receptionDateObj = new Date(receptionEvent?.event_date || wedding.wedding_date || '2026-12-22');
const receptionDayName = receptionDateObj.toLocaleDateString('id-ID', { weekday: 'long' }).toUpperCase();
const receptionDayNum = String(receptionDateObj.getDate()).padStart(2, '0');
const receptionMonthYear = receptionDateObj.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }).toUpperCase();

function formatCleanTime(startTime?: string, endTime?: string): string {
  if (!startTime) return '';
  const s = startTime.trim().replace(/^pukul\s*:\s*/i, '');
  const e = endTime ? endTime.trim().replace(/^pukul\s*:\s*/i, '') : '';

  if (!e) return s;
  return `${s} - ${e}`;
}

function formatTitleCaseIfNeeded(str?: string): string {
  if (!str) return '';
  if (/[a-z]/.test(str) && /[A-Z]/.test(str)) {
    return str;
  }
  return str
    .toLowerCase()
    .split(' ')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

const themeAssets = themeConfig.assets || {};
const coverImage = themeAssets.coverImage || 'https://media.senadda.id/rah-agus-komala/closing/closing.webp';
const heroImage = themeAssets.heroImage || bgHero.src;
const brideImage = themeAssets.brideImage || coupleBride.src;
const groomImage = themeAssets.groomImage || coupleGroom.src;
const closingImage = themeAssets.closingImage || 'https://media.senadda.id/rah-agus-komala/closing/closing.webp';

const quotePhoto = galleryThree.src;
const theWaitBg = galleryFour.src;
const eventCeremonyBg = galleryOne.src;
const eventReceptionBg = galleryFive.src;
const rsvpBg = galleryTwo.src;
const streamPhoto = galleryFive.src;

const googleCalendarUrl = ceremonyEvent ? buildGoogleCalendarUrl(wedding as any, ceremonyEvent as any) : '';

const defaultGallery = [
  { id: '1', image_url: galleryOne.src, variant: 'full' },
  { id: '2', image_url: galleryTwo.src, variant: 'half' },
  { id: '3', image_url: galleryThree.src, variant: 'half' },
  { id: '4', image_url: galleryFour.src, variant: 'half' },
  { id: '5', image_url: galleryFive.src, variant: 'half' },
  { id: '6', image_url: gallerySix.src, variant: 'half' },
  { id: '7', image_url: gallerySeven.src, variant: 'half' }
];

const activeGallery = gallery && gallery.length > 0
  ? gallery.map((image, index) => ({
      id: image.id,
      image_url: typeof image.image_url === 'string' ? image.image_url : (image.image_url as any)?.src || galleryOne.src,
      variant: index === 0 || index === 7 ? 'full' : 'half'
    }))
  : defaultGallery;

const _themeName = 'Nocturne';

const rawSliderImages = [
  coverImage,
  ...(themeAssets.bgSliderImages && themeAssets.bgSliderImages.length > 0
    ? themeAssets.bgSliderImages
    : (themeAssets.sliderImages && themeAssets.sliderImages.length > 0
        ? themeAssets.sliderImages
        : (activeGallery && activeGallery.length > 0
            ? activeGallery.map((g: any) => g.image_url).filter(Boolean)
            : [heroImage, brideImage, groomImage, galleryOne.src, galleryTwo.src])))
].filter(Boolean);

const seenSliderUrls = new Set<string>();
const sliderImages = rawSliderImages.filter((url) => {
  const key = typeof url === 'string' ? url : (url as any)?.src || '';
  if (!key || seenSliderUrls.has(key)) return false;
  seenSliderUrls.add(key);
  return true;
});
if (sliderImages.length === 0 && coverImage) sliderImages.push(coverImage);

const brideFather = themeContent.brideFatherName || 'Bapak Mempelai';
const brideMother = themeContent.brideMotherName || 'Ibu Mempelai';
const bridePrefix = formatChildPrefix(wedding.bride_child_position || themeContent.brideChildPosition, 'Putri', null, isPreview ? 'Putri Pertama dari' : 'Putri dari');

const groomFather = themeContent.groomFatherName || 'Bapak Mempelai';
const groomMother = themeContent.groomMotherName || 'Ibu Mempelai';
const groomPrefix = formatChildPrefix(wedding.groom_child_position || themeContent.groomChildPosition, 'Putra', null, isPreview ? 'Putra Kedua dari' : 'Putra dari');

const brideInstagramUrl = themeContent.brideInstagramUrl || (wedding.bride_instagram ? `https://instagram.com/${wedding.bride_instagram.replace('@', '')}` : null);
const groomInstagramUrl = themeContent.groomInstagramUrl || (wedding.groom_instagram ? `https://instagram.com/${wedding.groom_instagram.replace('@', '')}` : null);

const instagramUrl = themeContent.instagramUrl || platformSettings?.instagram_url || 'https://instagram.com/senadda.id';
const _baseWa = themeContent.whatsappUrl || platformSettings?.whatsapp_url || '';
const whatsappUrl = _baseWa ? `${_baseWa}${_baseWa.includes('?') ? '&' : '?'}text=${encodeURIComponent('Halo Admin, saya tertarik untuk membuat undangan digital dengan tema *' + _themeName + '*. Boleh minta informasi mengenai cara pemesanannya?')}` : '';
const closingTitle = themeContent.thankYouTitle || themeContent.closingTitle || 'Terima Kasih';
const closingMessage = themeContent.thankYouMessage || themeContent.closingMessage || 'Merupakan suatu kebahagiaan dan kehormatan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir di hari bahagia kami.';

const defaultGifts = [
  {
    id: 'gift-1',
    bank_name: 'BCA',
    account_number: '0123 456 789',
    account_name: groomFullName,
    bank_logo: undefined
  },
  {
    id: 'gift-2',
    bank_name: 'MANDIRI',
    account_number: '123 456 7891',
    account_name: brideFullName,
    bank_logo: undefined
  }
];

const activeGifts = gifts && gifts.length > 0
  ? gifts.map((g) => ({
      id: g.id,
      bank_name: g.bank_name,
      account_number: g.account_number,
      account_name: g.account_name,
      bank_logo: (g as any).bank_logo
    }))
  : defaultGifts;

const displayedWishes = wishes && wishes.length > 0 ? wishes.slice(0, 4) : [];
const isWishesEmpty = !wishes || wishes.length === 0;
const totalWishPages = Math.ceil((wishes?.length || 0) / 4);

function getInitials(name: string): string {
  if (!name) return '??';
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[1][0]).toUpperCase();
}

const activeMusicUrl = wedding.music_url || themeAssets.musicUrl || (isPreview ? 'https://media.senadda.id/audio/banda-neira-sampai-jadi-debu.mp3' : undefined);
---

<BaseLayout
  wedding={wedding}
  settings={overrideSettings}
  to={guestName}
  templateClass={`template-nocturne${sections.introAnimation !== false ? " has-intro" : ""}`}
  image={coverImage}
  styleUrl={styleUrl}
>
  <div class="invitation-root" data-template-root>
    {sections.introAnimation !== false && (
      <ClassicIntro
        groomName={groomNickname}
        brideName={brideNickname}
        subtitle="The Wedding Of"
      />
    )}

    <div class="cover" data-template-cover id="sec">
      <SmartImage class="cover__bg" src={coverImage} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
      <div class="cover__overlay"></div>

      <div class="cover__inner" id="kolom">
        <header class="cover__header">
          <p class="cover__eyebrow">THE WEDDING OF</p>
          <h1 class="cover__names">
            <span class="cover__names-line">{brideNickname} <span class="cover__slash">/</span> {groomNickname}</span>
          </h1>
        </header>

        <div class="cover__guest-box">
          <p class="cover__dear">KEPADA YTH.</p>
          <h2 class="cover__guest-name">{guestName || 'Nama Tamu'}</h2>

          <button class="cover__btn" data-template-open aria-label="Buka Undangan">
            <span>BUKA UNDANGAN</span>
          </button>
        </div>
      </div>
    </div>

    <div class="layout" data-template-layout>

      <aside class="sidebar" id="desk_cov">
        <SmartImage class="sidebar__bg" src={coverImage} alt="" aria-hidden="true" />
        <div class="sidebar__overlay"></div>
        <div class="sidebar__content">
          <p class="sidebar__eyebrow" data-animate="fade-up" style="--animate-delay: 200ms;">The Wedding of</p>
          <h2 class="sidebar__names" data-animate="fade-up" style="--animate-delay: 450ms;">
            <span>{brideNickname}</span>
            <span class="script-and">and</span>
            <span>{groomNickname}</span>
          </h2>
          <div class="sidebar__date" data-animate="fade-up" style="--animate-delay: 700ms;">
            <span>{spacedDotDate}</span>
          </div>
        </div>
      </aside>

      <main class="main-content" id="isi">

        <div class="main-bg-slider" data-main-bg-slider aria-hidden="true">
          <div class="main-bg-slider__slides">
            {sliderImages.map((slide: string, index: number) => (
              <SmartImage
                class={`main-bg-slider__slide ${index === 0 ? 'is-active' : ''}`}
                src={slide}
                alt=""
                aria-hidden="true"
              />
            ))}
          </div>
          <div class="main-bg-slider__overlay"></div>
        </div>

        <section class="hero" id="hero">

          <div class="hero__inner">
            <div class="hero__kicker" data-animate="fade-up" style="--animate-delay: 200ms;">The Wedding Of</div>
            <div class="hero__rule" data-animate="expand-x" data-animate-origin="right" style="--animate-delay: 450ms;"></div>

            <div class="hero__names">
              <h1 class="hero__title" data-animate="fade-up" style="--animate-delay: 350ms;">{brideNickname}</h1>
              <h1 class="hero__title" data-animate="fade-up" style="--animate-delay: 500ms;">{groomNickname}</h1>
            </div>

            <div class="hero__timeline">
              <div class="hero__v-line hero__v-line-top" data-animate="expand-y" data-animate-origin="bottom" style="--animate-delay: 1100ms;"></div>
              <div class="hero__date-stacked" data-animate="fade-up">
                <span>{dayStr}</span>
                <span class="hero__dot">•</span>
                <span>{monthStr}</span>
                <span class="hero__dot">•</span>
                <span>{yearShortStr}</span>
              </div>
              <div class="hero__v-line hero__v-line-bottom" data-animate="expand-y" data-animate-origin="top" style="--animate-delay: 1400ms;"></div>
            </div>
          </div>

          <p class="quote-section__verse" data-animate="fade-up" style="--animate-delay: 800ms;">"Ihaiva stam mā vi yaustam, Visvām āyur vyasnutam. Krindantau putrair naptrbhih, Modamānau sve grhe." <strong>(Rgveda : X.85.42)</strong> 
          </p>
        </section>

        {sections.coupleInfo !== false && (
          <section class="couple-section" id="mempelai">
            
            <article class="couple-card couple-card--groom">
              <div class="couple-card__heading" data-animate="fade-up" style="--animate-delay: 150ms;">
                <h2>The<br>Groom</h2>
              </div>
              <div class="couple-card__photo-wrap couple-card__photo-wrap--right">
                <div class="couple-card__line-v couple-card__line-v--right" data-animate="expand-y" data-animate-origin="top" style="--animate-delay: 350ms;"></div>
                <div class="couple-card__line-h couple-card__line-h--right" data-animate="expand-x" data-animate-origin="right" style="--animate-delay: 650ms;"></div>
                <div class="couple-card__photo" data-animate="fade-up" style="--animate-delay: 200ms;">
                  <SmartImage src={groomImage} alt={groomNickname} />
                </div>
              </div>

              <div class="couple-card__info">
                <h3 class="couple-card__name" data-animate="fade-up" style="--animate-delay: 750ms;">{groomFullName}</h3>
                <p class="couple-card__parents" data-animate="fade-up" style="--animate-delay: 1000ms;">
                  {groomPrefix}<br />
                  {groomFather} &amp;<br />
                  {groomMother}
                </p>

                {(groomInstagramUrl || isPreview) && (
                  <a class="couple-card__instagram" href={groomInstagramUrl || 'https://instagram.com'} target="_blank" rel="noopener noreferrer" data-animate="fade-up" style="--animate-delay: 1250ms;">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                    <span>@{getInstagramUsername(groomInstagramUrl) || wedding.groom_instagram || 'instagram'}</span>
                  </a>
                )}
              </div>
            </article>

            <div class="couple-section__amp" data-animate="fade-up" style="--animate-delay: 300ms;">&amp;</div>
            
            <article class="couple-card couple-card--bride">
              <div class="couple-card__heading" data-animate="fade-up" style="--animate-delay: 150ms;">
                <h2>The<br>Bride</h2>
              </div>
              <div class="couple-card__photo-wrap couple-card__photo-wrap--left">
                <div class="couple-card__line-v couple-card__line-v--left" data-animate="expand-y" data-animate-origin="top" style="--animate-delay: 350ms;"></div>
                <div class="couple-card__line-h couple-card__line-h--left" data-animate="expand-x" data-animate-origin="left" style="--animate-delay: 650ms;"></div>
                <div class="couple-card__photo" data-animate="fade-up" style="--animate-delay: 200ms;">
                  <SmartImage src={brideImage} alt={brideNickname} />
                </div>
              </div>

              <div class="couple-card__info">
                <h3 class="couple-card__name" data-animate="fade-up" style="--animate-delay: 750ms;">{brideFullName}</h3>
                <p class="couple-card__parents" data-animate="fade-up" style="--animate-delay: 1000ms;">
                  {bridePrefix}<br />
                  {brideFather} &amp;<br />
                  {brideMother}
                </p>

                {(brideInstagramUrl || isPreview) && (
                  <a class="couple-card__instagram" href={brideInstagramUrl || 'https://instagram.com'} target="_blank" rel="noopener noreferrer" data-animate="fade-up" style="--animate-delay: 1250ms;">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                    <span>@{getInstagramUsername(brideInstagramUrl) || wedding.bride_instagram || 'instagram'}</span>
                  </a>
                )}
              </div>
            </article>

          </section>
        )}

        {sections.eventDetails !== false && (
          <section class="events-section" id="acara">

            <div class="events-section__inner">
              
              <div class="events-section__header" data-animate="fade-up">
                <h2 class="events-section__title" data-animate="fade-up">Wedding<br />Date</h2>
              </div>

              <div class="events-list">
                {activeEvents.map((evt, idx) => {
                  const isRight = idx % 2 === 1;
                  const evtDate = evt.event_date ? new Date(evt.event_date) : (wedding.wedding_date ? new Date(wedding.wedding_date) : new Date());
                  const validDate = isNaN(evtDate.getTime()) ? new Date('2026-12-22') : evtDate;

                  const dayName = validDate.toLocaleDateString('id-ID', { weekday: 'long' });
                  const dayNum = String(validDate.getDate());
                  const monthName = validDate.toLocaleDateString('id-ID', { month: 'long' });
                  const yearNum = String(validDate.getFullYear());

                  const timeFormatted = formatCleanTime(evt.start_time, evt.end_time);
                  const venueFormatted = formatTitleCaseIfNeeded(evt.venue_name);

                  return (
                    <article class={`event-card ${isRight ? 'event-card--right' : 'event-card--left'}`} data-animate="fade-up" style={`--animate-delay: ${idx * 220}ms;`}>
                      <div class="event-card__strip" data-animate="fade-up" style="--animate-delay: 80ms;">
                        <span class="event-card__strip-title">{evt.event_name}</span>
                      </div>

                      <div class="event-card__strip-border" aria-hidden="true" data-animate="expand-y" data-animate-origin="top" style="--animate-delay: 180ms;"></div>

                      <div class="event-card__body">
                        <div class="event-card__date-row" data-animate="fade-up" style="--animate-delay: 160ms;">
                          <span class="event-card__date-num">{dayNum}</span>
                          <div class="event-card__date-stack">
                            <span class="event-card__day">{dayName}</span>
                            <span class="event-card__month">{monthName}</span>
                            <span class="event-card__year">{yearNum}</span>
                          </div>
                        </div>

                        <div class="event-card__divider-h" aria-hidden="true" data-animate="expand-x" data-animate-origin="left" style="--animate-delay: 240ms;"></div>

                        <div class="event-card__details" data-animate="fade-up" style="--animate-delay: 320ms;">
                          {timeFormatted && (
                            <p class="event-card__time">{timeFormatted}</p>
                          )}

                          {venueFormatted && (
                            <p class="event-card__venue">{venueFormatted}</p>
                          )}

                          {evt.venue_address && (
                            <p class="event-card__address">{evt.venue_address}</p>
                          )}

                          {(evt.maps_url || wedding.maps_url) && (
                            <a
                              href={evt.maps_url || wedding.maps_url || '#'}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="event-card__link"
                              data-animate="fade-up"
                              style="--animate-delay: 400ms;"
                            >
                              <svg width="13" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                              </svg>
                              <span>Lihat Lokasi</span>
                            </a>
                          )}
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>

              <div class="events-section__countdown">
                <CountdownTimer
                  date={wedding.wedding_date || ceremonyEvent?.event_date || '2026-12-22'}
                  animateItems={true}
                  baseDelay={200}
                  staggerDelay={160}
                />
              </div>

              {googleCalendarUrl && (
                <div class="events-section__cal-wrap" data-animate="fade-up" style="--animate-delay: 880ms;">
                  <a href={googleCalendarUrl} target="_blank" rel="noopener noreferrer" class="events-section__cal-btn">
                    SAVE TO CALENDAR
                  </a>
                </div>
              )}

            </div>
          </section>
        )}

        {sections.gallery !== false && settings.gallery_enabled !== false && activeGallery.length > 0 && (
          <section class="gallery-section" id="gallery">
            <div class="gallery-container">
              <div class="gallery-header" data-animate="fade-up">
                <h2 class="section-title gallery-section__title" data-animate="fade-up">Our Gallery</h2>
                <div class="gallery-header__rule" data-animate="fade-up" style="--animate-delay: 150ms;"></div>
              </div>

              <div class="gallery-slider-wrap" data-gallery-slider data-animate="fade-up" style="--animate-delay: 280ms;">
                <button type="button" class="gallery-slider__nav gallery-slider__nav--prev" data-slider-prev aria-label="Foto sebelumnya">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>

                <div class="gallery-slider__viewport" data-slider-viewport>
                  <div class="gallery-slider__track" data-slider-track>
                    {activeGallery.map((img, idx) => (
                      <div class={`gallery-slider__slide ${idx === 0 ? 'is-active' : ''}`} data-slider-slide data-index={idx}>
                        <a
                          href={typeof img.image_url === 'string' ? img.image_url : img.image_url.src}
                          data-fancybox="gallery"
                          class="gallery-slider__link"
                        >
                          <SmartImage src={img.image_url} alt={`Gallery moment ${idx + 1}`} loading="lazy" />
                        </a>
                      </div>
                    ))}
                  </div>
                </div>

                <button type="button" class="gallery-slider__nav gallery-slider__nav--next" data-slider-next aria-label="Foto berikutnya">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              </div>

              {activeGallery.length > 1 && (
                <div class="gallery-grid">
                  {activeGallery.slice(1).map((image, index) => (
                    <a
                      class="gallery-item"
                      href={typeof image.image_url === 'string' ? image.image_url : image.image_url.src}
                      data-fancybox="gallery"
                      data-animate="fade-up"
                      style={`--animate-delay: ${(index % 2) * 140 + Math.floor(index / 2) * 80}ms;`}
                    >
                      <SmartImage
                        src={image.image_url}
                        alt="Wedding gallery moment"
                        loading="lazy"
                        class="gallery-item__img"
                      />
                      <div class="gallery-item__overlay">
                        <div class="gallery-item__zoom">
                          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="22" height="22">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                          </svg>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              )}

            </div>
          </section>
        )}
        {sections.rsvp !== false && settings.rsvp_enabled !== false && (
          <section class="rsvp-row" id="rsvp" data-rsvp-section>
            <div class="rsvp-row__content">
              <section class="rsvp-section" data-animate="fade-up">
                <div class="rsvp-container">
                  <div class="rsvp-header" data-animate="fade-up">
                    <h2 class="rsvp-header__title section-title rsvp-section__title" data-animate="fade-up">RSVP &amp;<br />WISHES</h2>
                    <div class="rsvp-header__rule-bottom" data-animate="expand-x" data-animate-origin="left" style="--animate-delay: 200ms;"></div>
                    <p class="rsvp-header__desc rsvp-section__desc" data-animate="fade-up" style="--animate-delay: 240ms;">
                      {themeContent.rsvpDescription ? (
                        themeContent.rsvpDescription
                      ) : (
                        <>Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu :</>
                      )}
                    </p>
                  </div>

                  <div class="rsvp-panel">
                    <div class="rsvp-card" data-animate="fade-up" style="--animate-delay: 340ms;">
                      <div class="rsvp-success" data-rsvp-success>
                        <div class="rsvp-success__icon">
                          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="40" height="40">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                        </div>
                        <h4 class="rsvp-success__title">Terima Kasih!</h4>
                        <p class="rsvp-success__desc">Konfirmasi kehadiran dan ucapan Anda telah berhasil kami simpan.</p>
                      </div>

                      <form class="rsvp-form" data-rsvp-form>
                        <input type="hidden" name="weddingId" value={wedding.id} />
                        <div class="rsvp-form__field">
                          <input type="text" id="rsvp-nocturne-name" name="name" required placeholder="Nama Lengkap *" class="rsvp-form__input" value={guestName || ''} maxlength="100" />
                        </div>
                        <div class="rsvp-form__field">
                          <select id="rsvp-nocturne-attendance" name="attendance" required class="rsvp-form__select" data-rsvp-attendance>
                            <option value="" disabled>Konfirmasi Kehadiran *</option>
                            <option value="attending" selected>Hadir</option>
                            <option value="tentative">Ragu-ragu</option>
                            <option value="declined">Tidak Hadir</option>
                          </select>
                        </div>
                        <div class="rsvp-form__field">
                          <select name="count" class="rsvp-form__select">
                            <option value="1" selected>1 Orang</option>
                            <option value="2">2 Orang</option>
                            <option value="3">3 Orang</option>
                            <option value="4">4 Orang</option>
                            <option value="5">5 Orang</option>
                          </select>
                        </div>
                        <div class="rsvp-form__field">
                          <textarea id="rsvp-nocturne-message" name="message" rows="3" placeholder="Ucapan &amp; Doa" class="rsvp-form__textarea" maxlength="500"></textarea>
                        </div>
                        <div class="rsvp-form__error" data-rsvp-error></div>
                        <button type="submit" class="rsvp-form__submit" data-rsvp-submit>Kirim</button>
                      </form>
                    </div>

                    <div class="wishes-list" data-wishes-list>
                      <div class:list={['wishes-empty', { 'is-hidden': !isWishesEmpty }]} data-wishes-empty>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="36" height="36">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <span>Belum ada ucapan. Jadilah yang pertama memberikan doa restu!</span>
                      </div>

                      {displayedWishes.map((wish, wIdx) => (
                        <div
                          class="wish-card"
                          data-animate="fade-up"
                          style={`--animate-delay: ${wIdx * 120}ms;`}
                          data-wish-id={wish.id}
                          data-wish-key={wish.id || `${wish.created_at}|${wish.guest_name}|${wish.message || ''}`}
                        >
                          <div class="wish-card__header">
                            <div class="wish-card__meta">
                              <span class="wish-card__name">{decodeHtmlEntities(wish.guest_name)}</span>
                              <span class={`wish-card__badge ${wish.attendance_status === "attending" ? "wish-card__badge--attend" : wish.attendance_status === "tentative" ? "wish-card__badge--tentative" : "wish-card__badge--absent"}`}>
                                {wish.attendance_status === "attending" ? "Hadir" : wish.attendance_status === "tentative" ? "Ragu" : "Tidak Hadir"}
                              </span>
                            </div>
                            <span class="wish-card__date">{formatWishDate(wish.created_at)}</span>
                          </div>
                          <p class="wish-card__message">{decodeHtmlEntities(wish.message)}</p>
                        </div>
                      ))}
                    </div>

                    {totalWishPages > 1 && (
                      <div class="wishes-pagination" data-wishes-pagination data-wedding-id={wedding.id} data-current-page="1" data-total-pages={totalWishPages} data-per-page="4" data-animate="fade-up" style="--animate-delay: 200ms;">
                        <button type="button" class="wishes-pagination__btn" data-wishes-prev disabled aria-label="Halaman sebelumnya">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </button>
                        <div class="wishes-pagination__numbers" data-wishes-numbers>
                          {generatePaginationItems(1, totalWishPages).map((item) => (
                            typeof item === 'number' ? (
                              <button
                                type="button"
                                class={`wishes-pagination__num ${item === 1 ? 'wishes-pagination__num--active' : ''}`}
                                data-wishes-page={item}
                                aria-label={`Halaman ${item}`}
                              >
                                {item}
                              </button>
                            ) : (
                              <span class="wishes-pagination__ellipsis">...</span>
                            )
                          ))}
                        </div>
                        <button type="button" class="wishes-pagination__btn" data-wishes-next aria-label="Halaman berikutnya">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              </section>
            </div>
          </section>
        )}

        <section class="gift-section" id="gift">
          <div class="gift-section__top" data-animate="fade-up">
            <h2 class="gift-section__token-title" data-animate="fade-up" style="--animate-delay: 80ms;">WEDDING<br />GIFT</h2>
            <div class="gift-section__v-line" data-animate="expand-y" data-animate-origin="top" style="--animate-delay: 280ms;"></div>
            <p class="gift-section__kindness" data-animate="fade-up" style="--animate-delay: 480ms;">
              Bagi Bapak/Ibu/Saudara/i yang berkenan memberikan tanda kasih, dapat melalui rekening berikut.
            </p>
          </div>

          <div class="gift-container">
            <div class="gift-grid">
              {activeGifts.map((gift, gIdx) => {
                const logoUrl = getBankLogoUrl(gift.bank_name, (gift as any).bank_logo);
                return (
                  <article class="gift-card" data-animate="fade-up" style={`--animate-delay: ${gIdx * 160 + 100}ms;`}>
                    <div class="gift-card__body">
                      {logoUrl ? (
                        <img src={logoUrl} alt={gift.bank_name} class="gift-card__bank-logo" />
                      ) : (
                        <span class="gift-card__bank">{gift.bank_name}</span>
                      )}
                      <p class="gift-card__number">{gift.account_number}</p>
                      <p class="gift-card__holder">a.n. {gift.account_name}</p>
                    </div>
                    <div class="gift-card__actions">
                      <button
                        class="gift-btn gift-btn--copy"
                        data-copy-btn
                        data-value={gift.account_number}
                        data-account-name={gift.account_name}
                        data-bank-name={gift.bank_name}
                        type="button"
                      >
                        <span class="gift-btn__icon-wrapper">
                          <svg class="gift-btn__icon gift-btn__icon--copy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                          </svg>
                          <svg class="gift-btn__icon gift-btn__icon--check" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                          </svg>
                        </span>
                        <span class="gift-btn__text">Salin</span>
                      </button>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        </section>

        <section class:list={['closing-row', { 'closing-row--no-media': !closingImage }]}>
          {closingImage && (
            <div class="closing-row__media" data-animate="fade-up" style="--animate-delay: 100ms;">
              <SmartImage src={closingImage} alt="" loading="lazy" />
            </div>
          )}
          <div class="closing-row__content">
            <h3 class="closing-row__title" data-animate="fade-up" style="--animate-delay: 220ms;">{closingTitle}</h3>
            <p class="closing-row__message" data-animate="fade-up" style="--animate-delay: 340ms;">{closingMessage}</p>
            <h4 class="closing-row__names" data-animate="fade-up" style="--animate-delay: 460ms;">{wedding.groom_name} &amp; {wedding.bride_name}</h4>
            <footer class="thankyou-section__footer" data-animate="fade-up" style="--animate-delay: 580ms;">
              <a href="https://senadda.id" target="_blank" rel="noopener noreferrer" title="Senadda - Undangan Digital Bali" class="thankyou-section__brand-link" data-track-vendor-site style="display: inline-block; line-height: 0;">
                <SmartImage src="/images/senadda-logo.png" alt="Senadda - Undangan Digital Bali" class="thankyou-section__brand" />
              </a>
              <div class="thankyou-section__socials">
                <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link" data-track-vendor-instagram>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="1"></circle>
                  </svg>
                </a>
                {whatsappUrl && (
                  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-link" data-track-vendor-whatsapp>
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                    </svg>
                  </a>
                )}
                <a href="/" target="_blank" rel="noopener noreferrer" aria-label="Website" class="social-link" data-track-vendor-site>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path></svg>
                </a>
              </div>
              <p class="thankyou-section__copyright">&copy; Copyright {new Date().getFullYear()}</p>
            </footer>
          </div>
        </section>

      </main>
    </div>

    {sections.music !== false && activeMusicUrl && (
      <button class="audio-toggle" data-template-audio-toggle type="button" aria-label="Play or pause music">
        <div class="audio-icon-wrapper">
          <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
        </div>
        <audio data-template-audio loop preload="none" src={activeMusicUrl}></audio>
      </button>
    )}

  </div>
</BaseLayout>

<script>
  import './script.js';
</script>
