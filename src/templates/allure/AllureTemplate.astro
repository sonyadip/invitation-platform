---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClassicIntro from "../../components/common/ClassicIntro.astro";
import SmartImage from "../../components/common/SmartImage.astro";
import CountdownTimer from "../../components/common/CountdownTimer.astro";
import type { FullInvitationData } from '../../types';
import { getPlatformSettings } from '../../services/platform-settings';
import GiftGrid from '../../components/common/GiftGrid.astro';
import bgHero from '../noir/assets/bg-hero.webp';
import coupleBride from '../noir/assets/couple-bride.jpg';
import coupleGroom from '../noir/assets/couple-groom.jpg';
import coverImg from './assets/cover.webp';
import galleryOne from '../noir/assets/gallery-1.jpg';
import galleryTwo from '../noir/assets/gallery-2.jpg';
import galleryThree from '../noir/assets/gallery-3.jpg';
import galleryFour from '../noir/assets/gallery-4.jpg';
import galleryFive from '../noir/assets/gallery-5.jpg';
import gallerySix from '../noir/assets/gallery-6.jpg';
import gallerySeven from '../noir/assets/gallery-7.jpg';
import galleryEight from '../noir/assets/gallery-8.webp';
import '@fancyapps/ui/dist/fancybox/fancybox.css';
import styleUrl from './style.scss?url';

import {
  formatChildPrefix,
  buildCoupleLines,
  formatDate,
  buildGoogleCalendarUrl,
  getInstagramUsername,
  formatWishDate,
  generatePaginationItems,
  decodeHtmlEntities
} from '../../utils/template-helpers';

interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings, events, gallery, gifts, wishes } = data;
const sections = settings.sections || ({} as any);

const isPreview = wedding.id.startsWith('preview-');

const groomNickname = wedding.groom_name || 'Yudi';
const brideNickname = wedding.bride_name || 'Meita';
const groomFullName = wedding.groom_full_name || wedding.groom_name || 'I Wayan Yudi Artayasa';
const brideFullName = wedding.bride_full_name || wedding.bride_name || 'Ni Kadek Meita Widiantari';

const customGallery = [
  { id: '1', image_url: galleryOne.src, variant: 'full-16x10' },
  { id: '2', image_url: galleryTwo.src, variant: 'half' },
  { id: '3', image_url: galleryThree.src, variant: 'half' },
  { id: '4', image_url: galleryFour.src, variant: 'half' },
  { id: '5', image_url: galleryFive.src, variant: 'half' },
  { id: '6', image_url: gallerySix.src, variant: 'full-16x10' }
];

const themeConfig = (settings.theme_config || {
  theme: {},
  layout: { galleryColumns: 3 },
  assets: {}
}) as any;
const themeContent = themeConfig.content || {};
const platformSettings = await getPlatformSettings();

const overrideSettings = {
  ...settings,
  theme_config: {
    ...themeConfig,
    theme: {
      ...themeConfig.theme,
      primaryColor: '#FFFFFF',
      secondaryColor: '#0E0E0E',
      textColor: '#FFFFFF',
      bgColor: '#0E0E0E',
      fontHeading: 'Ivy Mode',
      fontBody: 'Poppins'
    }
  }
};

const formattedDate = formatDate(wedding.wedding_date);

const activeEvents = events && events.length > 0
  ? events
  : [
      {
        id: 'event-resepsi',
        event_name: 'Resepsi',
        event_date: wedding.wedding_date || '2026-12-22',
        start_time: '18:00',
        end_time: '21:00',
        venue_name: wedding.venue_name || (isPreview ? 'The Royal Garden' : 'The Royal Garden'),
        venue_address: wedding.venue_address || (isPreview ? 'Jl. Pantai Indah No. 8, Bali' : 'Jl. Pantai Indah No. 8, Bali'),
        maps_url: wedding.maps_url || 'https://maps.google.com',
        sort_order: 1,
        wedding_id: wedding.id,
        created_at: ''
      }
    ];

const themeAssets = themeConfig.assets || {};
const coverImage = themeAssets.coverImage || themeAssets.heroImage || (isPreview ? coverImg.src : undefined);
const heroImage = themeAssets.heroImage || themeAssets.coverImage || (isPreview ? bgHero.src : coverImg.src);
const rawHeroSlides = [
  themeAssets.coverImage,
  themeAssets.heroImage,
  themeAssets.heroImageTwo,
  themeAssets.heroImageThree,
  ...(gallery && gallery.length > 0
    ? gallery.slice(0, 3).map((g: any) => typeof g.image_url === 'string' ? g.image_url : g.image_url?.src)
    : (isPreview ? [bgHero.src, galleryOne.src, gallerySix.src] : []))
].filter(Boolean);

const seenSlides = new Set<string>();
const heroSlides = rawHeroSlides.filter((slide) => {
  const key = typeof slide === 'string' ? slide : (slide as any)?.src || '';
  if (!key || seenSlides.has(key)) return false;
  seenSlides.add(key);
  return true;
});
if (heroSlides.length === 0 && heroImage) heroSlides.push(heroImage);

const resepsiEvent = activeEvents.find(e => e.event_name.toLowerCase().includes('resepsi')) || activeEvents[0];
const mainEvent = resepsiEvent;
const mainEventDate = mainEvent ? formatDate(mainEvent.event_date) : 'Selasa, 22 Desember 2026';
const mainEventTime = isPreview
  ? '13:00 WITA - Selesai'
  : (mainEvent?.start_time
      ? (mainEvent.end_time ? `${mainEvent.start_time} - ${mainEvent.end_time}` : `${mainEvent.start_time} - Selesai`)
      : '13:00 WITA - Selesai');
const mainEventImage = (mainEvent as any)?.image
  || themeAssets.eventImage
  || (gallery && gallery.length > 1 ? (typeof gallery[1].image_url === 'string' ? gallery[1].image_url : gallery[1].image_url?.src) : undefined)
  || (gallery && gallery.length > 0 ? (typeof gallery[0].image_url === 'string' ? gallery[0].image_url : gallery[0].image_url?.src) : undefined)
  || heroImage;
const mainEventAddress = mainEvent?.venue_address || wedding.venue_address || (isPreview ? 'Jl. Pantai Indah No. 8, Bali' : '');

const googleCalendarUrl = mainEvent ? buildGoogleCalendarUrl(wedding as any, mainEvent as any) : '';

const videoUrl = themeAssets.videoUrl || themeAssets.heroVideo || (isPreview ? 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm' : undefined);
const videoPoster = themeAssets.videoPoster || themeAssets.posterImage || heroImage;
const brideImage = themeAssets.brideImage || (isPreview ? coupleBride.src : undefined);
const groomImage = themeAssets.groomImage || (isPreview ? coupleGroom.src : undefined);
const closingImage = themeAssets.closingImage || (isPreview ? 'https://media.senadda.id/yudi-meita/gallery/1787747006762-gallery-3.webp' : heroImage);
const instagramUrl = themeContent.instagramUrl || platformSettings.instagram_url || 'https://instagram.com';
const _baseWa = themeContent.whatsappUrl || platformSettings.whatsapp_url || '';
const _themeName = 'Allure';
const whatsappUrl = _baseWa ? `${_baseWa}${_baseWa.includes('?') ? '&' : '?'}text=${encodeURIComponent('Halo Admin, saya tertarik untuk membuat undangan digital dengan tema *' + _themeName + '*. Boleh minta informasi mengenai cara pemesanannya?')}` : '';

const groomRawIg = themeContent.groomInstagramUrl || (themeContent.groomIg ? `https://instagram.com/${themeContent.groomIg.replace(/^@/, '')}` : '');
const brideRawIg = themeContent.brideInstagramUrl || (themeContent.brideIg ? `https://instagram.com/${themeContent.brideIg.replace(/^@/, '')}` : '');

const groomInstagramUrl = groomRawIg && groomRawIg !== '#' && groomRawIg !== '-'
  ? (groomRawIg.startsWith('http') ? groomRawIg : `https://instagram.com/${groomRawIg.replace(/^@/, '')}`)
  : (isPreview ? (instagramUrl !== '#' ? instagramUrl : 'https://instagram.com') : null);

const brideInstagramUrl = brideRawIg && brideRawIg !== '#' && brideRawIg !== '-'
  ? (brideRawIg.startsWith('http') ? brideRawIg : `https://instagram.com/${brideRawIg.replace(/^@/, '')}`)
  : (isPreview ? (instagramUrl !== '#' ? instagramUrl : 'https://instagram.com') : null);

const giftDescription = themeContent.giftDescription || 'Bagi Bapak/Ibu/Saudara/i yang ingin memberikan tanda kasih, dapat melalui transfer ke rekening berikut:';
const thankYouMessage = themeContent.closingMessage || 'Merupakan suatu kebahagiaan dan kehormatan bagi kami, apabila Bapak/Ibu/Saudara/i berkenan hadir di hari bahagia kami.';
const closingTitle = themeContent.thankYouTitle || themeContent.closingTitle || 'Terima Kasih';
const closingMessage = themeContent.thankYouMessage || thankYouMessage;
const openingVerse = themeContent.quoteText || themeContent.openingVerse || `"Wahai pasangan suami-isteri, semoga kalian tetap bersatu dan tidak pernah terpisahkan. Semoga kalian mencapai hidup penuh kebahagiaan, tinggal di rumah yang penuh kegembiraan bersama seluruh keturunanmu."`;
const openingVerseSource = themeContent.quoteSource || themeContent.verseSource || '(Rgveda : X.85.42)';
const cleanQuoteText = openingVerse.replace(/^["“”]/, '').replace(/["“”]$/, '');

const groomPrefix = formatChildPrefix(themeContent.groomChildNumber, 'Putra', themeContent.groomPrefix, isPreview ? 'Putra pertama dari' : 'Putra dari');
const bridePrefix = formatChildPrefix(themeContent.brideChildNumber, 'Putri', themeContent.bridePrefix, isPreview ? 'Putri kedua dari' : 'Putri dari');
const groomAddressText = themeContent.groomAddress || themeContent.groomCity || themeContent.groomOrigin || (isPreview ? 'Denpasar, Bali' : '');
const brideAddressText = themeContent.brideAddress || themeContent.brideCity || themeContent.brideOrigin || (isPreview ? 'Gianyar, Bali' : '');

const groomParentLines = buildCoupleLines(
  groomPrefix,
  themeContent.groomFatherName || (isPreview ? 'Bapak Mempelai' : undefined),
  themeContent.groomMotherName || (isPreview ? 'Ibu Mempelai' : undefined),
  themeContent.groomParents || 'Keluarga Mempelai Pria',
  groomAddressText
);
const brideParentLines = buildCoupleLines(
  bridePrefix,
  themeContent.brideFatherName || (isPreview ? 'Bapak Mempelai' : undefined),
  themeContent.brideMotherName || (isPreview ? 'Ibu Mempelai' : undefined),
  themeContent.brideParents || 'Keluarga Mempelai Wanita',
  brideAddressText
);

const activeGallery = gallery && gallery.length > 0
  ? gallery.map((image, index) => ({
      id: image.id,
      image_url: image.image_url,
      variant: index === 0 || index === 5 ? 'full-16x10' : 'half'
    }))
  : (isPreview ? customGallery : []);

const isWishesEmpty = !wishes || wishes.length === 0;
const displayedWishes = wishes ? wishes.slice(0, 4) : [];
const totalWishPages = wishes ? Math.ceil(wishes.length / 4) : 0;

const activeGifts = gifts && gifts.length > 0
  ? gifts
  : [
      { id: '1', bank_name: 'BCA', account_number: '0123 456 789', account_name: groomNickname, qris_url: null }
    ];

const activeStory = (wedding.story && wedding.story.length > 0)
  ? wedding.story
  : [
      {
        year: '2022',
        title: 'Awal Cerita',
        description: 'Berawal dari pertemuan sederhana, kami saling mengenal dan mulai berbagi banyak cerita. Tanpa disadari, kebersamaan itu tumbuh menjadi rasa nyaman yang semakin kuat dari hari ke hari.'
      },
      {
        year: '2024',
        title: 'Lamaran',
        description: 'Dengan niat yang tulus dan restu keluarga, kami memutuskan untuk melangkah ke tahap yang lebih serius. Momen lamaran menjadi awal dari perjalanan baru yang penuh harapan dan doa baik.'
      },
      {
        year: '2026',
        title: 'Pernikahan',
        description: 'Kini, kami mengikat janji suci di hadapan keluarga tercinta, memulai lembaran hidup baru sebagai pasangan suami istri yang saling melengkapi.'
      }
    ];
const loveStories = activeStory;

const wDate = new Date(wedding.wedding_date);
const dayStr = String(wDate.getDate()).padStart(2, '0');
const monthStr = String(wDate.getMonth() + 1).padStart(2, '0');
const yearStr = String(wDate.getFullYear());
const spacedNumericDate = `${dayStr} . ${monthStr} . ${yearStr}`;
const activeMusicUrl = wedding.music_url || themeAssets.musicUrl || (isPreview ? 'https://media.senadda.id/audio/banda-neira-sampai-jadi-debu.mp3' : undefined);
---

<BaseLayout
  wedding={wedding}
  settings={overrideSettings}
  to={guestName}
  templateClass={`template-allure${sections.introAnimation !== false ? " has-intro" : ""}`}
  image={coverImage}
  styleUrl={styleUrl}
>
  <div class="invitation-root" data-template-root>
    {sections.introAnimation !== false && (
      <ClassicIntro
        groomName={groomNickname}
        brideName={brideNickname}
        subtitle="The Wedding Of"
      />
    )}
    
    <div class="cover" data-template-cover id="sec">
      <SmartImage class="cover__bg" src={coverImage} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
      <div class="cover__overlay"></div>
      
      <div class="cover__content" id="kolom">
        <p class="cover__eyebrow">The Wedding of</p>
        <h1 class="cover__names">
          <span class="cover__names-line">{groomNickname} &amp; {brideNickname}</span>
        </h1>
        
        <div class="cover__guest-box">
          <p class="cover__dear">Kepada Yth.</p>
          <h2 class="cover__guest-name">{guestName || 'Nama Tamu'}</h2>
          
          <button class="cover__btn" data-template-open aria-label="Buka Undangan">
            <span>Buka Undangan</span>
          </button>
        </div>
      </div>
    </div>

    <div class="layout" data-template-layout>

      <aside class="sidebar" id="desk_cov">
        <SmartImage class="sidebar__bg" src={coverImage} alt="" aria-hidden="true" />
        <div class="sidebar__overlay"></div>
        <div class="sidebar__content">
          <p class="sidebar__eyebrow" data-animate="fade-up" style="--animate-delay: 200ms;">The Wedding of</p>
          <h2 class="sidebar__names" data-animate="fade-up" style="--animate-delay: 500ms;">
            <span>{groomNickname}</span>
            <span class="sidebar__amp">&amp;</span>
            <span>{brideNickname}</span>
          </h2>
          <div class="sidebar__date-badge" data-animate="fade-up" style="--animate-delay: 800ms;">
            <span>{spacedNumericDate}</span>
          </div>
        </div>
      </aside>

      <main class="main-content" id="isi">

        <section class="hero" data-hero-slider>
          <div class="hero__slides">
            {heroSlides.map((slide, index) => (
              <SmartImage class={`hero__slide ${index === 0 ? 'is-active' : ''}`} src={slide} alt="" />
            ))}
          </div>
          <div class="hero__overlay"></div>
          
          <div class="hero__content">
            <div class="hero__top">
              <p class="hero__eyebrow" data-animate="fade-up" style="--animate-delay: 200ms;">The Wedding of</p>
              <h2 class="hero__names" data-animate="fade-up" style="--animate-delay: 450ms;">
                <span>{groomNickname}</span>
                <span class="hero__amp-line">&amp; {brideNickname}</span>
              </h2>
              <p class="hero__date" data-animate="fade-up" style="--animate-delay: 700ms;">{spacedNumericDate}</p>
            </div>

            <div class="hero__bottom">
              <div class="hero__verse" data-animate="fade-up" style="--animate-delay: 950ms;">
                <blockquote class="hero__quote">
                  "{cleanQuoteText}"
                  {openingVerseSource && (
                    <cite class="hero__verse-source">
                      {openingVerseSource.startsWith('(') ? openingVerseSource : `(${openingVerseSource})`}
                    </cite>
                  )}
                </blockquote>
              </div>
            </div>
          </div>
        </section>

        {sections.coupleInfo !== false && (
          <section class="couple" id="mempelai">
            <div class="couple__cards">
              <div class="couple__header-divider couple__header-divider--groom" data-animate="fade" style="--animate-delay: 150ms;">
                <h2 class="couple__eyebrow">The Groom</h2>
                <span class="divider-line"></span>
              </div>

              <div class="person">
                <div class="person__photo-wrap" data-animate="slide-right" style="--animate-delay: 300ms;">
                  <div class="person__photo-frame">
                    <SmartImage
                      class="person__photo"
                      src={groomImage}
                      alt={groomNickname}
                      loading="lazy"
                    />
                  </div>
                  <div class="person__script-overlay" data-animate="handwriting" style="--animate-delay: 850ms;">
                    <span class="person__script-wrap">
                      <span class="person__script-text">{groomNickname}</span>
                      <span class="person__script-pen" aria-hidden="true"></span>
                    </span>
                  </div>
                </div>
                <h4 class="person__fullname" data-animate="fade-up" style="--animate-delay: 550ms;">{groomFullName}</h4>
                <p class="person__parents" data-animate="fade-up" style="--animate-delay: 800ms;">
                  {groomParentLines.map((line, index) => (
                    <>
                      {index > 0 && <br />}
                      {line}
                    </>
                  ))}
                </p>
                {groomInstagramUrl && (
                  <a class="person-card__social" href={groomInstagramUrl} target="_blank" rel="noopener noreferrer" aria-label={`${groomNickname} Instagram`} data-track-couple-instagram="groom" data-animate="fade-up" style="--animate-delay: 1050ms;">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                      <circle cx="12" cy="12" r="4"></circle>
                      <circle cx="17.5" cy="6.5" r="1"></circle>
                    </svg>
                    <span>{getInstagramUsername(groomInstagramUrl)}</span>
                  </a>
                )}
              </div>

              <div class="couple__header-divider couple__header-divider--bride" data-animate="fade" style="--animate-delay: 150ms;">
                <span class="divider-line"></span>
                <h2 class="couple__eyebrow">The Bride</h2>
              </div>

              <div class="person">
                <div class="person__photo-wrap" data-animate="slide-left" style="--animate-delay: 300ms;">
                  <div class="person__photo-frame">
                    <SmartImage
                      class="person__photo"
                      src={brideImage}
                      alt={brideNickname}
                      loading="lazy"
                    />
                  </div>
                  <div class="person__script-overlay" data-animate="handwriting" style="--animate-delay: 850ms;">
                    <span class="person__script-wrap">
                      <span class="person__script-text">{brideNickname}</span>
                      <span class="person__script-pen" aria-hidden="true"></span>
                    </span>
                  </div>
                </div>
                <h4 class="person__fullname" data-animate="fade-up" style="--animate-delay: 550ms;">{brideFullName}</h4>
                <p class="person__parents" data-animate="fade-up" style="--animate-delay: 800ms;">
                  {brideParentLines.map((line, index) => (
                    <>
                      {index > 0 && <br />}
                      {line}
                    </>
                  ))}
                </p>
                {brideInstagramUrl && (
                  <a class="person-card__social" href={brideInstagramUrl} target="_blank" rel="noopener noreferrer" aria-label={`${brideNickname} Instagram`} data-track-couple-instagram="bride" data-animate="fade-up" style="--animate-delay: 1050ms;">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                      <circle cx="12" cy="12" r="4"></circle>
                      <circle cx="17.5" cy="6.5" r="1"></circle>
                    </svg>
                    <span>{getInstagramUsername(brideInstagramUrl)}</span>
                  </a>
                )}
              </div>
            </div>
          </section>
        )}

        {sections.eventDetails !== false && mainEvent && (
          <section class="events" id="acara">
            <div class="events__container">
              <div class="event-card" data-animate="fade" style="--animate-delay: 150ms;">
                <div class="event-card__photo-frame" data-animate="zoom-center" style="--animate-delay: 300ms;">
                  <SmartImage
                    class="event-card__photo"
                    src={mainEventImage}
                    alt={mainEvent.event_name || 'Resepsi'}
                    loading="lazy"
                  />
                  <div class="event-card__photo-fade"></div>
                </div>

                <h3 class="event-card__script-title" data-animate="handwriting" style="--animate-delay: 550ms;">
                  <span class="event-card__script-wrap">
                    <span class="event-card__script-text">{mainEvent.event_name || 'Resepsi'}</span>
                    <span class="event-card__script-pen" aria-hidden="true"></span>
                  </span>
                </h3>

                <p class="event-card__date" data-animate="fade-up" style="--animate-delay: 750ms;">{mainEventDate}</p>

                <div class="event-card__divider" data-animate="expand-x" style="--animate-delay: 950ms;"></div>

                <p class="event-card__time" data-animate="fade-up" style="--animate-delay: 1150ms;">{mainEventTime}</p>

                <p class="event-card__venue" data-animate="fade-up" style="--animate-delay: 1350ms;">
                  <strong>{mainEvent.venue_name || 'The Royal Garden'}</strong>
                  {mainEventAddress}
                </p>

                {mainEvent.maps_url && (
                  <a
                    href={mainEvent.maps_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="event-card__btn"
                    data-animate="fade-up"
                    style="--animate-delay: 1550ms;"
                    data-track-maps
                  >
                    <svg width="13" height="15" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                    </svg>
                    <span>Lihat Lokasi</span>
                  </a>
                )}
              </div>
            </div>
          </section>
        )}

        {sections.countdown !== false && settings.countdown_enabled && (
          <section class="save-date" id="save-date">

            <div class="save-date__timer">
              <CountdownTimer date={wedding.wedding_date} animateItems={true} baseDelay={300} staggerDelay={220} />
            </div>

            {googleCalendarUrl && (
              <div class="save-date__action" data-animate="fade-up" style="--animate-delay: 1100ms;">
                <a
                  href={googleCalendarUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="save-date__btn"
                  data-track-calendar
                  aria-label="Save wedding date to Google Calendar"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>Save to Google Calendar</span>
                </a>
              </div>
            )}
          </section>
        )}

        {sections.story !== false && activeStory.length > 0 && (
          <section class="story-section story" id="story">
            <div class="story-container">
              <div class="story-header" data-animate="fade-up" style="--animate-delay: 200ms;">
                <h2 class="section-title">
                  Love
                  <span class="section-script" data-animate="handwriting" style="--animate-delay: 500ms;">
                    <span class="section-script__wrap">
                      <span class="section-script__text">Story</span>
                      <span class="section-script__pen" aria-hidden="true"></span>
                    </span>
                  </span>
                </h2>
              </div>
              
              <div class="story-timeline">
                {activeStory.map((item, index) => (
                  <article class="story-item" data-animate="fade-up" style={`--animate-delay: ${300 + index * 250}ms;`}>
                    {item.year && <span class="story-item__year">{item.year}</span>}
                    <h3 class="story-item__title">{item.title}</h3>
                    <p class="story-item__text">{item.description}</p>
                    {(item as any).image && (
                      <div class="story-item__image-wrap">
                        <SmartImage class="story-item__image" src={(item as any).image} alt={item.title} loading="lazy" />
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </div>
          </section>
        )}

        {sections.gallery !== false && settings.gallery_enabled && activeGallery.length > 0 && (
          <section class="gallery">
            <div class="gallery-header" data-animate="fade-up" style="--animate-delay: 200ms;">
              <h2 class="section-title">
                Our
                <span class="section-script" data-animate="handwriting" style="--animate-delay: 500ms;">
                  <span class="section-script__wrap">
                    <span class="section-script__text">Gallery</span>
                    <span class="section-script__pen" aria-hidden="true"></span>
                  </span>
                </span>
              </h2>
            </div>

            <div class="gallery__grid">
              {activeGallery.map((img, index) => {
                const isFirst = index === 0;
                const showVideo = isFirst && Boolean(videoUrl) && sections.video !== false;

                if (showVideo) {
                  return (
                    <div class="gallery__item gallery__item--full-16x10 gallery__item--video" data-animate="blur-up" style={`--animate-delay: ${300 + (index % 4) * 200}ms;`}>
                      <div class="video-section__frame" data-template-video>
                        <video class="video-section__media" src={videoUrl} poster={videoPoster} playsinline preload="metadata"></video>
                        <button class="video-section__play" type="button" data-template-video-play aria-label="Play wedding video">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M8 5.14v13.72c0 .78.86 1.26 1.53.84l10.78-6.86a1 1 0 0 0 0-1.68L9.53 4.3A1 1 0 0 0 8 5.14Z"></path>
                          </svg>
                        </button>
                      </div>
                    </div>
                  );
                }

                return (
                  <a
                    href={typeof img.image_url === 'string' ? img.image_url : img.image_url.src}
                    class={`gallery__item gallery__item--${img.variant}`}
                    data-fancybox="gallery"
                    data-animate="zoom-in"
                    style={`--animate-delay: ${300 + (index % 4) * 200}ms;`}
                  >
                    <SmartImage src={img.image_url} alt="Wedding Gallery Moment" loading="lazy" class="gallery__img" />
                    <div class="gallery__overlay">
                      <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        {sections.rsvp !== false && settings.rsvp_enabled && (
          <section class="rsvp-section" data-rsvp-section id="rsvp">
            <div class="rsvp-container">
              <div class="rsvp-header" data-animate="fade-up" style="--animate-delay: 200ms;">
                <h2 class="section-title">
                  RSVP &amp;
                  <span class="section-script" data-animate="handwriting" style="--animate-delay: 500ms;">
                    <span class="section-script__wrap">
                      <span class="section-script__text">Wishes</span>
                      <span class="section-script__pen" aria-hidden="true"></span>
                    </span>
                  </span>
                </h2>
                <p class="rsvp-subtitle" data-animate="fade-up" style="--animate-delay: 450ms;">Mohon konfirmasi kehadiran Anda dan berikan doa restu untuk kami.</p>
              </div>

              <div class="rsvp-panel">
                <div class="rsvp-card" data-animate="fade-up" style="--animate-delay: 700ms;">
                  <div class="rsvp-success" data-rsvp-success style="display:none;">
                    <div class="rsvp-success__icon">
                      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </div>
                    <h4 class="rsvp-success__title">Terima Kasih!</h4>
                    <p class="rsvp-success__desc">Konfirmasi kehadiran dan ucapan Anda telah berhasil kami simpan.</p>
                  </div>

                  <form class="rsvp-form" data-rsvp-form>
                    <input type="hidden" name="weddingId" value={wedding.id} />
                    <div class="rsvp-form__field">
                      <input type="text" id="rsvp-name" name="name" required placeholder="Nama" class="rsvp-form__input" value={guestName || ''} />
                    </div>
                    <div class="rsvp-form__field">
                      <select id="rsvp-attendance" name="attendance" required class="rsvp-form__select" data-rsvp-attendance>
                        <option value="" disabled>Konfirmasi Kehadiran</option>
                        <option value="attending" selected>Hadir</option>
                        <option value="tentative">Ragu</option>
                        <option value="declined">Tidak Hadir</option>
                      </select>
                    </div>
                    <div class="rsvp-form__field">
                      <select name="count" class="rsvp-form__select">
                        <option value="1" selected>1 Orang</option>
                        <option value="2">2 Orang</option>
                        <option value="3">3 Orang</option>
                        <option value="4">4 Orang</option>
                        <option value="5">5 Orang</option>
                      </select>
                    </div>
                    <div class="rsvp-form__field">
                      <textarea id="rsvp-message" name="message" rows="4" placeholder="Ucapan" class="rsvp-form__textarea"></textarea>
                    </div>
                    <div class="rsvp-form__error" data-rsvp-error style="display:none;"></div>
                    <button type="submit" class="rsvp-form__submit" data-rsvp-submit>Submit</button>
                  </form>
                </div>

                <div class="wishes-list" data-wishes-list>
                  <div class="wishes-empty" data-wishes-empty style={isWishesEmpty ? '' : 'display:none;'}>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                    <span>Belum ada ucapan. Jadilah yang pertama memberikan doa restu!</span>
                  </div>

                  {displayedWishes.map((wish, wIdx) => (
                    <div
                      class="wish-card"
                      data-animate="fade-up"
                      style={`--animate-delay: ${300 + wIdx * 200}ms;`}
                      data-wish-id={wish.id}
                      data-wish-key={wish.id || `${wish.created_at}|${wish.guest_name}|${wish.message || ''}`}
                    >
                      <div class="wish-card__header">
                        <div class="wish-card__meta">
                          <span class="wish-card__name">{decodeHtmlEntities(wish.guest_name)}</span>
                          <span class={`wish-card__badge ${wish.attendance_status === "attending" ? "wish-card__badge--attend" : wish.attendance_status === "tentative" ? "wish-card__badge--tentative" : "wish-card__badge--absent"}`}>
                            {wish.attendance_status === "attending" ? "Hadir" : wish.attendance_status === "tentative" ? "Ragu" : "Tidak Hadir"}
                          </span>
                        </div>
                        <span class="wish-card__date">{formatWishDate(wish.created_at)}</span>
                      </div>
                      <p class="wish-card__message">{decodeHtmlEntities(wish.message)}</p>
                    </div>
                  ))}
                </div>

                {totalWishPages > 1 && (
                  <div class="wishes-pagination" data-animate="fade-up" style="--animate-delay: 900ms;" data-wishes-pagination data-wedding-id={wedding.id} data-current-page="1" data-total-pages={totalWishPages} data-per-page="4">
                    <button type="button" class="wishes-pagination__btn" data-wishes-prev disabled aria-label="Halaman sebelumnya">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                        <polyline points="15 18 9 12 15 6"></polyline>
                      </svg>
                    </button>
                    <div class="wishes-pagination__numbers" data-wishes-numbers>
                      {generatePaginationItems(1, totalWishPages).map((item) => (
                        typeof item === 'number' ? (
                          <button
                            type="button"
                            class={`wishes-pagination__num ${item === 1 ? 'wishes-pagination__num--active' : ''}`}
                            data-wishes-page={item}
                            aria-label={`Halaman ${item}`}
                          >
                            {item}
                          </button>
                        ) : (
                          <span class="wishes-pagination__ellipsis">...</span>
                        )
                      ))}
                    </div>
                    <button type="button" class="wishes-pagination__btn" data-wishes-next aria-label="Halaman berikutnya">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </button>
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {sections.gift !== false && settings.gift_enabled && (
          <section class="gift-section" data-gift-section id="gift">
            <div class="gift-container">
              <div class="gift-header" data-animate="fade-up" style="--animate-delay: 200ms;">
                <h2 class="section-title">
                  Wedding
                  <span class="section-script" data-animate="handwriting" style="--animate-delay: 500ms;">
                    <span class="section-script__wrap">
                      <span class="section-script__text">Gift</span>
                      <span class="section-script__pen" aria-hidden="true"></span>
                    </span>
                  </span>
                </h2>
                <p class="gift-desc" data-animate="fade-up" style="--animate-delay: 450ms;">{giftDescription}</p>
                <div class="section-rule" data-animate="zoom-in" style="--animate-delay: 700ms;"></div>
              </div>

              <GiftGrid gifts={activeGifts} />
            </div>
          </section>
        )}

        <section class:list={['closing-row', { 'closing-row--no-media': !closingImage }]}>
          {closingImage && (
            <div class="closing-row__media" data-animate="fade-up">
              <SmartImage src={closingImage} alt="" loading="lazy" />
            </div>
          )}
          <div class="closing-row__content">
            <h3 class="closing-row__title" data-animate="fade-up" style="--animate-delay: 200ms;">{closingTitle}</h3>
            <p class="closing-row__message" data-animate="fade-up" style="--animate-delay: 350ms;">{closingMessage}</p>
            <h4 class="closing-row__names" data-animate="fade-up" style="--animate-delay: 500ms;">{wedding.groom_name} &amp; {wedding.bride_name}</h4>
            <footer class="thankyou-section__footer" data-animate="fade-up" style="--animate-delay: 650ms;">
              <a href="https://senadda.id" target="_blank" rel="noopener noreferrer" title="Senadda - Undangan Digital Bali" class="thankyou-section__brand-link" data-track-vendor-site style="display: inline-block; line-height: 0;">
                <SmartImage src="/images/senadda-logo.png" alt="Senadda - Undangan Digital Bali" class="thankyou-section__brand" />
              </a>
              <div class="thankyou-section__socials">
                <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link" data-track-vendor-instagram>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="1"></circle>
                  </svg>
                </a>
                {whatsappUrl && (
                  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-link" data-track-vendor-whatsapp>
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                    </svg>
                  </a>
                )}
                <a href="/" target="_blank" rel="noopener noreferrer" aria-label="Website" class="social-link" data-track-vendor-site>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path></svg>
                </a>
              </div>
              <p class="thankyou-section__copyright">&copy; Copyright {new Date().getFullYear()}</p>
            </footer>
          </div>
        </section>

      </main>
    </div>

    {sections.music !== false && activeMusicUrl && (
      <button class="audio-toggle" data-template-audio-toggle type="button" aria-label="Play or pause music">
        <div class="audio-icon-wrapper">
          <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
        </div>
        <audio data-template-audio loop preload="none" src={activeMusicUrl}></audio>
      </button>
    )}

  </div>
</BaseLayout>

<script>
  import './script.js';
</script>
