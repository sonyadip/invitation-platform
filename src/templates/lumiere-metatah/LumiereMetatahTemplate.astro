---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SmartImage from "../../components/common/SmartImage.astro";
import CountdownTimer from "../../components/common/CountdownTimer.astro";
import GiftGrid from "../../components/common/GiftGrid.astro";
import ClassicIntro from "../../components/common/ClassicIntro.astro";
import type { FullInvitationData } from '../../types';
import { getPlatformSettings } from '../../services/platform-settings';
import {
  formatChildPrefix,
  buildCoupleLines,
  formatDate,
  formatEventDate,
  buildGoogleCalendarUrl,
  getInstagramUsername,
  formatWishDate,
  getYouTubeId,
  generatePaginationItems
} from '../../utils/template-helpers';

import metatahBg    from './assets/metatah-bg.jpg';
import sidebarBg    from './assets/sidebar-bg.jpg';

import './style.scss';

interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings, events, gallery, gifts, wishes } = data;
const sections = settings.sections;
const themeConfig = (settings.theme_config || { theme: {}, layout: {}, assets: {} }) as any;
const themeAssets = themeConfig.assets || {};
const themeContent = themeConfig.content || {};

const isPreview = wedding.id.startsWith('preview-');

// ── Asset resolution (prefer CMS override, fall back to the 2 new metatah images) ──────────
const defaultBg1    = metatahBg.src;
const defaultBg2    = sidebarBg.src;

const coverImage        = themeAssets.coverImage       || defaultBg1;
const heroBgImage       = themeAssets.heroImage        || defaultBg1;
const sidebarImage      = themeAssets.sidebarImage     || defaultBg2;
const participantImage  = themeAssets.participantImage || themeAssets.groomImage || defaultBg1;
const eventImage        = themeAssets.eventImage       || defaultBg1;
const rsvpImage         = themeAssets.rsvpImage        || defaultBg2;
const closingImage      = themeAssets.closingImage     || defaultBg1;
const saveDateImage     = themeAssets.countdownImage   || defaultBg2;

// ── Slideshow pool: Gunakan sliderImages jika diisi di backend/CMS, jika kosong gunakan 2 gambar default ──
const customSliderImages = Array.isArray(themeAssets.sliderImages) && themeAssets.sliderImages.length > 0
  ? themeAssets.sliderImages.filter((url: any) => typeof url === 'string' && url.trim() !== '')
  : null;

const defaultSliderImages = [
  metatahBg.src,
  sidebarBg.src
];

const heroSlides = (customSliderImages && customSliderImages.length > 0
  ? customSliderImages
  : defaultSliderImages
).filter((s: string, i: number, a: string[]) => Boolean(s) && a.indexOf(s) === i);

// ── Text / Content Defaults (Curated for Hindu Bali / Metatah) ───────────────
const defaultText = {
  ceremonyTitle: 'Mepandes / Metatah',
  ceremonyEyebrow: 'Upacara Manusa Yadnya',
  coverTitle: '',
  coverName: '',
  coverEyebrow: '',
  sidebarTitle: '',
  sidebarName: '',
  sidebarEyebrow: '',
  introTitle: '',
  introName: '',
  introEyebrow: 'UPACARA MANUSA YADNYA',
  introAnimationName: '',
  introAnimationSubtitle: '',
  pesertaSectionTitle: '',
  pesertaSectionEyebrow: 'Metatah / Potong Gigi',
  closingNames: '',
  verse: 'Om Swastyastu, Atas Asung Kertha Wara Nugraha Ida Sang Hyang Widhi Wasa / Tuhan Yang Maha Esa, kami bermaksud menyelenggarakan Upacara Manusa Yadnya (Mepandes / Metatah / Potong Gigi) putra-putri kami.',
  verseSource: 'Doa Restu Keluarga',
  participantRole: 'Putra',
  groomRole: 'Putra',
  participantParents: 'Putra dari Bapak & Ibu',
  groomParents: 'Putra dari Bapak & Ibu',
  familyLabel: 'Keluarga yang Mengundang',
  giftTitle: 'Tanda Kasih',
  giftDescription: 'Bagi keluarga dan kerabat yang ingin memberikan tanda kasih atau kado doa restu, dapat mengirimkannya melalui :',
  rsvpTitle: 'RSVP & Ucapan Doa',
  rsvpDescription: 'Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu :',
  closingTitle: 'Om Shanti, Shanti, Shanti, Om',
  closingMessage: 'Merupakan suatu kebahagiaan dan kehormatan bagi kami sekeluarga apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada putra-putri kami.',
  galleryQuote: 'Setiap senyuman dan doa restu adalah berkah terindah bagi kami sekeluarga.',
  storyTitle: 'Sekilas Upacara',
  instagramUrl: '#',
  participantInstagramUrl: '',
  groomInstagramUrl: '',
  participantIg: '',
  groomIg: ''
};

const text = { ...defaultText, ...themeContent };
const closingTitle = text.thankYouTitle || text.closingTitle || defaultText.closingTitle;
const closingMessage = text.thankYouMessage || text.closingMessage || defaultText.closingMessage;

// ── Metatah & Participant Setup ─────────────────────────────────────────────
const rawCustomParticipants: any[] | null =
  Array.isArray(themeContent.participants) && themeContent.participants.length > 0
    ? themeContent.participants
    : Array.isArray(themeContent.potongGigiMembers) && themeContent.potongGigiMembers.length > 0
      ? themeContent.potongGigiMembers
      : Array.isArray(themeContent.members) && themeContent.members.length > 0
        ? themeContent.members
        : null;

const hasCustomList = Boolean(rawCustomParticipants && rawCustomParticipants.length > 0);

const platformSettings = await getPlatformSettings();
const instagramUrl      = text.instagramUrl && text.instagramUrl !== '#' ? text.instagramUrl : (platformSettings.instagram_url || '#');
const _baseWa = themeContent.whatsappUrl || platformSettings.whatsapp_url || '';
const _themeName = (wedding.template || 'Lumiere Metatah');
const whatsappUrl = _baseWa ? `${_baseWa}${_baseWa.includes('?') ? '&' : '?'}text=${encodeURIComponent('Halo Admin, saya tertarik untuk membuat undangan digital dengan tema *' + _themeName + '*. Boleh minta informasi mengenai cara pemesanannya?')}` : '';

// Helper to prevent any wedding "mempelai" text from leaking into Metatah ceremony
const filterMempelai = (val?: string | null): string | undefined => {
  if (!val) return undefined;
  if (/mempelai/i.test(val)) return undefined;
  return val;
};

const defaultPreviewFather = 'I Wayan Sudarma';
const defaultPreviewMother = 'Ni Made Sukerti';

// Base participant 1 defaults
const participantName = themeContent.participantName || wedding.groom_name || 'Peserta';
const participantFullName = themeContent.participantFullName || wedding.groom_full_name || participantName;
const participantRole = text.participantRole || text.groomRole || 'Putra';
const participantPrefix = formatChildPrefix(
  text.participantChildNumber ?? text.groomChildNumber,
  participantRole,
  text.participantPrefix || text.groomPrefix,
  isPreview ? `${participantRole} pertama dari` : `${participantRole} dari`
);
const participantAddressText = text.participantAddress || text.groomAddress || text.groomCity || text.groomOrigin || (isPreview ? 'Denpasar, Bali' : '');

const participantFather = filterMempelai(text.participantFatherName) || filterMempelai(text.fatherName) || filterMempelai(text.groomFatherName) || (isPreview ? defaultPreviewFather : undefined);
const participantMother = filterMempelai(text.participantMotherName) || filterMempelai(text.motherName) || filterMempelai(text.groomMotherName) || (isPreview ? defaultPreviewMother : undefined);
const participantParentsText = filterMempelai(text.participantParents) || filterMempelai(text.groomParents);

const participantParentLines = buildCoupleLines(
  participantPrefix,
  participantFather,
  participantMother,
  participantParentsText,
  participantAddressText
);

const participantInstagramUrl = text.participantInstagramUrl || text.groomInstagramUrl || (text.participantIg ? `https://instagram.com/${text.participantIg.replace(/^@/, '')}` : '') || (text.groomIg ? `https://instagram.com/${text.groomIg.replace(/^@/, '')}` : '') || instagramUrl;

// Family who invite
const rawFamilyFather = filterMempelai(text.fatherName) || filterMempelai(text.groomFatherName) || participantFather;
const rawFamilyMother = filterMempelai(text.motherName) || filterMempelai(text.groomMotherName) || participantMother;
const familyInviting = themeContent.familyInviting || themeContent.parentsName || filterMempelai(text.familyNames) || (rawFamilyFather && rawFamilyMother ? `${rawFamilyFather} & ${rawFamilyMother}` : null);
const familyAddress = text.familyAddress || participantAddressText;

// Build list of all participants (all rendered with couple-section__person)
interface MetatahPerson {
  name: string;
  nickname: string;
  fullName: string;
  role: string;
  photo: any;
  parents: string[];
  instagram: string;
  description?: string | null;
}

let participantsList: MetatahPerson[] = [];

if (hasCustomList) {
  participantsList = rawCustomParticipants!.map((item: any, index: number) => {
    const isObj = typeof item === 'object' && item !== null;
    const nickname = isObj ? (item.nickname || item.nickName || item.name || `Peserta ${index + 1}`) : String(item);
    const name = isObj ? (item.name || item.fullName || nickname) : String(item);
    const fullName = isObj ? (item.fullName || item.name || nickname) : String(item);
    const role = isObj ? (item.role || `Peserta ${index + 1}`) : `Peserta ${index + 1}`;
    const photo = isObj ? (item.photo || item.image || item.image_url || (index % 2 === 0 ? participantImage : sidebarImage)) : (index % 2 === 0 ? participantImage : sidebarImage);
    const itemFather = filterMempelai(item.fatherName) || participantFather;
    const itemMother = filterMempelai(item.motherName) || participantMother;
    const itemParentsText = filterMempelai(item.parentsText) || participantParentsText;
    const parents = isObj ? (
      Array.isArray(item.parents)
        ? item.parents.map((p: any) => typeof p === 'string' ? p.replace(/\s*mempelai/gi, '') : p)
        : typeof item.parents === 'string' && item.parents.trim() !== ''
          ? [item.parents.replace(/\s*mempelai/gi, '')]
          : (item.fatherName || item.motherName || item.childNumber || item.prefix
              ? buildCoupleLines(
                  formatChildPrefix(item.childNumber, role, item.prefix, undefined),
                  itemFather,
                  itemMother,
                  itemParentsText,
                  item.address || item.city || participantAddressText
                )
              : participantParentLines)
    ) : participantParentLines;
    const ig = isObj ? (item.instagram || item.instagramUrl || item.ig || '') : '';
    const desc = isObj ? item.description : null;

    return {
      name,
      nickname,
      fullName,
      role,
      photo,
      parents,
      instagram: ig ? (ig.startsWith('http') ? ig : `https://instagram.com/${ig.replace(/^@/, '')}`) : '',
      description: desc
    };
  });
} else {
  // Person 1 (Primary)
  const p1Nickname = themeContent.participantNickname || wedding.groom_name || participantName;
  participantsList.push({
    name: participantName,
    nickname: p1Nickname,
    fullName: participantFullName,
    role: participantRole,
    photo: participantImage,
    parents: participantParentLines,
    instagram: participantInstagramUrl,
    description: null
  });

  // Person 2 (if bride_name exists and is not '-' / empty)
  if (wedding.bride_name && wedding.bride_name.trim() !== '' && wedding.bride_name.trim() !== '-') {
    const p2Nickname = themeContent.brideNickname || wedding.bride_name;
    const brideRole = text.brideRole || 'Putri';
    const bridePrefix = formatChildPrefix(
      text.brideChildNumber,
      brideRole,
      text.bridePrefix,
      isPreview ? `${brideRole} pertama dari` : `${brideRole} dari`
    );
    const brideAddressText = text.brideAddress || text.brideCity || text.brideOrigin || participantAddressText;
    const brideFather = filterMempelai(text.brideFatherName) || participantFather;
    const brideMother = filterMempelai(text.brideMotherName) || participantMother;
    const brideParentsText = filterMempelai(text.brideParents) || participantParentsText;
    const brideParentLines = buildCoupleLines(
      bridePrefix,
      brideFather,
      brideMother,
      brideParentsText,
      brideAddressText
    );
    const brideIg = text.brideInstagramUrl || (text.brideIg ? `https://instagram.com/${text.brideIg.replace(/^@/, '')}` : '') || '';

    participantsList.push({
      name: wedding.bride_name,
      nickname: p2Nickname,
      fullName: wedding.bride_full_name || wedding.bride_name,
      role: brideRole,
      photo: themeAssets.brideImage || sidebarImage,
      parents: brideParentLines,
      instagram: brideIg,
      description: null
    });
  }
}

const isMultipleParticipants = participantsList.length > 1;

// Nama ringkas (panggilan) semua peserta (contoh: "Rama" atau "Rama & Ayu")
const participantsNames = participantsList.map(p => p.nickname || p.name).filter(Boolean).join(' & ') || participantName;

// Nama lengkap semua peserta (contoh: "I Made Rama Pratama & Ni Putu Ayu Lestari")
const participantsFullNames = participantsList.map(p => p.fullName || p.name).filter(Boolean).join(' & ') || participantFullName;

// ── Overridable Title & Name Resolution ─────────────────────────────────────
// 1. Cover Section (Default nama peserta, bisa dioverride via field coverTitle / coverName / title)
const coverEyebrow = text.coverEyebrow || text.ceremonyEyebrow || 'Upacara Manusa Yadnya';
const coverTitle = text.coverTitle || text.coverName || text.title || themeContent.ceremonyTitle || participantsNames;

// 2. Sidebar Section (Default nama peserta, bisa dioverride via field sidebarName / sidebarTitle)
const sidebarEyebrow = text.sidebarEyebrow || text.ceremonyEyebrow || 'Upacara Manusa Yadnya';
const sidebarName = text.sidebarName || text.sidebarTitle || participantsNames;

// 3. Intro Section (#awal-undangan) - selalu pakai nama peserta secara default, bisa dioverride via field introName / introTitle
const introEyebrow = text.introEyebrow || 'UPACARA MANUSA YADNYA';
const introName = text.introName || text.introTitle || participantsNames;

// 4. ClassicIntro (modal intro animasi)
const introAnimationName = text.introAnimationName || text.introAnimationTitle || introName;
const introAnimationSubtitle = text.introAnimationSubtitle || 'Metatah / Potong Gigi';

// 5. Section Peserta Upacara Header
const pesertaSectionEyebrow = text.pesertaSectionEyebrow || text.coupleEyebrow || 'Metatah / Potong Gigi';
const pesertaSectionTitle = text.pesertaSectionTitle || 'Peserta Upacara';

// 6. Closing Section (menggunakan isi yang sama dengan intro-section__name)
const closingNames = text.closingNames || introName;

const formattedDate = formatDate(wedding.wedding_date);
const introDateFormatted = formattedDate.includes(',') ? formattedDate.split(',')[1].trim() : formattedDate;
const weddingDateObj = new Date(wedding.wedding_date);
const coverDateFormatted = `${String(weddingDateObj.getDate()).padStart(2, '0')}.${String(weddingDateObj.getMonth() + 1).padStart(2, '0')}.${String(weddingDateObj.getFullYear()).slice(-2)}`;

const videoUrl = themeAssets.videoUrl || '';

const rawActiveEvents = events && events.length > 0
  ? events
  : [{
      id: 'fallback-1',
      event_name: 'Metatah',
      event_date: wedding.wedding_date,
      start_time: '08:00',
      end_time: '12:00',
      venue_name: wedding.venue_name || 'Griya Agung',
      venue_address: wedding.venue_address || 'Bali',
      maps_url: wedding.maps_url,
      sort_order: 0,
      wedding_id: wedding.id,
      created_at: ''
    },
    {
      id: 'fallback-2',
      event_name: 'Resepsi',
      event_date: wedding.wedding_date,
      start_time: '13:00',
      end_time: 'Selesai',
      venue_name: wedding.venue_name || 'Griya Agung',
      venue_address: wedding.venue_address || 'Bali',
      maps_url: wedding.maps_url,
      sort_order: 1,
      wedding_id: wedding.id,
      created_at: ''
    }];

const activeEvents = rawActiveEvents.map((event) => ({
  ...event,
  event_name: event.event_name === 'Metatah / Potong Gigi' ? 'Metatah' : event.event_name
}));

const activeGifts = gifts && gifts.length > 0
  ? gifts
  : [
      { id: '1', bank_name: 'BCA', account_number: '0123 456 789', account_name: participantName, qris_url: null },
      { id: '2', bank_name: 'BPD Bali', account_number: '9876 543 210', account_name: participantName, qris_url: null }
    ];

const displayedWishes = wishes ? wishes.slice(0, 4) : [];
const isWishesEmpty   = !wishes || wishes.length === 0;
const totalWishPages  = wishes ? Math.ceil(wishes.length / 4) : 0;

const galleryColumns = themeConfig.layout?.galleryColumns || 2;
const galleryColClass = galleryColumns === 3
  ? 'gallery-grid--col3'
  : galleryColumns === 4
    ? 'gallery-grid--col4'
    : 'gallery-grid--col2';

const fallbackGallery = [
  metatahBg, sidebarBg, metatahBg, sidebarBg, metatahBg, sidebarBg
].map((image, index) => ({
  id: String(index + 1),
  image_url: image,
  variant: index === 0 || index === 3 ? 'full-16x10' : 'half'
}));

const activeGallery = gallery && gallery.length > 0
  ? gallery.map((image, index) => ({
      id: image.id,
      image_url: image.image_url,
      variant: index === 0 || index === 3 ? 'full-16x10' : 'half'
    }))
  : fallbackGallery;

const activeStory = wedding.story && wedding.story.length > 0 && wedding.story[0]?.title !== 'Pertama Bertemu'
  ? wedding.story
  : [
      { title: 'Makna Upacara Mepandes', description: 'Upacara Mepandes / Metatah (Potong Gigi) merupakan upacara Manusa Yadnya dalam agama Hindu di Bali yang melambangkan pengendalian Sad Ripu (enam musuh dalam diri manusia).' },
      { title: 'Penyucian Diri Menuju Kedewasaan', description: 'Sebagai simbol peralihan menuju kedewasaan, memohon keselamatan, ketenangan batin, serta keharmonisan lahir dan batin kepada Ida Sang Hyang Widhi Wasa.' }
    ];
---

<BaseLayout
  wedding={wedding}
  settings={settings}
  to={guestName}
  templateClass="template-lumiere-metatah"
  image={coverImage}
  title={text.metaTitle || (isMultipleParticipants ? `${text.ceremonyTitle || 'Upacara Metatah'} - ${participantsNames}` : `Upacara Metatah ${participantsNames}`)}
  description={text.metaDescription || (text.verse ? text.verse.slice(0, 160) : `Upacara Manusa Yadnya (Metatah / Potong Gigi) ${participantsNames}.`)}
>
  <div class="invitation-root" data-template-root>
    {sections.introAnimation !== false && (
      <ClassicIntro
        groomName={introAnimationName}
        brideName=""
        subtitle={introAnimationSubtitle}
        coverImage={coverImage}
      />
    )}

    <!-- ── Background slideshow ─────────────────────────────────────────── -->
    <div class="page-bg" data-template-slider aria-hidden="true">
      {heroSlides.map((slide, index) => {
          const isInitial = index === 0;
          const slideUrl = typeof slide === 'string' ? slide : (slide as any)?.src;
          return isInitial ? (
            <SmartImage
              class="template-slide is-active"
              src={slide}
              alt=""
              loading="eager"
              fetchpriority="high"
              data-cover-slide={slide === coverImage ? 'true' : 'false'}
            />
          ) : (
            <img
              class="template-slide"
              data-src={slideUrl}
              alt=""
              loading="lazy"
              decoding="async"
              data-cover-slide={slide === coverImage ? 'true' : 'false'}
            />
          );
        })}
    </div>

    <!-- ══════════════════ COVER / HERO ══════════════════ -->
    <section class="cover-section" data-template-cover>
      <SmartImage src={coverImage} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
      <div class="cover-section__overlay"></div>
      <div class="cover-section__body">
        <div class="cover-section__title-block">
          <span class="cover-section__eyebrow">{coverEyebrow}</span>
          <h1 class="cover-section__title">
            <span class="cover-section__name">{coverTitle}</span>
          </h1>
          <time class="cover-section__date">{text.coverDate || coverDateFormatted}</time>
        </div>
        <div class="cover-section__guest">
          <p class="cover-section__guest-label">Kepada Yth. Bapak/Ibu/Saudara/i</p>
          <strong class="cover-section__guest-name">{guestName || 'Tamu Undangan'}</strong>
          <button class="template-btn template-btn--cover" data-template-open type="button">
            Buka Undangan
          </button>
        </div>
      </div>
    </section>

    <!-- ══════════════════ INVITATION LAYOUT (hidden until opened) ══════════════════ -->
    <div class="invitation-layout" data-template-layout>
      <div class="sidebar-section-wrap">
        <aside class="sidebar-section">
          <SmartImage class="section-bg section-bg--sidebar" src={sidebarImage} alt="" aria-hidden="true" />
          <div class="sidebar-section__inner" data-animate>
            <p class="sidebar-section__eyebrow">{sidebarEyebrow}</p>
            <h2 class="sidebar-section__name">{sidebarName}</h2>
            <div class="sidebar-section__divider">
              <span class="sidebar-section__date">{text.sidebarDate || formattedDate}</span>
            </div>
          </div>
        </aside>
      </div>

      <main>

        <!-- ── Intro / Hero Section ──────────────────────────── -->
        <section class="intro-section" id="awal-undangan">
          <div class="intro-section__inner" data-animate>
            <span class="intro-section__eyebrow">{introEyebrow}</span>
            <h1 class="intro-section__title">
              <span class="intro-section__name">{introName}</span>
            </h1>
            <time class="intro-section__date">{text.introDate || introDateFormatted}</time>
            <div class="intro-section__scroll-indicator" aria-hidden="true">
              <span class="scroll-text">SCROLL</span>
              <div class="scroll-line"></div>
            </div>
          </div>
        </section>

        <!-- ── Quote / Doa Restu Section ─────────────────────── -->
        <section class="quote-section">
          <div class="quote-section__inner" data-animate>
            <blockquote class="quote-section__verse">
              {text.verse}
            </blockquote>
            <!-- <cite class="quote-section__source">{text.verseSource}</cite> -->
          </div>
        </section>

        <!-- ── Peserta Upacara ───────────────────────────────── -->
        {sections.coupleInfo && (
          <section class="couple-section couple-section--metatah" id="data-peserta">
            <div class="couple-section__header" data-animate>
              <p class="couple-section__eyebrow">
                {pesertaSectionEyebrow}
              </p>
              <h2 class="section-title">{pesertaSectionTitle}</h2>
              <div class="section-rule"></div>
            </div>

            {participantsList.map((person) => (
              <article class="couple-section__person" data-animate>
                <div class="couple-section__image-wrap" data-animate>
                  <SmartImage
                    class="couple-section__image"
                    src={person.photo}
                    alt={person.name}
                    loading="lazy"
                  />
                </div>
                <div class="couple-section__divider" data-animate>
                  <span class="couple-section__role">{person.nickname || person.name}</span>
                </div>
                <div class="couple-section__info" data-animate>
                  <h2 class="couple-section__name">{person.fullName || person.name}</h2>
                  {person.parents && person.parents.length > 0 && (
                    <p class="couple-section__parents">
                      {person.parents.map((line: string) => (
                        <span class="couple-section__parent-line">{line}</span>
                      ))}
                    </p>
                  )}
                  {person.description && (
                    <p class="couple-section__desc">
                      {person.description}
                    </p>
                  )}
                  {person.instagram && person.instagram !== '#' && (
                    <a class="couple-section__social" href={person.instagram} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} Instagram`} data-track-couple-instagram="participant">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                      </svg>
                      <span>{getInstagramUsername(person.instagram)}</span>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </section>
        )}

        <!-- ── Makna Upacara / Story Section ────────────────── -->
        {sections.story && (
          <section class="story-section">
            <h2 class="story-section__title" data-animate>{text.storyTitle || 'Sekilas Upacara'}</h2>
            {activeStory.map((item) => (
              <article class="story-section__item" data-animate>
                <h3 class="story-section__item-title">{item.title}</h3>
                <p class="story-section__text">{item.description}</p>
              </article>
            ))}
          </section>
        )}

        <!-- ── Save the Date / Countdown ────────────────────── -->
        {sections.countdown && settings.countdown_enabled && (
          <section class="countdown-section" data-animate>
            <h2 class="event-section__title" data-animate>Save The Date</h2>
            <div class="event-section__countdown" data-animate>
              <CountdownTimer date={wedding.wedding_date} />
            </div>
            <a
              class="template-btn"
              href={buildGoogleCalendarUrl(wedding as any, activeEvents[0] as any)}
              target="_blank"
              rel="noopener noreferrer"
              data-animate
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Simpan Tanggal
            </a>
          </section>
        )}

        <!-- ── Events Section ─────────────────────────────────── -->
        {sections.eventDetails && (
          <section class="event-section" id="event">
            <div class="event-section__media" data-animate>
              <SmartImage src={eventImage || saveDateImage} alt="" loading="lazy" />
            </div>
            <div class="event-section__content">
              {activeEvents.map((event) => {
                const eventDate = formatEventDate(event.event_date);
                return (
                  <article class="event-card" data-animate>
                    <h3 class="event-card__title">{event.event_name}</h3>
                    <h4 class="event-card__date">{eventDate.weekday}, {eventDate.date}</h4>
                    <p class="event-card__time">
                      Pukul {event.start_time} {event.end_time ? `- ${event.end_time}` : '- Selesai'}
                    </p>
                    <p class="event-card__venue">{event.venue_name}</p>
                    <p class="event-card__address">{event.venue_address}</p>
                    {event.maps_url && (
                      <a class="event-card__map-btn" href={event.maps_url} target="_blank" rel="noopener noreferrer">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                          <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        Open Maps
                      </a>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        )}

        <!-- ── Gallery Section ───────────────────────────────── -->
        {sections.gallery && settings.gallery_enabled && (
          <section class="gallery-section" id="gallery-section">
            <div class="gallery-container">
              <div class="gallery-header" data-animate data-stagger-heading>
                <h2 class="section-title gallery-section__title">Galeri Foto</h2>
              </div>
              <div class={`gallery-grid ${galleryColClass}`}>
                {activeGallery.map((image, index) => {
                  const isFirst = index === 0;
                  const showVideo = isFirst && Boolean(videoUrl) && sections.video !== false;
                  const itemVariant = image.variant;

                  return (
                    <a
                      class={`gallery-item gallery-item--${itemVariant}`}
                      href={showVideo ? videoUrl : (typeof image.image_url === 'string' ? image.image_url : image.image_url.src)}
                      data-fancybox="gallery-section"
                      data-animate
                    >
                      {showVideo ? (
                        <video
                          class="gallery-item__img"
                          src={videoUrl}
                          loop
                          muted
                          playsinline
                          poster={typeof image.image_url === 'string' ? image.image_url : image.image_url.src}
                        ></video>
                      ) : (
                        <SmartImage src={image.image_url} alt="Galeri upacara" loading="lazy" class="gallery-item__img" />
                      )}

                      <div class="gallery-item__overlay">
                        <div class="gallery-item__zoom">
                          {showVideo ? (
                            <svg viewBox="0 0 24 24" fill="currentColor">
                              <path d="M8 5.14v13.72c0 .78.86 1.26 1.53.84l10.78-6.86a1 1 0 0 0 0-1.68L9.53 4.3A1 1 0 0 0 8 5.14Z"></path>
                            </svg>
                          ) : (
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                            </svg>
                          )}
                        </div>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          </section>
        )}

        <!-- ── RSVP & Wishes ─────────────────────────────────── -->
        {sections.rsvp && settings.rsvp_enabled && (
          <section class="rsvp-row" id="rsvp" data-rsvp-section>
            <div class="rsvp-row__content">
              <section class="rsvp-section" data-animate>
                <div class="rsvp-container">
                  <div class="rsvp-header" data-animate data-stagger-heading>
                    <h3 class="section-title rsvp-section__title">{text.rsvpTitle || 'RSVP & Doa Restu'}</h3>
                    <p class="rsvp-section__desc">{text.rsvpDescription}</p>
                  </div>

                  <div class="rsvp-panel" data-animate>
                    <div class="rsvp-card">
                      <div class="rsvp-success" data-rsvp-success>
                        <div class="rsvp-success__icon">
                          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                        </div>
                        <h4 class="rsvp-success__title">Matur Suksma!</h4>
                        <p class="rsvp-success__desc">Konfirmasi kehadiran dan doa restu Anda telah berhasil kami terima.</p>
                      </div>

                      <form class="rsvp-form" data-rsvp-form>
                        <input type="hidden" name="weddingId" value={wedding.id} />
                        <div class="rsvp-form__field">
                          <input type="text" id="rsvp-lumiere-metatah-name" name="name" required placeholder="Nama Anda" class="rsvp-form__input" value={guestName || ''} />
                        </div>
                        <div class="rsvp-form__field">
                          <select id="rsvp-lumiere-metatah-attendance" name="attendance" required class="rsvp-form__select" data-rsvp-attendance>
                            <option value="" disabled>Konfirmasi Kehadiran</option>
                            <option value="attending" selected>Hadir</option>
                            <option value="tentative">Ragu-ragu</option>
                            <option value="declined">Tidak Dapat Hadir</option>
                          </select>
                        </div>
                        <div class="rsvp-form__field">
                          <select name="count" class="rsvp-form__select">
                            <option value="1" selected>1 Orang</option>
                            <option value="2">2 Orang</option>
                            <option value="3">3 Orang</option>
                            <option value="4">4 Orang</option>
                            <option value="5">5 Orang</option>
                          </select>
                        </div>
                        <div class="rsvp-form__field">
                          <textarea id="rsvp-lumiere-metatah-message" name="message" rows={3} placeholder="Doa Restu & Pesan" class="rsvp-form__textarea"></textarea>
                        </div>
                        <div class="rsvp-form__error" data-rsvp-error></div>
                        <button type="submit" class="rsvp-form__submit" data-rsvp-submit>Kirim Doa Restu</button>
                      </form>
                    </div>

                    <div class="wishes-list" data-wishes-list>
                      <div class={`wishes-empty ${isWishesEmpty ? '' : 'is-hidden'}`} data-wishes-empty>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <span>Belum ada doa restu. Jadilah yang pertama memberikan doa restu!</span>
                      </div>

                      {displayedWishes.map((wish) => (
                        <div
                          class="wish-card"
                          data-animate
                          data-wish-id={wish.id}
                          data-wish-key={wish.id || `${wish.created_at}|${wish.guest_name}|${wish.message || ''}`}
                        >
                          <div class="wish-card__header">
                            <div class="wish-card__meta">
                              <span class="wish-card__name">{wish.guest_name}</span>
                              <span class={`wish-card__badge ${wish.attendance_status === "attending" ? "wish-card__badge--attend" : wish.attendance_status === "tentative" ? "wish-card__badge--tentative" : "wish-card__badge--absent"}`}>
                                {wish.attendance_status === "attending" ? "Hadir" : wish.attendance_status === "tentative" ? "Ragu" : "Tidak Hadir"}
                              </span>
                            </div>
                            <span class="wish-card__date">{formatWishDate(wish.created_at)}</span>
                          </div>
                          <p class="wish-card__message">{wish.message}</p>
                        </div>
                      ))}
                    </div>
                    {totalWishPages > 1 && (
                      <div class="wishes-pagination" data-wishes-pagination data-wedding-id={wedding.id} data-current-page="1" data-total-pages={totalWishPages} data-per-page="4">
                        <button type="button" class="wishes-pagination__btn" data-wishes-prev disabled aria-label="Halaman sebelumnya">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </button>
                        <div class="wishes-pagination__numbers" data-wishes-numbers>
                          {generatePaginationItems(1, totalWishPages).map((item) => (
                            typeof item === 'number' ? (
                              <button
                                type="button"
                                class={`wishes-pagination__num ${item === 1 ? 'wishes-pagination__num--active' : ''}`}
                                data-wishes-page={item}
                                aria-label={`Halaman ${item}`}
                              >
                                {item}
                              </button>
                            ) : (
                              <span class="wishes-pagination__ellipsis">...</span>
                            )
                          ))}
                        </div>
                        <button type="button" class="wishes-pagination__btn" data-wishes-next aria-label="Halaman berikutnya">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              </section>
            </div>
          </section>
        )}

        <!-- ── Tanda Kasih / Gift ────────────────────────────── -->
        {sections.gift && settings.gift_enabled && (
          <section class="gift-section" id="gift" data-animate data-gift-section>
            <div class="gift-container">
              <div class="gift-header" data-animate data-stagger-heading>
                <h3 class="section-title gift-section__title">{text.giftTitle || 'Tanda Kasih'}</h3>
                <p class="gift-section__desc">{text.giftDescription}</p>
                <div class="section-rule"></div>
              </div>
              <button
                class="gift-toggle-btn"
                data-gift-toggle
                type="button"
                aria-expanded="false"
                data-show-text="Lihat Hadiah"
                data-hide-text="Sembunyikan Hadiah"
              >
                Lihat Hadiah
              </button>
              <GiftGrid gifts={activeGifts} hidden />
            </div>
          </section>
        )}

        <!-- ── Closing / Suksema ─────────────────────────────── -->
        <section class="closing-row">
          <div class="closing-row__media" data-animate>
            <SmartImage src={closingImage} alt="" loading="lazy" />
          </div>
          <div class="closing-row__content" data-animate>
            <h3 class="closing-row__title">{closingTitle}</h3>
            <p class="closing-row__message">{closingMessage}</p>
            <h4 class="closing-row__names">
              {closingNames}
            </h4>
            <footer class="thankyou-section__footer">
              <SmartImage src="/images/senadda-logo.png" alt="Senadda" class="thankyou-section__brand" />
              <div class="thankyou-section__socials">
                <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link" data-track-vendor-instagram>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="1"></circle>
                  </svg>
                </a>
                {whatsappUrl && (
                  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-link" data-track-vendor-whatsapp>
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                    </svg>
                  </a>
                )}
                <a href="/" target="_blank" rel="noopener noreferrer" aria-label="Website" class="social-link" data-track-vendor-site>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path></svg>
                </a>
              </div>
              <p class="thankyou-section__copyright">&copy; Copyright {new Date().getFullYear()}</p>
            </footer>
          </div>
        </section>

      </main>

      <!-- Music toggle -->
      {sections.music && (
        <button class="audio-toggle" data-template-audio-toggle type="button" aria-label="Play or pause music">
          <div class="audio-icon-wrapper">
            <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
          </div>
          {settings.music_enabled && wedding.music_url && (
            <audio data-template-audio loop preload="none" src={wedding.music_url}></audio>
          )}
        </button>
      )}

    </div><!-- /invitation-layout -->
  </div><!-- /invitation-root -->
</BaseLayout>

<script>
  import './script.js';
</script>
