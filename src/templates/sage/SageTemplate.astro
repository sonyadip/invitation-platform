---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { FullInvitationData } from '../../types';
import bgHero from './assets/bg-hero.webp';
import coupleBride from './assets/couple-bride.jpg';
import coupleGroom from './assets/couple-groom.jpg';
import galleryOne from './assets/gallery-1.jpg';
import galleryTwo from './assets/gallery-2.jpg';
import galleryThree from './assets/gallery-3.jpg';
import galleryFour from './assets/gallery-4.jpg';
import galleryFive from './assets/gallery-5.jpg';
import gallerySix from './assets/gallery-6.jpg';
import gallerySeven from './assets/gallery-7.jpg';
import galleryEight from './assets/gallery-8.webp';
import '@fancyapps/ui/dist/fancybox/fancybox.css';
import './style.scss';

interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings, events, gallery, gifts, wishes } = data;
const sections = settings.sections;
// Override gallery with custom local images for Sage template
const customGallery = [
  { id: '1', image_url: galleryOne.src, variant: 'full-16x10' },
  { id: '2', image_url: galleryTwo.src, variant: 'half' },
  { id: '3', image_url: galleryThree.src, variant: 'half' },
  { id: '4', image_url: galleryFour.src, variant: 'half' },
  { id: '5', image_url: galleryFive.src, variant: 'half' },
  { id: '6', image_url: gallerySix.src, variant: 'full-16x10' },
  { id: '7', image_url: gallerySeven.src, variant: 'half' },
  { id: '8', image_url: galleryEight.src, variant: 'half' }
];
const themeConfig = (settings.theme_config || {
  theme: {},
  layout: { galleryColumns: 3 },
  assets: {}
}) as any;

// Override font & color settings for the Sage theme
const overrideSettings = {
  ...settings,
  theme_config: {
    ...themeConfig,
    theme: {
      ...themeConfig.theme,
      primaryColor: '#DDE7D4', // Sage Ivory
      secondaryColor: '#17211A',
      textColor: '#F7F1E3',
      bgColor: '#17211A',
      fontHeading: 'CVR',
      fontBody: 'Josefin Sans'
    }
  }
};

const formattedDate = new Date(wedding.wedding_date).toLocaleDateString('id-ID', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const formatDate = (iso: string) => new Date(iso).toLocaleDateString('id-ID', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
});

const activeEvents = events && events.length > 0
  ? events
  : [{
      id: 'fallback',
      event_name: 'Akad Nikah',
      event_date: wedding.wedding_date,
      start_time: '09:00',
      end_time: 'Selesai',
      venue_name: wedding.venue_name,
      venue_address: wedding.venue_address,
      maps_url: wedding.maps_url,
      sort_order: 0,
      wedding_id: wedding.id,
      created_at: ''
    }];

const padDatePart = (value: number) => String(value).padStart(2, '0');

const buildCalendarDate = (dateInput: string, timeInput?: string) => {
  const date = new Date(dateInput);
  const [hour = '09', minute = '00'] = timeInput && /^\d{1,2}:\d{2}$/.test(timeInput)
    ? timeInput.split(':')
    : ['09', '00'];

  date.setHours(Number(hour), Number(minute), 0, 0);

  return [
    date.getFullYear(),
    padDatePart(date.getMonth() + 1),
    padDatePart(date.getDate()),
    'T',
    padDatePart(date.getHours()),
    padDatePart(date.getMinutes()),
    '00'
  ].join('');
};

const buildGoogleCalendarUrl = () => {
  const event = activeEvents[0];
  const startDate = new Date(event.event_date);
  const startTime = /^\d{1,2}:\d{2}$/.test(event.start_time) ? event.start_time : '09:00';
  let endTime = /^\d{1,2}:\d{2}$/.test(event.end_time) ? event.end_time : '';

  if (!endTime) {
    const fallbackEnd = new Date(startDate);
    const [hour, minute] = startTime.split(':');
    fallbackEnd.setHours(Number(hour) + 2, Number(minute), 0, 0);
    endTime = `${padDatePart(fallbackEnd.getHours())}:${padDatePart(fallbackEnd.getMinutes())}`;
  }

  const params = new URLSearchParams({
    action: 'TEMPLATE',
    text: `Wedding of ${wedding.groom_name} & ${wedding.bride_name}`,
    dates: `${buildCalendarDate(event.event_date, startTime)}/${buildCalendarDate(event.event_date, endTime)}`,
    details: `Wedding invitation for ${wedding.groom_name} and ${wedding.bride_name}.`,
    location: `${event.venue_name}, ${event.venue_address}`,
    ctz: 'Asia/Makassar'
  });

  return `https://calendar.google.com/calendar/render?${params.toString()}`;
};

const googleCalendarUrl = buildGoogleCalendarUrl();

const themeAssets = themeConfig.assets || {};
const heroImage = themeAssets.heroImage || bgHero.src;
const brideImage = themeAssets.brideImage || coupleBride.src;
const groomImage = themeAssets.groomImage || coupleGroom.src;
const activeGallery = gallery && gallery.length > 0
  ? gallery.map((image, index) => ({
      id: image.id,
      image_url: image.image_url,
      variant: index === 0 || index === 5 ? 'full-16x10' : 'half'
    }))
  : customGallery;
const galleryColumns = themeConfig.layout?.galleryColumns || 3;
const galleryColClass = galleryColumns === 2
  ? 'gallery-grid--col2'
  : galleryColumns === 4
    ? 'gallery-grid--col4'
    : 'gallery-grid--col3';

const formatWishDate = (isoStr: string) => new Date(isoStr).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});

const isWishesEmpty = !wishes || wishes.length === 0;
const displayedWishes = wishes ? wishes.slice(0, 3) : [];
const hasMoreWishes = wishes ? wishes.length > displayedWishes.length : false;

const activeGifts = gifts && gifts.length > 0
  ? gifts
  : [
      { id: '1', bank_name: 'BCA', account_number: '1234567890', account_name: 'Sony Pratama', qris_url: null },
      { id: '2', bank_name: 'Bank Mandiri', account_number: '0987654321', account_name: 'Pratiwi Indah', qris_url: null }
    ];

---

<BaseLayout wedding={wedding} settings={overrideSettings} to={guestName} templateClass="template-sage">
  <div class="invitation-root" data-template-root>
    <!-- ===================== COVER SCREEN ===================== -->
    <div class="cover-section" data-template-cover>
      <img class="section-bg section-bg--cover" src={heroImage} alt="" aria-hidden="true" />
      <div class="cover-section__body">
        <p class="cover-section__eyebrow">The Wedding Of</p>
        <h2 class="cover-section__names">
          {wedding.groom_name}
          <span class="cover-section__amp">&amp;</span>
          {wedding.bride_name}
        </h2>
        <div class="cover-section__divider"></div>
        {guestName && (
          <div class="cover-section__guest">
            <p class="cover-section__guest-label">Dear,</p>
            <p class="cover-section__guest-name">{guestName}</p>
          </div>
        )}
        <div class="cover-section__spacer"></div>
        <button class="cover-section__btn" data-template-open aria-label="Open Invitation">
          Open Invitation
        </button>
      </div>
    </div>

    <!-- ===================== MAIN LAYOUT ===================== -->
    <div class="invitation-layout" data-template-layout>

      <!-- LEFT FIXED SIDEBAR (desktop only) -->
      <div class="sidebar-section-wrap">
        <aside class="sidebar-section">
          <img class="section-bg section-bg--sidebar" src={heroImage} alt="" aria-hidden="true" />
          <div class="sidebar-section__inner" data-animate="fade-up">
            <p class="sidebar-section__eyebrow">The Wedding Of</p>
            <h2 class="sidebar-section__groom">{wedding.groom_name}</h2>
            <div class="sidebar-section__sep">&amp;</div>
            <h2 class="sidebar-section__bride">{wedding.bride_name}</h2>
            <div class="sidebar-section__divider">
              <span class="sidebar-section__date">{formattedDate}</span>
            </div>
          </div>
        </aside>
      </div>

      <!-- RIGHT SCROLLABLE CONTENT -->
      <main class="invitation-main">

        <!-- Hero (right column top) -->
        <div class="hero-section">
          <img class="section-bg section-bg--hero" src={heroImage} alt="" aria-hidden="true" />
          <div class="hero-section__inner" data-animate="fade-up">
            <p class="hero-section__eyebrow">The Wedding Of</p>
            <h3 class="hero-section__groom">{wedding.groom_name}</h3>
            <div class="hero-section__divider"><span>&amp;</span></div>
            <h3 class="hero-section__bride">{wedding.bride_name}</h3>
            <div class="hero-section__arrow">
              <a href="#template-content" aria-label="Scroll down">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 5v14M19 12l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Opening verse -->
        <div class="opening-section" data-animate="fade-up">
          <div class="opening-section__ornament"></div>
          <p class="opening-section__verse">
            "Ihaiva stam mā vi yaustam, Visvām āyur vyasnutam. Krindantau putrair naptrbhih, Modamānau sve grhe."
            <strong>(Rgveda : X.85.42)</strong>
          </p>
        </div>

        <div id="template-content" class="sections-stack">

          <!-- ===== COUPLE SECTION ===== -->
          {sections.coupleInfo && (
            <section class="couple-section" id="mempelai" data-animate="fade-up">
              {/* <div class="couple-section__greeting">
                <p>
                  <strong>Assalamu'alaikum Warahmatullahi Wabarakatuh</strong><br /><br />
                  Maha Suci Allah yang telah menciptakan makhluk-Nya berpasang-pasangan.
                  Ya Allah semoga ridho-Mu tercurah mengiringi pernikahan kami.
                </p>
              </div> */}

              <div class="couple-section__row">
                <!-- Bride card -->
                <div class="person-card" data-animate="fade-right">
                  <div class="person-card__photo-wrap">
                    <img
                      class="person-card__photo"
                      src={brideImage}
                      alt={wedding.bride_name}
                      loading="lazy"
                    />
                  </div>
                  <p class="person-card__role">Bride</p>
                  <p class="person-card__fullname">{wedding.bride_full_name}</p>
                  <p class="person-card__parents">Putri dari<br/>Keluarga Mempelai Wanita</p>
                </div>

                <!-- Ampersand -->
                <div class="couple-section__amp" data-animate="zoom-in">&amp;</div>

                <!-- Groom card -->
                <div class="person-card" data-animate="fade-left">
                  <div class="person-card__photo-wrap">
                    <img
                      class="person-card__photo"
                      src={groomImage}
                      alt={wedding.groom_name}
                      loading="lazy"
                    />
                  </div>
                  <p class="person-card__role">Groom</p>
                  <p class="person-card__fullname">{wedding.groom_full_name}</p>
                  <p class="person-card__parents">Putra dari<br/>Keluarga Mempelai Pria</p>
                </div>
              </div>
            </section>
          )}

          <!-- ===== EVENT DETAILS ===== -->
          {sections.eventDetails && (
            <section class="events-section">
              <div class="events-section__header" data-animate="fade-up">
                {/* <p class="section-eyebrow">Wedding Events</p> */}
                <h3 class="section-title">Save<br>The Date</h3>
              </div>

              <div class="events-section__cards">
                {activeEvents.map((evt) => (
                  <div class="event-card" data-animate="fade-up">
                    <div class="event-card__icon">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                    </div>
                    <p class="event-card__name">{evt.event_name}</p>
                    <div class="event-card__sep"></div>
                    <div>
                      <p class="event-card__date">{formatDate(evt.event_date)}</p>
                      <p class="event-card__time">{evt.start_time} - {evt.end_time}</p>
                    </div>
                    <div>
                      <p class="event-card__venue-name">{evt.venue_name}</p>
                      <p class="event-card__venue-addr">{evt.venue_address}</p>
                    </div>
                    <a
                      href={evt.maps_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="event-card__map-btn"
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                      </svg>
                      Open Maps
                    </a>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- ===== COUNTDOWN ===== -->
        {sections.countdown && (
          <div class="countdown-section" data-animate="fade-up">
            {/* <h2 class="countdown-section__title">Save The Date</h2> */}
            {settings.countdown_enabled && (
              <div class="countdown-section__timer" data-animate="fade-up">
                <div class="countdown-card glassmorphism">
                  <div class="countdown-grid" data-countdown-timer data-date={wedding.wedding_date}>
                    <div class="countdown-item">
                      <span class="countdown-item__value" data-countdown-days>00</span>
                      <span class="countdown-item__label">Hari</span>
                    </div>
                    <div class="countdown-item">
                      <span class="countdown-item__value" data-countdown-hours>00</span>
                      <span class="countdown-item__label">Jam</span>
                    </div>
                    <div class="countdown-item">
                      <span class="countdown-item__value" data-countdown-minutes>00</span>
                      <span class="countdown-item__label">Menit</span>
                    </div>
                    <div class="countdown-item">
                      <span class="countdown-item__value" data-countdown-seconds>00</span>
                      <span class="countdown-item__label">Detik</span>
                    </div>
                  </div>
                </div>
              </div>
            )}
            <a
              href={googleCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="countdown-section__calendar-btn"
              data-animate="zoom-in"
              aria-label="Save wedding date to Google Calendar"
            >
              Save to Google Calendar
            </a>
          </div>
        )}

          <!-- ===== GALLERY ===== -->
          {sections.gallery && (
            settings.gallery_enabled && (
              <>
                <section class="gallery-section">
                  <div class="gallery-container">
                    <div class="gallery-header" data-animate="fade-up">
                      <h2 class="section-title">Our Gallery</h2>
                      <div class="section-rule"></div>
                    </div>

                    <div class={`gallery-grid ${galleryColClass}`}>
                      {activeGallery.map((img) => (
                        <a
                          href={img.image_url}
                          class={`gallery-item gallery-item--${img.variant}`}
                          data-animate="zoom-in"
                          data-fancybox="sage-gallery"
                        >
                          <img src={img.image_url} alt="Wedding Gallery Moment" loading="lazy" class="gallery-item__img" />
                          <div class="gallery-item__overlay">
                            <div class="gallery-item__zoom">
                              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                              </svg>
                            </div>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                </section>
              </>
            )
          )}

          <!-- ===== RSVP & WISHES ===== -->
          {sections.rsvp && (
            settings.rsvp_enabled && (
              <section class="rsvp-section" data-animate="fade-up" data-rsvp-section>
                <div class="rsvp-container">
                  <div class="rsvp-header" data-animate="fade-up">
                    <h3 class="section-title">RSVP & Wishes</h3>
                    <p class="rsvp-subtitle">Mohon konfirmasi kehadiran Anda dan berikan doa restu.</p>
                  </div>

                  <div class="rsvp-panel" data-animate="fade-up">
                    <div class="rsvp-card">
                      <div class="rsvp-success" data-rsvp-success style="display:none;">
                        <div class="rsvp-success__icon">
                          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                        </div>
                        <h4 class="rsvp-success__title">Terima Kasih!</h4>
                        <p class="rsvp-success__desc">Konfirmasi kehadiran dan ucapan Anda telah berhasil kami simpan.</p>
                      </div>

                      <form class="rsvp-form" data-rsvp-form>
                        <input type="hidden" name="weddingId" value={wedding.id} />
                        <div class="rsvp-form__field">
                          <input type="text" id="rsvp-name" name="name" required placeholder="Nama" class="rsvp-form__input" />
                        </div>
                        <div class="rsvp-form__field">
                          <select id="rsvp-attendance" name="attendance" required class="rsvp-form__select" data-rsvp-attendance>
                            <option value="" disabled selected>Konfirmasi Kehadiran</option>
                            <option value="attending">Hadir</option>
                            <option value="declined">Tidak Hadir</option>
                          </select>
                        </div>
                        <div class="rsvp-form__field">
                          <textarea id="rsvp-message" name="message" rows="4" placeholder="Ucapan" class="rsvp-form__textarea"></textarea>
                        </div>
                        <div class="rsvp-form__error" data-rsvp-error style="display:none;"></div>
                        <button type="submit" class="rsvp-form__submit" data-rsvp-submit>Submit</button>
                      </form>
                    </div>

                    <div class="wishes-list" data-wishes-list>
                      <div class="wishes-empty" data-wishes-empty style={isWishesEmpty ? '' : 'display:none;'}>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <span>Belum ada ucapan. Jadilah yang pertama memberikan doa restu!</span>
                      </div>

                      {displayedWishes.map((wish) => (
                        <div class="wish-card animate-fade-in-up" data-animate="fade-up">
                          <div class="wish-card__header">
                            <div class="wish-card__meta">
                              <span class="wish-card__name">{wish.guest_name}</span>
                              <span class={`wish-card__badge ${wish.attendance_status === 'attending' ? 'wish-card__badge--attend' : 'wish-card__badge--absent'}`}>
                                {wish.attendance_status === 'attending' ? 'Hadir' : 'Absen'}
                              </span>
                            </div>
                            <span class="wish-card__date">{formatWishDate(wish.created_at)}</span>
                          </div>
                          <p class="wish-card__message">{wish.message}</p>
                        </div>
                      ))}
                    </div>
                    {hasMoreWishes && (
                      <button class="wishes-load-more" data-wishes-load-more data-offset={displayedWishes.length} data-wedding-id={wedding.id}>
                        Load More
                      </button>
                    )}
                  </div>
                </div>
              </section>
            )
          )}

          <!-- ===== GIFT ===== -->
          {sections.gift && (
            settings.gift_enabled && (
              <>
                <section class="gift-section" data-animate="fade-up" data-gift-section>
                  <div class="gift-container">
                    <div class="gift-header" data-animate="fade-up">
                      <h3 class="section-title">Wedding Gift</h3>
                      <p class="gift-desc">
                        Bagi Bapak/Ibu/Saudara/i yang ingin mengirimkan hadiah kasih, dapat melalui transfer rekening berikut:
                      </p>
                      <div class="section-rule"></div>
                    </div>

                    <button class="gift-toggle-btn" data-gift-toggle type="button">Lihat Hadiah Pernikahan</button>

                    <div class="gift-grid" data-gift-grid hidden>
                      {activeGifts.map((gift) => (
                        <div class="gift-card" data-animate="fade-up">
                          <div class="gift-card__body">
                            <span class="gift-card__bank">{gift.bank_name}</span>
                            <p class="gift-card__number">{gift.account_number}</p>
                            <p class="gift-card__holder">a.n. {gift.account_name}</p>
                          </div>
                          <div class="gift-card__actions">
                            <button class="gift-btn gift-btn--copy" data-copy-btn data-value={gift.account_number}>
                              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                              </svg>
                              <span>Salin</span>
                            </button>
                            {gift.qris_url && (
                              <button class="gift-btn gift-btn--qris" data-qris-btn data-url={gift.qris_url}>
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                                </svg>
                                <span>Tampilkan QRIS</span>
                              </button>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </section>

                <div class="qris-lightbox" data-qris-lightbox>
                  <div class="qris-lightbox__card" data-qris-card>
                    <button class="qris-lightbox__close" data-qris-close aria-label="Close QRIS">
                      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                    </button>
                    <h4 class="qris-lightbox__title">Scan QRIS Transfer</h4>
                    <div class="qris-lightbox__img-frame">
                      <img src="" alt="QRIS Scan" class="qris-lightbox__img" data-qris-img />
                    </div>
                    <p class="qris-lightbox__note">Silakan gunakan aplikasi perbankan atau e-wallet Anda untuk memindai kode QRIS di atas.</p>
                  </div>
                </div>
              </>
            )
          )}

        </div>

        <!-- Thank You -->
        <section class="thankyou-section" data-animate="fade-up">
          <img class="thankyou-section__bg" src={heroImage} alt="" aria-hidden="true" />
          <div class="thankyou-section__content" data-animate="fade-up">
            <p class="thankyou-section__title">Thank<br />you</p>
            <p class="thankyou-section__message">
              Merupakan suatu kebahagiaan dan kehormatan bagi kami, apabila Bapak/Ibu/Saudara/i berkenan hadir di hari bahagia kami.
            </p>
            <p class="thankyou-section__names">- {wedding.groom_name} &amp; {wedding.bride_name}</p>
          </div>
          <div class="thankyou-section__footer">
            <img src="/images/senadda-logo.png" alt="Senadda" class="thankyou-section__brand" />
            <div class="thankyou-section__socials">
              <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" xmlns="http://www.w3.org/2000/svg">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1"></circle>
                </svg>
              </a>
              <a href="https://wa.me/" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-link">
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12.04 2.5a9.43 9.43 0 0 0-8.16 14.14L2.5 21.5l4.98-1.31a9.43 9.43 0 1 0 4.56-17.69Zm0 17.14a7.71 7.71 0 0 1-3.93-1.08l-.28-.17-2.95.77.79-2.88-.18-.3a7.72 7.72 0 1 1 6.55 3.66Zm4.23-5.78c-.23-.12-1.37-.68-1.58-.75-.21-.08-.37-.12-.52.12-.16.23-.6.75-.74.9-.14.16-.27.18-.5.06-.23-.12-.98-.36-1.86-1.15-.69-.61-1.15-1.36-1.28-1.59-.14-.23-.02-.36.1-.48.11-.11.23-.27.35-.41.12-.14.16-.23.23-.39.08-.16.04-.29-.02-.41-.06-.12-.52-1.25-.71-1.71-.19-.45-.38-.39-.52-.4h-.45c-.16 0-.41.06-.62.29-.21.23-.81.79-.81 1.93 0 1.14.83 2.24.95 2.4.12.16 1.64 2.5 3.98 3.51.56.24.99.38 1.33.49.56.18 1.07.15 1.47.09.45-.07 1.37-.56 1.57-1.1.19-.54.19-1 .14-1.1-.06-.1-.21-.16-.44-.28Z"/>
                </svg>
              </a>
            </div>
            <p class="thankyou-section__copyright">&copy; Copyright {new Date().getFullYear()}</p>
          </div>
        </section>

      </main>
    </div>

    <!-- Floating Audio Player -->
    {sections.music && (
      <div class="audio-toggle" data-template-audio-toggle title="Play/Pause Music">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
        {settings.music_enabled && wedding.music_url && (
          <audio data-template-audio loop src={wedding.music_url}></audio>
        )}
      </div>
    )}

  </div>
</BaseLayout>

<script>
  import './script.js';
</script>

