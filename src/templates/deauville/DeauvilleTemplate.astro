---
import CinematicIntro from "../../components/common/CinematicIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SmartImage from "../../components/common/SmartImage.astro";
import type { FullInvitationData } from "../../types";
import { getPlatformSettings } from "../../services/platform-settings";
import deauvilleCover from "./assets/deauville-cover.jpg";
import deauvilleGroom from "./assets/deauville-groom.jpg";
import deauvilleBride from "./assets/deauville-bride.jpg";
import deauvilleEvent from "./assets/deauville-event.jpg";
import deauvilleRsvp from "./assets/deauville-rsvp.jpg";
import deauvilleSaveDate from "./assets/deauville-save-date.jpg";
import deauvilleClosing from "./assets/deauville-closing.jpg";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import "./style.scss";

import {
  buildParentText,
  formatDate,
  formatEventDate,
  buildGoogleCalendarUrl,
  formatWishDate
} from "../../utils/template-helpers";
import CountdownTimer from "../../components/common/CountdownTimer.astro";
import GiftGrid from "../../components/common/GiftGrid.astro";
import QRISLightbox from "../../components/common/QRISLightbox.astro";

interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings, events, gallery, gifts, wishes } = data;
const sections = settings.sections;
const themeConfig = (settings.theme_config || {
  theme: {},
  layout: {},
  assets: {},
}) as any;

const overrideSettings = {
  ...settings,
  theme_config: {
    ...themeConfig,
    theme: {
      ...themeConfig.theme,
      primaryColor: "#f2eee8",
      secondaryColor: "#171717",
      textColor: "#f8f5ef",
      bgColor: "#171717",
      fontHeading: "Cormorant Garamond",
      fontBody: "Josefin Sans",
    },
  },
};

const themeAssets = themeConfig.assets || {};
const themeContent = themeConfig.content || {};
const heroSlides = [
  themeAssets.heroImage || deauvilleGroom,
  themeAssets.heroImageTwo || deauvilleBride,
  themeAssets.heroImageThree || deauvilleEvent,
  themeAssets.eventImage || deauvilleEvent,
  themeAssets.rsvpImage || deauvilleRsvp,
  themeAssets.countdownImage || deauvilleSaveDate,
  themeAssets.closingImage || deauvilleClosing,
].filter(
  (slide, index, slides) => Boolean(slide) && slides.indexOf(slide) === index,
);
const featureSlides = [
  themeAssets.eventImage || deauvilleEvent,
  themeAssets.rsvpImage || deauvilleRsvp,
  themeAssets.countdownImage || deauvilleSaveDate,
  themeAssets.closingImage || deauvilleClosing,
].filter(
  (slide, index, slides) => Boolean(slide) && slides.indexOf(slide) === index,
);
const coverImage = themeAssets.coverImage || deauvilleCover.src;
const groomImage = themeAssets.groomImage || deauvilleGroom.src;
const brideImage = themeAssets.brideImage || deauvilleBride.src;
const closingImage = themeAssets.closingImage || deauvilleClosing.src;
const countdownImage = themeAssets.countdownImage || deauvilleSaveDate.src;
const videoUrl =
  themeAssets.videoUrl ||
  themeAssets.heroVideo ||
  "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm";
const videoPoster =
  themeAssets.videoPoster || themeAssets.posterImage || countdownImage;

const defaultText = {
  verse:
    "Wahai pasangan suami-isteri, semoga kalian tetap bersatu dan tidak pernah terpisahkan. Semoga kalian mencapai hidup penuh kebahagiaan, tinggal di rumah yang penuh kegembiraan bersama seluruh keturunanmu.",
  verseSource: "(Rgveda : X.85.42)",
  groomParents: "Putra dari Bapak Mempelai & Ibu Mempelai",
  brideParents: "Putri dari Bapak Mempelai & Ibu Mempelai",
  giftDescription:
    "Tanpa mengurangi rasa hormat, bagi tamu yang ingin mengirimkan hadiah kasih dapat melalui rekening berikut.",
  rsvpDescription:
    "Mohon konfirmasi kehadiran Anda dan berikan doa restu untuk kami.",
  closingMessage:
    "Merupakan suatu kebahagiaan dan kehormatan bagi kami, apabila Bapak/Ibu/Saudara/i berkenan hadir di hari bahagia kami.",
  instagramUrl: "#",
  groomInstagramUrl: "",
  brideInstagramUrl: "",
};
const text = { ...defaultText, ...themeContent };
const platformSettings = await getPlatformSettings();
const instagramUrl =
  text.instagramUrl && text.instagramUrl !== "#"
    ? text.instagramUrl
    : platformSettings.instagram_url || "#";
const whatsappUrl =
  themeContent.whatsappUrl || platformSettings.whatsapp_url || "";
const groomInstagramUrl = text.groomInstagramUrl || instagramUrl;
const brideInstagramUrl = text.brideInstagramUrl || instagramUrl;
const groomParentsText = buildParentText(
  "Putra dari",
  text.groomFatherName,
  text.groomMotherName,
  text.groomParents,
);
const brideParentsText = buildParentText(
  "Putri dari",
  text.brideFatherName,
  text.brideMotherName,
  text.brideParents,
);

const formattedDate = formatDate(wedding.wedding_date);
const compactDate = new Date(wedding.wedding_date)
  .toLocaleDateString("id-ID", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  })
  .replace(/\//g, " . ");

const activeEvents =
  events && events.length > 0
    ? events
    : [
        {
          id: "fallback",
          event_name: "Holy Matrimony",
          event_date: wedding.wedding_date,
          start_time: "08:00",
          end_time: "Selesai",
          venue_name: wedding.venue_name,
          venue_address: wedding.venue_address,
          maps_url: wedding.maps_url,
          sort_order: 0,
          wedding_id: wedding.id,
          created_at: "",
        },
      ];

const fallbackGallery = [
  deauvilleCover,
  deauvilleGroom,
  deauvilleBride,
  deauvilleEvent,
  deauvilleRsvp,
  deauvilleSaveDate,
  deauvilleClosing,
].map((image, index) => ({
  id: String(index + 1),
  image_url: image,
  variant: index === 0 || index === 5 ? "wide" : "square",
}));

const activeGallery =
  gallery && gallery.length > 0
    ? gallery.map((image, index) => ({
        id: image.id,
        image_url: image.image_url,
        variant: index % 5 === 0 ? "wide" : "square",
      }))
    : fallbackGallery;

const displayedWishes = wishes ? wishes.slice(0, 4) : [];
const isWishesEmpty = !wishes || wishes.length === 0;
const hasMoreWishes = wishes ? wishes.length > displayedWishes.length : false;
const activeGifts =
  gifts && gifts.length > 0
    ? gifts
    : [
        {
          id: "1",
          bank_name: "BCA",
          account_number: "1234567890",
          account_name: wedding.groom_name,
          qris_url: null,
        },
        {
          id: "2",
          bank_name: "Mandiri",
          account_number: "0987654321",
          account_name: wedding.bride_name,
          qris_url: null,
        },
      ];
---

<BaseLayout
  wedding={wedding}
  settings={overrideSettings}
  to={guestName}
  templateClass="template-deauville"
>
  <div class="invitation-root" data-template-root>
    <CinematicIntro
      groomName={wedding.groom_name}
      brideName={wedding.bride_name}
      coverImage={coverImage}
      fontClass="deauville-name--glasvia"
    />
    <section class="cover-section" data-template-cover>
      <SmartImage
        class="cover-section__bg"
        src={coverImage}
        alt=""
        aria-hidden="true"
      loading="eager" fetchpriority="high" />
      <div class="cover-section__body">
        <div class="cover-section__title-block">
          <p>The Wedding Of</p>
          <h1>
            <span class="deauville-name deauville-name--glasvia"
              >{wedding.groom_name}</span
            >
            <!-- <em>AND</em> -->
            <span class="deauville-name deauville-name--letterx"
              >{wedding.bride_name}</span
            >
          </h1>
        </div>
        <div class="cover-section__guest">
          <span>Kepada Yth:</span>
          <strong>{guestName || "Nama Tamu"}</strong>
          <button
            class="template-btn template-btn--light"
            data-template-open
            type="button">Buka Undangan</button
          >
        </div>
      </div>
    </section>

    <div class="invitation-layout" data-template-layout>
      <div class="sidebar-section-wrap">
        <aside class="sidebar-section">
          <SmartImage class="section-bg section-bg--sidebar" src={coverImage} alt="" aria-hidden="true" />
          <div class="sidebar-section__inner" data-animate>
            <p class="sidebar-section__eyebrow">The Wedding Of</p>
            <h2 class="sidebar-section__groom deauville-name--glasvia">{wedding.groom_name}</h2>
            <div class="sidebar-section__sep">&amp;</div>
            <h2 class="sidebar-section__bride deauville-name--letterx">{wedding.bride_name}</h2>
            <div class="sidebar-section__divider">
              <span class="sidebar-section__date">{formattedDate}</span>
            </div>
          </div>
        </aside>
      </div>

      <main class="invitation-main">


        <section class="hero-section snap-section">
          <div class="template-slider" data-template-slider>
            {
              themeAssets.heroVideo ? (
                <video
                  class="template-slide is-active"
                  src={themeAssets.heroVideo}
                  autoplay
                  loop
                  muted
                  playsinline
                ></video>
              ) : (
                heroSlides.map((slide, index) => (
                  <SmartImage
                    class={`template-slide ${index === 0 ? "is-active" : ""}`}
                    src={slide}
                    alt=""
                    aria-hidden="true"
                  />
                ))
              )
            }
          </div>
          <div class="hero-section__names" data-opening-animate>
            <h2 class="deauville-name--glasvia">{wedding.groom_name}</h2>
            <h2 class="deauville-name--letterx">{wedding.bride_name}</h2>
            <time>{compactDate}</time>
          </div>
          <blockquote data-opening-animate>
            "{text.verse}"
            <cite>{text.verseSource}</cite>
          </blockquote>
        </section>

        {
          sections.coupleInfo && (
            <>
              <section class="couple-section couple-section--groom snap-section">
                <SmartImage
                  class="couple-section__image"
                  src={groomImage}
                  alt=""
                  aria-hidden="true"
                />
                <div class="couple-section__content" data-animate>
                  <p class="couple-section__eyebrow">
                    The <i>Groom</i>
                  </p>
                  <h3>{wedding.groom_full_name || wedding.groom_name}</h3>
                  <p>{groomParentsText}</p>
                  <a
                    class="couple-section__social"
                    href={groomInstagramUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${wedding.groom_name} Instagram`}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      aria-hidden="true"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r="1" />
                    </svg>
                    <span>Instagram</span>
                  </a>
                </div>
              </section>
              <section class="couple-section couple-section--bride snap-section">
                <SmartImage
                  class="couple-section__image"
                  src={brideImage}
                  alt=""
                  aria-hidden="true"
                />
                <div class="couple-section__content" data-animate>
                  <p class="couple-section__eyebrow">
                    The <i>Bride</i>
                  </p>
                  <h3>{wedding.bride_full_name || wedding.bride_name}</h3>
                  <p>{brideParentsText}</p>
                  <a
                    class="couple-section__social"
                    href={brideInstagramUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${wedding.bride_name} Instagram`}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      aria-hidden="true"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r="1" />
                    </svg>
                    <span>Instagram</span>
                  </a>
                </div>
              </section>
            </>
          )
        }

        {
          sections.eventDetails && (
            <section class="event-section snap-section" id="event">
              <header data-animate>
                <div class="event-section__title">
                  <span class="event-section__title-main">Save</span>
                  <span class="event-section__title-script">The Date</span>
                </div>
              </header>
              <div class="event-grid" data-animate>
                {activeEvents.map((event) => (
                  <article class="event-card" data-animate>
                    <h4 class="event-card__title">{event.event_name}</h4>
                    <time class="event-card__date">
                      {formatEventDate(event.event_date).weekday},{" "}
                      {formatEventDate(event.event_date).date}
                    </time>
                    <p class="event-card__time">
                      {event.start_time} - {event.end_time}
                    </p>
                    <strong class="event-card__venue">
                      {event.venue_name}
                    </strong>
                    <p class="event-card__address">{event.venue_address}</p>
                    <a
                      class="event-card__map-btn"
                      href={event.maps_url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Google Maps
                    </a>
                  </article>
                ))}
              </div>
              {sections.countdown && settings.countdown_enabled && (
                <div class="countdown-section" data-animate>
                  <div class="countdown-section__timer" data-animate>
                    <div class="countdown-card">
                      <CountdownTimer date={wedding.wedding_date} />
                    </div>
                  </div>
                  <a
                    class="countdown-section__calendar-btn"
                    href={buildGoogleCalendarUrl(wedding as any, activeEvents[0] as any)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <rect x="3" y="4" width="18" height="18" rx="2" />
                      <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    Save to Calendar
                  </a>
                </div>
              )}
            </section>
          )
        }

        {
          sections.gallery && settings.gallery_enabled && (
            <section class="gallery-section snap-section" id="gallery">
              <h3 class="gallery-section__title" data-animate>
                Our Gallery
              </h3>
              {videoUrl && videoUrl.trim() !== "" && (
                <a
                  class="gallery-video-full"
                  href={videoUrl}
                  data-fancybox="gallery-section"
                  data-animate
                >
                  <SmartImage src={videoPoster} alt="Wedding film" loading="lazy" />
                  <div class="gallery-item__play">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5.14v13.72c0 .78.86 1.26 1.53.84l10.78-6.86a1 1 0 0 0 0-1.68L9.53 4.3A1 1 0 0 0 8 5.14Z" />
                    </svg>
                  </div>
                </a>
              )}
              <div class="gallery-grid" data-animate>
                {activeGallery.map((image) => (
                  <a
                    class={`gallery-item gallery-item--${image.variant}`}
                    href={typeof image.image_url === 'string' ? image.image_url : image.image_url.src}
                    data-fancybox="gallery-section"
                    data-animate
                  >
                    <SmartImage
                      src={image.image_url}
                      alt="Wedding gallery"
                      loading="lazy"
                    />
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          sections.gift && settings.gift_enabled && (
            <section class="gift-section snap-section" data-gift-section>
              <div class="gift-container">
                <div class="gift-header" data-animate>
                  <h3 class="gift-section__title">Wedding Gift</h3>
                  <p class="gift-section__desc">{text.giftDescription}</p>
                </div>

                <GiftGrid gifts={activeGifts} />
              </div>
            </section>
          )
        }

        {
          sections.rsvp && settings.rsvp_enabled && (
            <section
              class="rsvp-section snap-section"
              id="ucapan"
              data-rsvp-section
            >
              <h3 data-animate>RSVP &amp; Wishes</h3>
              <p data-animate>{text.rsvpDescription}</p>
              <form class="rsvp-form" data-animate data-rsvp-form>
                <input type="hidden" name="weddingId" value={wedding.id} />
                <input type="text" name="name" required placeholder="Nama" />
                <select name="attendance" required data-rsvp-attendance>
                  <option value="" disabled selected>
                    Konfirmasi Kehadiran
                  </option>
                  <option value="attending">Hadir</option>
                  <option value="declined">Tidak Hadir</option>
                </select>
                <textarea
                  name="message"
                  rows="5"
                  required
                  placeholder="Ucapan"
                />
                <div
                  class="rsvp-form__error"
                  data-rsvp-error
                  style="display:none;"
                />
                <button
                  class="template-btn template-btn--light"
                  type="submit"
                  data-rsvp-submit
                >
                  Send
                </button>
              </form>
              <div class="rsvp-success" data-rsvp-success style="display:none;">
                <h4>Terima kasih</h4>
                <p>Konfirmasi dan ucapan Anda sudah tersimpan.</p>
              </div>
              <div class="wishes-list" data-animate data-wishes-list>
                <div
                  class="wishes-empty"
                  data-wishes-empty
                  style={isWishesEmpty ? "" : "display:none;"}
                >
                  Belum ada ucapan. Jadilah yang pertama memberikan doa restu.
                </div>
                {displayedWishes.map((wish) => (
                  <article
                    class="wish-card"
                    data-animate
                    data-wish-id={wish.id}
                    data-wish-key={
                      wish.id ||
                      `${wish.created_at}|${wish.guest_name}|${wish.message || ""}`
                    }
                  >
                    <div class="wish-card__header">
                      <div class="wish-card__meta">
                        <span class="wish-card__name">{wish.guest_name}</span>
                        <span
                          class={`wish-card__badge ${wish.attendance_status === "attending" ? "wish-card__badge--attend" : "wish-card__badge--absent"}`}
                        >
                          {wish.attendance_status === "attending"
                            ? "Hadir"
                            : "Absen"}
                        </span>
                      </div>
                      <span class="wish-card__date">
                        {formatWishDate(wish.created_at)}
                      </span>
                    </div>
                    <p class="wish-card__message">{wish.message}</p>
                  </article>
                ))}
              </div>
              {hasMoreWishes && (
                <button
                  class="template-btn wishes-load-more"
                  data-wishes-load-more
                  data-offset={displayedWishes.length}
                  data-wedding-id={wedding.id}
                >
                  Load More
                </button>
              )}
            </section>
          )
        }

        <section class="thankyou-section snap-section">
          <SmartImage
            class="thankyou-section__bg"
            src={closingImage}
            alt=""
            aria-hidden="true"
          />
          <div class="thankyou-section__inner" data-animate>
            <h2 class="thankyou-section__title">Terima Kasih</h2>
            <div class="thankyou-section__socials">
              <a
                href={instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="social-link"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1"></circle>
                </svg>
              </a>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
                class="social-link"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12.04 2.5a9.43 9.43 0 0 0-8.16 14.14L2.5 21.5l4.98-1.31a9.43 9.43 0 1 0 4.56-17.69Zm0 17.14a7.71 7.71 0 0 1-3.93-1.08l-.28-.17-2.95.77.79-2.88-.18-.3a7.72 7.72 0 1 1 6.55 3.66Zm4.23-5.78c-.23-.12-1.37-.68-1.58-.75-.21-.08-.37-.12-.52.12-.16.23-.6.75-.74.9-.14.16-.27.18-.5.06-.23-.12-.98-.36-1.86-1.15-.69-.61-1.15-1.36-1.28-1.59-.14-.23-.02-.36.1-.48.11-.11.23-.27.35-.41.12-.14.16-.23.23-.39.08-.16.04-.29-.02-.41-.06-.12-.52-1.25-.71-1.71-.19-.45-.38-.39-.52-.4h-.45c-.16 0-.41.06-.62.29-.21.23-.81.79-.81 1.93 0 1.14.83 2.24.95 2.4.12.16 1.64 2.5 3.98 3.51.56.24.99.38 1.33.49.56.18 1.07.15 1.47.09.45-.07 1.37-.56 1.57-1.1.19-.54.19-1 .14-1.1-.06-.1-.21-.16-.44-.28Z"
                  ></path>
                </svg>
              </a>
            </div>
            <p class="thankyou-section__brand-text">
              wedding invitation by <span>Senadda</span>
            </p>
          </div>
        </section>

        {
          sections.music && (
            <button
              class="audio-toggle"
              data-template-audio-toggle
              type="button"
              aria-label="Play or pause music"
            >
              <span />
              {settings.music_enabled && wedding.music_url && (
                <audio data-template-audio loop src={wedding.music_url} />
              )}
            </button>
          )
        }
      </main>

      <QRISLightbox />
    </div>
  </div>
</BaseLayout>

<script>
  import "./script.js";
</script>
