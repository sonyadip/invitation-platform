  <script>
    import './script.js';

    // Solstice Hero Scroll Animation
    document.addEventListener('DOMContentLoaded', () => {
      const heroImage = document.querySelector('.solstice-hero__image');
      if (heroImage) {
        window.addEventListener('scroll', () => {
          const scrollY = window.scrollY;
          const vh = window.innerHeight;
          const progress = Math.min(scrollY / vh, 1);
          const baseScale = window.innerWidth >= 768 ? 0.4 : 0.5;
          const maxScale = 1.0;
          const currentScale = baseScale + (progress * (maxScale - baseScale));
          
          heroImage.style.transform = `scale(${currentScale})`;
        }, { passive: true });
      }
    });
  </script>
