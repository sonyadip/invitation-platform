---
import CinematicIntro from '../../components/common/CinematicIntro.astro';
import BaseLayout from "../../layouts/BaseLayout.astro";
import SmartImage from "../../components/common/SmartImage.astro";
import type { FullInvitationData } from '../../types';
import { getPlatformSettings } from '../../services/platform-settings';
import bgHero from '../noir/assets/bg-hero.webp';
import coupleBride from '../noir/assets/couple-bride.jpg';
import coupleGroom from '../noir/assets/couple-groom.jpg';
import galleryOne from '../noir/assets/gallery-1.jpg';
import galleryTwo from '../noir/assets/gallery-2.jpg';
import galleryThree from '../noir/assets/gallery-3.jpg';
import galleryFour from '../noir/assets/gallery-4.jpg';
import galleryFive from '../noir/assets/gallery-5.jpg';
import gallerySix from '../noir/assets/gallery-6.jpg';
import gallerySeven from '../noir/assets/gallery-7.jpg';
import galleryEight from '../noir/assets/gallery-8.webp';
import '@fancyapps/ui/dist/fancybox/fancybox.css';
import './style.scss';

import {
  buildParentText,
  formatDate,
  formatEventDate,
  buildGoogleCalendarUrl,
  formatWishDate
} from '../../utils/template-helpers';
import CountdownTimer from '../../components/common/CountdownTimer.astro';
import GiftGrid from '../../components/common/GiftGrid.astro';
interface Props {
  data: FullInvitationData;
  guestName: string | null;
}

const { data, guestName } = Astro.props;
const { wedding, settings, events, gallery, gifts, wishes } = data;
const sections = settings.sections;
// Override gallery with custom local images for Noir template
const customGallery = [
  { id: '1', image_url: galleryOne, variant: 'full-16x10' },
  { id: '2', image_url: galleryTwo, variant: 'half' },
  { id: '3', image_url: galleryThree, variant: 'half' },
  { id: '4', image_url: galleryFour, variant: 'half' },
  { id: '5', image_url: galleryFive, variant: 'half' },
  { id: '6', image_url: gallerySix, variant: 'full-16x10' },
  { id: '7', image_url: gallerySeven, variant: 'half' },
  { id: '8', image_url: galleryEight, variant: 'half' }
];
const themeConfig = (settings.theme_config || {
  theme: {},
  layout: { galleryColumns: 3 },
  assets: {}
}) as any;
const themeContent = themeConfig.content || {};
const platformSettings = await getPlatformSettings();

// Override font & color settings for the Noir theme
const overrideSettings = {
  ...settings,
  theme_config: {
    ...themeConfig,
    theme: {
      ...themeConfig.theme,
      primaryColor: '#FFFFFF', // Noir White
      secondaryColor: '#111111',
      textColor: '#FFFFFF',
      bgColor: '#111111',
      fontHeading: 'CVR',
      fontBody: 'Josefin Sans'
    }
  }
};

const formattedDate = formatDate(wedding.wedding_date);

const activeEvents = events && events.length > 0
  ? events
  : [{
      id: 'fallback',
      event_name: 'Akad Nikah',
      event_date: wedding.wedding_date,
      start_time: '09:00',
      end_time: 'Selesai',
      venue_name: wedding.venue_name,
      venue_address: wedding.venue_address,
      maps_url: wedding.maps_url,
      sort_order: 0,
      wedding_id: wedding.id,
      created_at: ''
    }];

const googleCalendarUrl = buildGoogleCalendarUrl(wedding as any, activeEvents[0] as any);

const themeAssets = themeConfig.assets || {};
const heroImage = themeAssets.heroImage || bgHero.src;
const coverImage = heroImage;
const eventImage = themeAssets.eventImage || galleryTwo.src;
const closingImage = themeAssets.closingImage || bgHero.src;
const heroSlides = [
  themeAssets.heroImage || bgHero,
  themeAssets.heroImageTwo || galleryOne,
  themeAssets.heroImageThree || gallerySix.src
].filter(Boolean);
const videoUrl = themeAssets.videoUrl || themeAssets.heroVideo || 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm';
const videoPoster = themeAssets.videoPoster || themeAssets.posterImage || heroImage;
const brideImage = themeAssets.brideImage || coupleBride.src;
const groomImage = themeAssets.groomImage || coupleGroom.src;
const instagramUrl = themeContent.instagramUrl || platformSettings.instagram_url || 'https://instagram.com';
const whatsappUrl = themeContent.whatsappUrl || platformSettings.whatsapp_url || '';
const groomInstagramUrl = themeContent.groomInstagramUrl || instagramUrl;
const brideInstagramUrl = themeContent.brideInstagramUrl || instagramUrl;
const giftDescription = themeContent.giftDescription || 'Bagi Bapak/Ibu/Saudara/i yang ingin mengirimkan hadiah kasih, dapat melalui transfer rekening berikut:';
const thankYouMessage = themeContent.closingMessage || 'Merupakan suatu kebahagiaan dan kehormatan bagi kami, apabila Bapak/Ibu/Saudara/i berkenan hadir di hari bahagia kami.';
const buildParentLines = (
  roleText: string,
  fatherName: string | undefined,
  motherName: string | undefined,
  fallbackFamily: string
) => {
  const parents = [
    fatherName ? `Bapak ${fatherName}` : '',
    motherName ? `Ibu ${motherName}` : ''
  ].filter(Boolean).join(' & ');

  return parents ? [roleText, parents] : [roleText, fallbackFamily];
};
const brideParentLines = buildParentLines(
  'Putri dari',
  themeContent.brideFatherName,
  themeContent.brideMotherName,
  'Keluarga Mempelai Wanita'
);
const groomParentLines = buildParentLines(
  'Putra dari',
  themeContent.groomFatherName,
  themeContent.groomMotherName,
  'Keluarga Mempelai Pria'
);
const activeGallery = gallery && gallery.length > 0
  ? gallery.map((image, index) => ({
      id: image.id,
      image_url: image.image_url,
      variant: index === 0 || index === 5 ? 'full-16x10' : 'half'
    }))
  : customGallery;
const galleryColumns = themeConfig.layout?.galleryColumns || 3;
const galleryColClass = galleryColumns === 2
  ? 'gallery-grid--col2'
  : galleryColumns === 4
    ? 'gallery-grid--col4'
    : 'gallery-grid--col3';

const isWishesEmpty = !wishes || wishes.length === 0;
const displayedWishes = wishes ? wishes.slice(0, 3) : [];
const hasMoreWishes = wishes ? wishes.length > displayedWishes.length : false;

const activeGifts = gifts && gifts.length > 0
  ? gifts
  : [
      { id: '1', bank_name: 'BCA', account_number: '1234567890', account_name: 'Sony Pratama', qris_url: null },
      { id: '2', bank_name: 'Bank Mandiri', account_number: '0987654321', account_name: 'Pratiwi Indah', qris_url: null }
    ];


const defaultText = {
  verse: "Maha Suci Allah yang telah menciptakan makhluk-Nya berpasang-pasangan. Ya Allah semoga ridho-Mu tercurah mengiringi pernikahan kami.",
  verseSource: "",
  groomParents: "Putra dari",
  brideParents: "Putri dari",
  giftDescription: "Tanpa mengurangi rasa hormat, bagi tamu yang ingin mengirimkan hadiah kasih dapat melalui rekening berikut.",
  rsvpDescription: "Mohon konfirmasi kehadiran Anda dan berikan doa restu untuk kami.",
  closingMessage: "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kedua mempelai.",
};
const text = { ...defaultText, ...themeContent };
const compactDate = new Date(wedding?.wedding_date || new Date().toISOString()).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).toUpperCase();

---
<BaseLayout
  wedding={wedding}
  settings={overrideSettings}
  to={guestName}
  templateClass="template-blush"
  image={heroImage}
>
  <div class="invitation-root" data-template-root>
    <CinematicIntro
      groomName={wedding.groom_name}
      brideName={wedding.bride_name}
      coverImage={heroImage}
    />
    <!-- ===================== COVER SCREEN ===================== -->
    <div class="cover-section" data-template-cover>
      <SmartImage class="section-bg section-bg--cover" src={heroImage} alt="" aria-hidden="true" />
      <div class="cover-section__body">
        <div class="cover-section__title-block">
          <p>The Wedding Of</p>
          <h1>
            <span class="deauville-name deauville-name--glasvia">{wedding.groom_name}</span>
            <span class="deauville-name deauville-name--letterx">{wedding.bride_name}</span>
          </h1>
        </div>
        <div class="cover-section__guest">
          <span>Kepada Yth:</span>
          <strong>{guestName || 'Nama Tamu'}</strong>
          <button class="cover-section__btn" data-template-open type="button">
            Open Invitation
          </button>
        </div>
      </div>
    </div>

    <!-- ===================== MAIN LAYOUT ===================== -->
    <div class="invitation-layout" data-template-layout>

      <!-- LEFT FIXED SIDEBAR (desktop only) -->
      <div class="sidebar-section-wrap">
        <aside class="sidebar-section">
          <SmartImage class="section-bg section-bg--sidebar" src={heroImage} alt="" aria-hidden="true" />
          <div class="sidebar-section__inner" data-animate="fade-up" style="--animate-delay: 300ms;">
            <p class="sidebar-section__eyebrow">The Wedding Of</p>
            <h2 class="sidebar-section__groom">{wedding.groom_name}</h2>
            <div class="sidebar-section__sep">&amp;</div>
            <h2 class="sidebar-section__bride">{wedding.bride_name}</h2>
            <div class="sidebar-section__divider">
              <span class="sidebar-section__date">{formattedDate}</span>
            </div>
          </div>
        </aside>
      </div>

      <!-- RIGHT SCROLLABLE CONTENT -->
      <main class="invitation-main">
        
        <section class="solstice-hero">
          <div class="solstice-hero__container">
            <div class="solstice-hero__sticky">
              <div class="solstice-hero__image-wrap" data-animate>
                <div class="solstice-hero__image-inner">
                  <SmartImage class="solstice-hero__image" src={coverImage} alt="Couple" loading="lazy" />
                </div>
              </div>
              <div class="hero-section__scroll-indicator" aria-hidden="true">
                <div class="hero-section__scroll-line"></div>
              </div>
            </div>
              
            <div class="hero-section__content" data-animate>
              <h1 class="hero-section__names">{wedding?.groom_name} &amp; {wedding?.bride_name}</h1>
              <p class="hero-section__date">{compactDate.replace(/ /g, ' . ')}</p>
            </div>
          </div>
        </section>

        <!-- Opening Verse Section -->
        <blockquote class="intro-section__verse" data-animate>
          "Wahai pasangan suami-isteri, semoga kalian tetap bersatu dan tidak pernah terpisahkan. Semoga kalian mencapai hidup penuh kebahagiaan, tinggal di rumah yang penuh kegembiraan bersama seluruh keturunanmu."
          <cite class="intro-section__source">(Rgveda : X.85.42)</cite>
        </blockquote>

        <div id="template-content" class="sections-stack">
          <!-- Couple Section -->
          <section class="couple-section">
            <div class="couple-section__photos">
              <SmartImage src={groomImage} alt="Groom" class="couple-section__photo couple-section__photo--groom" loading="lazy" />
              <SmartImage src={brideImage} alt="Bride" class="couple-section__photo couple-section__photo--bride" loading="lazy" />
            </div>
            <div class="couple-section__info">
              <div class="couple-section__person" data-animate>
                <h2 class="couple-section__name">{wedding?.groom_full_name || wedding?.groom_name}</h2>
                <p class="couple-section__parents">{text.groomParents}</p>
                <p class="couple-section__parent-names">
                  Bapak {text.groomFatherName || 'Nama Bapak'}<br/>
                  &amp; Ibu {text.groomMotherName || 'Nama Ibu'}
                </p>
                <a class="couple-section__social" href={groomInstagramUrl} target="_blank" rel="noopener noreferrer" aria-label={`${wedding?.groom_name} Instagram`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" />
                  </svg>
                  <span>Instagram</span>
                </a>
              </div>
              <div class="couple-section__divider">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="12" y="2" width="10" height="10" transform="rotate(45 12 2)" fill="#C6A87C"/>
                </svg>
              </div>
              <div class="couple-section__person" data-animate>
                <h2 class="couple-section__name">{wedding?.bride_full_name || wedding?.bride_name}</h2>
                <p class="couple-section__parents">{text.brideParents}</p>
                <p class="couple-section__parent-names">
                  Bapak {text.brideFatherName || 'Nama Bapak'}<br/>
                  &amp; Ibu {text.brideMotherName || 'Nama Ibu'}
                </p>
                <a class="couple-section__social" href={brideInstagramUrl} target="_blank" rel="noopener noreferrer" aria-label={`${wedding?.bride_name} Instagram`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" />
                  </svg>
                  <span>Instagram</span>
                </a>
              </div>
            </div>
          </section>

          <!-- Events Section -->
          <section class="events-section">
            <SmartImage class="events-section__bg" src={eventImage} alt="" loading="lazy" />
            <div class="events-section__overlay"></div>
            <div class="events-section__content">
              <h2 class="section-title" data-animate>Wedding Event</h2>
              
              <div class="events-section__list">
                {activeEvents.map((event, index) => {
                  const dateInfo = formatEventDate(event.event_date);
                  return (
                    <div class="event-card" data-animate>
                      <h3 class="event-card__name">{event.event_name}</h3>
                      <div class="event-card__details">
                        <div class="event-card__date">
                          <p>{dateInfo.weekday}</p>
                          <p>{dateInfo.date}</p>
                        </div>
                        <div class="event-card__time">
                          <p>PUKUL</p>
                          <p>{event.start_time} - {event.end_time || 'SELESAI'}</p>
                        </div>
                      </div>
                      <p class="event-card__location">{event.venue_name || event.location_name}</p>
                      <a href={event.maps_url || '#'} target="_blank" class="event-card__map-btn">Map Lokasi</a>
                    </div>
                  );
                })}
              </div>
            </div>
          </section>

          <!-- Gallery Section -->
          <section class="gallery-section">
            <h2 class="section-title" data-animate>Gallery</h2>
              {videoUrl && videoUrl.trim() !== "" && (
                <a class="gallery-video-full" href={videoUrl} data-fancybox="gallery-section" data-animate>
                  <SmartImage src={videoPoster} alt="Wedding film" loading="lazy" />
                  <div class="gallery-item__play">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5.14v13.72c0 .78.86 1.26 1.53.84l10.78-6.86a1 1 0 0 0 0-1.68L9.53 4.3A1 1 0 0 0 8 5.14Z" />
                    </svg>
                  </div>
                </a>
              )}
              <div class="gallery-section__grid">
                {activeGallery.slice(0, 4).map((img, index) => (
                  <a href={typeof img.image_url === 'string' ? img.image_url : img.image_url.src} class={`gallery-section__item gallery-section__item--${index}`} data-fancybox="gallery-section" data-animate>
                    <SmartImage src={img.image_url} alt="Gallery" loading="lazy" />
                  </a>
                ))}
              </div>
          </section>

          <!-- Gifts Section -->
          {sections.gift && settings.gift_enabled && (
            <>
              <section class="gift-section" data-gift-section>
                <div class="gift-container">
                  <div class="gift-header" data-animate="fade-up" data-stagger-heading style="--animate-delay: 200ms;">
                    <h3 class="section-title">Wedding Gift</h3>
                    <p class="gift-desc">{text.giftDescription}</p>
                    <div class="section-rule"></div>
                  </div>

                  <GiftGrid gifts={activeGifts} />
                </div>
              </section>

              </>
          )}

          <!-- RSVP & Wishes Section -->
          {sections.rsvp && settings.rsvp_enabled && (
            <section class="rsvp-section" data-rsvp-section>
              <div class="rsvp-container">
                <div class="rsvp-header" data-animate="fade-up" data-stagger-heading style="--animate-delay: 200ms;">
                  <h3 class="section-title">RSVP & Wishes</h3>
                  <p class="rsvp-subtitle">{text.rsvpDescription}</p>
                </div>

                <div class="rsvp-panel" data-animate="fade-up" style="--animate-delay: 400ms;">
                  <div class="rsvp-card">
                    <div class="rsvp-success" data-rsvp-success style="display:none;">
                      <div class="rsvp-success__icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                      </div>
                      <h4 class="rsvp-success__title">Terima Kasih!</h4>
                      <p class="rsvp-success__desc">Konfirmasi kehadiran dan ucapan Anda telah berhasil kami simpan.</p>
                    </div>

                    <form class="rsvp-form" data-rsvp-form>
                      <input type="hidden" name="weddingId" value={wedding?.id} />
                      <div class="rsvp-form__field">
                        <input type="text" id="rsvp-name" name="name" required placeholder="Nama" class="rsvp-form__input" value={guestName || ''} readonly={!!guestName} />
                      </div>
                      <div class="rsvp-form__field">
                        <select id="rsvp-attendance" name="attendance" required class="rsvp-form__select" data-rsvp-attendance>
                          <option value="" disabled>Konfirmasi Kehadiran</option>
                          <option value="attending" selected>Hadir</option>
                      <option value="tentative">Ragu</option>
                          <option value="declined">Tidak Hadir</option>
                        </select>
                      </div>
                      <div class="rsvp-form__field">
                          <select name="count" class="rsvp-form__select">
                            <option value="1" selected>1 Orang</option>
                            <option value="2">2 Orang</option>
                            <option value="3">3 Orang</option>
                            <option value="4">4 Orang</option>
                            <option value="5">5 Orang</option>
                          </select>
                        </div>
                        <div class="rsvp-form__field">
                        <textarea id="rsvp-message" name="message" rows="4" placeholder="Ucapan" class="rsvp-form__textarea"></textarea>
                      </div>
                      <div class="rsvp-form__error" data-rsvp-error style="display:none;"></div>
                      <button type="submit" class="rsvp-form__submit" data-rsvp-submit>Kirim</button>
                    </form>
                  </div>

                  <div class="wishes-list" data-wishes-list>
                    <div class="wishes-empty" data-wishes-empty style={isWishesEmpty ? '' : 'display:none;'}>
                      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                      </svg>
                      <span>Belum ada ucapan. Jadilah yang pertama memberikan doa restu!</span>
                    </div>

                    {displayedWishes.map((wish, index) => (
                      <div
                        class="wish-card animate-fade-in-up"
                        data-animate="fade-up"
                        style={`--animate-delay: ${200 + index * 200}ms;`}
                        data-wish-id={wish.id}
                        data-wish-key={wish.id || `${wish.created_at}|${wish.guest_name}|${wish.message || ''}`}
                      >
                        <div class="wish-card__header">
                          <div class="wish-card__meta">
                            <span class="wish-card__name">{wish.guest_name}</span>
                            <span class={`wish-card__badge ${wish.attendance_status === "attending" ? "wish-card__badge--attend" : wish.attendance_status === "tentative" ? "wish-card__badge--tentative" : "wish-card__badge--absent"}`}>
                              {wish.attendance_status === "attending" ? "Hadir" : wish.attendance_status === "tentative" ? "Ragu" : "Absen"}
                            </span>
                          </div>
                          <span class="wish-card__date">{formatWishDate(wish.created_at)}</span>
                        </div>
                        <p class="wish-card__message">{wish.message}</p>
                      </div>
                    ))}
                  </div>
                  {hasMoreWishes && (
                    <button class="wishes-load-more" data-wishes-load-more data-offset={displayedWishes.length} data-wedding-id={wedding?.id}>
                      Load More
                    </button>
                  )}
                </div>
              </div>
            </section>
          )}

        </div>

        <!-- Closing Section -->
        <section class="thankyou-section">
          <SmartImage class="thankyou-section__bg" src={closingImage} alt="" aria-hidden="true" />
          <div class="thankyou-section__inner" data-animate="fade-up" style="--animate-delay: 300ms;">
            <h2 class="thankyou-section__title">Terima Kasih</h2>
            <div class="thankyou-section__socials">
              <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" xmlns="http://www.w3.org/2000/svg">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1"></circle>
                </svg>
              </a>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
                class="social-link"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
